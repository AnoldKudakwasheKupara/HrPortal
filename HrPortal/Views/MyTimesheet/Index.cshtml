@using HrPortal.Entities
@model HrPortal.ViewModels.MyTimesheetIndexViewModel

@{
    ViewData["Title"] = "My Timesheet";

    var today = DateTime.Today;

    string Week(DateTime start) => start.ToString("yyyy-MM-dd");

    string Hours(int minutes) => TimesheetEntry.FormatDuration(minutes);

    var averagePerLoggedDay = Model.DaysLoggedThisWeek == 0
        ? 0
        : Model.MinutesThisWeek / Model.DaysLoggedThisWeek;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>My Timesheet</h2>
            <p class="text-muted mb-0">
                What you worked on and how long it took, kept for the
                @Model.DepartmentName record.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Log Work
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-stats">

        <div class="report-stat">
            <span class="report-stat-label">This week</span>
            <span class="report-stat-value">@Hours(Model.MinutesThisWeek)</span>
            <span class="report-stat-note">
                @Model.Entries.Count @(Model.Entries.Count == 1 ? "entry" : "entries")
            </span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">Days logged</span>
            <span class="report-stat-value">@Model.DaysLoggedThisWeek</span>
            <span class="report-stat-note">
                @(Model.DaysLoggedThisWeek == 0
                    ? "Nothing yet this week"
                    : "Averaging " + Hours(averagePerLoggedDay) + " a day")
            </span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">This month</span>
            <span class="report-stat-value">@Hours(Model.MinutesThisMonth)</span>
            <span class="report-stat-note">
                @Model.EntriesThisMonth @(Model.EntriesThisMonth == 1 ? "entry" : "entries") in @today.ToString("MMMM")
            </span>
        </div>

    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">

            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary"
                   asp-action="Index"
                   asp-route-week="@Week(Model.WeekStart.AddDays(-7))">
                    &laquo; Previous week
                </a>

                @if (!Model.IsCurrentWeek)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Index">
                        This week
                    </a>
                }

                @if (Model.WeekEnd < today)
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Index"
                       asp-route-week="@Week(Model.WeekStart.AddDays(7))">
                        Next week &raquo;
                    </a>
                }
            </div>

            <strong>
                Week of @Model.WeekStart.ToString("d MMM")
                to @Model.WeekEnd.ToString("d MMM yyyy")
                @if (Model.IsCurrentWeek)
                {
                    <span class="badge bg-info ms-1">Current</span>
                }
            </strong>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Type</th>
                            <th>Task</th>
                            <th>Reference</th>
                            <th>Asset</th>
                            <th class="num">Time</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var day in Model.DailyMinutes.Keys.OrderBy(d => d))
                    {
                        var entries = Model.Entries
                            .Where(e => e.WorkDate.Date == day)
                            .ToList();

                        var isWeekend =
                            day.DayOfWeek == DayOfWeek.Saturday ||
                            day.DayOfWeek == DayOfWeek.Sunday;

                        if (isWeekend && entries.Count == 0 && day != today)
                            continue;

                        if (day > today)
                            continue;

                        <tr class="table-light">
                            <td colspan="5">
                                <strong>@day.ToString("dddd d MMM")</strong>
                                @if (day == today)
                                {
                                    <span class="badge bg-primary ms-1">Today</span>
                                }
                            </td>
                            <td class="num">
                                <strong>
                                    @(entries.Count == 0 ? "--" : Hours(Model.DailyMinutes[day]))
                                </strong>
                            </td>
                            <td class="col-actions">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Create"
                                   asp-route-date="@day.ToString("yyyy-MM-dd")">
                                    Log work
                                </a>
                            </td>
                        </tr>

                        if (entries.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-muted small ps-4">
                                    Nothing logged.
                                </td>
                            </tr>
                            continue;
                        }

                        foreach (var e in entries)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    @if (e.StartTime.HasValue && e.EndTime.HasValue)
                                    {
                                        @e.StartTime.Value.ToString("HH:mm")
                                        <text>&ndash;</text>
                                        @e.EndTime.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>@e.Category</td>

                                <td>
                                    <strong>@e.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(e.Details))
                                    {
                                        <div class="text-muted small">@e.Details</div>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(e.Reference) ? "--" : e.Reference)
                                </td>

                                <td>
                                    @if (e.Asset != null)
                                    {
                                        @e.Asset.DeviceModel
                                        @if (!string.IsNullOrWhiteSpace(e.Asset.SerialNumber))
                                        {
                                            <div class="text-muted small">@e.Asset.SerialNumber</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td class="num">@Hours(e.DurationMinutes)</td>

                                <td class="col-actions">
                                    <div class="table-actions">

                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Edit" asp-route-id="@e.Id">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@e.Id"
                                              method="post"
                                              onsubmit="return confirm('Remove this entry from your timesheet?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Remove
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                    @if (Model.Entries.Any())
                    {
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end">
                                    <strong>Week total</strong>
                                </td>
                                <td class="num">
                                    <strong>@Hours(Model.MinutesThisWeek)</strong>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }

                </table>
            </div>
        </div>
    </div>

</div>
