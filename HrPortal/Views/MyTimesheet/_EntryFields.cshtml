@using HrPortal.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model HrPortal.ViewModels.TimesheetEntryViewModel

@{
    var assets = ViewBag.Assets as List<SelectListItem>
        ?? new List<SelectListItem>();
}

<div class="row">

    <div class="col-md-4 mb-3">
        <label asp-for="WorkDate" class="form-label"></label>
        <input asp-for="WorkDate" class="form-control" type="date"
               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="WorkDate" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select"
                asp-items="Html.GetEnumSelectList<WorkCategory>()">
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Reference" class="form-label"></label>
        <input asp-for="Reference" class="form-control"
               placeholder="Ticket or job number, if any" />
        <span asp-validation-for="Reference" class="text-danger"></span>
    </div>

</div>

<div class="section-heading">Time spent</div>

<div class="row">

    <div class="col-md-3 mb-3">
        <label asp-for="StartTime" class="form-label"></label>
        <input asp-for="StartTime" class="form-control" type="time"
               id="timesheet-start" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="col-md-3 mb-3">
        <label asp-for="EndTime" class="form-label"></label>
        <input asp-for="EndTime" class="form-control" type="time"
               id="timesheet-end" />
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <div class="col-md-3 mb-3">
        <label asp-for="Hours" class="form-label"></label>
        <input asp-for="Hours" class="form-control" type="number"
               step="0.25" min="0" max="24" id="timesheet-hours"
               placeholder="e.g. 1.5" />
        <span asp-validation-for="Hours" class="text-danger"></span>
    </div>

    <div class="col-md-3 mb-3 d-flex align-items-end">
        <div class="form-text mb-2" id="timesheet-duration"></div>
    </div>

</div>

<div class="form-text mb-3">
    Give a start and finish time, or just the hours it took
    (1.5 is an hour and a half). When both are given the times win.
</div>

<div class="section-heading">The work</div>

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control"
           placeholder="e.g. Replaced the faulty hard drive on the finance laptop" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="AssetId" class="form-label"></label>
    <select asp-for="AssetId" class="form-select">
        <option value="">-- Not tied to a machine on the register --</option>
        @foreach (var a in assets)
        {
            <option value="@a.Value"
                    selected="@(Model.AssetId?.ToString() == a.Value)">
                @a.Text
            </option>
        }
    </select>
    <span asp-validation-for="AssetId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Details" class="form-label"></label>
    <textarea asp-for="Details" class="form-control" rows="4"
              placeholder="What you did, what you found, anything still outstanding"></textarea>
    <span asp-validation-for="Details" class="text-danger"></span>
</div>

<script>
(function () {
    var start = document.getElementById('timesheet-start');
    var end = document.getElementById('timesheet-end');
    var hours = document.getElementById('timesheet-hours');
    var out = document.getElementById('timesheet-duration');

    if (!start || !end || !hours || !out) return;

    function minutesOf(value) {
        if (!value) return null;
        var parts = value.split(':');
        return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
    }

    function label(minutes) {
        var h = Math.floor(minutes / 60);
        var m = Math.round(minutes % 60);
        if (h === 0) return m + 'm';
        return m === 0 ? h + 'h' : h + 'h ' + (m < 10 ? '0' : '') + m + 'm';
    }

    function refresh() {
        var a = minutesOf(start.value);
        var b = minutesOf(end.value);

        if (a !== null && b !== null) {
            if (b <= a) {
                out.textContent = 'Finish must be after start.';
                return;
            }
            hours.value = ((b - a) / 60).toFixed(2);
            hours.readOnly = true;
            out.textContent = 'Will record ' + label(b - a) + '.';
            return;
        }

        hours.readOnly = false;

        var typed = parseFloat(hours.value);
        out.textContent = typed > 0
            ? 'Will record ' + label(typed * 60) + '.'
            : '';
    }

    start.addEventListener('input', refresh);
    end.addEventListener('input', refresh);
    hours.addEventListener('input', refresh);
    refresh();
})();
</script>
