@model HrPortal.ViewModels.TimesheetEntryViewModel

@{
    ViewData["Title"] = "Log Work";
}

<div class="container">

    <div class="page-head-simple">
        <h2>Log Work</h2>
        <p class="text-muted">
            Record a job you did and how long it took. One entry per
            piece of work keeps the record useful later.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <partial name="_EntryFields" model="Model" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Entry
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
