@model HrPortal.ViewModels.TimesheetEntryViewModel

@{
    ViewData["Title"] = "Edit Entry";
}

<div class="container">

    <div class="page-head-simple">
        <h2>Edit Entry</h2>
        <p class="text-muted">
            Correct what was logged for this piece of work.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <partial name="_EntryFields" model="Model" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                    <a asp-action="Index"
                       asp-route-week="@HrPortal.Controllers.MyTimesheetController.WeekStart(Model.WorkDate).ToString("yyyy-MM-dd")"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
