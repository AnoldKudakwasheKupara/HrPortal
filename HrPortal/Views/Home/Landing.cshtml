@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";

    var quickAccess = new (string Icon, string Title, string Note, string Target)[]
    {
        ("fa-user-group", "People & Directory",
            "Find colleagues and connect across the business.",
            "/Directory"),

        ("fa-file-lines", "Policies & Documents",
            "Access company policies, forms and useful resources.",
            "/Policy"),

        ("fa-calendar-check", "Leave & Training",
            "Manage your leave and explore training opportunities.",
            "/MyLeave"),

        ("fa-bell", "Company Updates",
            "Stay informed with the latest news and announcements.",
            "/MyNotifications")
    };
}

<section class="hero" id="home">

    <div class="hero-copy">

        <span class="eyebrow is-on-dark">@Brand.Current.ShortName People Portal</span>

        <h1 class="hero-title">
            Welcome to the
            <span>@Brand.Current.ShortName team.</span>
        </h1>

        <p class="hero-lede">
            Your central place for company policies, employee
            resources, training, leave and staff information.
        </p>

        <a class="btn btn-light hero-action"
           asp-area="Identity"
           asp-page="/Account/Login">
            Sign in to the portal
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>

    </div>

    <div class="hero-plate">

        <svg class="hero-plate-art"
             viewBox="0 0 800 520"
             preserveAspectRatio="xMidYMid slice"
             aria-hidden="true"
             focusable="false">
            <circle cx="690" cy="60" r="300" class="plate-wash" />
            <circle cx="120" cy="470" r="260" class="plate-wash" />
            <path d="M-40 0 C 140 150, 90 360, 210 520" class="plate-thread" />
        </svg>

        <img src="@Url.Content(Brand.Current.Asset("logo-on-dark.png"))"
             alt="@Brand.Current.FullName"
             class="hero-plate-logo" />

        <span class="hero-badge">
            <i class="fas fa-user-group" aria-hidden="true"></i>
            Your workplace, connected
        </span>

    </div>

</section>

<section class="band is-sunken" id="quick-access">

    <div class="band-inner quick-layout">

        <div class="quick-intro">
            <span class="eyebrow">Quick access</span>
            <h2 class="band-title">
                Everything you need,
                <span>in one place</span>
            </h2>
        </div>

        <div class="quick-grid">

            @foreach (var item in quickAccess)
            {
                <a class="quick-card"
                   asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-returnUrl="@item.Target">

                    <span class="quick-icon">
                        <i class="fas @item.Icon" aria-hidden="true"></i>
                    </span>

                    <span class="quick-title">@item.Title</span>

                    <span class="quick-note">@item.Note</span>

                    <i class="fas fa-chevron-right quick-chevron"
                       aria-hidden="true"></i>

                </a>
            }

        </div>

    </div>

</section>

<partial name="@Brand.Current.AboutPartial" optional="true" />
