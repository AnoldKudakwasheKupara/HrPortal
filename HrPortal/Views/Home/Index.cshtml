@using HrPortal.Entities
@model HrPortal.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting =
        hour < 12 ? "Good morning"
        : hour < 18 ? "Good afternoon"
        : "Good evening";

    string Ago(DateTime when)
    {
        var span = DateTime.UtcNow - when;

        if (span.TotalMinutes < 1) return "Just now";

        if (span.TotalMinutes < 60)
        {
            var m = (int)span.TotalMinutes;
            return m == 1 ? "1 min ago" : $"{m} mins ago";
        }

        if (span.TotalHours < 24)
        {
            var h = (int)span.TotalHours;
            return h == 1 ? "1 hour ago" : $"{h} hours ago";
        }

        if (span.TotalDays < 30)
        {
            var d = (int)span.TotalDays;
            return d == 1 ? "Yesterday" : $"{d} days ago";
        }

        return when.ToLocalTime().ToString("d MMM yyyy");
    }

    string AuditIcon(string action) => action switch
    {
        "Created" => "fa-plus",
        "Updated" => "fa-pen",
        "Deleted" => "fa-trash-can",
        "Activated" => "fa-toggle-on",
        "Deactivated" => "fa-toggle-off",
        "Password Reset" => "fa-key",
        "Role Changed" => "fa-user-shield",
        "Document Uploaded" => "fa-file-arrow-up",
        var a when a.StartsWith("Leave") => "fa-umbrella-beach",
        var a when a.StartsWith("Training") => "fa-graduation-cap",
        _ => "fa-circle-dot"
    };

    // One row of uniform tiles, chosen by the strongest role the
    // person holds, and one slim column of quick actions.
    var tiles = new List<(string Icon, string Label, string Value,
                          string Note, string Ctrl, string Act, string Tone)>();
    var actions = new List<(string Icon, string Title, string Ctrl, string Act)>();
    (string Title, string Ctrl, string Act)? primary = null;

    if (Model.Admin != null)
    {
        var a = Model.Admin;

        tiles.Add(("fa-users", "Employees", a.ActiveEmployees.ToString("N0"),
            a.EmployeesWithoutLogin == 0
                ? "All have a login"
                : $"{a.EmployeesWithoutLogin:N0} without a login",
            "Employee", "Index", ""));

        tiles.Add(("fa-laptop", "Assets", a.Assets.ToString("N0"),
            $"{a.UnassignedAssets:N0} unassigned",
            "Asset", "Index", ""));

        tiles.Add(("fa-certificate", "Licences",
            (a.LicensesExpired + a.LicensesExpiringSoon).ToString("N0"),
            a.LicensesExpired > 0
                ? $"{a.LicensesExpired:N0} lapsed"
                : "Due within 60 days",
            "License", "Index",
            a.LicensesExpired > 0 ? "is-critical"
                : a.LicensesExpiringSoon > 0 ? "is-warning" : ""));

        tiles.Add(("fa-screwdriver-wrench", "Maintenance",
            (a.MaintenanceOverdue + a.MaintenanceDueSoon).ToString("N0"),
            a.MaintenanceOverdue > 0
                ? $"{a.MaintenanceOverdue:N0} overdue"
                : "Due within 30 days",
            "AssetMaintenance", "Index",
            a.MaintenanceOverdue > 0 ? "is-critical"
                : a.MaintenanceDueSoon > 0 ? "is-warning" : ""));

        tiles.Add(("fa-headset", "IT activity", a.ActivitiesThisWeek.ToString("N0"),
            a.ActivitiesOutstanding == 0
                ? "Nothing outstanding"
                : $"{a.ActivitiesOutstanding:N0} still open",
            "ItActivity", "Index",
            a.ActivitiesOutstanding > 0 ? "is-warning" : ""));

        tiles.Add(("fa-file-lines", "Weekly report",
            a.WeeklyReportDue ? "Due" : "Done",
            a.WeeklyReportDue ? "This week's is not drafted" : "This week is covered",
            "WeeklyReport", "Index",
            a.WeeklyReportDue ? "is-warning" : "is-good"));

        primary = ("Add employee", "Employee", "Create");
        actions.Add(("fa-user-plus", "Add employee", "Employee", "Create"));
        actions.Add(("fa-laptop", "Register asset", "Asset", "Create"));
        actions.Add(("fa-file-arrow-up", "Upload document", "Repository", "Upload"));
        actions.Add(("fa-headset", "Log IT activity", "ItActivity", "Create"));
        actions.Add(("fa-file-lines", "Weekly report", "WeeklyReport", "Index"));
        actions.Add(("fa-chart-column", "Reports", "Reports", "Index"));
    }
    else if (Model.Hr != null)
    {
        var h = Model.Hr;

        tiles.Add(("fa-inbox", "Awaiting review", h.AwaitingReview.ToString("N0"),
            h.AwaitingReview == 0 ? "Nothing to review" : "Waiting on HR",
            "LeaveApproval", "Index", h.AwaitingReview > 0 ? "is-warning" : "is-good"));

        tiles.Add(("fa-stamp", "With the MD", h.WithMd.ToString("N0"),
            "Cleared HR, awaiting sign-off",
            "LeaveRequest", "Index", ""));

        tiles.Add(("fa-rotate-left", "Returned", h.ReturnedToEmployees.ToString("N0"),
            "Sent back and not resubmitted",
            "LeaveRequest", "Index", h.ReturnedToEmployees > 0 ? "is-warning" : ""));

        tiles.Add(("fa-users", "Staff", h.ActiveEmployees.ToString("N0"),
            $"{h.OnLeaveToday:N0} on leave today",
            "Employee", "Index", ""));

        tiles.Add(("fa-graduation-cap", "Overdue training", h.OverdueTrainingOrgWide.ToString("N0"),
            h.OverdueTrainingOrgWide == 0 ? "Everyone is up to date" : "Past the due date",
            "Reports", "Training", h.OverdueTrainingOrgWide > 0 ? "is-critical" : "is-good"));

        tiles.Add(("fa-calendar-check", "Approved this month", h.ApprovedThisMonth.ToString("N0"),
            "Leave requests completed",
            "Reports", "LeaveRequests", ""));

        primary = ("Review leave", "LeaveApproval", "Index");
        actions.Add(("fa-inbox", "Review leave", "LeaveApproval", "Index"));
        actions.Add(("fa-user-plus", "Add employee", "Employee", "Create"));
        actions.Add(("fa-file-arrow-up", "File a document", "EmployeeDocument", "Create"));
        actions.Add(("fa-clipboard-check", "Add a course", "TrainingCourse", "Create"));
        actions.Add(("fa-user-graduate", "Course applications", "CourseApproval", "Index"));
        actions.Add(("fa-chart-column", "Reports", "Reports", "Index"));
    }
    else if (Model.Md != null)
    {
        var m = Model.Md;

        tiles.Add(("fa-stamp", "To sanction", m.AwaitingFinalApproval.ToString("N0"),
            m.AwaitingFinalApproval == 0 ? "Nothing waiting" : "Leave waiting on you",
            "LeaveApproval", "FinalApproval",
            m.AwaitingFinalApproval > 0 ? "is-warning" : "is-good"));

        tiles.Add(("fa-calendar-check", "Approved", m.ApprovedThisMonth.ToString("N0"),
            $"{m.DaysApprovedThisMonth:0.#} days this month",
            "LeaveRequest", "Index", ""));

        tiles.Add(("fa-ban", "Rejected", m.RejectedThisMonth.ToString("N0"),
            "This month",
            "LeaveRequest", "Index", ""));

        tiles.Add(("fa-umbrella-beach", "On leave today", m.OnLeaveToday.ToString("N0"),
            "Staff away right now",
            "Reports", "Absence", ""));

        primary = ("Final approval", "LeaveApproval", "FinalApproval");
        actions.Add(("fa-stamp", "Final approval", "LeaveApproval", "FinalApproval"));
        actions.Add(("fa-hand-holding-dollar", "Sanction a loan", "LoanApproval", "Index"));
        actions.Add(("fa-user-graduate", "Course applications", "CourseApproval", "Index"));
        actions.Add(("fa-chart-column", "Reports", "Reports", "Index"));
    }
    else if (Model.Mine != null)
    {
        var me = Model.Mine;

        tiles.Add(("fa-calendar-days", "Leave remaining",
            me.HasBalances ? me.RemainingDays.ToString("0.#") : "—",
            me.HasBalances
                ? (me.HeadlineLeaveType ?? "days available")
                : "No balance set up yet",
            "MyLeave", "Index", ""));

        tiles.Add(("fa-umbrella-beach", "Leave taken",
            me.HasBalances ? me.DaysTakenThisYear.ToString("0.#") : "—",
            $"Days used in {DateTime.Today.Year}",
            "MyLeave", "Index", ""));

        tiles.Add(("fa-hourglass-half", "In progress", me.RequestsInProgress.ToString("N0"),
            me.RequestsInProgress == 0 ? "No open requests" : "Awaiting a decision",
            "MyLeave", "Index", ""));

        tiles.Add(("fa-graduation-cap", "Training to do", me.OutstandingTraining.ToString("N0"),
            me.OverdueTraining > 0
                ? $"{me.OverdueTraining:N0} overdue"
                : me.OutstandingTraining == 0 ? "All caught up" : "None overdue",
            "MyTraining", "Index",
            me.OverdueTraining > 0 ? "is-critical" : me.OutstandingTraining == 0 ? "is-good" : ""));

        tiles.Add(("fa-laptop", "My assets", me.MyAssets.ToString("N0"),
            me.MyAssets == 0 ? "Nothing issued" : "Issued to you",
            "MyAssets", "Index", ""));

        tiles.Add(("fa-bell", "Notices", me.UnreadNotifications.ToString("N0"),
            me.UnreadNotifications == 0 ? "Nothing new" : "Unread",
            "MyNotifications", "Index", me.UnreadNotifications > 0 ? "is-warning" : ""));

        primary = Model.ShowsOwnLeave ? ("Request leave", "MyLeave", "Create") : null;
        actions.Add(("fa-calendar-plus", "Request leave", "MyLeave", "Create"));
        actions.Add(("fa-graduation-cap", "My training", "MyTraining", "Index"));
        actions.Add(("fa-id-badge", "My record", "MyProfile", "Index"));
        actions.Add(("fa-user-graduate", "Apply for a course", "MyCourses", "Create"));
        actions.Add(("fa-hand-holding-dollar", "Apply for a loan", "MyLoans", "Create"));
        actions.Add(("fa-book", "Policies", "Policy", "Index"));
    }

    var hasAttention = Model.Focus.Any() || Model.Upcoming.Any();

    var queue = Model.Hr?.ReviewQueue ?? Model.Md?.ApprovalQueue ?? new List<LeaveRequest>();
    var queueTitle = Model.Hr != null ? "Leave to review" : "Leave to sign off";
    var queueCtrl = "LeaveApproval";
    var queueAct = Model.Hr != null ? "Index" : "FinalApproval";
    var startingSoon = Model.Hr?.StartingSoon ?? Model.Md?.StartingSoon ?? new List<LeaveRequest>();

    var charts = Model.Trends
        .Where(t => t.Points.Count > 1 && t.Total > 0)
        .ToList();
}

<div class="container-fluid dash">

    <div class="dash-head">
        <div>
            <span class="eyebrow">@DateTime.Today.ToString("dddd, d MMMM yyyy")</span>
            <h1>@greeting, <span class="dash-name">@Model.GreetingName</span></h1>
        </div>
        @if (primary != null)
        {
            <a class="btn btn-primary dash-primary"
               asp-controller="@primary.Value.Ctrl"
               asp-action="@primary.Value.Act">
                <i class="fas fa-plus" aria-hidden="true"></i>
                @primary.Value.Title
            </a>
        }
    </div>

    @if (!Model.HasEmployeeRecord)
    {
        <div class="alert alert-info dash-alert">
            <strong>No employee record is linked to your account.</strong>
            Leave, training and other personal sections stay hidden until an
            administrator links one.
        </div>
    }

    @if (Model.Admin != null && (!Model.Admin.HasHrOfficer || !Model.Admin.HasMd))
    {
        <div class="alert alert-warning dash-alert">
            <strong>Nobody can approve at every stage.</strong>
            @if (!Model.Admin.HasHrOfficer) { <text>Nobody holds the HR Officer role. </text> }
            @if (!Model.Admin.HasMd) { <text>Nobody holds the MD role. </text> }
            Requests will still be raised, but nobody is told to act on them.
            <a asp-controller="Role" asp-action="Index">Grant the roles</a>.
        </div>
    }

    <div class="dash-kpis" data-count="@tiles.Count">
        @foreach (var tile in tiles)
        {
            <a class="kpi @tile.Tone"
               asp-controller="@tile.Ctrl"
               asp-action="@tile.Act">
                <span class="kpi-icon"><i class="fas @tile.Icon" aria-hidden="true"></i></span>
                <span class="kpi-label">@tile.Label</span>
                <span class="kpi-value">@tile.Value</span>
                <span class="kpi-note">@tile.Note</span>
            </a>
        }
    </div>

    <div class="dash-body">

        <div class="dash-main">

            <section class="card dash-card">
                <header class="dash-card-head">
                    <h2>Needs your attention</h2>
                    @if (hasAttention)
                    {
                        <span class="dash-count">@(Model.Focus.Count + Model.Upcoming.Count)</span>
                    }
                </header>

                @if (hasAttention)
                {
                    <ul class="dash-list">
                        @foreach (var item in Model.Focus)
                        {
                            <li>
                                <a class="dash-row @item.Tone"
                                   asp-controller="@item.Controller"
                                   asp-action="@item.Action"
                                   asp-all-route-data="@item.RouteData">
                                    <span class="dash-row-icon">
                                        <i class="fas @item.Icon" aria-hidden="true"></i>
                                    </span>
                                    <span class="dash-row-main">
                                        <span class="dash-row-title">@item.Label</span>
                                        <span class="dash-row-meta">@item.Note</span>
                                    </span>
                                    @if (item.Figure != null)
                                    {
                                        <span class="dash-row-figure">
                                            @item.Figure
                                            @if (item.Unit != null) { <small>@item.Unit</small> }
                                        </span>
                                    }
                                    <i class="fas fa-chevron-right dash-row-chevron" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @foreach (var item in Model.Upcoming)
                        {
                            <li>
                                <a class="dash-row @(item.IsLate ? "is-critical" : "")"
                                   asp-controller="@item.Controller"
                                   asp-action="@item.Action">
                                    <span class="dash-row-icon">
                                        <i class="fas @item.Icon" aria-hidden="true"></i>
                                    </span>
                                    <span class="dash-row-main">
                                        <span class="dash-row-title">@item.Title</span>
                                        <span class="dash-row-meta">@item.Detail</span>
                                    </span>
                                    <span class="dash-row-when @(item.IsLate ? "is-late" : "")">@item.When</span>
                                    <i class="fas fa-chevron-right dash-row-chevron" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="dash-empty is-clear">
                        <span class="dash-empty-icon"><i class="fas fa-check" aria-hidden="true"></i></span>
                        <span>
                            <strong>You're all caught up.</strong>
                            Nothing is waiting on you. Approvals, overdue training and
                            upcoming dates will appear here.
                        </span>
                    </div>
                }
            </section>

            @if (Model.Hr != null || Model.Md != null)
            {
                <section class="card dash-card">
                    <header class="dash-card-head">
                        <h2>@queueTitle</h2>
                        <a class="dash-link" asp-controller="@queueCtrl" asp-action="@queueAct">
                            Open queue <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </header>
                    @if (queue.Any())
                    {
                        <ul class="dash-list">
                            @foreach (var request in queue)
                            {
                                <li>
                                    <a class="dash-row"
                                       asp-controller="LeaveApproval"
                                       asp-action="Details"
                                       asp-route-id="@request.Id">
                                        <span class="dash-avatar">
                                            @request.Employee.FirstName.Substring(0, 1)@request.Employee.LastName.Substring(0, 1)
                                        </span>
                                        <span class="dash-row-main">
                                            <span class="dash-row-title">
                                                @request.Employee.FirstName @request.Employee.LastName
                                                <span class="dash-row-ref">@request.RequestNumber</span>
                                            </span>
                                            <span class="dash-row-meta">
                                                @request.LeaveType.Name &middot;
                                                @request.StartDate.ToString("d MMM") &ndash;
                                                @request.EndDate.ToString("d MMM") &middot;
                                                @request.NumberOfDays.ToString("0.##") days
                                            </span>
                                        </span>
                                        <partial name="_LeaveStatusBadge" model="request.Status" />
                                        <i class="fas fa-chevron-right dash-row-chevron" aria-hidden="true"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="dash-empty">
                            <span>Nothing is waiting in the queue.</span>
                        </div>
                    }
                </section>

                @if (startingSoon.Any())
                {
                    <section class="card dash-card">
                        <header class="dash-card-head">
                            <h2>Leave starting soon</h2>
                        </header>
                        <ul class="dash-list">
                            @foreach (var request in startingSoon)
                            {
                                <li>
                                    <a class="dash-row"
                                       asp-controller="LeaveRequest"
                                       asp-action="Details"
                                       asp-route-id="@request.Id">
                                        <span class="dash-avatar">
                                            @request.Employee.FirstName.Substring(0, 1)@request.Employee.LastName.Substring(0, 1)
                                        </span>
                                        <span class="dash-row-main">
                                            <span class="dash-row-title">
                                                @request.Employee.FirstName @request.Employee.LastName
                                            </span>
                                            <span class="dash-row-meta">
                                                @request.LeaveType.Name &middot;
                                                @request.NumberOfDays.ToString("0.##") days
                                            </span>
                                        </span>
                                        <span class="dash-row-when">@request.StartDate.ToString("d MMM")</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </section>
                }
            }

            @if (Model.Mine != null && Model.Admin == null && (Model.ShowsOwnLeave || Model.Mine.TrainingToDo.Any()))
            {
                <div class="dash-pair">
                    @if (Model.ShowsOwnLeave)
                    {
                        <section class="card dash-card">
                            <header class="dash-card-head">
                                <h2>My recent leave</h2>
                                <a class="dash-link" asp-controller="MyLeave" asp-action="Index">
                                    All requests <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </header>
                            @if (Model.Mine.RecentRequests.Any())
                            {
                                <ul class="dash-list">
                                    @foreach (var request in Model.Mine.RecentRequests)
                                    {
                                        <li>
                                            <a class="dash-row"
                                               asp-controller="MyLeave"
                                               asp-action="Details"
                                               asp-route-id="@request.Id">
                                                <span class="dash-row-main">
                                                    <span class="dash-row-title">@request.LeaveType.Name</span>
                                                    <span class="dash-row-meta">
                                                        @request.StartDate.ToString("d MMM") &ndash;
                                                        @request.EndDate.ToString("d MMM yyyy") &middot;
                                                        @request.NumberOfDays.ToString("0.##") days
                                                    </span>
                                                </span>
                                                <partial name="_LeaveStatusBadge" model="request.Status" />
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="dash-empty">
                                    <span>You have not requested any leave yet.</span>
                                </div>
                            }
                        </section>
                    }

                    <section class="card dash-card">
                        <header class="dash-card-head">
                            <h2>Training to complete</h2>
                            <a class="dash-link" asp-controller="MyTraining" asp-action="Index">
                                All training <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </header>
                        @if (Model.Mine.TrainingToDo.Any())
                        {
                            <ul class="dash-list">
                                @foreach (var assignment in Model.Mine.TrainingToDo)
                                {
                                    var late = assignment.DueDate.HasValue &&
                                               assignment.DueDate.Value.Date < DateTime.Today;
                                    <li>
                                        <a class="dash-row @(late ? "is-critical" : "")"
                                           asp-controller="MyTraining"
                                           asp-action="Details"
                                           asp-route-id="@assignment.Id">
                                            <span class="dash-row-icon">
                                                <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                                            </span>
                                            <span class="dash-row-main">
                                                <span class="dash-row-title">@assignment.TrainingCourse.Title</span>
                                                <span class="dash-row-meta">
                                                    @(assignment.DueDate.HasValue
                                                        ? "Due " + assignment.DueDate.Value.ToString("d MMM yyyy")
                                                        : "No due date")
                                                </span>
                                            </span>
                                            <span class="dash-row-when @(late ? "is-late" : "")">
                                                @(late ? "Overdue" : "Open")
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="dash-empty">
                                <span>No outstanding training.</span>
                            </div>
                        }
                    </section>
                </div>
            }
        </div>

        <aside class="dash-side">

            <section class="card dash-card">
                <header class="dash-card-head">
                    <h2>Quick actions</h2>
                </header>
                <div class="dash-actions">
                    @foreach (var action in actions)
                    {
                        <a class="dash-action"
                           asp-controller="@action.Ctrl"
                           asp-action="@action.Act">
                            <i class="fas @action.Icon" aria-hidden="true"></i>
                            <span>@action.Title</span>
                            <i class="fas fa-chevron-right dash-row-chevron" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </section>

            @if (Model.Admin != null)
            {
                <section class="card dash-card">
                    <header class="dash-card-head">
                        <h2>Recent activity</h2>
                        <a class="dash-link" asp-controller="AuditLog" asp-action="Index">
                            Audit log <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </header>
                    @if (Model.Admin.RecentActivity.Any())
                    {
                        <ul class="dash-list is-feed">
                            @foreach (var entry in Model.Admin.RecentActivity)
                            {
                                <li>
                                    <a class="dash-row"
                                       asp-controller="AuditLog"
                                       asp-action="Details"
                                       asp-route-id="@entry.Id">
                                        <span class="dash-row-icon is-small">
                                            <i class="fas @AuditIcon(entry.Action)" aria-hidden="true"></i>
                                        </span>
                                        <span class="dash-row-main">
                                            <span class="dash-row-title">
                                                @(string.IsNullOrWhiteSpace(entry.Description)
                                                    ? entry.Action + " · " + entry.EntityName
                                                    : entry.Description)
                                            </span>
                                            <span class="dash-row-meta">
                                                @(entry.Employee != null
                                                    ? entry.Employee.FirstName + " " + entry.Employee.LastName
                                                    : "System")
                                                &middot; @Ago(entry.Timestamp)
                                            </span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="dash-empty">
                            <span>No activity has been recorded yet.</span>
                        </div>
                    }
                </section>

                <section class="card dash-card">
                    <header class="dash-card-head">
                        <h2>Setup</h2>
                    </header>
                    <ul class="dash-facts">
                        <li><span>Departments</span><strong>@Model.Admin.Departments</strong></li>
                        <li><span>Sign-in accounts</span><strong>@Model.Admin.SignInAccounts</strong></li>
                        <li><span>Document categories</span><strong>@Model.Admin.DocumentCategories</strong></li>
                        <li><span>Ageing machines</span><strong>@Model.Admin.AssetsNeedingAttention</strong></li>
                        <li>
                            <span>Approvers</span>
                            <strong class="@(Model.Admin.HasHrOfficer && Model.Admin.HasMd ? "" : "text-danger")">
                                @((Model.Admin.HasHrOfficer ? 1 : 0) + (Model.Admin.HasMd ? 1 : 0)) / 2
                            </strong>
                        </li>
                    </ul>
                </section>
            }

            @if (Model.Admin != null && Model.Mine != null && Model.Mine.TrainingToDo.Any())
            {
                <section class="card dash-card">
                    <header class="dash-card-head">
                        <h2>My training</h2>
                        <a class="dash-link" asp-controller="MyTraining" asp-action="Index">
                            All <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </header>
                    <ul class="dash-list">
                        @foreach (var assignment in Model.Mine.TrainingToDo)
                        {
                            var late = assignment.DueDate.HasValue &&
                                       assignment.DueDate.Value.Date < DateTime.Today;
                            <li>
                                <a class="dash-row @(late ? "is-critical" : "")"
                                   asp-controller="MyTraining"
                                   asp-action="Details"
                                   asp-route-id="@assignment.Id">
                                    <span class="dash-row-main">
                                        <span class="dash-row-title">@assignment.TrainingCourse.Title</span>
                                        <span class="dash-row-meta">
                                            @(assignment.DueDate.HasValue
                                                ? "Due " + assignment.DueDate.Value.ToString("d MMM yyyy")
                                                : "No due date")
                                        </span>
                                    </span>
                                    <span class="dash-row-when @(late ? "is-late" : "")">
                                        @(late ? "Overdue" : "Open")
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        </aside>
    </div>

    @if (charts.Any())
    {
        <section class="dash-trends">
            <header class="dash-section-head">
                <h2>Last twelve months</h2>
            </header>
            <partial name="_ReportTrends" model="charts" />
        </section>
    }
</div>
