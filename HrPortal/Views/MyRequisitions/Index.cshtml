@using HrPortal.Entities
@using HrPortal.Services
@model IEnumerable<HrPortal.Entities.Requisition>

@{
    ViewData["Title"] = "My Requisitions";

    var currency = ViewBag.Currency as string ?? "USD";
    var threshold = (decimal)ViewBag.Threshold;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>My Requisitions</h2>
            <p class="text-muted mb-0">
                Things you have asked to be bought, and where each one
                has got to.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">New Requisition</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-stats">

        <div class="report-stat @(((int)ViewBag.WithMe) > 0 ? "is-warning" : "")">
            <span class="report-stat-label">With you</span>
            <span class="report-stat-value">@ViewBag.WithMe</span>
            <span class="report-stat-note">Drafts and returns</span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">Awaiting a decision</span>
            <span class="report-stat-value">@ViewBag.Awaiting</span>
            <span class="report-stat-note">In review or with the MD</span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">Approved to date</span>
            <span class="report-stat-value is-money">
                @currency @(((decimal)ViewBag.ApprovedTotal).ToString("N2"))
            </span>
            <span class="report-stat-note">Estimated value</span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">MD threshold</span>
            <span class="report-stat-value is-money">
                @currency @threshold.ToString("N2")
            </span>
            <span class="report-stat-note">At or above, the MD decides</span>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Number</th>
                            <th>What for</th>
                            <th class="num">Items</th>
                            <th class="num">Estimated</th>
                            <th>Needed by</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                You have not raised any requisitions yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td><strong>@r.RequisitionNumber</strong></td>

                                <td>
                                    @r.Title
                                    @if (r.Vendor != null)
                                    {
                                        <div class="text-muted small">
                                            Suggested: @r.Vendor.Name
                                        </div>
                                    }
                                </td>

                                <td class="num">@r.Lines.Count</td>

                                <td class="num">
                                    @r.EstimatedTotal.ToString("N2")
                                </td>

                                <td>
                                    @(r.NeededBy?.ToString("d MMM yyyy") ?? "--")
                                </td>

                                <td>
                                    <partial name="_RequisitionStatusBadge"
                                             model="r.Status" />
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Details" asp-route-id="@r.Id">
                                            View
                                        </a>

                                        @if (RequisitionWorkflowService
                                                .IsWithRequester(r.Status))
                                        {
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-action="Edit" asp-route-id="@r.Id">
                                                Edit
                                            </a>
                                        }

                                        @if (r.Status == RequisitionStatus.Draft)
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@r.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
