@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.Requisition

@{
    ViewData["Title"] = Model.RequisitionNumber;

    var currency = ViewBag.Currency as string ?? "USD";
    var threshold = (decimal)ViewBag.Threshold;

    var canEdit = RequisitionWorkflowService.IsWithRequester(Model.Status);
    var canWithdraw = !RequisitionWorkflowService.IsFinal(Model.Status);
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@Model.RequisitionNumber</h2>

            <div class="detail-badges">
                <partial name="_RequisitionStatusBadge" model="Model.Status" />

                @if (Model.RequiresMdApproval)
                {
                    <span class="badge bg-light text-dark">
                        Needs MD approval
                    </span>
                }
                else if (Model.SubmittedAt != null)
                {
                    <span class="badge bg-light text-dark">
                        Below the @currency @threshold.ToString("N2") threshold
                    </span>
                }
            </div>
        </div>

        <div class="page-head-actions">
            @if (canEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-primary">Edit</a>
            }

            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header">The request</div>
                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-clipboard-list"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">What for</span>
                                <p class="field-value">@Model.Title</p>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-comment-dots"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Justification</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Justification))
                                {
                                    <p class="field-value">@Model.Justification</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">
                                        None given
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-calendar-day"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Needed by</span>
                                <p class="field-value">
                                    @(Model.NeededBy?.ToString("d MMM yyyy")
                                        ?? "No date given")
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">Where it stands</div>
                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-coins"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Estimated total</span>
                                <p class="field-value">
                                    @currency @Model.EstimatedTotal.ToString("N2")
                                </p>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-truck-field"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Suggested vendor</span>
                                <p class="field-value">
                                    @(Model.Vendor?.Name ?? "None suggested")
                                </p>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-paper-plane"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Submitted</span>
                                <p class="field-value">
                                    @(Model.SubmittedAt?.ToLocalTime()
                                        .ToString("d MMM yyyy HH:mm")
                                        ?? "Not yet submitted")
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header">Items</div>
        <div class="card-body is-table">
            <partial name="_RequisitionLines" model="Model" />
        </div>
    </div>

    <div class="card shadow-sm mt-3">

        <div class="card-header">History</div>

        <div class="card-body @(Model.History.Any() ? "is-table" : "")">
            @if (Model.History.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>What happened</th>
                                <th>By</th>
                                <th>Comment</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var h in Model.History
                            .OrderByDescending(h => h.ActionDate))
                        {
                            <tr>
                                <td>
                                    @(h.ActionDate.ToLocalTime()
                                        .ToString("d MMM yyyy HH:mm"))
                                </td>
                                <td>@h.Action</td>
                                <td>
                                    @(h.ActionedByEmployee.FirstName + " " +
                                      h.ActionedByEmployee.LastName)
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(h.Comment)
                                        ? "--"
                                        : h.Comment)
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    Nothing has happened to this requisition yet.
                </p>
            }
        </div>

    </div>

    @if (canWithdraw)
    {
        <div class="card shadow-sm mt-3 mb-4">
            <div class="card-body">
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <label class="form-label">
                        Withdraw this requisition
                    </label>

                    <div class="row g-2">
                        <div class="col-md-9">
                            <input name="comment" class="form-control"
                                   placeholder="Why you are withdrawing it (optional)" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit"
                                    class="btn btn-outline-danger w-100">
                                Withdraw
                            </button>
                        </div>
                    </div>

                    <div class="form-text">
                        Whoever is holding it will be told it has gone away.
                    </div>
                </form>
            </div>
        </div>
    }

</div>
