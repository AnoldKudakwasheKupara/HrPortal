@model HrPortal.ViewModels.RequisitionEditViewModel

@{ ViewData["Title"] = "New Requisition"; }

<div class="container">

    <div class="page-head-simple">
        <h2>New Requisition</h2>
        <p class="text-muted">
            Say what you need and roughly what it costs. Save it as a
            draft to come back to, or submit it for review.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <partial name="_RequisitionFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" name="submit" value="true"
                            class="btn btn-primary">
                        Submit for Review
                    </button>
                    <button type="submit" class="btn btn-outline-primary">
                        Save as Draft
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
