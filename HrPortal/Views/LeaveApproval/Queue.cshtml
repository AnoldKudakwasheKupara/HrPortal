@model IEnumerable<HrPortal.Entities.LeaveRequest>

@{
    var stage = ViewBag.Stage as string ?? "HR";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2>@ViewData["Title"]</h2>

        <p class="text-muted">
            @if (stage == "HR")
            {
                <text>
                    Requests submitted by employees, waiting for your
                    review. Approving sends the request to the
                    Managing Director.
                </text>
            }
            else
            {
                <text>
                    Requests that have cleared HR review and need your
                    final decision.
                </text>
            }
        </p>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var request in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @request.RequestNumber
                                </strong>
                            </td>

                            <td>
                                @request.Employee.FirstName
                                @request.Employee.LastName
                            </td>

                            <td>
                                @request.LeaveType.Name
                            </td>

                            <td>
                                @request.StartDate.ToString("dd MMM yyyy")
                                &ndash;
                                @request.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @request.NumberOfDays.ToString("0.##")
                            </td>

                            <td>
                                @request.SubmittedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <a class="btn btn-sm btn-primary"
                                   asp-action="Details"
                                   asp-route-id="@request.Id">

                                    Review

                                </a>
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

                @if (!Model.Any())
                {
                    <p class="text-muted mb-0">
                        There is nothing waiting for you right now.
                    </p>
                }

            </div>

        </div>

    </div>

</div>
