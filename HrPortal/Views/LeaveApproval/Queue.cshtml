@using HrPortal.ViewModels
@model IEnumerable<HrPortal.Entities.LeaveRequest>

@{
    var stage = ViewBag.Stage as string ?? "HR";
    var all = Model.ToList();
    var paged = PagedList.Of(all, PagedList.PageFrom(Context.Request));
    var today = DateTime.Today;

    var stats = new QueueStats(
        all.Count,
        "Days Requested",
        all.Sum(r => r.NumberOfDays).ToString("0.##"),
        all.Any() ? all.Min(r => r.SubmittedAt) : null,
        "Starting This Week",
        all.Count(r => r.StartDate.Date >= today && r.StartDate.Date <= today.AddDays(7)).ToString(),
        "fa-plane-departure");

    string Span(DateTime start, DateTime end) =>
        start.Date == end.Date ? start.ToString("d MMM yyyy")
        : start.Year == end.Year && start.Month == end.Month ? $"{start.Day}–{end:d MMM yyyy}"
        : start.Year == end.Year ? $"{start:d MMM} – {end:d MMM yyyy}"
        : $"{start:d MMM yyyy} – {end:d MMM yyyy}";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@ViewData["Title"]</h2>
            <p>
                @if (stage == "HR")
                {
                    <text>Requests submitted by employees, waiting for your review. Approving sends the request to the Managing Director.</text>
                }
                else if (stage == "Supervisor")
                {
                    <text>Requests from the people who report to you. Approving sends the request on to HR.</text>
                }
                else
                {
                    <text>Requests that have cleared HR review and need your final decision.</text>
                }
            </p>
        </div>

        <a asp-action="List" asp-route-stage="@ViewBag.Queue" class="btn btn-outline-secondary">
            <i class="fas fa-download" aria-hidden="true"></i> Download
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <partial name="_QueueStats" model="stats" />

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-inbox" aria-hidden="true"></i> Waiting for You
            <span class="tab-count">@all.Count</span>
        </h3>

        @if (!all.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-mug-hot" aria-hidden="true"></i>
                <p>There is nothing waiting for you right now.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th>Submitted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in paged.Items)
                        {
                            <tr>
                                <td class="text-nowrap fw-semibold">@request.RequestNumber</td>
                                <td>
                                    <div class="fw-semibold">@request.Employee.FirstName @request.Employee.LastName</div>
                                    <div class="small text-muted">@(request.Employee.Department?.Name ?? "")</div>
                                </td>
                                <td>@request.LeaveType.Name</td>
                                <td class="text-nowrap">@Span(request.StartDate, request.EndDate)</td>
                                <td>@request.NumberOfDays.ToString("0.##")</td>
                                <td class="text-nowrap">@request.SubmittedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-gold text-nowrap" asp-action="Details" asp-route-id="@request.Id">
                                            <i class="fas fa-gavel" aria-hidden="true"></i> Review
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "request", "requests")' />
        }

    </section>

</div>
