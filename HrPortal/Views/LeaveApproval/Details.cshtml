@model HrPortal.ViewModels.LeaveApprovalViewModel

@{
    ViewData["Title"] = "Review Leave Request";

    var request = Model.Request;
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@request.RequestNumber</h2>

            <p class="text-muted">
                Review Leave Request
            </p>
        </div>

        <partial name="_DownloadPdf" model="@Model.Request.Id" />

        <a asp-action="@(Model.CanActAsMd ? "FinalApproval" : "Index")"
           class="btn btn-secondary">

            Back to Queue

        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <div class="field-value">
                        @request.Employee.FirstName
                        @request.Employee.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <div class="field-value">
                        @request.Employee.Department.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Leave Type</span>

                    <div class="field-value">
                        @request.LeaveType.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Dates</span>

                    <div class="field-value">
                        @request.StartDate.ToString("dd MMM yyyy")
                        &ndash;
                        @request.EndDate.ToString("dd MMM yyyy")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Working Days</span>

                    <div class="field-value">
                        @request.NumberOfDays.ToString("0.##")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Status</span>

                    <div class="field-value">
                        <span class="badge bg-warning text-dark">
                            @request.Status
                        </span>
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Reason</span>

                    <div class="field-value">
                        @(request.Reason ?? "No reason given.")
                    </div>

                </div>

            </div>

        </div>

    </div>

    @if (Model.Balance != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">@Model.Balance.LeaveType.Name balance for @Model.Balance.Year</div>

            <div class="card-body">

                <div class="row text-center">

                    <div class="col">
                        <span class="field-label">Allocated</span>
                        <div class="field-value">@Model.Balance.AllocatedDays.ToString("0.##")</div>
                    </div>

                    <div class="col">
                        <span class="field-label">Used</span>
                        <div class="field-value">@Model.Balance.UsedDays.ToString("0.##")</div>
                    </div>

                    <div class="col">
                        <span class="field-label">Pending</span>
                        <div class="field-value">@Model.Balance.PendingDays.ToString("0.##")</div>
                    </div>

                    <div class="col">
                        <span class="field-label">Remaining</span>
                        <div class="field-value">
                            @if (Model.Balance.RemainingDays < 0)
                            {
                                <span class="badge bg-danger">
                                    @Model.Balance.RemainingDays.ToString("0.##")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    @Model.Balance.RemainingDays.ToString("0.##")
                                </span>
                            }
                        </div>
                    </div>

                </div>

            </div>

        </div>
    }

    @if (Model.CanActAsHr || Model.CanActAsMd || Model.CanActAsSupervisor)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                @(Model.CanActAsSupervisor
                    ? "Supervisor Approval"
                    : Model.CanActAsMd
                        ? "Final Decision"
                        : "HR Decision")
            </div>

            <div class="card-body">

                <form method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@request.Id" />

                    <div class="mb-3">

                        <label for="comment"
                               class="form-label">
                            Comment
                        </label>

                        <textarea id="comment"
                                  name="comment"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Required when rejecting or returning"></textarea>

                    </div>

                    @if (Model.CanActAsSupervisor)
                    {
                        <button type="submit"
                                class="btn btn-success"
                                asp-action="SupervisorApprove">
                            Approve and send to HR
                        </button>

                        <button type="submit"
                                class="btn btn-warning"
                                asp-action="SupervisorReturn">
                            Return to employee
                        </button>

                        <button type="submit"
                                class="btn btn-danger"
                                asp-action="SupervisorReject">
                            Decline
                        </button>
                    }

                    @if (Model.CanActAsHr)
                    {
                        <button type="submit"
                                class="btn btn-success"
                                asp-action="HrApprove">
                            Approve and send to MD
                        </button>

                        <button type="submit"
                                class="btn btn-warning"
                                asp-action="HrReturn">
                            Return to employee
                        </button>

                        <button type="submit"
                                class="btn btn-danger"
                                asp-action="HrReject">
                            Reject
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-success"
                                asp-action="MdApprove">
                            Approve
                        </button>

                        <button type="submit"
                                class="btn btn-danger"
                                asp-action="MdReject">
                            Reject
                        </button>
                    }

                </form>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-secondary">

            This request is not waiting on you. It is currently
            <strong>@request.Status</strong>.

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header">History</div>

        <div class="card-body @(request.History.Any() ? "is-table" : "")">

            @if (request.History.Any())
            {
                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>By</th>
                                <th>Date</th>
                                <th>Status Change</th>
                                <th>Comment</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var entry in request.History
                            .OrderBy(h => h.ActionDate))
                        {
                            <tr>

                                <td>
                                    <strong>@entry.Action</strong>
                                </td>

                                <td>
                                    @entry.ActionedByEmployee.FirstName
                                    @entry.ActionedByEmployee.LastName
                                </td>

                                <td>
                                    @entry.ActionDate.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @entry.PreviousStatus
                                    </span>
                                    &rarr;
                                    @entry.NewStatus
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                    {
                                        @entry.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No comment
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    No history has been recorded for this request.
                </p>
            }

        </div>

    </div>

</div>
