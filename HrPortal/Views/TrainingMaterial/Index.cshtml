@model IEnumerable<HrPortal.Entities.TrainingMaterial>

@{
    ViewData["Title"] = "Training Materials";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>
                @(ViewBag.IsTrainer == true
                    ? "Training I Lead"
                    : "Training Materials")
            </h2>

            <p class="text-muted">
                @(ViewBag.IsTrainer == true
                    ? "The courses you are delivering, and the content you have posted for them."
                    : "Documents and handouts attached to training courses.")
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Upload Material
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.MyCourses is List<HrPortal.Entities.TrainingCourse> leading
         && leading.Any())
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                Courses you are delivering
            </div>

            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Training date</th>
                                <th>Content due</th>
                                <th>Content posted</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        @foreach (var course in leading)
                        {
                            <tr>
                                <td>@course.Title</td>

                                <td>
                                    @(course.TrainingDate?.ToString("dd MMM yyyy")
                                        ?? "Not scheduled")
                                </td>

                                <td>
                                    @if (course.MaterialsDueDate == null)
                                    {
                                        <span class="text-muted">No date set</span>
                                    }
                                    else if (course.MaterialsOverdue)
                                    {
                                        <span class="badge bg-danger">
                                            Was due @course.MaterialsDueDate.Value.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        @course.MaterialsDueDate.Value.ToString("dd MMM yyyy")
                                    }
                                </td>

                                <td>
                                    @if (course.Materials.Count == 0)
                                    {
                                        <span class="text-muted">Nothing yet</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            @course.Materials.Count file(s)
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a class="btn btn-sm btn-primary"
                                       asp-action="Create"
                                       asp-route-courseId="@course.Id">
                                        Post content
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-4">

                    <label for="courseId"
                           class="form-label">
                        Training Course
                    </label>

                    <select id="courseId"
                            name="courseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">

                        <option value="">
                            -- All Courses --
                        </option>

                    </select>

                </div>

                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-outline-secondary">
                        Filter
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Course</th>
                            <th>Description</th>
                            <th>Uploaded By</th>
                            <th>Uploaded</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                No training materials match this filter.
                            </td>
                        </tr>
                    }

                    @foreach (var material in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @material.OriginalFileName
                                </strong>
                            </td>

                            <td>
                                @material.TrainingCourse.Title
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    material.Description))
                                {
                                    @material.Description
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No description
                                    </span>
                                }
                            </td>

                            <td>
                                @material.UploadedByEmployee.FirstName
                                @material.UploadedByEmployee.LastName
                            </td>

                            <td>
                                @material.UploadedAt.ToString("dd MMM yyyy")
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@material.Id">

                                        View

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Download"
                                       asp-route-id="@material.Id">

                                        Download

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@material.Id">

                                        Edit

                                    </a>

                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Delete"
                                       asp-route-id="@material.Id">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
