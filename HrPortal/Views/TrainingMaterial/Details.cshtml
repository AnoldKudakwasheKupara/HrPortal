@model HrPortal.Entities.TrainingMaterial

@{
    ViewData["Title"] = "Training Material Details";
    var canPreview = HrPortal.Services.FileStorageService.CanPreview(Model.OriginalFileName);
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2 class="text-break">@Model.OriginalFileName</h2>
            <p>Material for @Model.TrainingCourse.Title</p>
        </div>

        <div class="head-actions">
            <partial name="_DownloadPdf" model="@Model.Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-file-lines" aria-hidden="true"></i> Material Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-file" aria-hidden="true"></i>
                        <div><span>File name</span><strong class="text-break">@Model.OriginalFileName</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-chalkboard-user" aria-hidden="true"></i>
                        <div><span>Course</span><strong>@Model.TrainingCourse.Title</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div><span>Uploaded by</span><strong>@Model.UploadedByEmployee.FirstName @Model.UploadedByEmployee.LastName</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                        <div><span>Uploaded</span><strong>@Model.UploadedAt.ToString("d MMM yyyy HH:mm")</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-align-left" aria-hidden="true"></i> Description</h4>
                    <p class="pre-line">@(Model.Description ?? "No description provided.")</p>
                </div>

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">

                    <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-download" aria-hidden="true"></i> Download
                    </a>

                    @if (canPreview)
                    {
                        <a asp-action="Preview" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary">
                            <i class="fas fa-eye" aria-hidden="true"></i> Preview
                        </a>
                    }

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-success">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                    </a>

                </div>

            </section>

        </div>

    </div>

</div>
