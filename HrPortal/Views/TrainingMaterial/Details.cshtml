@model HrPortal.Entities.TrainingMaterial

@{
    ViewData["Title"] = "Training Material Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.OriginalFileName</h2>

            <p class="text-muted">
                Training Material Details
            </p>
        </div>

        <div>

            <a asp-action="Download"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">

                Download

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <partial name="_DownloadPdf" model="@Model.Id" />

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <span class="field-label">File Name</span>

                    <div class="field-value">
                        @Model.OriginalFileName
                    </div>

                </div>

                <div class="col-md-6">

                    <span class="field-label">Course</span>

                    <div class="field-value">
                        @Model.TrainingCourse.Title
                    </div>

                </div>

                <div class="col-md-6">

                    <span class="field-label">Uploaded By</span>

                    <div class="field-value">
                        @Model.UploadedByEmployee.FirstName
                        @Model.UploadedByEmployee.LastName
                    </div>

                </div>

                <div class="col-md-6">

                    <span class="field-label">Uploaded</span>

                    <div class="field-value">
                        @Model.UploadedAt.ToString("dd MMM yyyy HH:mm")
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Description</span>

                    <div class="field-value">
                        @(Model.Description ?? "No description provided.")
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
