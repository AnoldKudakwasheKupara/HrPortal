@{ ViewData["Title"] = "Import Complaints"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Import Complaints</h2>
        <p class="text-muted">
            Load a complaints register kept in a spreadsheet, so it does not
            have to be typed in again.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <ol class="mb-4">
                <li>
                    In Google Sheets, open the register and choose
                    <strong>File → Download → Microsoft Excel (.xlsx)</strong>.
                    From Excel, just save it.
                </li>
                <li>Choose that file below and import it.</li>
            </ol>

            <p class="small text-muted">
                The columns are found by their headings: Date Received, Client
                Name, Phone Number, Email Address, Nature of the Complaint,
                Staff Member Involved, Action Taken, Resolution Date, Status and
                Remarks. Only Client Name is needed. Dates can be written as
                3 February 2025, 5/11/2026 or 6-10-2026, day first. Complaints
                already in the register are left alone, so the same sheet can
                be imported again after rows are added to it.
            </p>

            <form asp-action="Import" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="file" class="form-label">Register (.xlsx or .csv)</label>
                    <input id="file" name="file" type="file" class="form-control"
                           accept=".xlsx,.csv" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-file-arrow-up" aria-hidden="true"></i> Import
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>
