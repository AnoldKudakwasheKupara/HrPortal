@model HrPortal.ViewModels.ComplaintFormViewModel

@{ ViewData["Title"] = "Record a Complaint"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Record a Complaint</h2>
        <p class="text-muted">
            A complaint from a client, as soon as it comes in. Add what was
            done as it happens, and mark it resolved when it is.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_ComplaintFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
