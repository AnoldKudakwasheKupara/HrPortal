@model HrPortal.ViewModels.ComplaintFormViewModel

@{ ViewData["Title"] = "Update Complaint"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Update Complaint</h2>
        <p class="text-muted">
            From @Model.ClientName.
            @if (Model.RecordedAt != null)
            {
                <text>Recorded @Model.RecordedAt.Value.ToLocalTime().ToString("d MMM yyyy")@(string.IsNullOrWhiteSpace(Model.RecordedBy) ? "" : $" by {Model.RecordedBy}").</text>
            }
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_ComplaintFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
