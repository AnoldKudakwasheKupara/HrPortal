@model HrPortal.Entities.Asset

@{
    ViewData["Title"] = "Delete Asset";
}

<div class="container">

    <div class="page-head-simple">
        <h2>Delete Asset</h2>
        <p class="text-muted">
            This asset will be removed from the register permanently.
        </p>
    </div>

    <div class="alert alert-warning">
        Are you sure you want to delete this asset? This cannot be
        undone.
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <span class="field-label">Device / Model</span>
                    <p class="field-value">@Model.DeviceModel</p>
                </div>

                <div class="col-md-4">
                    <span class="field-label">Serial Number</span>
                    <p class="field-value">
                        @(string.IsNullOrWhiteSpace(Model.SerialNumber)
                            ? "Not recorded" : Model.SerialNumber)
                    </p>
                </div>

                <div class="col-md-4">
                    <span class="field-label">Assigned To</span>
                    <p class="field-value">
                        @if (Model.AssignedToEmployee != null)
                        {
                            @Model.AssignedToEmployee.FirstName
                            @Model.AssignedToEmployee.LastName
                        }
                        else
                        {
                            <span class="text-muted">Unassigned</span>
                        }
                    </p>
                </div>

            </div>

        </div>

    </div>

    <div class="mt-3 d-flex gap-2">

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">
                Delete Asset
            </button>

        </form>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>

    </div>

</div>
