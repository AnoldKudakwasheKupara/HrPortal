@model HrPortal.Entities.Asset

@{
    ViewData["Title"] = "Asset Details";

    var holder = Model.AssignedToEmployee;

    var holderName = holder != null
        ? $"{holder.FirstName} {holder.LastName}"
        : null;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.DeviceModel</h2>

            <div class="detail-badges">
                <partial name="_AssetConditionBadge"
                         model="Model.Condition" />

                @if (Model.IsInUse)
                {
                    <span class="badge bg-info">In use</span>
                }
                else
                {
                    <span class="badge bg-secondary">Not in use</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Company))
                {
                    <span class="badge bg-light text-dark">
                        @Model.Company
                    </span>
                }
            </div>
        </div>

        <div class="page-head-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary">Edit</a>

            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>

    </div>


    <div class="row g-3">

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header">Device</div>

                <div class="card-body">

                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-laptop"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Device / model</span>
                                <p class="field-value">@Model.DeviceModel</p>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-microchip"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Processor</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Processor))
                                {
                                    <p class="field-value">@Model.Processor</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">
                                        Not recorded
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-barcode"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Serial number</span>
                                @if (!string.IsNullOrWhiteSpace(Model.SerialNumber))
                                {
                                    <p class="field-value">@Model.SerialNumber</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">
                                        Not recorded
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-calendar-day"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Procured</span>
                                @if (Model.ProcuredOn.HasValue)
                                {
                                    <p class="field-value">
                                        @Model.ProcuredOn.Value.ToString("dd MMM yyyy")
                                    </p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">
                                        Not recorded
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-building"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Company</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Company))
                                {
                                    <p class="field-value">@Model.Company</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">
                                        Not recorded
                                    </p>
                                }
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">Assignment</div>

                <div class="card-body">

                    <div class="assignment-holder">

                        @if (holderName != null)
                        {
                            <span class="assignment-avatar">
                                @holderName.Trim()[0].ToString().ToUpper()
                            </span>

                            <div>
                                <div class="assignment-name">
                                    @holderName
                                </div>
                                <div class="assignment-sub">
                                    @(holder!.Department?.Name
                                        ?? "No department")
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="assignment-avatar is-empty">
                                <i class="fas fa-user-slash"></i>
                            </span>

                            <div>
                                <div class="assignment-name">
                                    Unassigned
                                </div>
                                <div class="assignment-sub">
                                    Not issued to anyone
                                </div>
                            </div>
                        }

                    </div>

                    <div class="detail-rows mt-2">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-calendar-check"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Assigned on</span>
                                @if (Model.AssignedOn.HasValue)
                                {
                                    <p class="field-value">
                                        @Model.AssignedOn.Value.ToLocalTime()
                                            .ToString("dd MMM yyyy")
                                    </p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">--</p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-circle-check"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Status</span>
                                <p class="field-value">
                                    @(Model.IsInUse ? "In use" : "Not in use")
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    @{
        var maintenance =
            ViewBag.Maintenance as List<HrPortal.Entities.AssetMaintenance>
            ?? new List<HrPortal.Entities.AssetMaintenance>();
    }

    <div class="card shadow-sm mt-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>Maintenance</span>

            <a class="btn btn-sm btn-outline-secondary"
               asp-controller="AssetMaintenance"
               asp-action="Create"
               asp-route-assetId="@Model.Id">
                Schedule maintenance
            </a>

        </div>

        <div class="card-body is-table">

            @if (maintenance.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Work</th>
                                <th>Scheduled</th>
                                <th>Done by</th>
                                <th class="num">Cost</th>
                                <th>Status</th>
                                <th>Work done / notes</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var m in maintenance)
                        {
                            <tr>
                                <td>@m.Type</td>
                                <td>
                                    @m.ScheduledFor.ToString("d MMM yyyy")
                                    @if (m.CompletedOn.HasValue)
                                    {
                                        <div class="text-muted small">
                                            Done @m.CompletedOn.Value.ToString("d MMM yyyy")
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (m.Vendor != null)
                                    {
                                        @m.Vendor.Name
                                    }
                                    else if (!string.IsNullOrWhiteSpace(m.PerformedBy))
                                    {
                                        @m.PerformedBy
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td class="num">@(m.Cost?.ToString("0.00") ?? "--")</td>
                                <td>
                                    <partial name="_MaintenanceStatusBadge" model="m" />
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(m.Notes)
                                        ? "--" : m.Notes)
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="field-value is-empty mb-0 p-3">
                    No maintenance has been scheduled for this machine.
                </p>
            }

        </div>

    </div>


    <div class="card shadow-sm mt-3">

        <div class="card-header">Notes / issues</div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <p class="field-value mb-0">@Model.Notes</p>
            }
            else
            {
                <p class="field-value is-empty mb-0">
                    Nothing recorded against this machine.
                </p>
            }

        </div>

    </div>

</div>
