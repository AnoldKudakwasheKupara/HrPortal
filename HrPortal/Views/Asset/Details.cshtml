@model HrPortal.Entities.Asset

@{
    ViewData["Title"] = "Asset Details";

    var holder = Model.AssignedToEmployee;
    var holderName = holder != null ? $"{holder.FirstName} {holder.LastName}" : null;

    var maintenance = ViewBag.Maintenance as List<HrPortal.Entities.AssetMaintenance>
        ?? new List<HrPortal.Entities.AssetMaintenance>();
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.DeviceModel</h2>
            <p>@(holderName ?? "Unassigned")@(string.IsNullOrWhiteSpace(Model.Company) ? "" : ", " + Model.Company)</p>
        </div>

        <div class="head-actions">

            <partial name="_AssetConditionBadge" model="Model.Condition" />

            @if (Model.IsInUse)
            {
                <span class="status-badge badge-blue">In use</span>
            }
            else
            {
                <span class="status-badge badge-gray">Not in use</span>
            }

            <partial name="_DownloadPdf" model="Model.Id" />

            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-laptop" aria-hidden="true"></i> Device
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-laptop" aria-hidden="true"></i>
                        <div><span>Device / model</span><strong>@Model.DeviceModel</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-microchip" aria-hidden="true"></i>
                        <div>
                            <span>Processor</span>
                            @if (string.IsNullOrWhiteSpace(Model.Processor))
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.Processor</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-barcode" aria-hidden="true"></i>
                        <div>
                            <span>Serial number</span>
                            @if (string.IsNullOrWhiteSpace(Model.SerialNumber))
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong class="text-break">@Model.SerialNumber</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-day" aria-hidden="true"></i>
                        <div>
                            <span>Procured</span>
                            @if (Model.ProcuredOn == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.ProcuredOn.Value.ToString("d MMM yyyy")</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-building" aria-hidden="true"></i>
                        <div>
                            <span>Company</span>
                            @if (string.IsNullOrWhiteSpace(Model.Company))
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.Company</strong>
                            }
                        </div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-note-sticky" aria-hidden="true"></i> Notes / Issues</h4>
                    <p class="pre-line">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Nothing recorded against this machine." : Model.Notes)</p>
                </div>

            </section>

            <section class="panel-card mb-3">

                <div class="panel-head-split">
                    <h3 class="panel-head">
                        <i class="fas fa-screwdriver-wrench" aria-hidden="true"></i> Maintenance
                        <span class="tab-count">@maintenance.Count</span>
                    </h3>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="AssetMaintenance" asp-action="Create" asp-route-assetId="@Model.Id">
                        <i class="fas fa-plus" aria-hidden="true"></i> Schedule maintenance
                    </a>
                </div>

                @if (!maintenance.Any())
                {
                    <div class="list-empty mb-0">
                        <i class="fas fa-screwdriver-wrench" aria-hidden="true"></i>
                        <p>No maintenance has been scheduled for this machine.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Work</th>
                                    <th>Scheduled</th>
                                    <th>Done By</th>
                                    <th class="num">Cost</th>
                                    <th>Status</th>
                                    <th>Work Done / Notes</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var m in maintenance)
                                {
                                    <tr>
                                        <td>@m.Type</td>
                                        <td class="text-nowrap">
                                            @m.ScheduledFor.ToString("d MMM yyyy")
                                            @if (m.CompletedOn.HasValue)
                                            {
                                                <div class="small text-muted">Done @m.CompletedOn.Value.ToString("d MMM yyyy")</div>
                                            }
                                        </td>
                                        <td>
                                            @if (m.Vendor != null)
                                            {
                                                @m.Vendor.Name
                                            }
                                            else if (!string.IsNullOrWhiteSpace(m.PerformedBy))
                                            {
                                                @m.PerformedBy
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="num">@(m.Cost?.ToString("0.00") ?? "-")</td>
                                        <td><partial name="_MaintenanceStatusBadge" model="m" /></td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(m.Notes) ? "-" : m.Notes)</td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3 profile-card">

                @if (holderName != null)
                {
                    <div class="profile-avatar" aria-hidden="true">@holderName.Trim()[0].ToString().ToUpper()</div>
                    <div class="profile-name">@holderName</div>
                    <div class="profile-role">@(holder!.Department?.Name ?? "No department")</div>
                }
                else
                {
                    <div class="profile-avatar" aria-hidden="true"><i class="fas fa-user-slash"></i></div>
                    <div class="profile-name">Unassigned</div>
                    <div class="profile-role">Not issued to anyone</div>
                }

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit asset
                    </a>
                    <a class="btn btn-outline-secondary" asp-controller="AssetMaintenance" asp-action="Create" asp-route-assetId="@Model.Id">
                        <i class="fas fa-screwdriver-wrench" aria-hidden="true"></i> Schedule maintenance
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fas fa-trash" aria-hidden="true"></i> Delete asset
                    </a>
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Assignment
                </h3>

                <dl class="info-list">
                    <dt>Held by</dt>
                    <dd>@(holderName ?? "Unassigned")</dd>
                    <dt>Assigned on</dt>
                    <dd>@(Model.AssignedOn?.ToLocalTime().ToString("d MMM yyyy") ?? "-")</dd>
                    <dt>Status</dt>
                    <dd>@(Model.IsInUse ? "In use" : "Not in use")</dd>
                    <dt>Condition</dt>
                    <dd>@Model.Condition</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
