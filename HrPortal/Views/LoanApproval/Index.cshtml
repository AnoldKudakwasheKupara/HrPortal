@model List<HrPortal.Entities.LoanApplication>

@{
    var settled = ViewBag.Settled as bool? ?? false;

    ViewData["Title"] = settled
        ? "Loans Already Decided"
        : "Loans to Sanction";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@(settled ? "Loans already decided" : "Loans to sanction")</h2>

            <p class="text-muted mb-0">
                @(settled
                    ? "Applications that have been sanctioned, declined, returned or cancelled."
                    : "Applications waiting on your decision.")
            </p>
        </div>

        <a class="btn btn-outline-secondary"
           asp-action="Index"
           asp-route-settled="@(!settled)">
            @(settled ? "Waiting on me" : "Already decided")
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Applicant</th>
                            <th class="num">Requested</th>
                            <th>Repayment</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                @(settled
                                    ? "Nothing has been decided yet."
                                    : "Nothing is waiting for you right now.")
                            </td>
                        </tr>
                    }

                    @foreach (var application in Model)
                    {
                        <tr>

                            <td>
                                <strong>@application.ApplicationNumber</strong>
                            </td>

                            <td>
                                @application.Employee.FirstName
                                @application.Employee.LastName
                                <div class="row-meta">
                                    @(application.Employee.Department?.Name ?? "--")
                                </div>
                            </td>

                            <td class="num">
                                @application.AmountRequested.ToString("N2")
                            </td>

                            <td>
                                @application.RepaymentMonths months
                                @if (application.MonthlyInstalment != null)
                                {
                                    <div class="row-meta">
                                        @(application.MonthlyInstalment.Value.ToString("N2")) a month
                                    </div>
                                }
                            </td>

                            <td>
                                <partial name="_LoanStatusBadge"
                                         model="application.Status" />
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-primary"
                                       asp-action="Details"
                                       asp-route-id="@application.Id">
                                        @(settled ? "View" : "Decide")
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
