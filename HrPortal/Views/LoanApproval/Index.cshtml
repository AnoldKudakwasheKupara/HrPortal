@using HrPortal.Entities
@using HrPortal.Services
@using HrPortal.ViewModels
@model List<HrPortal.Entities.LoanApplication>

@{
    var settled = ViewBag.Settled as bool? ?? false;
    var queue = ViewBag.Queue?.ToString() ?? "Md";
    var isSupervisor = queue == "Supervisor";

    ViewData["Title"] = isSupervisor
        ? "Loans Awaiting Your Approval"
        : settled ? "Loans Already Decided" : "Loans to Sanction";

    var paged = PagedList.Of(Model, PagedList.PageFrom(Context.Request));

    var byCurrency = Model
        .GroupBy(l => l.Currency)
        .Select(g => LoanCurrencies.Format(g.Key, g.Sum(l => l.AmountRequested)))
        .ToList();

    var stats = new QueueStats(
        Model.Count,
        settled ? "Amount Decided" : "Amount Requested",
        byCurrency.Any() ? string.Join(" + ", byCurrency) : "0",
        settled || !Model.Any() ? null : Model.Min(l => l.SubmittedAt ?? l.CreatedAt),
        settled ? "Sanctioned" : "Average Months",
        settled
            ? Model.Count(l => l.Status == LoanApplicationStatus.Approved).ToString()
            : Model.Any() ? Model.Average(l => l.RepaymentMonths).ToString("0.#") : "0",
        settled ? "fa-circle-check" : "fa-calendar-days");
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@ViewData["Title"]</h2>
            <p>
                @(isSupervisor
                    ? "Applications from the people who report to you. Approving sends the application on to the Managing Director."
                    : settled
                        ? "Applications that have been sanctioned, declined, returned or cancelled."
                        : "Applications waiting on your decision.")
            </p>
        </div>

        <div class="head-actions">

            <a class="btn btn-outline-secondary" asp-action="List" asp-route-stage="@queue" asp-route-settled="@settled">
                <i class="fas fa-download" aria-hidden="true"></i> Download
            </a>

            @if (!isSupervisor)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-settled="@(!settled)">
                    <i class="fas @(settled ? "fa-inbox" : "fa-box-archive")" aria-hidden="true"></i>
                    @(settled ? "Waiting on me" : "Already decided")
                </a>
            }

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <partial name="_QueueStats" model="stats" />

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas @(settled ? "fa-box-archive" : "fa-inbox")" aria-hidden="true"></i>
            @(settled ? "Decided" : "Waiting for You")
            <span class="tab-count">@Model.Count</span>
        </h3>

        @if (!Model.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-mug-hot" aria-hidden="true"></i>
                <p>@(settled ? "Nothing has been decided yet." : "Nothing is waiting for you right now.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Applicant</th>
                            <th class="num">Requested</th>
                            <th>Repayment</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var application in paged.Items)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <div class="fw-semibold">@application.ApplicationNumber</div>
                                    <div class="small text-muted">@((application.SubmittedAt ?? application.CreatedAt).ToLocalTime().ToString("d MMM yyyy"))</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@application.Employee.FirstName @application.Employee.LastName</div>
                                    <div class="small text-muted">@(application.Employee.Department?.Name ?? "")</div>
                                </td>
                                <td class="num text-nowrap">@LoanCurrencies.Format(application.Currency, application.AmountRequested)</td>
                                <td>
                                    <div class="text-nowrap">@application.RepaymentMonths months</div>
                                    @if (application.MonthlyInstalment != null)
                                    {
                                        <div class="small text-muted text-nowrap">@LoanCurrencies.Format(application.Currency, application.MonthlyInstalment.Value) a month</div>
                                    }
                                </td>
                                <td><partial name="_LoanStatusBadge" model="application.Status" /></td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        @if (settled)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@application.Id">
                                                <i class="fas fa-eye" aria-hidden="true"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-gold text-nowrap" asp-action="Details" asp-route-id="@application.Id">
                                                <i class="fas fa-gavel" aria-hidden="true"></i> Decide
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "application", "applications")' />
        }

    </section>

</div>
