@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.LoanApplication

@{
    ViewData["Title"] = "Loan Application";

    var decision = ViewBag.Decision
        as HrPortal.ViewModels.LoanDecisionViewModel
        ?? new HrPortal.ViewModels.LoanDecisionViewModel();

    var awaiting = LoanWorkflowService.IsAwaitingMd(Model.Status);
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.ApplicationNumber</h2>

            <p class="text-muted mb-0">
                @Model.Employee.FirstName @Model.Employee.LastName
                &middot;
                @(Model.Employee.Department?.Name ?? "--")
            </p>
        </div>

        <div class="table-actions">

            <a class="btn btn-outline-secondary"
               asp-action="Form"
               asp-route-id="@Model.Id">
                <i class="fas fa-download" aria-hidden="true"></i>
                Application form (PDF)
            </a>

            <a class="btn btn-secondary" asp-action="Index">
                Back
            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>The application</span>

            <partial name="_LoanStatusBadge" model="Model.Status" />

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Amount required</span>
                    <div class="field-value">
                        @LoanCurrencies.Format(Model.Currency, Model.AmountRequested)
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Amount authorised</span>
                    <div class="field-value @(Model.AmountAuthorised == null ? "is-empty" : "")">
                        @(Model.AmountAuthorised == null
                            ? "Not yet decided"
                            : LoanCurrencies.Format(Model.Currency, Model.AmountAuthorised.Value))
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Repayment period</span>
                    <div class="field-value">
                        @Model.RepaymentMonths months
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Instalment per month</span>
                    <div class="field-value">
                        @(Model.MonthlyInstalment == null
                            ? "--"
                            : LoanCurrencies.Format(Model.Currency, Model.MonthlyInstalment.Value))
                    </div>
                </div>

                <div class="col-12">
                    <span class="field-label">In words</span>
                    <div class="field-value">
                        @LoanCurrencies.InWords(Model.Currency, Model.AmountRequested)
                    </div>
                </div>

                <div class="col-12">
                    <span class="field-label">Purpose</span>
                    <div class="field-value">@Model.Purpose</div>
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>Receipts and quotations</span>

            <span class="text-muted small">
                @Model.Attachments.Count
                @(Model.Attachments.Count == 1 ? "file" : "files")
            </span>

        </div>

        @if (Model.Attachments.Any())
        {
            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Added</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var attachment in Model.Attachments
                            .OrderByDescending(a => a.UploadedAt))
                        {
                            <tr>

                                <td>@attachment.OriginalFileName</td>

                                <td>
                                    @(attachment.UploadedAt.ToLocalTime().ToString("d MMM yyyy"))
                                </td>

                                <td class="col-actions">

                                    <div class="table-actions">

                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Attachment"
                                           asp-route-id="@Model.Id"
                                           asp-route-attachmentId="@attachment.Id">
                                            Download
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <p class="empty-state">
                    <span class="empty-icon">&#128206;</span>
                    Nothing was attached to this application.
                </p>

            </div>
        }

    </div>

    @if (awaiting)
    {
        <div class="card shadow-sm mb-3">

            <div class="card-header">Sanction this loan</div>

            <div class="card-body">

                <form asp-action="Approve"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label asp-for="@decision.AmountAuthorised"
                                   class="form-label"></label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    @LoanCurrencies.Code(Model.Currency)
                                </span>

                            <input asp-for="@decision.AmountAuthorised"
                                   name="AmountAuthorised"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0" />

                            </div>

                            <div class="form-text">
                                Need not match the amount asked for.
                            </div>

                        </div>

                        <div class="col-md-4">

                            <label asp-for="@decision.RepaymentStartDate"
                                   class="form-label"></label>

                            <input asp-for="@decision.RepaymentStartDate"
                                   name="RepaymentStartDate"
                                   class="form-control"
                                   type="date" />

                        </div>

                        <div class="col-md-4">

                            <label asp-for="@decision.Comment"
                                   class="form-label"></label>

                            <input asp-for="@decision.Comment"
                                   name="Comment"
                                   class="form-control"
                                   placeholder="Optional" />

                        </div>

                    </div>

                    <div class="mt-3">

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-stamp" aria-hidden="true"></i>
                            Sanction
                        </button>

                    </div>

                </form>

            </div>

        </div>

        <div class="card shadow-sm mb-3">

            <div class="card-header">Or send it back</div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <form asp-action="Return"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <label for="returnComment" class="form-label">
                                Return for changes
                            </label>

                            <input type="text"
                                   id="returnComment"
                                   name="comment"
                                   class="form-control mb-2"
                                   placeholder="What needs changing" />

                            <button type="submit"
                                    class="btn btn-outline-secondary">
                                Return to applicant
                            </button>

                        </form>

                    </div>

                    <div class="col-md-6">

                        <form asp-action="Reject"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <label for="rejectComment" class="form-label">
                                Decline
                            </label>

                            <input type="text"
                                   id="rejectComment"
                                   name="comment"
                                   class="form-control mb-2"
                                   placeholder="Reason" />

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Decline
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">History</div>

        @if (Model.History.Any())
        {
            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-sm align-middle mb-0">

                        <thead>
                            <tr>
                                <th>When</th>
                                <th>What happened</th>
                                <th>By</th>
                                <th>Comment</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var entry in Model.History
                            .OrderByDescending(h => h.ActionDate))
                        {
                            <tr>

                                <td>
                                    @(entry.ActionDate.ToLocalTime().ToString("d MMM yyyy HH:mm"))
                                </td>

                                <td>@entry.Action</td>

                                <td>
                                    @(entry.ActionedByEmployee == null
                                        ? "--"
                                        : entry.ActionedByEmployee.FirstName
                                          + " "
                                          + entry.ActionedByEmployee.LastName)
                                </td>

                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(entry.Comment)
                                        ? "--"
                                        : entry.Comment)
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    Nothing has happened to this application yet.
                </p>

            </div>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
