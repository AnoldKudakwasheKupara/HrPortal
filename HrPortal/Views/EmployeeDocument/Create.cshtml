@model HrPortal.ViewModels.EmployeeDocumentCreateViewModel

@{
    ViewData["Title"] = "Upload Document";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Upload Document</h2>

        <p class="text-muted">
            File a document against an employee record.
            Files must be 10 MB or smaller.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="EmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>

                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DocumentCategoryId"
                               class="form-label">
                        </label>

                        <select asp-for="DocumentCategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>

                        <span asp-validation-for="DocumentCategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="File"
                               class="form-label">
                        </label>

                        <input asp-for="File"
                               class="form-control"
                               type="file" />

                        <span asp-validation-for="File"
                              class="text-danger">
                        </span>

                    </div>


                </div>


                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Optional description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Upload Document

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
