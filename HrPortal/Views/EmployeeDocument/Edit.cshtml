@model HrPortal.ViewModels.EmployeeDocumentEditViewModel

@{
    ViewData["Title"] = "Edit Document";
}

<div class="container">

    <div class="mb-4">

        <h2>Edit Document</h2>

        <p class="text-muted">
            Update this document. Leave the file box empty to keep
            the file that is already uploaded.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CurrentFileName" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="EmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>

                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DocumentCategoryId"
                               class="form-label">
                        </label>

                        <select asp-for="DocumentCategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>

                        <span asp-validation-for="DocumentCategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="CurrentFileName"
                               class="form-label">
                        </label>

                        <input value="@Model.CurrentFileName"
                               class="form-control"
                               disabled />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="File"
                               class="form-label">
                        </label>

                        <input asp-for="File"
                               class="form-control"
                               type="file" />

                        <span asp-validation-for="File"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="ExpiryDate"
                               class="form-label">
                        </label>

                        <input asp-for="ExpiryDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="ExpiryDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="UploadedByEmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="UploadedByEmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select --
                            </option>

                        </select>

                        <span asp-validation-for="UploadedByEmployeeId"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Save Changes

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
