@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.EmployeeDocument>

@{
    ViewData["Title"] = "Employee Documents";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Employee Documents</h2>

            <p class="text-muted">
                Contracts, certificates and other files held on file
                for each employee.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Upload Document
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-4">

                    <label for="employeeId"
                           class="form-label">
                        Employee
                    </label>

                    <select id="employeeId"
                            name="employeeId"
                            asp-items="ViewBag.Employees"
                            class="form-select">

                        <option value="">
                            -- All Employees --
                        </option>

                    </select>

                </div>

                <div class="col-md-4">

                    <label for="categoryId"
                           class="form-label">
                        Category
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select">

                        <option value="">
                            -- All Categories --
                        </option>

                    </select>

                </div>

                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-outline-secondary">
                        Filter
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Expires</th>
                            <th>Uploaded</th>
                            <th>Uploaded By</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No documents match this filter.
                            </td>
                        </tr>
                    }

                    @foreach (var document in Model.Items)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @document.OriginalFileName
                                </strong>
                            </td>

                            <td>
                                @document.Employee.FirstName
                                @document.Employee.LastName
                            </td>

                            <td>
                                @document.DocumentCategory.Name
                            </td>

                            <td>
                                @if (document.ExpiryDate == null)
                                {
                                    <span class="text-muted">--</span>
                                }
                                else
                                {
                                    var days =
                                        (document.ExpiryDate.Value.Date
                                            - DateTime.Today).Days;

                                    <span class="@(days < 0
                                        ? "badge bg-danger"
                                        : days <= 30
                                            ? "badge bg-warning text-dark"
                                            : "")">
                                        @document.ExpiryDate.Value.ToString("dd MMM yyyy")
                                    </span>

                                    @if (days < 0)
                                    {
                                        <div class="text-muted small">
                                            expired
                                        </div>
                                    }
                                }
                            </td>

                            <td>
                                @document.UploadedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    document.UploadedByName))
                                {
                                    @document.UploadedByName
                                }
                                else if (document.UploadedByEmployee != null)
                                {
                                    @document.UploadedByEmployee.FirstName
                                    @document.UploadedByEmployee.LastName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not recorded
                                    </span>
                                }
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@document.Id">

                                        View

                                    </a>

                                    @if (HrPortal.Services.FileStorageService
                                        .CanPreview(document.OriginalFileName))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Preview"
                                           asp-route-id="@document.Id"
                                           target="_blank">

                                            Preview

                                        </a>
                                    }

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Download"
                                       asp-route-id="@document.Id">

                                        Download

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@document.Id">

                                        Edit

                                    </a>

                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Delete"
                                       asp-route-id="@document.Id">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            @{ var pager = HrPortal.ViewModels.PagerViewModel.From(Context.Request, Model, "documents"); }
            <partial name="_Pager" model="pager" />

            </div>

        </div>

    </div>

</div>
