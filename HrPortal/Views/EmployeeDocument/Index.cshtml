@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.EmployeeDocument>

@{
    ViewData["Title"] = "Employee Documents";

    var stats = (int[])ViewBag.Stats;
    var filtered = ViewBag.SelectedEmployeeId != null || ViewBag.SelectedCategoryId != null;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Employee Documents</h2>
            <p>Contracts, certificates and other files held on file for each employee.</p>
        </div>

        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-upload" aria-hidden="true"></i> Upload Document
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-folder-open"></i></span>
            <div>
                <div class="kpi-label">Documents</div>
                <div class="kpi-value">@stats[0]</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon @(stats[1] > 0 ? "is-red" : "is-gray")" aria-hidden="true"><i class="fas fa-circle-xmark"></i></span>
            <div>
                <div class="kpi-label">Expired</div>
                <div class="kpi-value">@stats[1]</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-hourglass-half"></i></span>
            <div>
                <div class="kpi-label">Expiring in 30 Days</div>
                <div class="kpi-value">@stats[2]</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-upload"></i></span>
            <div>
                <div class="kpi-label">Uploaded This Month</div>
                <div class="kpi-value">@stats[3]</div>
            </div>
        </div>

    </div>

    <form asp-action="Index" method="get" class="filter-bar filter-bar-short" data-auto-submit>

        <div>
            <label for="employeeId" class="form-label">Employee</label>
            <select id="employeeId" name="employeeId" asp-items="ViewBag.Employees" class="form-select">
                <option value="">All employees</option>
            </select>
        </div>

        <div>
            <label for="categoryId" class="form-label">Category</label>
            <select id="categoryId" name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">All categories</option>
            </select>
        </div>

        <div class="filter-bar-actions">
            <noscript>
                <button type="submit" class="btn btn-outline-secondary">Apply</button>
            </noscript>
            <a class="btn btn-outline-primary text-nowrap" asp-action="Index">
                <i class="fas fa-filter-circle-xmark" aria-hidden="true"></i> Reset Filters
            </a>
        </div>

    </form>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-folder-open" aria-hidden="true"></i> Documents
            <span class="tab-count">@Model.TotalCount</span>
        </h3>

        @if (!Model.Items.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-folder-open" aria-hidden="true"></i>
                <p>
                    @if (filtered)
                    {
                        <text>No documents match these filters.</text>
                        <a asp-action="Index">Reset filters</a>
                    }
                    else
                    {
                        <text>No documents have been uploaded yet.</text>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Expires</th>
                            <th>Uploaded</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var document in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-break">@document.OriginalFileName</td>
                                <td>@document.Employee.FirstName @document.Employee.LastName</td>
                                <td>@document.DocumentCategory.Name</td>
                                <td class="text-nowrap">
                                    @if (document.ExpiryDate == null)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        var days = (document.ExpiryDate.Value.Date - DateTime.Today).Days;

                                        <span class="@(days < 0 ? "status-badge badge-red" : days <= 30 ? "status-badge badge-amber" : "")">
                                            @document.ExpiryDate.Value.ToString("d MMM yyyy")
                                        </span>

                                        @if (days < 0)
                                        {
                                            <div class="small text-muted">expired</div>
                                        }
                                    }
                                </td>
                                <td>
                                    <div class="text-nowrap">@document.UploadedAt.ToString("d MMM yyyy")</div>
                                    <div class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(document.UploadedByName))
                                        {
                                            @document.UploadedByName
                                        }
                                        else if (document.UploadedByEmployee != null)
                                        {
                                            @document.UploadedByEmployee.FirstName<text> </text>@document.UploadedByEmployee.LastName
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="table-actions justify-content-end">

                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@document.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>

                                        @if (HrPortal.Services.FileStorageService.CanPreview(document.OriginalFileName))
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-action="Preview" asp-route-id="@document.Id"
                                               target="_blank" rel="noopener" title="Preview">
                                                <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                                                <span class="visually-hidden">Preview @document.OriginalFileName</span>
                                            </a>
                                        }

                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Download" asp-route-id="@document.Id" title="Download">
                                            <i class="fas fa-download" aria-hidden="true"></i>
                                            <span class="visually-hidden">Download @document.OriginalFileName</span>
                                        </a>

                                        <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@document.Id" title="Edit">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                                            <span class="visually-hidden">Edit @document.OriginalFileName</span>
                                        </a>

                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@document.Id" title="Delete">
                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                            <span class="visually-hidden">Delete @document.OriginalFileName</span>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='HrPortal.ViewModels.PagerSummary.From(Model, "document", "documents")' />
        }

    </section>

</div>

@section Scripts {
    <script src="~/js/filters.js" asp-append-version="true"></script>
}
