@model HrPortal.Entities.EmployeeDocument

@{
    ViewData["Title"] = "Delete Document";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Delete Document</h2>

        <p class="text-muted">
            This document will be removed permanently.
        </p>

    </div>

    <div class="alert alert-warning">

        Are you sure you want to delete this document?
        The uploaded file will be removed from the server too.

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">File Name</span>

                    <div class="field-value">
                        @Model.OriginalFileName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <div class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Category</span>

                    <div class="field-value">
                        @Model.DocumentCategory.Name
                    </div>

                </div>

                <div class="col-md-6">

                    <span class="field-label">Uploaded By</span>

                    <div class="field-value">
                        @if (!string.IsNullOrWhiteSpace(Model.UploadedByName))
                        {
                            @Model.UploadedByName
                        }
                        else if (Model.UploadedByEmployee != null)
                        {
                            @Model.UploadedByEmployee.FirstName
                            @Model.UploadedByEmployee.LastName
                        }
                        else
                        {
                            <span class="text-muted">Not recorded</span>
                        }
                    </div>

                </div>

                <div class="col-md-6">

                    <span class="field-label">Uploaded</span>

                    <div class="field-value">
                        @Model.UploadedAt.ToString("dd MMM yyyy")
                    </div>

                </div>

            </div>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete Document

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
