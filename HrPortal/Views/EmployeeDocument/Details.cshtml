@model HrPortal.Entities.EmployeeDocument

@{
    ViewData["Title"] = "Document Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.OriginalFileName</h2>

            <p class="text-muted">
                Document Details
            </p>
        </div>

        <div>

            @if (HrPortal.Services.FileStorageService
                .CanPreview(Model.OriginalFileName))
            {
                <a asp-action="Preview"
                   asp-route-id="@Model.Id"
                   target="_blank"
                   class="btn btn-outline-primary">

                    Preview

                </a>
            }

            <a asp-action="Download"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">

                Download

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">File Name</span>

                    <div class="field-value">
                        @Model.OriginalFileName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <div class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <div class="field-value">
                        @Model.Employee.Department.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Category</span>

                    <div class="field-value">
                        @Model.DocumentCategory.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Uploaded By</span>

                    <div class="field-value">
                        @if (!string.IsNullOrWhiteSpace(Model.UploadedByName))
                        {
                            @Model.UploadedByName
                        }
                        else if (Model.UploadedByEmployee != null)
                        {
                            @Model.UploadedByEmployee.FirstName
                            @Model.UploadedByEmployee.LastName
                        }
                        else
                        {
                            <span class="text-muted">Not recorded</span>
                        }
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Uploaded</span>

                    <div class="field-value">
                        @Model.UploadedAt.ToString("dd MMM yyyy HH:mm")
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Description</span>

                    <div class="field-value">
                        @(Model.Description ?? "No description provided.")
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
