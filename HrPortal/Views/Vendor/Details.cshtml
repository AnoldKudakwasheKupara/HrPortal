@model HrPortal.Entities.Vendor

@{
    ViewData["Title"] = "Vendor Details";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Name</h2>

            <div class="detail-badges">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">In use</span>
                }
                else
                {
                    <span class="badge bg-secondary">No longer used</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Category))
                {
                    <span class="badge bg-light text-dark">@Model.Category</span>
                }
            </div>
        </div>

        <div class="page-head-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary">Edit</a>

            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header">What they supply</div>

                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-box-open"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Product or service</span>
                                <p class="field-value">@Model.ProductOrService</p>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-tags"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Category</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Category))
                                {
                                    <p class="field-value">@Model.Category</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">Not set</p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-calendar-plus"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">On the register since</span>
                                <p class="field-value">
                                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">Contact details</div>

                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-user"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Contact person</span>
                                @if (!string.IsNullOrWhiteSpace(Model.ContactPerson))
                                {
                                    <p class="field-value">@Model.ContactPerson</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">Not recorded</p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Email</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <p class="field-value">
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    </p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">Not recorded</p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-phone"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Phone</span>
                                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    <p class="field-value">
                                        @Model.PhoneNumber
                                        @if (!string.IsNullOrWhiteSpace(Model.AlternatePhone))
                                        {
                                            <span class="text-muted">
                                                &middot; @Model.AlternatePhone
                                            </span>
                                        }
                                    </p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">Not recorded</p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-globe"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Website</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Website))
                                {
                                    <p class="field-value">@Model.Website</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">Not recorded</p>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-location-dot"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Address</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Address))
                                {
                                    <p class="field-value">@Model.Address</p>
                                }
                                else
                                {
                                    <p class="field-value is-empty">Not recorded</p>
                                }
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mt-3">

        <div class="card-header">Notes</div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <p class="field-value mb-0">@Model.Notes</p>
            }
            else
            {
                <p class="field-value is-empty mb-0">
                    Nothing recorded against this vendor.
                </p>
            }
        </div>

    </div>

</div>
