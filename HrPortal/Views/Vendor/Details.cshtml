@model HrPortal.Entities.Vendor

@{
    ViewData["Title"] = "Vendor Details";

    string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Name</h2>
            <p>@Model.ProductOrService</p>
        </div>

        <div class="head-actions">

            @if (Model.IsActive)
            {
                <span class="status-badge badge-green">In use</span>
            }
            else
            {
                <span class="status-badge badge-gray">No longer used</span>
            }

            <partial name="_DownloadPdf" model="@Model.Id" />

            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-box-open" aria-hidden="true"></i> What They Supply
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-box-open" aria-hidden="true"></i>
                        <div><span>Product or service</span><strong>@Model.ProductOrService</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-tags" aria-hidden="true"></i>
                        <div>
                            <span>Category</span>
                            @if (Blank(Model.Category) == null)
                            {
                                <em>Not set</em>
                            }
                            else
                            {
                                <strong>@Model.Category</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                        <div><span>On the register since</span><strong>@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-note-sticky" aria-hidden="true"></i> Notes</h4>
                    <p class="pre-line">@(Blank(Model.Notes) ?? "Nothing recorded against this vendor.")</p>
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-address-card" aria-hidden="true"></i> Contact Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div>
                            <span>Contact person</span>
                            @if (Blank(Model.ContactPerson) == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.ContactPerson</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        <div>
                            <span>Email</span>
                            @if (Blank(Model.Email) == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong class="text-break"><a href="mailto:@Model.Email">@Model.Email</a></strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-phone" aria-hidden="true"></i>
                        <div>
                            <span>Phone</span>
                            @if (Blank(Model.PhoneNumber) == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.PhoneNumber</strong>
                                @if (Blank(Model.AlternatePhone) != null)
                                {
                                    <strong class="fw-normal text-muted">@Model.AlternatePhone</strong>
                                }
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-globe" aria-hidden="true"></i>
                        <div>
                            <span>Website</span>
                            @if (Blank(Model.Website) == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong class="text-break">@Model.Website</strong>
                            }
                        </div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-location-dot" aria-hidden="true"></i> Address</h4>
                    <p class="pre-line">@(Blank(Model.Address) ?? "Not recorded")</p>
                </div>

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit vendor
                    </a>
                    @if (Blank(Model.Email) != null)
                    {
                        <a href="mailto:@Model.Email" class="btn btn-outline-secondary">
                            <i class="fas fa-envelope" aria-hidden="true"></i> Email them
                        </a>
                    }
                    <partial name="_DownloadPdf" model="@Model.Id" />
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Vendor Information
                </h3>

                <dl class="info-list">
                    <dt>Status</dt>
                    <dd>@(Model.IsActive ? "In use" : "No longer used")</dd>
                    <dt>Category</dt>
                    <dd>@(Blank(Model.Category) ?? "Not set")</dd>
                    <dt>Added</dt>
                    <dd>@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
