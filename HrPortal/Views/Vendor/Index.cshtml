@model IEnumerable<HrPortal.Entities.Vendor>

@{
    ViewData["Title"] = "Vendors";
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>Vendors</h2>
            <p class="text-muted mb-0">
                Who we buy from, what they supply and how to reach them.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Add Vendor</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">

                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input name="search" class="form-control"
                           value="@ViewBag.Search"
                           placeholder="Name, product, contact or email" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        <option value="">-- All Categories --</option>
                        @foreach (var c in (ViewBag.Categories as List<string>)
                            ?? new List<string>())
                        {
                            <option value="@c"
                                    selected="@(c == (string?)ViewBag.CategoryFilter)">
                                @c
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="active" class="form-select">
                        <option value="">-- All --</option>
                        <option value="true"
                                selected="@(ViewBag.ActiveFilter as bool? == true)">
                            In use
                        </option>
                        <option value="false"
                                selected="@(ViewBag.ActiveFilter as bool? == false)">
                            No longer used
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">
                        Filter
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Vendor</th>
                            <th>Product / Service</th>
                            <th>Category</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No vendors match this filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var v in Model)
                        {
                            <tr>
                                <td><strong>@v.Name</strong></td>

                                <td>@v.ProductOrService</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(v.Category))
                                    {
                                        <span class="badge bg-light text-dark">
                                            @v.Category
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(v.ContactPerson))
                                    {
                                        <div>@v.ContactPerson</div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(v.PhoneNumber))
                                    {
                                        <div class="text-muted small">
                                            @v.PhoneNumber
                                        </div>
                                    }

                                    @if (string.IsNullOrWhiteSpace(v.ContactPerson) &&
                                         string.IsNullOrWhiteSpace(v.PhoneNumber))
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>
                                    @if (v.IsActive)
                                    {
                                        <span class="badge bg-success">In use</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not used
                                        </span>
                                    }
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Details" asp-route-id="@v.Id">
                                            View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Edit" asp-route-id="@v.Id">
                                            Edit
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-action="Delete" asp-route-id="@v.Id">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
