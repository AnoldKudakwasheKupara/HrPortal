@model HrPortal.Entities.TrainingFeedback

@{
    ViewData["Title"] = "Delete Training Feedback";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Delete Training Feedback</h2>

        <p class="text-muted">
            This feedback will be removed permanently.
        </p>

    </div>

    <div class="alert alert-warning">

        Are you sure you want to delete this feedback?
        This cannot be undone.

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Course</span>

                    <div class="field-value">
                        @Model.TrainingAssignment.TrainingCourse.Title
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <div class="field-value">
                        @Model.TrainingAssignment.Employee.FirstName
                        @Model.TrainingAssignment.Employee.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Rating</span>

                    <div class="field-value">
                        <span class="badge bg-info text-dark">
                            @Model.Rating / 5
                        </span>
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Comments</span>

                    <div class="field-value">
                        @(Model.Comments ?? "No comments given.")
                    </div>

                </div>

            </div>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete Feedback

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
