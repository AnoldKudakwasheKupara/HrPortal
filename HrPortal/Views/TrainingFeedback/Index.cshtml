@model IEnumerable<HrPortal.Entities.TrainingFeedback>

@{
    ViewData["Title"] = "Training Feedback";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Training Feedback</h2>

            <p class="text-muted">
                What employees thought of the courses they attended.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Record Feedback
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Employee</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Submitted</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                No training feedback has been recorded yet.
                            </td>
                        </tr>
                    }

                    @foreach (var feedback in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @feedback.TrainingAssignment.TrainingCourse.Title
                                </strong>
                            </td>

                            <td>
                                @feedback.TrainingAssignment.Employee.FirstName
                                @feedback.TrainingAssignment.Employee.LastName
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @feedback.Rating / 5
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    feedback.Comments))
                                {
                                    @feedback.Comments
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No comments
                                    </span>
                                }
                            </td>

                            <td>
                                @feedback.SubmittedAt.ToString("dd MMM yyyy")
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@feedback.Id">

                                        View

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@feedback.Id">

                                        Edit

                                    </a>

                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Delete"
                                       asp-route-id="@feedback.Id">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
