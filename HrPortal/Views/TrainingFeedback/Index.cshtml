@using HrPortal.ViewModels
@model IEnumerable<HrPortal.Entities.TrainingFeedback>

@{
    ViewData["Title"] = "Training Feedback";

    var all = Model.ToList();
    var search = PagedList.SearchFrom(Context.Request);
    var show = Context.Request.Query["show"].ToString() switch
    {
        "high" => "high",
        "low" => "low",
        _ => "all"
    };

    var shown = all
        .Where(f => show switch { "high" => f.Rating >= 4, "low" => f.Rating <= 2, _ => true })
        .Where(f => PagedList.Matches(search,
            f.TrainingAssignment.TrainingCourse.Title,
            f.TrainingAssignment.Employee.FirstName + " " + f.TrainingAssignment.Employee.LastName,
            f.Comments))
        .ToList();
    var paged = PagedList.Of(shown, PagedList.PageFrom(Context.Request));

    var tabs = new List<ListTab>
    {
        new("all", "All", "fa-list-ul", "is-teal", all.Count),
        new("high", "Rated 4 or 5", "fa-thumbs-up", "is-green", all.Count(f => f.Rating >= 4)),
        new("low", "Rated 1 or 2", "fa-thumbs-down", "is-amber", all.Count(f => f.Rating <= 2))
    };
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Training Feedback</h2>
            <p>What employees thought of the courses they attended.</p>
        </div>

        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-plus" aria-hidden="true"></i> Record Feedback
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-comment-dots"></i></span>
            <div>
                <div class="kpi-label">Responses</div>
                <div class="kpi-value">@all.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-star"></i></span>
            <div>
                <div class="kpi-label">Average Rating</div>
                <div class="kpi-value">@(all.Any() ? all.Average(f => f.Rating).ToString("0.0") : "-") <span class="kpi-unit">/ 5</span></div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-thumbs-up"></i></span>
            <div>
                <div class="kpi-label">Rated 4 or 5</div>
                <div class="kpi-value">@all.Count(f => f.Rating >= 4)</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-chalkboard-user"></i></span>
            <div>
                <div class="kpi-label">Courses Rated</div>
                <div class="kpi-value">@all.Select(f => f.TrainingAssignment.TrainingCourseId).Distinct().Count()</div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-comment-dots" aria-hidden="true"></i> Feedback
            <span class="tab-count">@shown.Count</span>
        </h3>

        <partial name="_ListToolbar" model='new ListToolbarModel(new ListTabsModel(tabs, show), search, "Search course, employee, comment...")' />

        @if (!shown.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-comment-slash" aria-hidden="true"></i>
                <p>@(all.Any() ? "No feedback matches." : "No training feedback has been recorded yet.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Employee</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Submitted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var feedback in paged.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@feedback.TrainingAssignment.TrainingCourse.Title</td>
                                <td>@feedback.TrainingAssignment.Employee.FirstName @feedback.TrainingAssignment.Employee.LastName</td>
                                <td class="text-nowrap">
                                    <span class="status-badge @(feedback.Rating >= 4 ? "badge-green" : feedback.Rating <= 2 ? "badge-amber" : "badge-blue")">
                                        <i class="fas fa-star" aria-hidden="true"></i> @feedback.Rating / 5
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(feedback.Comments))
                                    {
                                        <span class="small text-clamp-1">@feedback.Comments</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No comments</span>
                                    }
                                </td>
                                <td class="text-nowrap">@feedback.SubmittedAt.ToString("d MMM yyyy")</td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@feedback.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>
                                        <a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Edit" asp-route-id="@feedback.Id">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@feedback.Id" title="Delete">
                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                            <span class="visually-hidden">Delete this feedback</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "response", "responses")' />
        }

    </section>

</div>
