@model IEnumerable<HrPortal.Entities.TrainingFeedback>

@{
    ViewData["Title"] = "Training Feedback";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Training Feedback</h2>

            <p class="text-muted">
                What employees thought of the courses they attended.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Record Feedback
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Employee</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var feedback in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @feedback.TrainingAssignment.TrainingCourse.Title
                                </strong>
                            </td>

                            <td>
                                @feedback.TrainingAssignment.Employee.FirstName
                                @feedback.TrainingAssignment.Employee.LastName
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @feedback.Rating / 5
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    feedback.Comments))
                                {
                                    @feedback.Comments
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No comments
                                    </span>
                                }
                            </td>

                            <td>
                                @feedback.SubmittedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                <div class="dropdown">

                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">

                                        Actions

                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@feedback.Id">

                                                View

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@feedback.Id">

                                                Edit

                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@feedback.Id">

                                                Delete

                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

                @if (!Model.Any())
                {
                    <p class="text-muted mb-0">
                        No training feedback has been recorded yet.
                    </p>
                }

            </div>

        </div>

    </div>

</div>
