@model HrPortal.Entities.TrainingFeedback

@{
    ViewData["Title"] = "Training Feedback Details";

    var employee = Model.TrainingAssignment.Employee;
    var tone = Model.Rating >= 4 ? "badge-green" : Model.Rating <= 2 ? "badge-amber" : "badge-blue";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.TrainingAssignment.TrainingCourse.Title</h2>
            <p>Feedback from @employee.FirstName @employee.LastName</p>
        </div>

        <div class="head-actions">

            <span class="status-badge @tone"><i class="fas fa-star" aria-hidden="true"></i> @Model.Rating / 5</span>

            <partial name="_DownloadPdf" model="@Model.Id" />

            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-comment-dots" aria-hidden="true"></i> Feedback Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-chalkboard-user" aria-hidden="true"></i>
                        <div><span>Course</span><strong>@Model.TrainingAssignment.TrainingCourse.Title</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div><span>Employee</span><strong>@employee.FirstName @employee.LastName</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-building" aria-hidden="true"></i>
                        <div><span>Department</span><strong>@(employee.Department?.Name ?? "--")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-star" aria-hidden="true"></i>
                        <div><span>Rating</span><strong>@Model.Rating out of 5</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-quote-left" aria-hidden="true"></i> Comments</h4>
                    <p class="pre-line">@(Model.Comments ?? "No comments given.")</p>
                </div>

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit feedback
                    </a>
                    <partial name="_DownloadPdf" model="@Model.Id" />
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Feedback Information
                </h3>

                <dl class="info-list">
                    <dt>Submitted</dt>
                    <dd>@Model.SubmittedAt.ToString("d MMM yyyy")</dd>
                    <dt>Rating</dt>
                    <dd>@Model.Rating / 5</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
