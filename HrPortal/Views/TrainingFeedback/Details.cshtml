@model HrPortal.Entities.TrainingFeedback

@{
    ViewData["Title"] = "Training Feedback Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.TrainingAssignment.TrainingCourse.Title</h2>

            <p class="text-muted">
                Feedback from
                @Model.TrainingAssignment.Employee.FirstName
                @Model.TrainingAssignment.Employee.LastName
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <span class="field-label">Course</span>

                    <p class="field-value">
                        @Model.TrainingAssignment.TrainingCourse.Title
                    </p>

                </div>


                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <p class="field-value">
                        @Model.TrainingAssignment.Employee.FirstName
                        @Model.TrainingAssignment.Employee.LastName
                    </p>

                </div>


                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <p class="field-value">
                        @Model.TrainingAssignment.Employee.Department.Name
                    </p>

                </div>


                <div class="col-md-4">

                    <span class="field-label">Rating</span>

                    <p class="field-value">
                        <span class="badge bg-info text-dark">
                            @Model.Rating / 5
                        </span>
                    </p>

                </div>


                <div class="col-md-4">

                    <span class="field-label">Submitted</span>

                    <p class="field-value">
                        @Model.SubmittedAt.ToString("dd MMM yyyy")
                    </p>

                </div>


                <div class="col-12">

                    <span class="field-label">Comments</span>

                    <p class="field-value">
                        @(Model.Comments ?? "No comments given.")
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
