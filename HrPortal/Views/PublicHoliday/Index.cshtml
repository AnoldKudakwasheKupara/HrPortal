@model IEnumerable<HrPortal.Entities.PublicHoliday>

@{
    ViewData["Title"] = "Public Holidays";

    var year = (int)ViewBag.Year;
    var years = ViewBag.Years as List<int> ?? new List<int>();
    var onWeekdays = (int)ViewBag.OnWeekdays;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>Public Holidays</h2>
            <p class="text-muted mb-0">
                Days leave is not counted against. A holiday falling on a
                weekday is taken out of any leave request covering it.
            </p>
        </div>

        <a asp-action="Create" asp-route-year="@year" class="btn btn-primary">
            Add Holiday
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-stats">

        <div class="report-stat">
            <span class="report-stat-label">Holidays in @year</span>
            <span class="report-stat-value">@Model.Count()</span>
            <span class="report-stat-note">On the calendar</span>
        </div>

        <div class="report-stat @(onWeekdays > 0 ? "is-good" : "")">
            <span class="report-stat-label">On a weekday</span>
            <span class="report-stat-value">@onWeekdays</span>
            <span class="report-stat-note">These shorten leave requests</span>
        </div>

    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-2 align-items-end">

            <form method="get" class="d-flex gap-2 align-items-end">
                <div>
                    <label class="form-label">Year</label>
                    <select name="year" class="form-select">
                        @if (!years.Contains(year))
                        {
                            <option value="@year" selected>@year</option>
                        }
                        @foreach (var y in years)
                        {
                            <option value="@y" selected="@(y == year)">@y</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-secondary">Show</button>
            </form>

            <form asp-action="CopyToNextYear" method="post" class="ms-auto">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@year" />
                <button type="submit" class="btn btn-outline-primary">
                    Copy @year into @(year + 1)
                </button>
            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Holiday</th>
                            <th>Notes</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No holidays recorded for @year. Until they
                                are, leave spanning a holiday will count it
                                as a working day.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var h in Model)
                        {
                            var weekend =
                                h.Date.DayOfWeek == DayOfWeek.Saturday ||
                                h.Date.DayOfWeek == DayOfWeek.Sunday;

                            <tr>
                                <td>
                                    <strong>@h.Date.ToString("d MMM yyyy")</strong>
                                </td>

                                <td>
                                    @h.Date.ToString("dddd")
                                    @if (weekend)
                                    {
                                        <span class="badge bg-light text-dark">
                                            Weekend
                                        </span>
                                    }
                                </td>

                                <td>@h.Name</td>

                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(h.Notes)
                                        ? "--"
                                        : h.Notes)
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Edit" asp-route-id="@h.Id">
                                            Edit
                                        </a>
                                        <form asp-action="Delete"
                                              asp-route-id="@h.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@h.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
