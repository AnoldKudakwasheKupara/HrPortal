@using HrPortal.ViewModels
@model IEnumerable<HrPortal.Entities.PublicHoliday>

@{
    ViewData["Title"] = "Public Holidays";

    var year = (int)ViewBag.Year;
    var years = ViewBag.Years as List<int> ?? new List<int>();
    var onWeekdays = (int)ViewBag.OnWeekdays;
    var all = Model.ToList();
    var paged = PagedList.Of(all, PagedList.PageFrom(Context.Request));
    var next = all.Where(h => h.Date.Date >= DateTime.Today).OrderBy(h => h.Date).FirstOrDefault();
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Public Holidays</h2>
            <p>
                Days leave is not counted against. A holiday falling on a weekday is taken out of any
                leave request covering it.
            </p>
        </div>

        <a asp-action="Create" asp-route-year="@year" class="btn btn-gold">
            <i class="fas fa-plus" aria-hidden="true"></i> Add Holiday
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-calendar-check"></i></span>
            <div>
                <div class="kpi-label">Holidays in @year</div>
                <div class="kpi-value">@all.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-business-time"></i></span>
            <div>
                <div class="kpi-label">On a Weekday</div>
                <div class="kpi-value">@onWeekdays</div>
                <div class="kpi-note">These shorten leave requests</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-mug-hot"></i></span>
            <div>
                <div class="kpi-label">On a Weekend</div>
                <div class="kpi-value">@(all.Count - onWeekdays)</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-calendar-day"></i></span>
            <div>
                <div class="kpi-label">Next Holiday</div>
                @if (next == null)
                {
                    <div class="kpi-value kpi-value-text text-muted">None ahead</div>
                }
                else
                {
                    <div class="kpi-value kpi-value-text">@next.Date.ToString("d MMM")</div>
                    <div class="kpi-note text-truncate" title="@next.Name">@next.Name</div>
                }
            </div>
        </div>

    </div>

    <form method="get" class="filter-bar filter-bar-short" data-auto-submit>

        <div>
            <label for="holiday-year" class="form-label">Year</label>
            <select id="holiday-year" name="year" class="form-select">
                @if (!years.Contains(year))
                {
                    <option value="@year" selected>@year</option>
                }
                @foreach (var y in years)
                {
                    <option value="@y" selected="@(y == year)">@y</option>
                }
            </select>
        </div>

        <div class="filter-bar-actions">
            <noscript>
                <button type="submit" class="btn btn-outline-secondary">Show</button>
            </noscript>
        </div>

    </form>

    <section class="panel-card mb-4">

        <div class="panel-head-split">

            <h3 class="panel-head">
                <i class="fas fa-calendar-check" aria-hidden="true"></i> Holidays in @year
                <span class="tab-count">@all.Count</span>
            </h3>

            <form asp-action="CopyToNextYear" method="post">
                <input type="hidden" name="year" value="@year" />
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-copy" aria-hidden="true"></i> Copy @year into @(year + 1)
                </button>
            </form>

        </div>

        @if (!all.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-calendar-xmark" aria-hidden="true"></i>
                <p>
                    No holidays recorded for @year. Until they are, leave spanning a holiday will count it
                    as a working day.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Holiday</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var h in paged.Items)
                        {
                            var weekend = h.Date.DayOfWeek == DayOfWeek.Saturday || h.Date.DayOfWeek == DayOfWeek.Sunday;

                            <tr>
                                <td class="text-nowrap fw-semibold">@h.Date.ToString("d MMM yyyy")</td>
                                <td class="text-nowrap">
                                    @h.Date.ToString("dddd")
                                    @if (weekend)
                                    {
                                        <span class="status-badge badge-gray ms-1">Weekend</span>
                                    }
                                </td>
                                <td class="fw-semibold">@h.Name</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(h.Notes) ? "-" : h.Notes)</td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Edit" asp-route-id="@h.Id">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@h.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Remove @h.Name?');">
                                            <input type="hidden" name="id" value="@h.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fas fa-trash" aria-hidden="true"></i>
                                                <span class="visually-hidden">Remove @h.Name</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "holiday", "holidays")' />
        }

    </section>

</div>

@section Scripts {
    <script src="~/js/filters.js" asp-append-version="true"></script>
}
