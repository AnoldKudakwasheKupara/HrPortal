@model HrPortal.ViewModels.PublicHolidayViewModel

@{ ViewData["Title"] = "Add Holiday"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Add Holiday</h2>
        <p class="text-muted">
            One row per actual date. Leave covering it will not count
            that day against the employee.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control"
                               placeholder="Christmas Day" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control"
                           placeholder="Observed on the Monday" />
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Add Holiday
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
