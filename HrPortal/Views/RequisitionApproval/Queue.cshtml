@model IEnumerable<HrPortal.Entities.Requisition>

@{
    var stage = ViewBag.Stage as string ?? "Review";
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@ViewData["Title"]</h2>
            <p class="text-muted mb-0">
                @if (stage == "MD")
                {
                    <text>
                        These have cleared review and reached the
                        threshold, so they need your decision.
                    </text>
                }
                else
                {
                    <text>
                        Submitted requisitions waiting on you. Approve,
                        send back for more detail, or turn down.
                    </text>
                }
            </p>
        </div>

        <a asp-action="All" class="btn btn-secondary">All Requisitions</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Number</th>
                            <th>Raised by</th>
                            <th>What for</th>
                            <th class="num">Items</th>
                            <th class="num">Estimated</th>
                            <th>Needed by</th>
                            <th>Submitted</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                Nothing is waiting on you.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td><strong>@r.RequisitionNumber</strong></td>

                                <td>
                                    @(r.Employee.FirstName + " " +
                                      r.Employee.LastName)
                                    <div class="text-muted small">
                                        @r.Employee.Department?.Name
                                    </div>
                                </td>

                                <td>@r.Title</td>

                                <td class="num">@r.Lines.Count</td>

                                <td class="num">
                                    <strong>@r.EstimatedTotal.ToString("N2")</strong>
                                </td>

                                <td>
                                    @(r.NeededBy?.ToString("d MMM yyyy") ?? "--")
                                </td>

                                <td>
                                    @(r.SubmittedAt?.ToLocalTime()
                                        .ToString("d MMM HH:mm") ?? "--")
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Details" asp-route-id="@r.Id">
                                            Open
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
