@using HrPortal.Entities
@model IEnumerable<HrPortal.Entities.Requisition>

@{
    ViewData["Title"] = "All Requisitions";

    var currency = ViewBag.Currency as string ?? "USD";
    var threshold = (decimal)ViewBag.Threshold;
    var filter = ViewBag.StatusFilter as RequisitionStatus?;

    ViewBag.Currency = currency;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>All Requisitions</h2>
            <p class="text-muted mb-0">
                Everything raised, whatever stage it has reached.
            </p>
        </div>

        <div class="page-head-actions">
            @if (User.IsInRole(HrPortal.Security.Roles.Administrator))
            {
                <a asp-action="Index" class="btn btn-outline-primary">
                    Awaiting Review
                </a>
            }

            @if (User.IsInRole(HrPortal.Security.Roles.Md))
            {
                <a asp-action="FinalApproval" class="btn btn-outline-primary">
                    Awaiting My Approval
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="report-stats">

        <a class="report-stat @(((int)ViewBag.AwaitingReview) > 0 ? "is-warning" : "")"
           asp-action="All" asp-route-status="@RequisitionStatus.Submitted">
            <span class="report-stat-label">Awaiting review</span>
            <span class="report-stat-value">@ViewBag.AwaitingReview</span>
            <span class="report-stat-note">Submitted, not yet reviewed</span>
        </a>

        <a class="report-stat @(((int)ViewBag.AwaitingMd) > 0 ? "is-warning" : "")"
           asp-action="All" asp-route-status="@RequisitionStatus.ReviewApproved">
            <span class="report-stat-label">Awaiting the MD</span>
            <span class="report-stat-value">@ViewBag.AwaitingMd</span>
            <span class="report-stat-note">Cleared review</span>
        </a>

        <div class="report-stat">
            <span class="report-stat-label">Approved this year</span>
            <span class="report-stat-value is-money">
                @currency @(((decimal)ViewBag.ApprovedThisYear).ToString("N2"))
            </span>
            <span class="report-stat-note">Estimated value</span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">MD threshold</span>
            <span class="report-stat-value is-money">
                @currency @threshold.ToString("N2")
            </span>
            <span class="report-stat-note">Set in configuration</span>
        </div>

    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All</option>
                        @foreach (var s in Enum.GetValues<RequisitionStatus>())
                        {
                            <option value="@s" selected="@(filter == s)">
                                @s
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">
                        Filter
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Number</th>
                            <th>Raised by</th>
                            <th>What for</th>
                            <th class="num">Estimated</th>
                            <th>Vendor</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Nothing matches this filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td><strong>@r.RequisitionNumber</strong></td>

                                <td>
                                    @(r.Employee.FirstName + " " +
                                      r.Employee.LastName)
                                </td>

                                <td>@r.Title</td>

                                <td class="num">
                                    @r.EstimatedTotal.ToString("N2")
                                </td>

                                <td>@(r.Vendor?.Name ?? "--")</td>

                                <td>
                                    <partial name="_RequisitionStatusBadge"
                                             model="r.Status" />
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Details" asp-route-id="@r.Id">
                                            Open
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
