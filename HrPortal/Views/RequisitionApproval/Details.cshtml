@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.ViewModels.RequisitionDecisionViewModel

@{
    var r = Model.Requisition;

    ViewData["Title"] = r.RequisitionNumber;

    ViewBag.Currency = Model.Currency;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@r.RequisitionNumber</h2>

            <div class="detail-badges">
                <partial name="_RequisitionStatusBadge" model="r.Status" />

                <span class="badge bg-light text-dark">
                    @Model.Currency @r.EstimatedTotal.ToString("N2")
                </span>

                @if (r.RequiresMdApproval)
                {
                    <span class="badge bg-info">MD approval required</span>
                }
            </div>
        </div>

        <div class="page-head-actions">
            <a asp-action="All" class="btn btn-secondary">All Requisitions</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.IsRequesterTheReviewer)
    {
        <div class="alert alert-info">
            This was raised by the configured requisition reviewer, so it
            skipped review and came straight to the Managing Director.
        </div>
    }

    <div class="row g-3">

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header">The request</div>
                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-user"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Raised by</span>
                                <div class="field-value">
                                    @(r.Employee.FirstName + " " +
                                      r.Employee.LastName)
                                    <span class="text-muted">
                                        &mdash; @r.Employee.Department?.Name
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-clipboard-list"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">What for</span>
                                <div class="field-value">@r.Title</div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-comment-dots"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Justification</span>
                                @if (!string.IsNullOrWhiteSpace(r.Justification))
                                {
                                    <div class="field-value">@r.Justification</div>
                                }
                                else
                                {
                                    <div class="field-value is-empty">
                                        None given
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">The numbers</div>
                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-coins"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Estimated total</span>
                                <div class="field-value">
                                    @Model.Currency @r.EstimatedTotal.ToString("N2")
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-scale-balanced"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">MD threshold</span>
                                <div class="field-value">
                                    @Model.Currency @Model.Threshold.ToString("N2")
                                    <span class="text-muted">
                                        &mdash;
                                        @(r.RequiresMdApproval
                                            ? "at or above, so the MD decides"
                                            : "below, so review is final")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-truck-field"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Suggested vendor</span>
                                <div class="field-value">
                                    @(r.Vendor?.Name ?? "None suggested")
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-calendar-day"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Needed by</span>
                                <div class="field-value">
                                    @(r.NeededBy?.ToString("d MMM yyyy")
                                        ?? "No date given")
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header">Items</div>
        <div class="card-body is-table">
            <partial name="_RequisitionLines" model="r" />
        </div>
    </div>

    @if (Model.CanReview)
    {
        <div class="card shadow-sm mt-3">

            <div class="card-header">Your review</div>

            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Comment</label>
                    <textarea id="comment" name="comment" class="form-control"
                              rows="3"
                              placeholder="Required when sending it back; optional otherwise."></textarea>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <form asp-action="Approve" asp-route-id="@r.Id"
                          method="post" class="js-carry">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="comment" />
                        <button type="submit" class="btn btn-success">
                            @(r.RequiresMdApproval
                                ? "Approve and send to the MD"
                                : "Approve")
                        </button>
                    </form>

                    <form asp-action="Return" asp-route-id="@r.Id"
                          method="post" class="js-carry">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="comment" />
                        <button type="submit" class="btn btn-outline-warning">
                            Send back for amendment
                        </button>
                    </form>

                    <form asp-action="Reject" asp-route-id="@r.Id"
                          method="post" class="js-carry">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="comment" />
                        <button type="submit" class="btn btn-outline-danger">
                            Reject
                        </button>
                    </form>

                </div>

                @if (!r.RequiresMdApproval)
                {
                    <div class="form-text mt-2">
                        This is below the threshold, so approving it here
                        is the final approval.
                    </div>
                }

            </div>

        </div>
    }

    @if (Model.CanDecideAsMd)
    {
        <div class="card shadow-sm mt-3">

            <div class="card-header">Final approval</div>

            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Comment</label>
                    <textarea id="comment" name="comment" class="form-control"
                              rows="3" placeholder="Optional"></textarea>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <form asp-action="FinalApprove" asp-route-id="@r.Id"
                          method="post" class="js-carry">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="comment" />
                        <button type="submit" class="btn btn-success">
                            Approve
                        </button>
                    </form>

                    <form asp-action="FinalReject" asp-route-id="@r.Id"
                          method="post" class="js-carry">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="comment" />
                        <button type="submit" class="btn btn-outline-danger">
                            Reject
                        </button>
                    </form>

                </div>

            </div>

        </div>
    }

    @if (!Model.CanReview && !Model.CanDecideAsMd)
    {
        <div class="alert alert-secondary mt-3">
            @if (RequisitionWorkflowService.IsFinal(r.Status))
            {
                <text>This requisition is closed. Nothing further to do.</text>
            }
            else if (RequisitionWorkflowService.IsWithRequester(r.Status))
            {
                <text>This is back with the requester.</text>
            }
            else
            {
                <text>
                    This is waiting on someone else at this stage, so
                    there is nothing for you to decide.
                </text>
            }
        </div>
    }

    <div class="card shadow-sm mt-3 mb-4">

        <div class="card-header">History</div>

        <div class="card-body @(r.History.Any() ? "is-table" : "")">
            @if (r.History.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>What happened</th>
                                <th>By</th>
                                <th>Comment</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var h in r.History
                            .OrderByDescending(h => h.ActionDate))
                        {
                            <tr>
                                <td>
                                    @(h.ActionDate.ToLocalTime()
                                        .ToString("d MMM yyyy HH:mm"))
                                </td>
                                <td>@h.Action</td>
                                <td>
                                    @(h.ActionedByEmployee.FirstName + " " +
                                      h.ActionedByEmployee.LastName)
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(h.Comment)
                                        ? "--"
                                        : h.Comment)
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    Nothing recorded yet.
                </p>
            }
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('form.js-carry').forEach(function (form) {
            form.addEventListener('submit', function () {
                var box = document.getElementById('comment');
                var hidden = form.querySelector('input[name="comment"]');

                if (box && hidden) {
                    hidden.value = box.value;
                }
            });
        });
    </script>
}
