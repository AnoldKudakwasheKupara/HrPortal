@model HrPortal.ViewModels.ReportViewModel<HrPortal.ViewModels.TrainingCourseReportRow>

@{ ViewData["Title"] = Model.Title; }

<div class="container-fluid">

    <partial name="_ReportHead"
             model="@((Model.Title, Model.Description, Model.Action, Model.Rows.Count))" />

    <partial name="_ReportStats" model="Model.Stats" />

    <partial name="_ReportFilters"
             model="@((Model.Filter, new[] { "inactive" }))" />

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Trainer</th>
                            <th>Training date</th>
                            <th class="num">Assigned</th>
                            <th class="num">Completed</th>
                            <th class="num">Overdue</th>
                            <th class="num">Completion</th>
                            <th class="num">Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">
                            No courses to report on.
                        </td></tr>
                    }
                    else
                    {
                        foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td><strong>@r.Course</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(r.Trainer) ? "--" : r.Trainer)</td>
                                <td>@(r.TrainingDate?.ToString("d MMM yyyy") ?? "--")</td>
                                <td class="num">@r.Assigned</td>
                                <td class="num">@r.Completed</td>
                                <td class="num">
                                    @if (r.Overdue > 0)
                                    {
                                        <span class="badge bg-danger">@r.Overdue</span>
                                    }
                                    else
                                    {
                                        <text>0</text>
                                    }
                                </td>
                                <td class="num">@r.CompletionRate.ToString("0.#")%</td>
                                <td class="num">
                                    @if (r.AverageRating.HasValue)
                                    {
                                        <text>@r.AverageRating.Value.ToString("0.00")</text>
                                        <span class="text-muted">(@r.Responses)</span>
                                    }
                                    else
                                    {
                                        <text>--</text>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
