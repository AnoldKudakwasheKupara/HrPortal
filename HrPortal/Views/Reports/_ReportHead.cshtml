@model (string Title, string Description, string Action, int RowCount, string Coverage, DateTime GeneratedAt)

<div class="page-head report-head">

    <div>
        <h2>@Model.Title</h2>
        <p class="text-muted mb-2">@Model.Description</p>

        <div class="report-meta">
            <span class="report-chip">
                <i class="fas fa-list-ul"></i>
                @Model.RowCount row@(Model.RowCount == 1 ? "" : "s")
            </span>

            @if (!string.IsNullOrWhiteSpace(Model.Coverage))
            {
                <span class="report-chip">
                    <i class="fas fa-calendar-day"></i>
                    @Model.Coverage
                </span>
            }

            <span class="report-chip">
                <i class="fas fa-clock"></i>
                Run @Model.GeneratedAt.ToString("d MMM yyyy HH:mm")
            </span>
        </div>
    </div>

    <div class="page-head-actions">

        <button type="button" class="btn btn-outline-secondary"
                onclick="window.print()">
            <i class="fas fa-print" aria-hidden="true"></i> Print
        </button>

        <a class="btn btn-outline-secondary"
           asp-action="@Model.Action"
           asp-all-route-data="@(Context.Request.Query
               .Where(q => q.Key != "export")
               .ToDictionary(q => q.Key, q => q.Value.ToString()))"
           asp-route-export="csv">
            <i class="fas fa-file-csv" aria-hidden="true"></i> Export CSV
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-chart-column" aria-hidden="true"></i> All reports
        </a>

    </div>

</div>
