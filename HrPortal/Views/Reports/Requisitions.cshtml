@using HrPortal.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model HrPortal.ViewModels.ReportViewModel<HrPortal.ViewModels.RequisitionReportRow>

@{
    ViewData["Title"] = Model.Title;

    var departments = ViewBag.Departments as List<SelectListItem>
        ?? new List<SelectListItem>();

    var vendors = ViewBag.Vendors as List<SelectListItem>
        ?? new List<SelectListItem>();

    string Label(RequisitionStatus s) => s switch
    {
        RequisitionStatus.Submitted => "Awaiting review",
        RequisitionStatus.ReviewApproved => "Awaiting MD",
        RequisitionStatus.ReturnedToRequester => "Returned",
        RequisitionStatus.ReviewRejected => "Rejected at review",
        RequisitionStatus.Rejected => "Rejected by MD",
        RequisitionStatus.Cancelled => "Withdrawn",
        _ => s.ToString()
    };
}

<div class="container-fluid">

    <partial name="_ReportHead"
             model="@((Model.Title, Model.Description, Model.Action, Model.Rows.Count, Model.Coverage, Model.GeneratedAt))" />

    <partial name="_ReportStats" model="Model.Stats" />

    <partial name="_ReportTrends" model="Model.Trends" />

    <partial name="_ReportBreakdowns" model="Model.Breakdowns" />

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">

                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" name="From" class="form-control"
                           value="@Model.Filter.From?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" name="To" class="form-control"
                           value="@Model.Filter.To?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Show</label>
                    <select name="Show" class="form-select">
                        <option value="">Everything</option>
                        <option value="awaiting"
                                selected="@(Model.Filter.Show == "awaiting")">
                            Awaiting a decision
                        </option>
                        <option value="approved"
                                selected="@(Model.Filter.Show == "approved")">
                            Approved only
                        </option>
                        <option value="declined"
                                selected="@(Model.Filter.Show == "declined")">
                            Declined only
                        </option>
                        <option value="overthreshold"
                                selected="@(Model.Filter.Show == "overthreshold")">
                            Needed MD approval
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="RequisitionStatus" class="form-select">
                        <option value="">All</option>
                        @foreach (var s in Enum.GetValues<RequisitionStatus>())
                        {
                            <option value="@s"
                                    selected="@(Model.Filter.RequisitionStatus == s)">
                                @Label(s)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Department</label>
                    <select name="DepartmentId" class="form-select">
                        <option value="">All</option>
                        @foreach (var dpt in departments)
                        {
                            <option value="@dpt.Value"
                                    selected="@(Model.Filter.DepartmentId?.ToString() == dpt.Value)">
                                @dpt.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Vendor</label>
                    <select name="VendorId" class="form-select">
                        <option value="">All</option>
                        @foreach (var v in vendors)
                        {
                            <option value="@v.Value"
                                    selected="@(Model.Filter.VendorId?.ToString() == v.Value)">
                                @v.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-secondary">
                        Apply
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Number</th>
                            <th>Raised by</th>
                            <th>What for</th>
                            <th class="num">Items</th>
                            <th class="num">Estimated</th>
                            <th>Route</th>
                            <th>Status</th>
                            <th class="num">Turnaround</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No requisitions match this filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <strong>@r.RequisitionNumber</strong>
                                    <div class="text-muted small">
                                        @r.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                                    </div>
                                </td>

                                <td>
                                    @r.RaisedBy
                                    <div class="text-muted small">@r.Department</div>
                                </td>

                                <td>
                                    @r.Title
                                    @if (!string.IsNullOrWhiteSpace(r.Vendor))
                                    {
                                        <div class="text-muted small">
                                            Suggested: @r.Vendor
                                        </div>
                                    }
                                </td>

                                <td class="num">@r.Lines</td>

                                <td class="num">
                                    @r.EstimatedTotal.ToString("N2")
                                </td>

                                <td>
                                    @if (r.RequiresMdApproval)
                                    {
                                        <span class="badge bg-info">MD</span>
                                    }
                                    else if (r.SubmittedAt != null)
                                    {
                                        <span class="badge bg-light text-dark">
                                            Review
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>
                                    @switch (r.Status)
                                    {
                                        case RequisitionStatus.Approved:
                                            <span class="badge bg-success">Approved</span>
                                            break;
                                        case RequisitionStatus.Rejected:
                                        case RequisitionStatus.ReviewRejected:
                                            <span class="badge bg-danger">
                                                @Label(r.Status)
                                            </span>
                                            break;
                                        case RequisitionStatus.Submitted:
                                        case RequisitionStatus.ReviewApproved:
                                        case RequisitionStatus.ReturnedToRequester:
                                            <span class="badge bg-warning text-dark">
                                                @Label(r.Status)
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">
                                                @Label(r.Status)
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="num">
                                    @(r.TurnaroundDays?.ToString("0.#") ?? "--")
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                    @if (Model.Rows.Any())
                    {
                        <tfoot>
                            <tr>
                                <th colspan="4" class="text-end">
                                    Total estimated, shown
                                </th>
                                <th class="num">
                                    @Model.Rows.Sum(r => r.EstimatedTotal).ToString("N2")
                                </th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    }

                </table>
            </div>
        </div>
    </div>

</div>
