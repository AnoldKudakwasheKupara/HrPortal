@model List<HrPortal.ViewModels.ReportBreakdown>

@*  A second cut of the same rows: ranked bars so the shape of the
    data is readable without reading every row.                 *@

@if (Model.Any())
{
    <div class="row g-3 mb-3">

        @foreach (var b in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@b.Title</span>
                        <span class="text-muted small">@b.Unit</span>
                    </div>

                    <div class="card-body">

                        <ul class="breakdown">

                        @foreach (var i in b.Items)
                        {
                            var pct = b.Max <= 0
                                ? 0
                                : (double)(i.Value / b.Max) * 100;

                            var share = b.Total <= 0
                                ? 0
                                : (double)(i.Value / b.Total) * 100;

                            <li class="breakdown-item">
                                <div class="breakdown-head">
                                    <span class="breakdown-label">@i.Label</span>
                                    <span class="breakdown-value">
                                        @i.Value.ToString("0.##")
                                    </span>
                                </div>
                                <div class="breakdown-track">
                                    <span class="breakdown-fill @(i.Tone is null ? "" : "is-" + i.Tone)"
                                          style="width:@pct.ToString("0.#")%"></span>
                                </div>
                                <span class="breakdown-share">
                                    @share.ToString("0.#")% of total
                                </span>
                            </li>
                        }

                        </ul>

                    </div>

                </div>

            </div>
        }

    </div>
}
