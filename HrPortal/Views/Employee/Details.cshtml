@model HrPortal.Entities.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>
                @Model.FirstName @Model.LastName
            </h2>

            <p class="text-muted">
                @Model.EmployeeNumber
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <span class="field-label">Employee Number</span>
                    <div class="field-value">@Model.EmployeeNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Department</span>
                    <div class="field-value">@Model.Department?.Name</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">First Name</span>
                    <div class="field-value">@Model.FirstName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Last Name</span>
                    <div class="field-value">@Model.LastName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Email</span>
                    <div class="field-value">@Model.Email</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Phone Number</span>
                    <div class="field-value">@Model.PhoneNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">National ID</span>
                    <div class="field-value">@Model.NationalId</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Date Joined</span>
                    <div class="field-value">
                        @Model.DateJoined.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Status</span>
                    <div class="field-value">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactive
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Login Account</span>
                    <div class="field-value">
                        @if (Model.User != null)
                        {
                            <span class="badge bg-success">
                                Created
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Not Created
                            </span>
                        }
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>