@model HrPortal.Entities.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>
                @Model.FirstName @Model.LastName
            </h2>

            <p class="text-muted">
                @Model.EmployeeNumber
            </p>
        </div>

        <div>
            @if (Model.User != null)
            {
                <a asp-action="ResetPassword"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">
                    Reset Password
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(Model.EmergencyContactName))
            {
                <a asp-action="NextOfKinForm"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-download" aria-hidden="true"></i>
                    Next of kin (PDF)
                </a>
            }

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <partial name="_DownloadPdf" model="@Model.Id" />

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <span class="field-label">Employee Number</span>
                    <div class="field-value">@Model.EmployeeNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Department</span>
                    <div class="field-value">@Model.Department?.Name</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Reports to</span>
                    <div class="field-value">
                        @if (Model.Supervisor != null)
                        {
                            <a asp-action="Details"
                               asp-route-id="@Model.Supervisor.Id">
                                @Model.Supervisor.FirstName
                                @Model.Supervisor.LastName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Nobody &mdash; requests go straight to HR
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">First Name</span>
                    <div class="field-value">@Model.FirstName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Last Name</span>
                    <div class="field-value">@Model.LastName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Employment</span>
                    <div class="field-value">
                        @Html.DisplayFor(m => m.EmploymentType)
                        @if (Model.ContractEndDate != null)
                        {
                            <span class="text-muted">
                                &mdash; ends
                                @Model.ContractEndDate.Value.ToString("d MMM yyyy")
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Status</span>
                    <div class="field-value">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Employed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Left@(Model.EndDate != null
                                    ? " " + Model.EndDate.Value.ToString("d MMM yyyy")
                                    : "")
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.LeavingReason))
                            {
                                <div class="text-muted small">
                                    @Model.LeavingReason
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Job Title</span>
                    <div class="field-value">
                        @(string.IsNullOrWhiteSpace(Model.JobTitle)
                            ? "Not recorded"
                            : Model.JobTitle)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Email</span>
                    <div class="field-value">@Model.Email</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Phone Number</span>
                    <div class="field-value">@Model.PhoneNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">National ID</span>
                    <div class="field-value">@Model.NationalId</div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Date Joined</span>
                    <div class="field-value">
                        @Model.DateJoined.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Status</span>
                    <div class="field-value">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactive
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Login Account</span>
                    <div class="field-value">
                        @if (Model.User != null)
                        {
                            <span class="badge bg-success">
                                Created
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Not Created
                            </span>
                        }
                    </div>
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mt-3">

        <div class="card-header">Personal details</div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4 mb-3">
                    <span class="field-label">Date of Birth</span>
                    <div class="field-value">
                        @(Model.DateOfBirth?.ToString("d MMM yyyy") ?? "Not recorded")
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <span class="field-label">Gender</span>
                    <div class="field-value">@Html.DisplayFor(m => m.Gender)</div>
                </div>

                <div class="col-md-4 mb-3">
                    <span class="field-label">Marital Status</span>
                    <div class="field-value">@Html.DisplayFor(m => m.MaritalStatus)</div>
                </div>

                <div class="col-12 mb-3">
                    <span class="field-label">Home Address</span>
                    <div class="field-value">
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "Not recorded"
                            : Model.Address)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Emergency Contact</span>
                    <div class="field-value">
                        @if (string.IsNullOrWhiteSpace(Model.EmergencyContactName))
                        {
                            <span class="text-muted">Not recorded</span>
                        }
                        else
                        {
                            @Model.EmergencyContactName
                            @if (!string.IsNullOrWhiteSpace(Model.EmergencyContactRelationship))
                            {
                                <span class="text-muted">
                                    (@Model.EmergencyContactRelationship)
                                </span>
                            }
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Emergency Contact Phone</span>
                    <div class="field-value">
                        @(string.IsNullOrWhiteSpace(Model.EmergencyContactPhone)
                            ? "Not recorded"
                            : Model.EmergencyContactPhone)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Emergency Contact Address</span>
                    <div class="field-value">
                        @(string.IsNullOrWhiteSpace(Model.EmergencyContactAddress)
                            ? "Same as the employee's"
                            : Model.EmergencyContactAddress)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <span class="field-label">Next Of Kin Confirmed</span>
                    <div class="field-value">
                        @if (Model.NextOfKinConfirmedAt == null)
                        {
                            <span class="badge bg-warning">
                                Not confirmed by the employee
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">Confirmed</span>
                            <span class="text-muted">
                                @(Model.NextOfKinConfirmedAt.Value.ToLocalTime()
                                    .ToString("d MMM yyyy HH:mm"))
                            </span>
                        }
                    </div>
                </div>

            </div>
        </div>

    </div>

</div>
