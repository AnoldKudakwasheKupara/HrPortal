@model HrPortal.Entities.Employee

@{
    ViewData["Title"] = "Delete Employee";

    var blockers = ViewBag.Blockers as List<string> ?? new List<string>();
    var removals = ViewBag.Removals as List<string> ?? new List<string>();
}

<div class="container">

    <div class="page-head-simple">

        <h2>Delete Employee</h2>

        <p class="text-muted">
            This employee record will be removed permanently.
        </p>

    </div>

    @if (blockers.Count > 0)
    {
        <div class="alert alert-danger">

            <p>
                <strong>This employee cannot be deleted.</strong>
                Their record is referenced by work that must be kept:
            </p>

            <ul class="mb-2">
                @foreach (var blocker in blockers)
                {
                    <li>@blocker</li>
                }
            </ul>

            <p class="mb-0">
                Open the employee and clear the <strong>Active</strong>
                tick instead. That stops them signing in and keeps the
                history intact.
            </p>

        </div>
    }
    else
    {
        <div class="alert alert-warning">

            <p>
                Are you sure you want to delete this employee?
                This cannot be undone.
            </p>

            @if (removals.Count > 0)
            {
                <p class="mb-2">
                    The following will be deleted with them:
                </p>

                <ul class="mb-2">
                    @foreach (var removal in removals)
                    {
                        <li>@removal</li>
                    }
                </ul>
            }

            <p class="mb-0">
                @if (Model.User != null)
                {
                    <text>
                        Their sign-in account will also be removed, and
                        any uploaded files deleted from the server.
                    </text>
                }
                else
                {
                    <text>
                        Any uploaded files will be deleted from the
                        server.
                    </text>
                }
            </p>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Employee Number</span>

                    <div class="field-value">
                        @Model.EmployeeNumber
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Name</span>

                    <div class="field-value">
                        @Model.FirstName @Model.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <div class="field-value">
                        @(Model.Department?.Name ?? "Not set")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Email</span>

                    <div class="field-value">
                        @Model.Email
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Sign-in Account</span>

                    <div class="field-value">
                        @(Model.User != null ? "Yes" : "No")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Status</span>

                    <div class="field-value">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-3 d-flex gap-2">

        @if (blockers.Count == 0)
        {
            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Delete Employee
                </button>

            </form>
        }

        <a asp-action="Index" class="btn btn-secondary">
            Back to Employees
        </a>

    </div>

</div>
