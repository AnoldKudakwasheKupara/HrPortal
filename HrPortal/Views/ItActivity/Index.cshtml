@using HrPortal.Entities
@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.ItActivity>

@{
    ViewData["Title"] = "IT Activity Log";

    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;

    var byCategory =
        ViewBag.ByCategory as Dictionary<ItActivityCategory, int>
        ?? new Dictionary<ItActivityCategory, int>();

    string Badge(ItActivityStatus s) => s switch
    {
        ItActivityStatus.Resolved => "bg-success",
        ItActivityStatus.InProgress => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    string Label(ItActivityStatus s) => s switch
    {
        ItActivityStatus.InProgress => "In progress",
        _ => s.ToString()
    };
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>IT Activity Log</h2>
            <p class="text-muted mb-0">
                Requests, incidents and tasks as they happen. This is
                what the weekly status report is built from.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Log Activity</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-stats">

        <div class="report-stat">
            <span class="report-stat-label">Logged this period</span>
            <span class="report-stat-value">@ViewBag.InPeriod</span>
            <span class="report-stat-note">
                @from.ToString("d MMM") &ndash; @to.ToString("d MMM yyyy")
            </span>
        </div>

        <a class="report-stat @(((int)ViewBag.Outstanding) > 0 ? "is-warning" : "")"
           asp-action="Index"
           asp-route-from="@from.ToString("yyyy-MM-dd")"
           asp-route-to="@to.ToString("yyyy-MM-dd")"
           asp-route-status="@ItActivityStatus.Open">
            <span class="report-stat-label">Still outstanding</span>
            <span class="report-stat-value">@ViewBag.Outstanding</span>
            <span class="report-stat-note">Across all periods</span>
        </a>

        <div class="report-stat @(((int)ViewBag.HardwareInPeriod) > 0 ? "is-critical" : "is-good")">
            <span class="report-stat-label">Hardware faults</span>
            <span class="report-stat-value">@ViewBag.HardwareInPeriod</span>
            <span class="report-stat-note">
                @(((int)ViewBag.HardwareInPeriod) == 0
                    ? "None reported this period"
                    : "Reported this period")
            </span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">Flagged notable</span>
            <span class="report-stat-value">@ViewBag.NotableInPeriod</span>
            <span class="report-stat-note">Named in the report</span>
        </div>

    </div>

    @if (byCategory.Any())
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">This period by category</div>
            <div class="card-body">
                <div class="breakdown">
                    @foreach (var pair in byCategory)
                    {
                        <a class="report-chip"
                           asp-action="Index"
                           asp-route-from="@from.ToString("yyyy-MM-dd")"
                           asp-route-to="@to.ToString("yyyy-MM-dd")"
                           asp-route-category="@pair.Key">
                            @pair.Key <strong>@pair.Value</strong>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">

                <div class="col-md-3">
                    <label class="form-label">From</label>
                    <input type="date" name="from" class="form-control"
                           value="@from.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">To</label>
                    <input type="date" name="to" class="form-control"
                           value="@to.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        <option value="">All</option>
                        @foreach (var c in Enum.GetValues<ItActivityCategory>())
                        {
                            <option value="@c"
                                    selected="@(ViewBag.CategoryFilter as ItActivityCategory? == c)">
                                @c
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All</option>
                        @foreach (var s in Enum.GetValues<ItActivityStatus>())
                        {
                            <option value="@s"
                                    selected="@(ViewBag.StatusFilter as ItActivityStatus? == s)">
                                @Label(s)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">
                        Filter
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>What came up</th>
                            <th>Raised by</th>
                            <th>Machine</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Nothing logged for this period yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var a in Model.Items)
                        {
                            <tr>
                                <td>@a.LoggedOn.ToString("ddd d MMM")</td>

                                <td>@a.Category</td>

                                <td>
                                    <strong>@a.Summary</strong>
                                    @if (a.IsNotable)
                                    {
                                        <span class="badge bg-info">Notable</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.ActionTaken))
                                    {
                                        <div class="text-muted small">
                                            @a.ActionTaken
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (a.RaisedByEmployee != null)
                                    {
                                        @(a.RaisedByEmployee.FirstName + " " +
                                          a.RaisedByEmployee.LastName)
                                    }
                                    else if (!string.IsNullOrWhiteSpace(a.RaisedByOther))
                                    {
                                        @a.RaisedByOther
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>

                                <td>
                                    @if (a.Asset != null)
                                    {
                                        <a asp-controller="Asset" asp-action="Details"
                                           asp-route-id="@a.AssetId">
                                            @a.Asset.DeviceModel
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @Badge(a.Status)">
                                        @Label(a.Status)
                                    </span>
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        @if (a.Status != ItActivityStatus.Resolved)
                                        {
                                            <form asp-action="Resolve"
                                                  asp-route-id="@a.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Resolve
                                                </button>
                                            </form>
                                        }
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Edit" asp-route-id="@a.Id">
                                            Edit
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-action="Delete" asp-route-id="@a.Id">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>

            @{ var pager = HrPortal.ViewModels.PagerViewModel.From(Context.Request, Model, "activities"); }
            <partial name="_Pager" model="pager" />

        </div>
    </div>

</div>
