@using HrPortal.Entities
@using HrPortal.ViewModels
@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.ItActivity>

@{
    ViewData["Title"] = "IT Activity Log";

    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
    var outstanding = (int)ViewBag.Outstanding;
    var hardware = (int)ViewBag.HardwareInPeriod;
    var categoryFilter = ViewBag.CategoryFilter as ItActivityCategory?;
    var statusFilter = ViewBag.StatusFilter as ItActivityStatus?;

    var byCategory = ViewBag.ByCategory as Dictionary<ItActivityCategory, int> ?? new Dictionary<ItActivityCategory, int>();

    string Badge(ItActivityStatus s) => s switch
    {
        ItActivityStatus.Resolved => "badge-green",
        ItActivityStatus.InProgress => "badge-amber",
        _ => "badge-gray"
    };

    string Label(ItActivityStatus s) => s switch
    {
        ItActivityStatus.InProgress => "In progress",
        _ => s.ToString()
    };
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>IT Activity Log</h2>
            <p>Requests, incidents and tasks as they happen. This is what the weekly status report is built from.</p>
        </div>

        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-plus" aria-hidden="true"></i> Log Activity
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-headset"></i></span>
            <div>
                <div class="kpi-label">Logged This Period</div>
                <div class="kpi-value">@ViewBag.InPeriod</div>
                <div class="kpi-note">@from.ToString("d MMM") &ndash; @to.ToString("d MMM yyyy")</div>
            </div>
        </div>

        <a class="kpi text-decoration-none"
           asp-action="Index"
           asp-route-from="@from.ToString("yyyy-MM-dd")"
           asp-route-to="@to.ToString("yyyy-MM-dd")"
           asp-route-status="@ItActivityStatus.Open">
            <span class="kpi-icon @(outstanding > 0 ? "is-amber" : "is-green")" aria-hidden="true"><i class="fas fa-hourglass-half"></i></span>
            <div>
                <div class="kpi-label">Still Outstanding</div>
                <div class="kpi-value">@outstanding</div>
                <div class="kpi-note">Across all periods</div>
            </div>
        </a>

        <div class="kpi">
            <span class="kpi-icon @(hardware > 0 ? "is-red" : "is-green")" aria-hidden="true"><i class="fas fa-microchip"></i></span>
            <div>
                <div class="kpi-label">Hardware Faults</div>
                <div class="kpi-value">@hardware</div>
                <div class="kpi-note">@(hardware == 0 ? "None reported this period" : "Reported this period")</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-star"></i></span>
            <div>
                <div class="kpi-label">Flagged Notable</div>
                <div class="kpi-value">@ViewBag.NotableInPeriod</div>
                <div class="kpi-note">Named in the report</div>
            </div>
        </div>

    </div>

    <form method="get" class="filter-bar" data-auto-submit>

        <div>
            <label for="it-from" class="form-label">From</label>
            <input id="it-from" type="date" name="from" class="form-control" value="@from.ToString("yyyy-MM-dd")" />
        </div>

        <div>
            <label for="it-to" class="form-label">To</label>
            <input id="it-to" type="date" name="to" class="form-control" value="@to.ToString("yyyy-MM-dd")" />
        </div>

        <div>
            <label for="it-category" class="form-label">Category</label>
            <select id="it-category" name="category" class="form-select">
                <option value="">All categories</option>
                @foreach (var c in Enum.GetValues<ItActivityCategory>())
                {
                    <option value="@c" selected="@(categoryFilter == c)">@c</option>
                }
            </select>
        </div>

        <div>
            <label for="it-status" class="form-label">Status</label>
            <select id="it-status" name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<ItActivityStatus>())
                {
                    <option value="@s" selected="@(statusFilter == s)">@Label(s)</option>
                }
            </select>
        </div>

        <div class="filter-bar-actions">
            <noscript>
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </noscript>
            <a class="btn btn-outline-primary text-nowrap" asp-action="Index">
                <i class="fas fa-filter-circle-xmark" aria-hidden="true"></i> Reset
            </a>
        </div>

    </form>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-headset" aria-hidden="true"></i> Activity
            <span class="tab-count">@Model.TotalCount</span>
        </h3>

        @if (byCategory.Any())
        {
            <div class="breakdown mb-3">
                @foreach (var pair in byCategory)
                {
                    <a class="report-chip"
                       asp-action="Index"
                       asp-route-from="@from.ToString("yyyy-MM-dd")"
                       asp-route-to="@to.ToString("yyyy-MM-dd")"
                       asp-route-category="@pair.Key">
                        @pair.Key <strong>@pair.Value</strong>
                    </a>
                }
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-headset" aria-hidden="true"></i>
                <p>Nothing logged for this period yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>What Came Up</th>
                            <th>Raised By</th>
                            <th>Machine</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var a in Model.Items)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <div>@a.LoggedOn.ToString("ddd d MMM")</div>
                                    <div class="small text-muted">@a.Category</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        @a.Summary
                                        @if (a.IsNotable)
                                        {
                                            <span class="status-badge badge-blue ms-1">Notable</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(a.ActionTaken))
                                    {
                                        <div class="small text-muted">@a.ActionTaken</div>
                                    }
                                </td>
                                <td>
                                    @if (a.RaisedByEmployee != null)
                                    {
                                        @(a.RaisedByEmployee.FirstName + " " + a.RaisedByEmployee.LastName)
                                    }
                                    else if (!string.IsNullOrWhiteSpace(a.RaisedByOther))
                                    {
                                        @a.RaisedByOther
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (a.Asset != null)
                                    {
                                        <a asp-controller="Asset" asp-action="Details" asp-route-id="@a.AssetId">@a.Asset.DeviceModel</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="status-badge @Badge(a.Status)">@Label(a.Status)</span></td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        @if (a.Status != ItActivityStatus.Resolved)
                                        {
                                            <form asp-action="Resolve" asp-route-id="@a.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">
                                                    <i class="fas fa-check" aria-hidden="true"></i> Resolve
                                                </button>
                                            </form>
                                        }
                                        <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@a.Id" title="Edit">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                                            <span class="visually-hidden">Edit @a.Summary</span>
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id" title="Delete">
                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                            <span class="visually-hidden">Delete @a.Summary</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(Model, "activity", "activities")' />
        }

    </section>

</div>

