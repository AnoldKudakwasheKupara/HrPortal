@model HrPortal.ViewModels.ItActivityCreateViewModel

@{ ViewData["Title"] = "Log Activity"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Log Activity</h2>
        <p class="text-muted">
            One request, incident or task. Log it the same day and the
            weekly report writes most of itself.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_ItActivityFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="submit" name="saveAndNew" value="true"
                            class="btn btn-outline-primary">
                        Save and log another
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
