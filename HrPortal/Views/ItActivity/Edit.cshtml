@model HrPortal.ViewModels.ItActivityEditViewModel

@{ ViewData["Title"] = "Edit Activity"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Edit Activity</h2>
        <p class="text-muted">
            @if (!string.IsNullOrWhiteSpace(Model.LoggedBy))
            {
                <text>Originally logged by @Model.LoggedBy.</text>
            }
            else
            {
                <text>Correct the record of what came up and what was done.</text>
            }
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="LoggedBy" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_ItActivityFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
