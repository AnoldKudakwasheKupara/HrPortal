@model HrPortal.ViewModels.FundMarketDataViewModel

@{
    ViewData["Title"] = "Rates and market returns";
    var latestRate = Model.Rates.OrderByDescending(r => r.Month).FirstOrDefault();
    var latestQuarter = Model.Quarters.OrderByDescending(q => q.Year).ThenByDescending(q => q.Quarter).FirstOrDefault();
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Rates and Market Returns</h2>
            <p>The same for every fund. A quarter with a missing rate does not calculate: a rate is never assumed.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-money-bill-transfer"></i></span>
            <div>
                <div class="kpi-label">Latest Rate</div>
                @if (latestRate == null)
                {
                    <div class="kpi-value kpi-value-text text-muted">None yet</div>
                }
                else
                {
                    <div class="kpi-value kpi-value-text">@latestRate.ZwgPerUsd</div>
                    <div class="kpi-note">ZWG per USD, @latestRate.Month.ToString("MMM yyyy")</div>
                }
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-calendar"></i></span>
            <div>
                <div class="kpi-label">Months Recorded</div>
                <div class="kpi-value">@Model.Rates.Count()</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-chart-line"></i></span>
            <div>
                <div class="kpi-label">Quarters Recorded</div>
                <div class="kpi-value">@Model.Quarters.Count()</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-calendar-check"></i></span>
            <div>
                <div class="kpi-label">Latest Quarter</div>
                <div class="kpi-value kpi-value-text @(latestQuarter == null ? "text-muted" : "")">
                    @(latestQuarter == null ? "None yet" : $"Q{latestQuarter.Quarter} {latestQuarter.Year}")
                </div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-3">

        <h3 class="panel-head">
            <i class="fas fa-money-bill-transfer" aria-hidden="true"></i> Official Exchange Rate, ZWG per 1 USD at Month-end
        </h3>

        <form asp-action="SaveRate" method="post" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label for="month" class="form-label">Month</label>
                <input id="month" name="month" type="month" class="form-control" required />
            </div>
            <div class="col-auto">
                <label for="rate" class="form-label">Rate</label>
                <input id="rate" name="rate" type="number" step="any" min="0" class="form-control" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-gold">
                    <i class="fas fa-floppy-disk" aria-hidden="true"></i> Save
                </button>
            </div>
        </form>

        @if (!Model.Rates.Any())
        {
            <p class="text-muted mb-0">No rates recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Month</th><th class="num">ZWG per USD</th></tr></thead>
                    <tbody>
                        @foreach (var rate in Model.Rates)
                        {
                            <tr><td>@rate.Month.ToString("MMM yyyy")</td><td class="num">@rate.ZwgPerUsd</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </section>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-chart-line" aria-hidden="true"></i> Market Returns for the Quarter, in Percentages
        </h3>

        <form asp-action="SaveMarketQuarter" method="post" class="row g-2 align-items-end mb-3">
            <div class="col-auto"><label for="Year" class="form-label">Year</label><input id="Year" name="Year" type="number" min="2000" max="2100" class="form-control" required /></div>
            <div class="col-auto">
                <label for="Quarter" class="form-label">Quarter</label>
                <select id="Quarter" name="Quarter" class="form-select">
                    <option>1</option><option>2</option><option>3</option><option>4</option>
                </select>
            </div>
            <div class="col-auto"><label for="Cash" class="form-label">Cash</label><input id="Cash" name="Cash" type="number" step="any" class="form-control" required /></div>
            <div class="col-auto"><label for="MoneyMarket" class="form-label">Money market</label><input id="MoneyMarket" name="MoneyMarket" type="number" step="any" class="form-control" required /></div>
            <div class="col-auto"><label for="Bonds" class="form-label">Bonds</label><input id="Bonds" name="Bonds" type="number" step="any" class="form-control" required /></div>
            <div class="col-auto"><label for="ZseAllShareUsd" class="form-label">ZSE All Share, USD</label><input id="ZseAllShareUsd" name="ZseAllShareUsd" type="number" step="any" class="form-control" required /></div>
            <div class="col-auto"><label for="VfexAllShare" class="form-label">VFEX All Share</label><input id="VfexAllShare" name="VfexAllShare" type="number" step="any" class="form-control" required /></div>
            <div class="col-auto"><label for="UsdInflation" class="form-label">USD inflation</label><input id="UsdInflation" name="UsdInflation" type="number" step="any" class="form-control" required /></div>
            <div class="col-auto">
                <button type="submit" class="btn btn-gold">
                    <i class="fas fa-floppy-disk" aria-hidden="true"></i> Save
                </button>
            </div>
        </form>

        @if (!Model.Quarters.Any())
        {
            <p class="text-muted mb-0">No quarters recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Quarter</th><th class="num">Cash</th><th class="num">Money Market</th><th class="num">Bonds</th><th class="num">ZSE, USD</th><th class="num">VFEX</th><th class="num">USD Inflation</th></tr></thead>
                    <tbody>
                        @foreach (var market in Model.Quarters)
                        {
                            <tr>
                                <td class="fw-semibold">Q@(market.Quarter) @market.Year</td>
                                <td class="num">@market.Cash.ToString("P2")</td>
                                <td class="num">@market.MoneyMarket.ToString("P2")</td>
                                <td class="num">@market.Bonds.ToString("P2")</td>
                                <td class="num">@market.ZseAllShareUsd.ToString("P2")</td>
                                <td class="num">@market.VfexAllShare.ToString("P2")</td>
                                <td class="num">@market.UsdInflation.ToString("P2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </section>

</div>
