@model List<HrPortal.Entities.PensionFund>

@{
    ViewData["Title"] = "Pension funds";
    var labels = (int)ViewBag.LabelsToDecide;
    var securities = (int)ViewBag.SecuritiesToConfirm;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Pension Funds</h2>
            <p>Load each fund's statements, clear the checks, and read its quarter.</p>
        </div>

        <div class="head-actions">
            <a asp-action="Review" class="btn btn-outline-secondary">
                <i class="fas fa-tags" aria-hidden="true"></i> Classifications
            </a>
            <a asp-action="MarketData" class="btn btn-outline-secondary">
                <i class="fas fa-chart-line" aria-hidden="true"></i> Rates and market returns
            </a>
        </div>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (labels > 0 || securities > 0)
    {
        <div class="alert alert-warning d-flex justify-content-between flex-wrap gap-2 align-items-center">
            <span>Waiting for a decision: @labels statement label(s) and @securities security(ies). Quarters using them stay blocked.</span>
            <a asp-action="Review" class="btn btn-sm btn-gold">Decide them</a>
        </div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-building-columns"></i></span>
            <div>
                <div class="kpi-label">Funds</div>
                <div class="kpi-value">@Model.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-wallet"></i></span>
            <div>
                <div class="kpi-label">Accounts</div>
                <div class="kpi-value">@Model.Sum(f => f.Accounts.Count)</div>
            </div>
        </div>

        <a class="kpi text-decoration-none" asp-action="Review">
            <span class="kpi-icon @(labels > 0 ? "is-amber" : "is-green")" aria-hidden="true"><i class="fas fa-tags"></i></span>
            <div>
                <div class="kpi-label">Labels to Decide</div>
                <div class="kpi-value">@labels</div>
            </div>
        </a>

        <a class="kpi text-decoration-none" asp-action="Review">
            <span class="kpi-icon @(securities > 0 ? "is-amber" : "is-green")" aria-hidden="true"><i class="fas fa-shield-halved"></i></span>
            <div>
                <div class="kpi-label">Securities to Confirm</div>
                <div class="kpi-value">@securities</div>
            </div>
        </a>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-4">

                <h3 class="panel-head">
                    <i class="fas fa-building-columns" aria-hidden="true"></i> Funds
                    <span class="tab-count">@Model.Count</span>
                </h3>

                @if (Model.Count == 0)
                {
                    <div class="list-empty mb-0">
                        <i class="fas fa-building-columns" aria-hidden="true"></i>
                        <p>No funds yet. Add the first one alongside.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr><th>Fund</th><th class="num">Accounts</th><th class="text-end">Actions</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var fund in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@fund.Name</td>
                                        <td class="num">@fund.Accounts.Count</td>
                                        <td>
                                            <div class="table-actions justify-content-end">
                                                <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Fund" asp-route-id="@fund.Id">
                                                    <i class="fas fa-eye" aria-hidden="true"></i> Open
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-4">

                <h3 class="panel-head">
                    <i class="fas fa-plus" aria-hidden="true"></i> Add a Fund
                </h3>

                <form asp-action="CreateFund" method="post">
                    <label for="name" class="form-label">Fund name</label>
                    <input id="name" name="name" class="form-control mb-3" maxlength="200" required />
                    <div class="d-grid">
                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-plus" aria-hidden="true"></i> Add
                        </button>
                    </div>
                </form>

            </section>

        </div>

    </div>

</div>
