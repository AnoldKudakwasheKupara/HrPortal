@using HrPortal.Services.FundReporting
@model HrPortal.ViewModels.FundQuarterViewModel

@{
    ViewData["Title"] = $"{Model.Fund.Name}: {Model.Quarter.Label}";
    var report = Model.Report;
    var blocks = Model.Findings.Where(f => f.Severity == FundFindingSeverity.Block).ToList();
    var checks = Model.Findings.Where(f => f.Severity == FundFindingSeverity.Check).ToList();

    string Money(decimal value) => value.ToString("N0");
    string Pct(decimal? value) => value == null ? "n/m" : value.Value.ToString("P2");
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Fund.Name: @Model.Quarter.Label</h2>
            <p>Values in USD unless stated.</p>
        </div>

        <div class="head-actions">
            @if (report != null)
            {
                <span class="status-badge badge-green">Ready</span>
            }
            else
            {
                <span class="status-badge badge-red">Not ready</span>
            }
            <a asp-action="Fund" asp-route-id="@Model.Fund.Id" class="btn btn-outline-secondary">Back</a>
        </div>

    </div>

    @if (blocks.Count > 0)
    {
        <section class="panel-card mb-3">

            <div class="panel-head-split">
                <h3 class="panel-head">
                    <i class="fas fa-ban text-danger" aria-hidden="true"></i> Must Be Fixed First
                    <span class="tab-count">@blocks.Count</span>
                </h3>
                <div class="table-actions">
                    <a asp-action="Review" class="btn btn-sm btn-gold">Classifications</a>
                    <a asp-action="MarketData" class="btn btn-sm btn-outline-secondary">Rates and market returns</a>
                </div>
            </div>

            <p class="small text-muted">No figures are shown until these are clear.</p>

            <partial name="_FundFindings" model="blocks" />

        </section>
    }

    @if (checks.Count > 0)
    {
        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i> Worth a Look
                <span class="tab-count">@checks.Count</span>
            </h3>

            <partial name="_FundFindings" model="checks" />

        </section>
    }

    @if (report != null)
    {
        <div class="kpis">

            <div class="kpi">
                <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-sack-dollar"></i></span>
                <div>
                    <div class="kpi-label">Fund Value</div>
                    <div class="kpi-value kpi-value-text">US$@Money(report.FundValue)</div>
                </div>
            </div>

            <div class="kpi">
                <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-chart-line"></i></span>
                <div>
                    <div class="kpi-label">Quarter Return</div>
                    <div class="kpi-value kpi-value-text">@Pct(report.FundReturn)</div>
                </div>
            </div>

            <div class="kpi">
                <span class="kpi-icon @(report.PrescribedShortfall > 0 ? "is-red" : "is-green")" aria-hidden="true"><i class="fas fa-shield-halved"></i></span>
                <div>
                    <div class="kpi-label">Prescribed Assets</div>
                    <div class="kpi-value kpi-value-text">@Pct(report.PrescribedShare)</div>
                    <div class="kpi-note @(report.PrescribedShortfall > 0 ? "is-alert" : "")">
                        @(report.PrescribedShortfall > 0 ? "Below the minimum" : "Minimum met")
                    </div>
                </div>
            </div>

            <div class="kpi">
                <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-arrow-trend-up"></i></span>
                <div>
                    <div class="kpi-label">Over USD Inflation</div>
                    <div class="kpi-value kpi-value-text">@Pct(report.ExcessOverInflation)</div>
                </div>
            </div>

        </div>

        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-chart-pie" aria-hidden="true"></i> Asset Allocation
            </h3>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Asset Class</th><th class="num">USD</th><th class="num">ZWG</th><th class="num">Weight</th><th class="num">Last Quarter</th><th class="num">Change</th><th class="num">Change %</th></tr></thead>
                    <tbody>
                        @foreach (var line in report.Allocation)
                        {
                            <tr><td class="fw-semibold">@line.Name</td><td class="num">@Money(line.Usd)</td><td class="num">@Money(line.Zwg)</td><td class="num">@Pct(line.Weight)</td><td class="num">@Money(line.LastQuarterUsd)</td><td class="num">@Money(line.Change)</td><td class="num">@Pct(line.ChangePercent)</td></tr>
                        }
                    </tbody>
                </table>
            </div>

        </section>

        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-right-left" aria-hidden="true"></i> Asset Manager Movements
            </h3>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Manager</th><th class="num">Opening</th><th class="num">Net Contributions</th><th class="num">Investment Gain</th><th class="num">Closing</th></tr></thead>
                    <tbody>
                        @foreach (var line in report.Movements)
                        {
                            <tr><td class="fw-semibold">@line.Manager</td><td class="num">@Money(line.Opening)</td><td class="num">@Money(line.NetContributions)</td><td class="num">@Money(line.Gain)</td><td class="num">@Money(line.Closing)</td></tr>
                        }
                    </tbody>
                </table>
            </div>

        </section>

        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-bullseye" aria-hidden="true"></i> Performance Against Benchmark
            </h3>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Period</th><th class="num">Fund</th><th class="num">Benchmark</th><th class="num">Variance</th></tr></thead>
                    <tbody>
                        @foreach (var line in report.Performance)
                        {
                            <tr><td class="fw-semibold">@line.Period</td><td class="num">@Pct(line.FundReturn)</td><td class="num">@Pct(line.Benchmark)</td><td class="num">@Pct(line.Variance)</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="small text-muted mt-3 mb-0">
                n/m means an earlier quarter has not passed its checks, or its market returns or the policy are missing.
                Excess over USD inflation this quarter: @Pct(report.ExcessOverInflation).
                ZWG flows are converted at the month-end rate of the month they happened in.
            </p>

        </section>

        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-users-gear" aria-hidden="true"></i> Returns by Manager and Account
            </h3>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Name</th><th class="num">Opening</th><th class="num">Closing</th><th class="num">Return</th><th class="num">Contribution</th></tr></thead>
                    <tbody>
                        @foreach (var line in report.Managers)
                        {
                            <tr class="fw-semibold"><td>@line.Name</td><td class="num">@Money(line.Opening)</td><td class="num">@Money(line.Closing)</td><td class="num">@Pct(line.Return)</td><td class="num">@Pct(line.Contribution)</td></tr>
                        }
                        <tr><td colspan="4">Difference between contributions and the fund return (from flows in the quarter)</td><td class="num">@Pct(report.ContributionDifference)</td></tr>
                        @foreach (var line in report.SubFunds)
                        {
                            <tr><td>Sub-fund @line.Name</td><td class="num">@Money(line.Opening)</td><td class="num">@Money(line.Closing)</td><td class="num">@Pct(line.Return)</td><td></td></tr>
                        }
                        @foreach (var line in report.Accounts)
                        {
                            <tr class="text-muted"><td>@line.Name</td><td class="num">@Money(line.Opening)</td><td class="num">@Money(line.Closing)</td><td class="num">@Pct(line.Return)</td><td></td></tr>
                        }
                    </tbody>
                </table>
            </div>

        </section>

        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-scale-balanced" aria-hidden="true"></i> Compliance: Prescribed Assets and Policy
            </h3>

            <p>
                Prescribed assets are US$@Money(report.PrescribedValue), @Pct(report.PrescribedShare) of the fund.
                @if (report.PrescribedShortfall > 0)
                {
                    <strong class="text-danger">Short of the minimum by US$@Money(report.PrescribedShortfall).</strong>
                }
                else
                {
                    <span>The minimum is met.</span>
                }
            </p>

            @if (report.Policy.Count == 0)
            {
                <p class="text-muted mb-0">This fund has no policy entered yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Asset Class</th><th class="num">Weight</th><th class="num">Target</th><th class="num">Corridor</th><th class="num">IPEC Limit</th><th>Position</th></tr></thead>
                        <tbody>
                            @foreach (var line in report.Policy)
                            {
                                <tr><td class="fw-semibold">@line.Name</td><td class="num">@Pct(line.Weight)</td><td class="num">@Pct(line.Target)</td><td class="num">@Pct(line.Low) to @Pct(line.High)</td><td class="num">@(line.IpecLimit == null ? "" : Pct(line.IpecLimit))</td><td>@line.Position</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </section>

        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-ranking-star" aria-hidden="true"></i> Largest Exposures
            </h3>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Security</th><th class="num">USD</th><th class="num">Weight</th><th></th></tr></thead>
                    <tbody>
                        <tr><td colspan="4" class="fw-semibold">Listed equities</td></tr>
                        @foreach (var line in report.TopEquities)
                        {
                            <tr>
                                <td>@line.Name</td>
                                <td class="num">@Money(line.Usd)</td>
                                <td class="num">@Pct(line.Weight)</td>
                                <td>
                                    @if (line.Flagged)
                                    {
                                        <span class="status-badge badge-amber">Above the @line.Limit.ToString("P0") guide</span>
                                    }
                                </td>
                            </tr>
                        }
                        <tr><td colspan="4" class="fw-semibold">Fixed income</td></tr>
                        @foreach (var line in report.TopFixedIncome)
                        {
                            <tr><td>@line.Name</td><td class="num">@Money(line.Usd)</td><td class="num">@Pct(line.Weight)</td><td></td></tr>
                        }
                    </tbody>
                </table>
            </div>

        </section>

        @if (report.PriceWarnings.Count > 0)
        {
            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i> Managers Pricing the Same Security Differently
                    <span class="tab-count">@report.PriceWarnings.Count</span>
                </h3>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Security</th><th class="num">Lowest</th><th class="num">Highest</th><th class="num">Difference</th></tr></thead>
                        <tbody>
                            @foreach (var line in report.PriceWarnings)
                            {
                                <tr><td class="fw-semibold">@line.Name</td><td class="num">@line.Currency @line.Lowest.ToString("N4")</td><td class="num">@line.Currency @line.Highest.ToString("N4")</td><td class="num">@Pct(line.Dispersion)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

            </section>
        }

        <div class="row g-3 mb-4">

            <div class="col-lg-7">

                <section class="panel-card h-100">

                    <h3 class="panel-head">
                        <i class="fas fa-dollar-sign" aria-hidden="true"></i> Holdings in USD Accounts, by Manager
                    </h3>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Manager</th><th class="num">USD</th><th class="num">Share of Fund</th></tr></thead>
                            <tbody>
                                @foreach (var line in report.PureUsd)
                                {
                                    <tr><td class="fw-semibold">@line.Name</td><td class="num">@Money(line.Usd)</td><td class="num">@Pct(line.Weight)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </section>

            </div>

            <div class="col-lg-5">

                <section class="panel-card h-100">

                    <h3 class="panel-head">
                        <i class="fas fa-money-bill-transfer" aria-hidden="true"></i> Exchange-rate Scenario
                    </h3>

                    <form method="get">
                        <input type="hidden" name="id" value="@Model.Fund.Id" />
                        <input type="hidden" name="year" value="@Model.Quarter.Year" />
                        <input type="hidden" name="number" value="@Model.Quarter.Number" />
                        <label for="scenarioRate" class="form-label">ZWG per USD (actual @report.RateAtEnd)</label>
                        <input id="scenarioRate" name="scenarioRate" type="number" step="any" min="0" class="form-control mb-3" value="@Model.ScenarioRate" />
                        <div class="d-grid">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="fas fa-calculator" aria-hidden="true"></i> Work it out
                            </button>
                        </div>
                    </form>

                    @if (report.Scenario != null)
                    {
                        <p class="mt-3 mb-0">
                            At @report.Scenario.Rate the fund would be worth US$@Money(report.Scenario.ScenarioValue), a loss of US$@Money(report.Scenario.Loss).
                        </p>
                    }

                </section>

            </div>

        </div>
    }

</div>
