@model List<HrPortal.Services.FundReporting.FundFinding>

<div class="table-responsive">
    <table class="table mb-0">
        <thead>
            <tr><th>Check</th><th>Month</th><th>Where</th><th>What was found</th></tr>
        </thead>
        <tbody>
            @foreach (var finding in Model)
            {
                <tr>
                    <td class="text-nowrap">@finding.Check</td>
                    <td class="text-nowrap">@finding.Month?.ToString("MMM yyyy")</td>
                    <td>@finding.Where</td>
                    <td>@finding.Message</td>
                </tr>
            }
        </tbody>
    </table>
</div>
