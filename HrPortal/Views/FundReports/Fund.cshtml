@using HrPortal.Entities
@using HrPortal.Services.FundReporting
@model HrPortal.ViewModels.FundPageViewModel

@{
    ViewData["Title"] = Model.Fund.Name;
    var classes = FundAssetClasses.Each.ToList();
    string Percent(decimal? value) => value == null ? "" : (value.Value * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Fund.Name</h2>
            <p>Statements, accounts, investment policy and quarters for this fund.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-calendar-check"></i></span>
            <div>
                <div class="kpi-label">Quarters</div>
                <div class="kpi-value">@Model.Quarters.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-wallet"></i></span>
            <div>
                <div class="kpi-label">Accounts</div>
                <div class="kpi-value">@Model.Fund.Accounts.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-bullseye"></i></span>
            <div>
                <div class="kpi-label">Policy Lines Set</div>
                <div class="kpi-value">@Model.Fund.PolicyLines.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-file-csv"></i></span>
            <div>
                <div class="kpi-label">Files Loaded</div>
                <div class="kpi-value">@Model.Imports.Count</div>
            </div>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-wallet" aria-hidden="true"></i> Accounts
                    <span class="tab-count">@Model.Fund.Accounts.Count</span>
                </h3>

                @if (Model.Fund.Accounts.Count == 0)
                {
                    <p class="text-muted mb-0">Accounts appear when statements are loaded.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr><th>Manager</th><th>Account</th><th>Sub-fund</th><th>Closed From</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var account in Model.Fund.Accounts.OrderBy(a => a.Manager).ThenBy(a => a.AccountNumber))
                                {
                                    <tr>
                                        <td class="fw-semibold">@account.Manager</td>
                                        <td>@account.AccountNumber</td>
                                        <td>@account.SubFund</td>
                                        <td>
                                            <form asp-action="CloseAccount" method="post" class="d-flex gap-2">
                                                <input type="hidden" name="accountId" value="@account.Id" />
                                                <input type="month" name="month" class="form-control form-control-sm" style="max-width: 11rem"
                                                       aria-label="Closed from month for @account.AccountNumber"
                                                       value="@account.ClosedFromMonth?.ToString("yyyy-MM")" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bullseye" aria-hidden="true"></i> Investment Policy (Percentages)
                </h3>

                <form asp-action="SavePolicy" asp-route-id="@Model.Fund.Id" method="post">

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Asset Class</th><th>Target</th><th>Corridor Low</th><th>Corridor High</th><th>IPEC Limit</th></tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < classes.Count; i++)
                                {
                                    var line = Model.Fund.PolicyLines.FirstOrDefault(l => l.AssetClass == classes[i]);
                                    var name = FundAssetClasses.Name(classes[i]);

                                    <tr>
                                        <td class="fw-semibold">
                                            @name
                                            <input type="hidden" name="lines[@i].AssetClass" value="@classes[i]" />
                                        </td>
                                        <td><input name="lines[@i].Target" type="number" step="any" min="0" max="100" class="form-control form-control-sm" aria-label="@name target" value="@Percent(line?.Target)" /></td>
                                        <td><input name="lines[@i].Low" type="number" step="any" min="0" max="100" class="form-control form-control-sm" aria-label="@name corridor low" value="@Percent(line?.CorridorLow)" /></td>
                                        <td><input name="lines[@i].High" type="number" step="any" min="0" max="100" class="form-control form-control-sm" aria-label="@name corridor high" value="@Percent(line?.CorridorHigh)" /></td>
                                        <td><input name="lines[@i].Ipec" type="number" step="any" min="0" max="100" class="form-control form-control-sm" aria-label="@name IPEC limit" value="@Percent(line?.IpecLimit)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-floppy-disk" aria-hidden="true"></i> Save policy
                        </button>
                    </div>

                </form>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Recently Loaded
                </h3>

                @if (Model.Imports.Count == 0)
                {
                    <p class="text-muted mb-0">Nothing yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr><th>When</th><th>File</th><th>Kind</th><th class="num">Rows</th><th>By</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var import in Model.Imports)
                                {
                                    <tr>
                                        <td class="text-nowrap">@import.UploadedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>
                                        <td class="text-break">@import.FileName</td>
                                        <td>@import.Kind</td>
                                        <td class="num">@import.RowCount</td>
                                        <td>@import.UploadedByName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-calendar-check" aria-hidden="true"></i> Quarters
                </h3>

                @if (Model.Quarters.Count == 0)
                {
                    <p class="text-muted mb-0">No statements loaded yet.</p>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @foreach (var quarter in Model.Quarters)
                        {
                            <a class="btn btn-outline-primary" asp-action="Quarter" asp-route-id="@Model.Fund.Id"
                               asp-route-year="@quarter.Year" asp-route-number="@quarter.Number">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i> @quarter.Label
                            </a>
                        }
                    </div>
                }

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-upload" aria-hidden="true"></i> Load Statements
                </h3>

                <p class="small text-muted">
                    CSV files of positions, transactions and cash_recon, with the columns in the reporting guide.
                    A file replaces what is held for the accounts and months it covers. If any row is bad, nothing is loaded.
                </p>

                <form asp-action="Upload" asp-route-id="@Model.Fund.Id" method="post" enctype="multipart/form-data">
                    <label for="files" class="form-label">Files</label>
                    <input id="files" type="file" name="files" class="form-control mb-3" accept=".csv" multiple required />
                    <div class="d-grid">
                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-upload" aria-hidden="true"></i> Load
                        </button>
                    </div>
                </form>

            </section>

        </div>

    </div>

</div>
