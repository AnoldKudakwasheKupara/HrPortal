@model IEnumerable<HrPortal.Entities.AuditLog>

@{
    ViewData["Title"] = "Audit Log";

    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
    var stats = (int[])ViewBag.Stats;

    var employeeId = ViewBag.SelectedEmployeeId as int?;
    var entityName = ViewBag.SelectedEntityName as string;
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
    var filtered = employeeId != null || entityName != null || fromDate != null || toDate != null;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Audit Log</h2>
            <p>A record of what was done in the system, and by whom. Entries cannot be added or changed here.</p>
        </div>

    </div>

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-clipboard-list"></i></span>
            <div>
                <div class="kpi-label">All Entries</div>
                <div class="kpi-value">@stats[0]</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-calendar-day"></i></span>
            <div>
                <div class="kpi-label">Today</div>
                <div class="kpi-value">@stats[1]</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-calendar-week"></i></span>
            <div>
                <div class="kpi-label">Last 7 Days</div>
                <div class="kpi-value">@stats[2]</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-users"></i></span>
            <div>
                <div class="kpi-label">People Active This Week</div>
                <div class="kpi-value">@stats[3]</div>
            </div>
        </div>

    </div>

    <form asp-action="Index" method="get" class="filter-bar" data-auto-submit>

        <div>
            <label for="employeeId" class="form-label">Employee</label>
            <select id="employeeId" name="employeeId" asp-items="ViewBag.Employees" class="form-select">
                <option value="">All employees</option>
            </select>
        </div>

        <div>
            <label for="entityName" class="form-label">Entity</label>
            <select id="entityName" name="entityName" asp-items="ViewBag.EntityNames" class="form-select">
                <option value="">All entities</option>
            </select>
        </div>

        <div>
            <label for="fromDate" class="form-label">From</label>
            <input id="fromDate" name="fromDate" type="date" value="@(fromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>

        <div>
            <label for="toDate" class="form-label">To</label>
            <input id="toDate" name="toDate" type="date" value="@(toDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>

        <div class="filter-bar-actions">
            <noscript>
                <button type="submit" class="btn btn-outline-secondary">Apply</button>
            </noscript>
            <a class="btn btn-outline-primary text-nowrap" asp-action="Index">
                <i class="fas fa-filter-circle-xmark" aria-hidden="true"></i> Reset Filters
            </a>
        </div>

    </form>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-clipboard-list" aria-hidden="true"></i> Entries
            <span class="tab-count">@totalCount</span>
        </h3>

        @if (!Model.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <p>
                    @if (filtered)
                    {
                        <text>No audit entries match these filters.</text>
                        <a asp-action="Index">Reset filters</a>
                    }
                    else
                    {
                        <text>Nothing has been recorded yet.</text>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Record</th>
                            <th>By</th>
                            <th>IP Address</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@log.Timestamp.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>
                                <td class="fw-semibold">@log.Action</td>
                                <td>@log.EntityName</td>
                                <td>@(string.IsNullOrWhiteSpace(log.EntityId) ? "-" : log.EntityId)</td>
                                <td>
                                    @if (log.Employee != null)
                                    {
                                        @log.Employee.FirstName<text> </text>@log.Employee.LastName
                                    }
                                    else
                                    {
                                        <span class="text-muted">System</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(log.IpAddress) ? "-" : log.IpAddress)</td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@log.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='new HrPortal.ViewModels.PagerSummary(page, 10, totalCount, totalPages, totalCount == 1 ? "entry" : "entries")' />
        }

    </section>

</div>

