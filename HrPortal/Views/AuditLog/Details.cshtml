@model HrPortal.Entities.AuditLog

@{
    ViewData["Title"] = "Audit Entry Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.Action</h2>

            <p class="text-muted">
                Audit Entry Details
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            Back

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Action</span>

                    <div class="field-value">
                        @Model.Action
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Entity</span>

                    <div class="field-value">
                        @Model.EntityName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Record</span>

                    <div class="field-value">
                        @if (!string.IsNullOrWhiteSpace(Model.EntityId))
                        {
                            @Model.EntityId
                        }
                        else
                        {
                            <span class="text-muted">
                                Not recorded
                            </span>
                        }
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Performed By</span>

                    <div class="field-value">
                        @if (Model.Employee != null)
                        {
                            @Model.Employee.FirstName
                            @Model.Employee.LastName
                        }
                        else
                        {
                            <span class="text-muted">
                                System
                            </span>
                        }
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">When</span>

                    <div class="field-value">
                        @Model.Timestamp.ToString("dd MMM yyyy HH:mm:ss")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">IP Address</span>

                    <div class="field-value">
                        @if (!string.IsNullOrWhiteSpace(Model.IpAddress))
                        {
                            @Model.IpAddress
                        }
                        else
                        {
                            <span class="text-muted">
                                Not recorded
                            </span>
                        }
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Description</span>

                    <div class="field-value">
                        @(Model.Description ?? "No description recorded.")
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
