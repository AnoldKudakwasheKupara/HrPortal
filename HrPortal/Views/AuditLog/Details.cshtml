@model HrPortal.Entities.AuditLog

@{
    ViewData["Title"] = "Audit Entry Details";
    var who = Model.Employee == null ? "System" : $"{Model.Employee.FirstName} {Model.Employee.LastName}";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Action</h2>
            <p>@Model.EntityName, @Model.Timestamp.ToLocalTime().ToString("d MMM yyyy, HH:mm")</p>
        </div>

        <div class="head-actions">
            <partial name="_DownloadPdf" model="@Model.Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-clipboard-list" aria-hidden="true"></i> Entry Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-bolt" aria-hidden="true"></i>
                        <div><span>Action</span><strong>@Model.Action</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-database" aria-hidden="true"></i>
                        <div><span>Entity</span><strong>@Model.EntityName</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-hashtag" aria-hidden="true"></i>
                        <div>
                            <span>Record</span>
                            @if (string.IsNullOrWhiteSpace(Model.EntityId))
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.EntityId</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div><span>Performed by</span><strong>@who</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-align-left" aria-hidden="true"></i> Description</h4>
                    <p class="pre-line">@(Model.Description ?? "No description recorded.")</p>
                </div>

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Entry Information
                </h3>

                <dl class="info-list">
                    <dt>When</dt>
                    <dd>@Model.Timestamp.ToLocalTime().ToString("d MMM yyyy, HH:mm:ss")</dd>
                    <dt>By</dt>
                    <dd>@who</dd>
                    <dt>IP address</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.IpAddress) ? "Not recorded" : Model.IpAddress)</dd>
                    <dt>Entry No.</dt>
                    <dd>@Model.Id</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
