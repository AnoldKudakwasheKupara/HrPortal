@model HrPortal.ViewModels.TodoListViewModel

@{
    string name = ViewBag.PersonName;
    string? jobTitle = ViewBag.JobTitle;
    ViewData["Title"] = $"{name}'s To-Do List";
}

<div class="container-fluid">

    <div class="todo-head">

        <span class="todo-head-icon" aria-hidden="true">
            <i class="fas fa-clipboard-list"></i>
        </span>

        <div>
            <h2>@name's To-Do List</h2>
            <p>
                @if (!string.IsNullOrWhiteSpace(jobTitle))
                {
                    @jobTitle<text>. </text>
                }
                You can see this list, but only @name can change it.
            </p>
        </div>

    </div>

    <partial name="_TodoStats" model="Model.Counts" />

    <partial name="_TodoList" model="Model" />

    <a class="btn btn-outline-secondary" asp-action="Team">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to my team
    </a>

</div>

@section Scripts {
    <script src="~/js/todo.js" asp-append-version="true"></script>
}
