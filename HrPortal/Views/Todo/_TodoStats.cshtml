@model HrPortal.Services.TodoCounts

<div class="kpis">

    <div class="kpi">
        <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-clipboard-list"></i></span>
        <div>
            <div class="kpi-label">Total Tasks</div>
            <div class="kpi-value">@Model.Total</div>
        </div>
    </div>

    <div class="kpi">
        <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-clock"></i></span>
        <div>
            <div class="kpi-label">In Progress</div>
            <div class="kpi-value">@Model.InProgress</div>
        </div>
    </div>

    <div class="kpi">
        <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
        <div>
            <div class="kpi-label">Completed</div>
            <div class="kpi-value">@Model.Done</div>
        </div>
    </div>

    <div class="kpi">
        <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-calendar-days"></i></span>
        <div>
            <div class="kpi-label">Due Soon (&le; 7 days)</div>
            <div class="kpi-value">@Model.DueSoon</div>
            @if (Model.Overdue > 0)
            {
                <div class="kpi-note is-alert">@Model.Overdue overdue</div>
            }
        </div>
    </div>

</div>
