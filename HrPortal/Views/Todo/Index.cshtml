@model HrPortal.ViewModels.TodoListViewModel

@{
    ViewData["Title"] = "My To-Do List";
}

<div class="container-fluid">

    <div class="icon-head">

        <span class="icon-head-tile" aria-hidden="true">
            <i class="fas fa-clipboard-list"></i>
        </span>

        <div>
            <h2>My To-Do List</h2>
            <p>
                A list of your pending and in-progress tasks that require your
                action, review or completion. Your supervisor can see it, but
                only you can change it.
            </p>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <partial name="_TodoStats" model="Model.Counts" />

    <div class="card shadow-sm mb-4 todo-add">

        <div class="card-body">

            <div class="todo-add-head">

                <span class="todo-add-icon" aria-hidden="true">
                    <i class="fas fa-plus"></i>
                </span>

                <div>
                    <h3>Add a New Task</h3>
                    <p>Create a task for yourself to track and complete.</p>
                </div>

            </div>

            <form asp-action="Add" method="post">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-6">
                        <label asp-for="New!.Title" class="form-label">
                            What needs doing? <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="New!.Title" class="form-control" maxlength="200" required
                               placeholder="e.g. Prepare monthly report, Attend training, Follow up with Finance" />
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <label asp-for="New!.DueDate" class="form-label">Due date (optional)</label>
                        <input asp-for="New!.DueDate" type="date" class="form-control" />
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-plus" aria-hidden="true"></i> Add Task
                        </button>
                    </div>

                    <div class="col-12">
                        <label asp-for="New!.Notes" class="form-label">Notes (optional)</label>
                        <textarea asp-for="New!.Notes" class="form-control" rows="2" maxlength="2000"
                                  placeholder="Add any additional details, links or context..."></textarea>
                    </div>

                </div>

            </form>

        </div>

    </div>

    <partial name="_TodoList" model="Model" />

</div>

@section Scripts {
    <script src="~/js/todo.js" asp-append-version="true"></script>
}
