@model HrPortal.ViewModels.TodoListViewModel

@{
    ViewData["Title"] = "My To-Do List";
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>My To-Do List</h2>

        <p class="text-muted">
            Keep track of what you are working on. Your supervisor
            can see this list and where each item stands, but only
            you can change it.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">Add an item</div>

        <div class="card-body">

            <form asp-action="Add" method="post">

                <div class="row g-2 align-items-end">

                    <div class="col-md-6">
                        <label asp-for="New!.Title" class="form-label"></label>
                        <input asp-for="New!.Title" class="form-control" maxlength="200" required />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="New!.DueDate" class="form-label">Due (optional)</label>
                        <input asp-for="New!.DueDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-plus" aria-hidden="true"></i> Add
                        </button>
                    </div>

                    <div class="col-12">
                        <label asp-for="New!.Notes" class="form-label">Notes (optional)</label>
                        <textarea asp-for="New!.Notes" class="form-control" rows="2" maxlength="2000"></textarea>
                    </div>

                </div>

            </form>

        </div>

    </div>

    <partial name="_TodoList" model="Model" />

</div>
