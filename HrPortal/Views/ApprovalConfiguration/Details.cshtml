@model HrPortal.Entities.ApprovalConfiguration

@{
    ViewData["Title"] = "Approver Details";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>@Model.Role</h2>

            <p class="text-muted">
                Approval Configuration Details
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <strong>Approval Role</strong>

                    <p>
                        @Model.Role
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Status</strong>

                    <p>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Employee</strong>

                    <p>
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Department</strong>

                    <p>
                        @Model.Employee.Department.Name
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Email</strong>

                    <p>
                        @Model.Employee.Email
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Employee Number</strong>

                    <p>
                        @Model.Employee.EmployeeNumber
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
