@model HrPortal.Entities.ApprovalConfiguration

@{
    ViewData["Title"] = "Approver Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.Role</h2>

            <p class="text-muted">
                Approval Configuration Details
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <span class="field-label">Approval Role</span>

                    <p class="field-value">
                        @Model.Role
                    </p>

                </div>


                <div class="col-md-6">

                    <span class="field-label">Status</span>

                    <p class="field-value">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </p>

                </div>


                <div class="col-md-6">

                    <span class="field-label">Employee</span>

                    <p class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>


                <div class="col-md-6">

                    <span class="field-label">Department</span>

                    <p class="field-value">
                        @Model.Employee.Department.Name
                    </p>

                </div>


                <div class="col-md-6">

                    <span class="field-label">Email</span>

                    <p class="field-value">
                        @Model.Employee.Email
                    </p>

                </div>


                <div class="col-md-6">

                    <span class="field-label">Employee Number</span>

                    <p class="field-value">
                        @Model.Employee.EmployeeNumber
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
