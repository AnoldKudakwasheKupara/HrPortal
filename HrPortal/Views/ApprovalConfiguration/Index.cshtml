@model IEnumerable<HrPortal.Entities.ApprovalConfiguration>

@{
    ViewData["Title"] = "Approval Configuration";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Approval Configuration</h2>

            <p class="text-muted">
                Decide who approves leave at each stage.
                Only one approver can be active per role.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Approver
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Approval Role</th>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-4">
                                No approvers have been set up yet.
                            </td>
                        </tr>
                    }

                    @foreach (var configuration in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @configuration.Role
                                </strong>
                            </td>

                            <td>
                                @configuration.Employee.FirstName
                                @configuration.Employee.LastName
                            </td>

                            <td>
                                @configuration.Employee.Department.Name
                            </td>

                            <td>
                                @if (configuration.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@configuration.Id">

                                        View

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@configuration.Id">

                                        Edit

                                    </a>

                                    <form asp-action="ToggleStatus"
                                          asp-route-id="@configuration.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">

                                            @(configuration.IsActive
                                                ? "Deactivate"
                                                : "Activate")

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
