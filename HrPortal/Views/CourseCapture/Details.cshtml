@using HrPortal.Entities
@using HrPortal.Services
@model CourseApplication

@{
    ViewData["Title"] = Model.ApplicationNumber;
    var hidePersonal = !User.IsInRole(HrPortal.Security.Roles.HrOfficer);
    ViewData["HidePersonal"] = hidePersonal;

    var related = (List<HrPortal.ViewModels.RelatedCourse>)ViewBag.Related;
    var name = Model.Employee.FirstName + " " + Model.Employee.LastName;
    var nationalId = hidePersonal ? PersonalData.MaskId(Model.Employee.NationalId) : Model.Employee.NationalId;
    var history = Model.History.OrderByDescending(h => h.ActionDate).ThenByDescending(h => h.Id).ToList();
    var capture = Model.History.First(h => h.Action == CourseApplicationAction.CapturedAsApproved);
    var approvedBy = CourseCapture.ReadComment(capture.Comment).ApprovedBy;
    var lastUpdated = history.First().ActionDate;
    var badge = StatusNames.Of(Model.Status);
    var fileName = $"Course application - {Model.ApplicationNumber}.pdf";

    string Who(CourseApplicationHistory h) =>
        h.ActionedByEmployee == null ? "--" : h.ActionedByEmployee.FirstName + " " + h.ActionedByEmployee.LastName;

    string Attempt() => Model.Sitting switch
    {
        CourseSitting.NextLevel => "Proceeding to the next level",
        CourseSitting.Rewriting => "Re-writing",
        _ => "First attempt"
    };
}

<div class="container-fluid">

    <div class="icon-head icon-head-wide">

        <span class="icon-head-tile" aria-hidden="true">
            <i class="fas fa-file-lines"></i>
        </span>

        <div>
            <h2>@Model.ApplicationNumber</h2>
            <p>@Model.ProgramIntended, captured as approved on @name's behalf</p>
        </div>

        <div class="head-actions">

            <span class="meta-pill is-green">
                <i class="fas fa-circle-check" aria-hidden="true"></i>
                @badge.Label
            </span>

            <span class="meta-pill">
                <i class="fas fa-calendar-check" aria-hidden="true"></i>
                Approved: @Model.CompletedAt?.ToString("d MMM yyyy")
            </span>

            <a class="btn btn-outline-secondary" asp-action="Form" asp-route-id="@Model.Id">
                <i class="fas fa-download" aria-hidden="true"></i> Application form (PDF)
            </a>

            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <ul class="nav section-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab"
                    aria-controls="overview" aria-selected="true">Overview</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab"
                    aria-controls="history" aria-selected="false">History <span class="tab-count">@history.Count</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab"
                    aria-controls="documents" aria-selected="false">Documents <span class="tab-count">1</span></button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#related" type="button" role="tab"
                    aria-controls="related" aria-selected="false">Related <span class="tab-count">@related.Count</span></button>
        </li>
    </ul>

    <div class="row g-3">

        <div class="col-lg-8">

            <div class="tab-content">

                <div class="tab-pane fade show active" id="overview" role="tabpanel">

                    <section class="panel-card mb-3">

                        <h3 class="panel-head">
                            <i class="fas fa-briefcase" aria-hidden="true"></i> Application Details
                        </h3>

                        <div class="facts">

                            <div class="fact">
                                <i class="fas fa-user" aria-hidden="true"></i>
                                <div><span>Applicant</span><strong>@name</strong></div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-id-card" aria-hidden="true"></i>
                                <div>
                                    <span>I.D. No.</span>
                                    @if (nationalId == null)
                                    {
                                        <em>Not recorded</em>
                                    }
                                    else
                                    {
                                        <strong>@nationalId</strong>
                                    }
                                </div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-building" aria-hidden="true"></i>
                                <div><span>Department</span><strong>@(Model.Employee.Department?.Name ?? "--")</strong></div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-briefcase" aria-hidden="true"></i>
                                <div>
                                    <span>Position</span>
                                    @if (Model.Employee.JobTitle == null)
                                    {
                                        <em>Not recorded</em>
                                    }
                                    else
                                    {
                                        <strong>@Model.Employee.JobTitle</strong>
                                    }
                                </div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-layer-group" aria-hidden="true"></i>
                                <div><span>Programme intended</span><strong>@Model.ProgramIntended</strong></div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-calendar-days" aria-hidden="true"></i>
                                <div>
                                    <span>Target exam date</span>
                                    @if (Model.TargetExamDate == null)
                                    {
                                        <em>Not given</em>
                                    }
                                    else
                                    {
                                        <strong>@Model.TargetExamDate.Value.ToString("d MMM yyyy")</strong>
                                    }
                                </div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-circle-check" aria-hidden="true"></i>
                                <div><span>Sat before</span><strong>@(Model.HasSatBefore ? "Yes" : "No")</strong></div>
                            </div>

                            <div class="fact">
                                <i class="fas fa-rotate" aria-hidden="true"></i>
                                <div><span>This attempt</span><strong>@Attempt()</strong></div>
                            </div>

                        </div>

                        <div class="panel-block">
                            <h4><i class="fas fa-bullseye" aria-hidden="true"></i> Justification and Relevance</h4>
                            <p class="pre-line">@Model.Justification</p>
                        </div>

                        <div class="panel-block">
                            <h4><i class="fas fa-file-signature" aria-hidden="true"></i> Pledge</h4>
                            <p>
                                <em>
                                    @(Model.PledgedAt == null
                                        ? "On the paper form, approved before the portal."
                                        : "Made on " + Model.PledgedAt.Value.ToLocalTime().ToString("d MMM yyyy HH:mm") + ".")
                                </em>
                            </p>
                        </div>

                    </section>

                    <div class="row g-3">

                        <div class="col-xxl-7">

                            <section class="panel-card h-100">

                                <h3 class="panel-head">
                                    <i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Application History
                                </h3>

                                <partial name="_Timeline" model="Timeline.Of(history.Take(4))" />

                                @if (history.Count > 4)
                                {
                                    <button type="button" class="btn btn-link btn-sm px-0" data-show-tab="#history">
                                        See all @history.Count entries
                                    </button>
                                }

                            </section>

                        </div>

                        <div class="col-xxl-5">

                            <section class="panel-card h-100">

                                <h3 class="panel-head">
                                    <i class="fas fa-file-lines" aria-hidden="true"></i> Documents <span class="tab-count">1</span>
                                </h3>

                                <partial name="_CapturedDocument" model="Model" />

                            </section>

                        </div>

                    </div>

                </div>

                <div class="tab-pane fade" id="history" role="tabpanel">
                    <partial name="_CourseHistoryCard" model="Model" />
                </div>

                <div class="tab-pane fade" id="documents" role="tabpanel">
                    <section class="panel-card">
                        <h3 class="panel-head">
                            <i class="fas fa-file-lines" aria-hidden="true"></i> Documents
                        </h3>
                        <partial name="_CapturedDocument" model="Model" />
                    </section>
                </div>

                <div class="tab-pane fade" id="related" role="tabpanel">
                    <section class="panel-card">

                        <h3 class="panel-head">
                            <i class="fas fa-link" aria-hidden="true"></i> @name's other course applications
                        </h3>

                        @if (!related.Any())
                        {
                            <p class="text-muted mb-0">None. This is their only course application.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Number</th>
                                            <th>Programme</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in related)
                                        {
                                            <tr>
                                                <td class="text-nowrap">
                                                    @if (r.Captured)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@r.Id">@r.ApplicationNumber</a>
                                                    }
                                                    else
                                                    {
                                                        @r.ApplicationNumber
                                                    }
                                                </td>
                                                <td>@r.Programme</td>
                                                <td class="text-nowrap">@r.Date.ToString("d MMM yyyy")</td>
                                                <td><partial name="_CourseStatusBadge" model="r.Status" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </section>
                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="action-list">

                    <a asp-action="Edit" asp-route-id="@Model.Id">
                        <i class="fas fa-pen" aria-hidden="true"></i> Edit application
                        <i class="fas fa-chevron-right ms-auto" aria-hidden="true"></i>
                    </a>

                    <button type="button" data-bs-toggle="collapse" data-bs-target="#add-comment"
                            aria-expanded="false" aria-controls="add-comment">
                        <i class="fas fa-square-plus" aria-hidden="true"></i> Add comment
                        <i class="fas fa-chevron-down ms-auto" aria-hidden="true"></i>
                    </button>

                    <div class="collapse" id="add-comment">
                        <form asp-action="Comment" asp-route-id="@Model.Id" method="post" class="action-form">
                            <label for="comment" class="visually-hidden">Comment</label>
                            <textarea id="comment" name="comment" class="form-control" rows="3" maxlength="1000" required
                                      placeholder="Goes into the history, which @name can also see."></textarea>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Add comment</button>
                        </form>
                    </div>

                    <a asp-action="Form" asp-route-id="@Model.Id" asp-route-view="true" target="_blank" rel="noopener">
                        <i class="fas fa-print" aria-hidden="true"></i> Print / Export
                        <i class="fas fa-chevron-right ms-auto" aria-hidden="true"></i>
                    </a>

                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-user" aria-hidden="true"></i> Applicant Summary
                </h3>

                <dl class="info-list">
                    <dt>Name</dt>
                    <dd>@name</dd>
                    <dt>Department</dt>
                    <dd>@(Model.Employee.Department?.Name ?? "--")</dd>
                    <dt>Position</dt>
                    <dd>@(Model.Employee.JobTitle ?? "Not recorded")</dd>
                    <dt>Programme</dt>
                    <dd>@Model.ProgramIntended</dd>
                </dl>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Application Information
                </h3>

                <dl class="info-list">
                    <dt>Application No.</dt>
                    <dd>@Model.ApplicationNumber</dd>
                    <dt>Status</dt>
                    <dd><partial name="_CourseStatusBadge" model="Model.Status" /></dd>
                    <dt>Approved</dt>
                    <dd>@Model.CompletedAt?.ToString("d MMM yyyy")</dd>
                    @if (!string.IsNullOrWhiteSpace(approvedBy))
                    {
                        <dt>Approved by</dt>
                        <dd>@approvedBy</dd>
                    }
                    <dt>Captured</dt>
                    <dd>@capture.ActionDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                    <dt>Captured by</dt>
                    <dd>@Who(capture)</dd>
                    <dt>Last updated</dt>
                    <dd>@lastUpdated.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/tabs.js" asp-append-version="true"></script>
}
