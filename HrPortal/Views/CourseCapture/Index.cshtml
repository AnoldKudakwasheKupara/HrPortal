@model HrPortal.ViewModels.CapturedCourseListViewModel

@{
    ViewData["Title"] = "Captured Course Approvals";

    var paged = Model.Page;
}

<div class="container-fluid">

    <div class="icon-head icon-head-wide">

        <span class="icon-head-tile" aria-hidden="true">
            <i class="fas fa-graduation-cap"></i>
        </span>

        <div>
            <h2>Captured Course Approvals</h2>
            <p>
                Course requests that were approved before the portal, recorded
                here on the employee's behalf. Each one shows as approved on the
                employee's My Courses.
            </p>
        </div>

        <a class="btn btn-gold" asp-action="Create">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Capture approved course request
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="kpis">

        <div class="kpi is-filled is-green">
            <span class="kpi-icon" aria-hidden="true"><i class="fas fa-layer-group"></i></span>
            <div>
                <div class="kpi-label">Total Captured</div>
                <div class="kpi-value">@Model.Total</div>
            </div>
        </div>

        <div class="kpi is-filled is-amber">
            <span class="kpi-icon" aria-hidden="true"><i class="fas fa-users"></i></span>
            <div>
                <div class="kpi-label">Employees</div>
                <div class="kpi-value">@Model.Employees</div>
            </div>
        </div>

        <div class="kpi is-filled is-blue">
            <span class="kpi-icon" aria-hidden="true"><i class="fas fa-calendar-check"></i></span>
            <div>
                <div class="kpi-label">Captured This Month</div>
                <div class="kpi-value">@Model.ThisMonth</div>
            </div>
        </div>

        <div class="kpi is-filled is-teal">
            <span class="kpi-icon" aria-hidden="true"><i class="fas fa-user-check"></i></span>
            <div>
                <div class="kpi-label">Captured by You</div>
                <div class="kpi-value">@Model.ByYou</div>
            </div>
        </div>

    </div>

    <form method="get" class="filter-bar" data-auto-submit>

        <div class="filter-bar-search">
            <label for="cc-q" class="visually-hidden">Search</label>
            <div class="filter-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="cc-q" type="search" name="q" value="@Model.Search" class="form-control"
                       placeholder="Search by number, programme or employee..." />
            </div>
        </div>

        <div>
            <label for="cc-employee" class="form-label">Employee</label>
            <select id="cc-employee" name="employeeId" class="form-select" asp-items="Model.EmployeeOptions">
                <option value="">All employees</option>
            </select>
        </div>

        <div>
            <label for="cc-from" class="form-label">Approved from</label>
            <input id="cc-from" type="date" name="from" class="form-control"
                   value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>

        <div>
            <label for="cc-to" class="form-label">Approved to</label>
            <input id="cc-to" type="date" name="to" class="form-control"
                   value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="filter-bar-actions">
            <noscript>
                <button type="submit" class="btn btn-outline-secondary">Apply</button>
            </noscript>
            <a class="btn btn-outline-primary" asp-action="Index">
                <i class="fas fa-filter-circle-xmark" aria-hidden="true"></i> Reset Filters
            </a>
        </div>

    </form>

    @if (Model.Total == 0)
    {
        <div class="list-empty">
            <i class="fas fa-graduation-cap" aria-hidden="true"></i>
            <p>Nothing has been captured yet.</p>
        </div>
    }
    else if (paged.TotalCount == 0)
    {
        <div class="list-empty">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            <p>Nothing matches these filters. <a asp-action="Index">Reset filters</a></p>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0 table-soft-head">

                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Employee</th>
                                <th>Programme</th>
                                <th>Captured</th>
                                <th>Approved</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var a in paged.Items)
                            {
                                <tr>
                                    <td class="text-nowrap fw-semibold">@a.ApplicationNumber</td>
                                    <td>@a.EmployeeName</td>
                                    <td>
                                        <div class="fw-semibold">@a.Programme</div>
                                        <div class="small text-muted text-clamp-1">@a.Justification</div>
                                    </td>
                                    <td>
                                        <div class="text-nowrap">@a.CapturedAt.ToLocalTime().ToString("d MMM yyyy")</div>
                                        <div class="small text-muted">by @a.CapturedBy</div>
                                    </td>
                                    <td>
                                        <div class="text-nowrap">@a.ApprovedOn?.ToString("d MMM yyyy")</div>
                                        @if (!string.IsNullOrWhiteSpace(a.ApprovedBy))
                                        {
                                            <div class="small text-muted">by @a.ApprovedBy</div>
                                        }
                                    </td>
                                    <td><partial name="_CourseStatusBadge" model="a.Status" /></td>
                                    <td>
                                        <div class="table-actions justify-content-end">
                                            <a class="btn btn-sm btn-outline-secondary text-nowrap"
                                               asp-action="Details" asp-route-id="@a.Id">
                                                <i class="fas fa-eye" aria-hidden="true"></i> View
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary text-nowrap"
                                               asp-action="Edit" asp-route-id="@a.Id">
                                                <i class="fas fa-pen" aria-hidden="true"></i> Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <partial name="_NumberedPager" model='HrPortal.ViewModels.PagerSummary.From(paged, "entry", "entries")' />

            </div>

        </div>
    }

</div>
