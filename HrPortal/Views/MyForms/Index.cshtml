@using HrPortal.Entities
@using HrPortal.Services.ProviderForms
@model List<ProviderForm>

@{
    ViewData["Title"] = "My Forms";
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>My Forms</h2>
            <p>
                Fill in and sign the funeral cover and pension forms here. HR checks them and sends the
                provider their own form, filled in.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-3">

        @foreach (var kind in Enum.GetValues<ProviderFormKind>())
        {
            var open = Model.FirstOrDefault(f => f.Kind == kind && ProviderFormRules.WithEmployee(f.Status));

            <div class="col-md-6">

                <section class="panel-card h-100">

                    <h3 class="panel-head">
                        <i class="fas @(kind == ProviderFormKind.Minerva ? "fa-piggy-bank" : "fa-people-roof")" aria-hidden="true"></i>
                        @ProviderFormRules.Title(kind)
                    </h3>

                    <p class="text-muted">
                        @(kind == ProviderFormKind.Minerva
                            ? "Join the pension fund and name who should benefit. You need a witness with you when you sign."
                            : "Join, change your plan, or add, remove or update the people covered.")
                    </p>

                    <form asp-action="Start" method="post">
                        <input type="hidden" name="kind" value="@kind" />
                        <button type="submit" class="btn btn-gold">
                            <i class="fas @(open == null ? "fa-plus" : "fa-pen-to-square")" aria-hidden="true"></i>
                            @(open == null ? "Fill in this form" : $"Carry on with {open.Reference}")
                        </button>
                    </form>

                </section>

            </div>
        }

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-file-signature" aria-hidden="true"></i> Forms You Have Started
            <span class="tab-count">@Model.Count</span>
        </h3>

        @if (!Model.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-file-signature" aria-hidden="true"></i>
                <p>You have not started a form yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Form</th>
                            <th>Started</th>
                            <th>Signed</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var form in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@ProviderFormRules.Title(form.Kind)</div>
                                    <div class="small text-muted">@form.Reference</div>
                                </td>
                                <td class="text-nowrap">@form.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                <td class="text-nowrap">@(form.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy") ?? "-")</td>
                                <td><partial name="_ProviderFormStatusBadge" model="form.Status" /></td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@form.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>
                                        @if (ProviderFormRules.WithEmployee(form.Status))
                                        {
                                            <a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Edit" asp-route-id="@form.Id">
                                                <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>
