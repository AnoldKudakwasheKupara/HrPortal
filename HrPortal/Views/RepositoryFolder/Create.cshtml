@using HrPortal.Entities
@model HrPortal.ViewModels.RepositoryFolderEditViewModel

@{ ViewData["Title"] = "Add Folder"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Add Folder</h2>
        <p class="text-muted">
            The audience applies to everything put in it, so pick it
            with that in mind.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control"
                               placeholder="HR Forms" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Audience" class="form-label"></label>
                        <select asp-for="Audience" class="form-select"
                                asp-items="Html.GetEnumSelectList<DocumentAudience>()">
                        </select>
                        <span asp-validation-for="Audience" class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">
                        In use
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add Folder</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
