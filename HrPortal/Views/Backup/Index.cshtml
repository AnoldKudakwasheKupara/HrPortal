@{
    ViewData["Title"] = "Backups";

    var available = ViewBag.Available == true;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Backups</h2>
            <p>Download a complete copy of the portal to keep somewhere safe.</p>
        </div>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-7">

            <section class="panel-card h-100">

                <h3 class="panel-head">
                    <i class="fas fa-download" aria-hidden="true"></i> Download a Backup
                </h3>

                @if (!available)
                {
                    <div class="alert alert-warning mb-0">
                        The database backup tool (pg_dump) is not installed where the portal runs, so a
                        backup cannot be made from here. It is installed with the portal on Render;
                        locally, set <code>Backup:PgDumpPath</code> to it.
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        One zip file with the whole database and every uploaded document, policy,
                        training material and loan attachment, and instructions for restoring it.
                        It can take a minute to prepare.
                    </p>

                    <form asp-action="Download" method="post" autocomplete="off">

                        <div class="mb-3">

                            <label for="password" class="form-label">Your password</label>

                            <input id="password" name="password" type="password" class="form-control"
                                   autocomplete="current-password" required />

                            <div class="form-text">
                                Asked again because the file holds everybody's personal data. Each
                                download is recorded in the audit log.
                            </div>

                        </div>

                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-download" aria-hidden="true"></i> Download backup
                        </button>

                    </form>
                }

            </section>

        </div>

        <div class="col-lg-5">

            <section class="panel-card h-100">

                <h3 class="panel-head">
                    <i class="fas fa-shield-halved" aria-hidden="true"></i> Keeping It Safe
                </h3>

                <ul class="notice-list">
                    <li>
                        <i class="fas fa-lock" aria-hidden="true"></i>
                        <div class="notice-title">
                            Store it where only authorised people can reach it, such as a restricted
                            company OneDrive or SharePoint folder, not on a personal laptop or USB stick.
                        </div>
                    </li>
                    <li>
                        <i class="fas fa-trash" aria-hidden="true"></i>
                        <div class="notice-title">Delete it from Downloads once it is stored.</div>
                    </li>
                    <li>
                        <i class="fas fa-calendar-week" aria-hidden="true"></i>
                        <div class="notice-title">Take one regularly, for example weekly, and before any large change.</div>
                    </li>
                    <li>
                        <i class="fas fa-server" aria-hidden="true"></i>
                        <div class="notice-title">
                            Render also keeps its own backups of the database, depending on the plan.
                            This is a copy you hold yourselves, including the uploaded files.
                        </div>
                    </li>
                </ul>

            </section>

        </div>

    </div>

</div>
