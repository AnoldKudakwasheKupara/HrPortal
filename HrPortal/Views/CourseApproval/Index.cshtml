@using HrPortal.ViewModels
@model List<HrPortal.Entities.CourseApplication>

@{
    var stage = ViewBag.Stage as string ?? "review";
    ViewData["Title"] ??= "Course Applications";
    var today = DateTime.Today;

    var stats = new QueueStats(
        Model.Count,
        "Programmes",
        Model.Select(c => c.ProgramIntended.Trim().ToLowerInvariant()).Distinct().Count().ToString(),
        Model.Any() ? Model.Min(c => c.SubmittedAt ?? c.CreatedAt) : null,
        "Exams Within 60 Days",
        Model.Count(c => c.TargetExamDate?.Date >= today && c.TargetExamDate?.Date <= today.AddDays(60)).ToString());
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@ViewData["Title"]</h2>
            <p>Waiting on you at @stage.</p>
        </div>

        <div class="head-actions">

            <a class="btn btn-outline-secondary" asp-action="List" asp-route-stage="@ViewBag.Queue">
                <i class="fas fa-download" aria-hidden="true"></i> Download
            </a>

            @if (User.IsInRole(HrPortal.Security.Roles.HrOfficer))
            {
                <a class="btn btn-outline-secondary" asp-action="Approved">
                    <i class="fas fa-print" aria-hidden="true"></i> Approved, to print
                </a>
            }

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <partial name="_QueueStats" model="stats" />

    <partial name="_CourseApplicationTable" model="Model" />

</div>
