@model List<HrPortal.Entities.CourseApplication>

@{
    var stage = ViewBag.Stage as string ?? "review";

    ViewData["Title"] = "Course Applications";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Course applications</h2>

            <p class="text-muted mb-0">
                Waiting on you at @stage.
            </p>
        </div>

        <div class="page-head-actions">

            <a class="btn btn-outline-secondary"
               asp-action="List"
               asp-route-stage="@ViewBag.Queue">
                <i class="fas fa-download" aria-hidden="true"></i>
                Download
            </a>

            @if (User.IsInRole(HrPortal.Security.Roles.HrOfficer))
            {
                <a class="btn btn-outline-secondary"
                   asp-action="Approved">
                    Approved, to print
                </a>
            }

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <partial name="_CourseApplicationTable" model="Model" />

</div>
