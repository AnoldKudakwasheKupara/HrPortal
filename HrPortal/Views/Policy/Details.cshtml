@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.ViewModels.PolicyDetailsViewModel

@{
    var p = Model.Policy;

    ViewData["Title"] = p.Title;

    var overdue = p.ReviewDate != null && p.ReviewDate.Value.Date < DateTime.Today;
    var needsConfirming = p.RequiresAcknowledgement && p.Status == PolicyStatus.Active && !Model.Acknowledged;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@p.Title</h2>
            <p>
                Version @p.Version@(string.IsNullOrWhiteSpace(p.Reference) ? "" : $", {p.Reference}")
                @if (overdue)
                {
                    <span class="status-badge badge-amber ms-1">Overdue for review</span>
                }
            </p>
        </div>

        <div class="head-actions">

            @switch (p.Status)
            {
                case PolicyStatus.Active:
                    <span class="status-badge badge-green">In force</span>
                    break;
                case PolicyStatus.Draft:
                    <span class="status-badge badge-gray">Draft</span>
                    break;
                case PolicyStatus.Superseded:
                    <span class="status-badge badge-blue">Replaced</span>
                    break;
                default:
                    <span class="status-badge badge-red">Withdrawn</span>
                    break;
            }

            <partial name="_DownloadPdf" model="@Model.Policy.Id" />

            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-scale-balanced" aria-hidden="true"></i> What It Says
                </h3>

                <p class="pre-line mb-3">@(string.IsNullOrWhiteSpace(p.Summary) ? "No summary was written. Open the document itself." : p.Summary)</p>

                <div class="doc-row">

                    <span class="doc-icon" aria-hidden="true"><i class="fas fa-file-lines"></i></span>

                    <div class="doc-info">
                        <div class="doc-name text-break">@p.OriginalFileName</div>
                        <div class="doc-meta">Version @p.Version</div>
                    </div>

                    <div class="doc-buttons">

                        @if (FileStorageService.CanPreview(p.OriginalFileName))
                        {
                            <a asp-action="Read" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" target="_blank"
                               rel="noopener" title="Read" data-opens-policy>
                                <i class="fas fa-eye" aria-hidden="true"></i>
                                <span class="visually-hidden">Read the policy</span>
                            </a>
                        }

                        <a asp-action="Download" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Download" data-opens-policy>
                            <i class="fas fa-download" aria-hidden="true"></i>
                            <span class="visually-hidden">Download the policy</span>
                        </a>

                    </div>

                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Where It Stands
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-calendar-day" aria-hidden="true"></i>
                        <div><span>Takes effect</span><strong>@p.EffectiveDate.ToString("d MMM yyyy")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-rotate" aria-hidden="true"></i>
                        <div>
                            <span>Review by</span>
                            @if (p.ReviewDate == null)
                            {
                                <em>No review date set</em>
                            }
                            else
                            {
                                <strong class="@(overdue ? "text-danger" : "")">@p.ReviewDate.Value.ToString("d MMM yyyy")</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-user-shield" aria-hidden="true"></i>
                        <div>
                            <span>Owner</span>
                            @if (string.IsNullOrWhiteSpace(p.Owner))
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@p.Owner</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <div><span>Applies to</span><strong>@Html.DisplayFor(m => m.Policy.Audience)</strong></div>
                    </div>

                    @if (p.Supersedes != null)
                    {
                        <div class="fact">
                            <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
                            <div>
                                <span>Replaces</span>
                                <strong>Version @p.Supersedes.Version, from @p.Supersedes.EffectiveDate.ToString("d MMM yyyy")</strong>
                            </div>
                        </div>
                    }

                </div>

            </section>

            @if (Model.CanManage)
            {
                <section class="panel-card mb-3">

                    <div class="panel-head-split">

                        <h3 class="panel-head">
                            <i class="fas fa-users" aria-hidden="true"></i> Who Has Read It
                            <span class="tab-count">@Model.AcknowledgedCount of @Model.ActiveStaff</span>
                        </h3>

                        @if (p.RequiresAcknowledgement)
                        {
                            <a asp-action="Confirmations" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-download" aria-hidden="true"></i> Download the record
                            </a>
                        }

                    </div>

                    @if (!p.RequiresAcknowledgement)
                    {
                        <p class="text-muted mb-0">This policy does not ask for acknowledgement.</p>
                    }
                    else
                    {
                        <div class="balance-bar mb-2" role="img" aria-label="@Model.Coverage percent have read it">
                            <span class="is-used" style="width: @Model.Coverage%"></span>
                        </div>
                        <p class="small text-muted">@Model.Coverage% of active staff have confirmed.</p>

                        @if (Model.Outstanding.Count == 0)
                        {
                            <p class="mb-0">Everyone currently employed has acknowledged it.</p>
                        }
                        else
                        {
                            <p class="mb-2"><strong>@Model.Outstanding.Count still to acknowledge:</strong></p>
                            <div class="breakdown">
                                @foreach (var name in Model.Outstanding)
                                {
                                    <span class="report-chip">@name</span>
                                }
                            </div>
                        }
                    }

                    @if (Model.Confirmations.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr><th>Confirmed By</th><th>Document Opened</th><th>Confirmed</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Confirmations)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@c.Name</td>
                                            <td class="text-nowrap">@(c.OpenedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "Not recorded")</td>
                                            <td class="text-nowrap">@c.ConfirmedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </section>
            }

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Read and Confirm
                </h3>

                <div class="d-grid gap-2">

                    @if (FileStorageService.CanPreview(p.OriginalFileName))
                    {
                        <a asp-action="Read" asp-route-id="@p.Id" class="btn @(needsConfirming ? "btn-outline-primary" : "btn-gold")"
                           target="_blank" rel="noopener" data-opens-policy>
                            <i class="fas fa-book-open" aria-hidden="true"></i> Read
                        </a>
                    }

                    <a asp-action="Download" asp-route-id="@p.Id" class="btn btn-outline-secondary" data-opens-policy>
                        <i class="fas fa-download" aria-hidden="true"></i> Download
                    </a>

                </div>

                @if (p.RequiresAcknowledgement && p.Status == PolicyStatus.Active)
                {
                    <hr />

                    @if (Model.Acknowledged)
                    {
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas fa-circle-check text-success mt-1" aria-hidden="true"></i>
                            <div>
                                <strong>You have confirmed that you read and understood this policy.</strong>
                                <div class="text-muted small">If it is reissued as a new version you will be asked again.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Acknowledge" asp-route-id="@p.Id" method="post">
                            <input type="hidden" name="id" value="@p.Id" />

                            <p class="mb-1"><strong>You must read this policy and confirm.</strong></p>

                            <p class="text-muted small">
                                This records your name and the time against version @p.Version as your policy confirmation.
                                @(Model.Opened ? "" : "Open the document with Read or Download first; the button works once you have.")
                            </p>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-gold" data-confirm-policy disabled="@(!Model.Opened)">
                                    <i class="fas fa-file-signature" aria-hidden="true"></i> I have read and understood this policy
                                </button>
                            </div>
                        </form>
                    }
                }

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Policy Information
                </h3>

                <dl class="info-list">
                    <dt>Version</dt>
                    <dd>@p.Version</dd>
                    <dt>Reference</dt>
                    <dd>@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</dd>
                    <dt>Takes effect</dt>
                    <dd>@p.EffectiveDate.ToString("d MMM yyyy")</dd>
                    <dt>Confirmation</dt>
                    <dd>@(p.RequiresAcknowledgement ? "Required" : "Not required")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll("[data-opens-policy]").forEach(function (link) {
            link.addEventListener("click", function () {
                var button = document.querySelector("[data-confirm-policy]");
                if (button) button.disabled = false;
            });
        });
    </script>
}
