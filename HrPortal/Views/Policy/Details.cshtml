@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.ViewModels.PolicyDetailsViewModel

@{
    var p = Model.Policy;

    ViewData["Title"] = p.Title;

    var overdue = p.ReviewDate != null &&
                  p.ReviewDate.Value.Date < DateTime.Today;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@p.Title</h2>

            <div class="detail-badges">
                @switch (p.Status)
                {
                    case PolicyStatus.Active:
                        <span class="badge bg-success">In force</span>
                        break;
                    case PolicyStatus.Draft:
                        <span class="badge bg-secondary">Draft</span>
                        break;
                    case PolicyStatus.Superseded:
                        <span class="badge bg-info">Replaced</span>
                        break;
                    default:
                        <span class="badge bg-danger">Withdrawn</span>
                        break;
                }

                <span class="badge bg-light text-dark">Version @p.Version</span>

                @if (!string.IsNullOrWhiteSpace(p.Reference))
                {
                    <span class="badge bg-light text-dark">@p.Reference</span>
                }

                @if (overdue)
                {
                    <span class="badge bg-warning text-dark">
                        Overdue for review
                    </span>
                }
            </div>
        </div>

        <div class="page-head-actions">
            @if (FileStorageService.CanPreview(p.OriginalFileName))
            {
                <a asp-action="Read" asp-route-id="@p.Id"
                   class="btn btn-primary" target="_blank">Read</a>
            }

            <a asp-action="Download" asp-route-id="@p.Id"
               class="btn btn-outline-primary">Download</a>

            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header">What it says</div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(p.Summary))
                    {
                        <div class="field-value">@p.Summary</div>
                    }
                    else
                    {
                        <div class="field-value is-empty">
                            No summary was written. Open the document
                            itself.
                        </div>
                    }

                    <div class="text-muted small mt-3">
                        @p.OriginalFileName
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">Where it stands</div>
                <div class="card-body">
                    <div class="detail-rows">

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-calendar-day"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Takes effect</span>
                                <div class="field-value">
                                    @p.EffectiveDate.ToString("d MMM yyyy")
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-rotate"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Review by</span>
                                <div class="field-value">
                                    @(p.ReviewDate?.ToString("d MMM yyyy")
                                        ?? "No review date set")
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-user-shield"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Owner</span>
                                <div class="field-value">
                                    @(string.IsNullOrWhiteSpace(p.Owner)
                                        ? "Not recorded"
                                        : p.Owner)
                                </div>
                            </div>
                        </div>

                        <div class="detail-row">
                            <span class="detail-icon">
                                <i class="fas fa-users"></i>
                            </span>
                            <div class="detail-text">
                                <span class="field-label">Applies to</span>
                                <div class="field-value">
                                    @Html.DisplayFor(m => m.Policy.Audience)
                                </div>
                            </div>
                        </div>

                        @if (p.Supersedes != null)
                        {
                            <div class="detail-row">
                                <span class="detail-icon">
                                    <i class="fas fa-clock-rotate-left"></i>
                                </span>
                                <div class="detail-text">
                                    <span class="field-label">Replaces</span>
                                    <div class="field-value">
                                        Version @p.Supersedes.Version,
                                        in force from
                                        @p.Supersedes.EffectiveDate.ToString("d MMM yyyy")
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (p.RequiresAcknowledgement && p.Status == PolicyStatus.Active)
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                @if (Model.Acknowledged)
                {
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-circle-check text-success"></i>
                        <div>
                            <strong>You have acknowledged this policy.</strong>
                            <div class="text-muted small">
                                If it is reissued as a new version you
                                will be asked again.
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <form asp-action="Acknowledge" asp-route-id="@p.Id"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />

                        <p class="mb-2">
                            <strong>Confirm you have read this policy.</strong>
                        </p>

                        <p class="text-muted small">
                            This records your name and the time against
                            version @p.Version. Please open the document
                            and read it first.
                        </p>

                        <button type="submit" class="btn btn-success">
                            I have read and understood this policy
                        </button>
                    </form>
                }
            </div>
        </div>
    }

    @if (Model.CanManage)
    {
        <div class="card shadow-sm mt-3 mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Who has read it</span>
                <span class="text-muted small">
                    @Model.AcknowledgedCount of @Model.ActiveStaff
                    (@Model.Coverage%)
                </span>
            </div>

            <div class="card-body">
                @if (!p.RequiresAcknowledgement)
                {
                    <div class="field-value is-empty mb-0">
                        This policy does not ask for acknowledgement.
                    </div>
                }
                else if (Model.Outstanding.Count == 0)
                {
                    <div class="field-value mb-0">
                        Everyone currently employed has acknowledged it.
                    </div>
                }
                else
                {
                    <p class="mb-2">
                        <strong>@Model.Outstanding.Count still to
                        acknowledge:</strong>
                    </p>
                    <div class="breakdown">
                        @foreach (var name in Model.Outstanding)
                        {
                            <span class="report-chip">@name</span>
                        }
                    </div>
                }
            </div>

        </div>
    }

</div>
