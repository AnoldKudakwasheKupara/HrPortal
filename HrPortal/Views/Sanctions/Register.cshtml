@model List<HrPortal.Entities.SanctionsRegisterEntry>

@{
    ViewData["Title"] = "Sanctions register";

    var removed = ViewBag.Removed == true;

    static string Lines(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "" : string.Join("; ", text.Split('\n', StringSplitOptions.RemoveEmptyEntries));
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@(removed ? "Removed from the register" : "Sanctions register")</h2>
            <p class="text-muted mb-0">
                @(removed
                    ? "Parties that were on the register and have since been removed."
                    : "Everybody currently listed, as built up from the documents applied so far.")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Register" asp-route-removed="@(!removed)" class="btn btn-outline-secondary">
                @(removed ? "Current register" : "Removed entries")
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="removed" value="@removed.ToString().ToLowerInvariant()" />
                <div class="col-md-8">
                    <label class="form-label" for="search">Search</label>
                    <input id="search" name="search" class="form-control" value="@ViewBag.Search"
                           placeholder="Reference, name, alias or passport number" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Name</th>
                            <th>Also known as</th>
                            <th>Date of birth</th>
                            <th>Nationality</th>
                            <th>Passport / ID numbers</th>
                            <th>Last changed</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Nothing to show.</td></tr>
                    }
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td><strong>@entry.Reference</strong></td>
                            <td>
                                @entry.Name
                                @if (entry.IsEntity)
                                {
                                    <span class="badge bg-light text-dark">Entity</span>
                                }
                            </td>
                            <td class="small">@Lines(entry.Aliases)</td>
                            <td class="small">@entry.DateOfBirth</td>
                            <td class="small">@entry.Nationality</td>
                            <td class="small">@Lines(entry.Identifiers)</td>
                            <td class="small text-muted">@entry.UpdatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
