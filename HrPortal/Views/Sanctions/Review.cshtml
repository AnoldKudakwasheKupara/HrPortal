@using HrPortal.Entities
@using HrPortal.Services.Sanctions
@model HrPortal.Entities.SanctionsList

@{
    ViewData["Title"] = Model.ReviewNumber;

    var pending = Model.Status == SanctionsReviewStatus.Pending;
    var inReview = Model.Status == SanctionsReviewStatus.InReview;

    var open = Model.Concerns.Where(c => c.Status == SanctionsConcernStatus.Open).ToList();
    var concerns = Model.Concerns
        .OrderBy(c => c.Status == SanctionsConcernStatus.Open ? 0 : 1)
        .ThenBy(c => c.Category)
        .ThenByDescending(c => c.Score)
        .ToList();

    var others = (IEnumerable<dynamic>)ViewBag.Others;

    static string Lines(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "" : string.Join("; ", text.Split('\n', StringSplitOptions.RemoveEmptyEntries));
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@Model.ReviewNumber</h2>
            <p class="text-muted mb-1" style="max-width: 900px;">@(Model.Title ?? Model.OriginalFileName)</p>
            <div class="detail-badges">
                <partial name="_SanctionsStatus" model="Model.Status" />
                @if (Model.DocumentReference != null)
                {
                    <span class="badge bg-light text-dark">@Model.DocumentReference</span>
                }
                @if (Model.IssuedOn != null)
                {
                    <span class="badge bg-light text-dark">Dated @Model.IssuedOn.Value.ToString("d MMM yyyy")</span>
                }
                <span class="badge bg-light text-dark">@Model.Entries.Count entries read</span>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Document" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Original PDF</a>
            @if (!pending)
            {
                <a asp-action="Report" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    @(Model.Status == SanctionsReviewStatus.SignedOff ? "Signed report" : "Preview report")
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header">The file</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <span class="field-label">File</span>
                    <div class="field-value">@Model.OriginalFileName</div>
                </div>
                <div class="col-md-4 mb-2">
                    <span class="field-label">Uploaded</span>
                    <div class="field-value">
                        @Model.UploadedAt.ToLocalTime().ToString("d MMM yyyy HH:mm") by @Model.UploadedByName
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <span class="field-label">Applied</span>
                    <div class="field-value">
                        @(Model.AppliedAt == null
                            ? "Not yet"
                            : $"{Model.AppliedAt.Value.ToLocalTime():d MMM yyyy HH:mm} by {Model.AppliedByName}")
                    </div>
                </div>
                <div class="col-12">
                    <span class="field-label">SHA-256 of the file</span>
                    <div class="field-value"><code>@Model.Sha256</code></div>
                </div>
            </div>
        </div>
    </div>

    @if (pending)
    {
        <form asp-action="Apply" asp-route-id="@Model.Id" method="post">

            <div class="card shadow-sm mb-3">
                <div class="card-header">Confirm what kind of document this is</div>
                <div class="card-body">

                    <p class="text-muted">
                        The portal guessed from the title. Check it, and on a notice that
                        removes some names and changes others, tick the ones being removed.
                        Nothing on the register changes until you apply it.
                    </p>

                    @foreach (var (kind, label, help) in new[]
                    {
                        (SanctionsListKind.Changes, "A notice of names added or amended",
                         "Each entry is added, or updated if already on the register. Nothing else changes."),
                        (SanctionsListKind.Removals, "A notice of names removed",
                         "Every entry in it comes off the register."),
                        (SanctionsListKind.FullList, "The full list",
                         "Becomes the register: anybody on the register but not in this document is removed.")
                    })
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="kind"
                                   id="kind-@kind" value="@kind" checked="@(Model.Kind == kind)" />
                            <label class="form-check-label" for="kind-@kind">
                                <strong>@label</strong>
                                <span class="d-block text-muted small">@help</span>
                            </label>
                        </div>
                    }

                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header">Entries read from the document</div>
                <div class="card-body is-table">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Name</th>
                                    <th>Also known as</th>
                                    <th>Date of birth</th>
                                    <th>Passport / ID numbers</th>
                                    <th>Being removed</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var entry in Model.Entries.OrderBy(e => e.Id))
                            {
                                <tr>
                                    <td><strong>@entry.Reference</strong></td>
                                    <td>@entry.Name</td>
                                    <td class="small">@Lines(entry.Aliases)</td>
                                    <td class="small">@entry.DateOfBirth</td>
                                    <td class="small">@Lines(entry.Identifiers)</td>
                                    <td>
                                        <input class="form-check-input" type="checkbox" name="removed"
                                               value="@entry.Id" aria-label="@entry.Reference is being removed" />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-4">
                <button type="submit" class="btn btn-primary">Apply to the register and screen</button>
            </div>

        </form>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mb-4"
              data-confirm="Delete @Model.ReviewNumber? It has not been applied, so nothing else changes."
              onsubmit="return confirm(this.dataset.confirm);">
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete this upload</button>
        </form>
    }
    else
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>Changes to the register</span>
                <span class="text-muted small">Register now holds @Model.RegisterSizeAfter listed parties</span>
            </div>
            <div class="card-body is-table">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Change</th>
                                <th>Reference</th>
                                <th>Name</th>
                                <th>What changed</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!Model.Changes.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Nothing on the register changed.</td></tr>
                        }
                        @foreach (var change in Model.Changes.OrderBy(c => c.Type).ThenBy(c => c.Reference))
                        {
                            <tr>
                                <td>
                                    <span class="badge @(change.Type switch
                                    {
                                        SanctionsChangeType.Added => "bg-danger",
                                        SanctionsChangeType.Removed => "bg-success",
                                        _ => "bg-warning text-dark"
                                    })">@change.Type</span>
                                </td>
                                <td><strong>@change.Reference</strong></td>
                                <td>@change.Name</td>
                                <td class="small" style="white-space: pre-line;">@change.Differences</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Screening</span>
                @if (inReview)
                {
                    <form asp-action="Rescreen" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Screen again</button>
                    </form>
                }
            </div>
            <div class="card-body">
                <p class="mb-1">
                    Checked <strong>@Model.ScreenedStaff</strong> staff,
                    <strong>@Model.ScreenedVendors</strong> vendors and
                    <strong>@Model.ScreenedClients</strong> clients against all
                    <strong>@Model.RegisterSizeAfter</strong> listed parties on the register.
                </p>
                <p class="text-muted small mb-0">
                    @(Model.ClientList == null
                        ? "No client list had been uploaded, so no clients were screened."
                        : $"Clients from {Model.ClientList.OriginalFileName}, uploaded {Model.ClientList.UploadedAt.ToLocalTime():d MMM yyyy}.")
                    Screening again picks up a newer client list without raising the same matter twice.
                </p>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between">
            <span>Matters of concern</span>
            <span class="text-muted small">@open.Count open of @concerns.Count</span>
        </div>
        <div class="card-body">

            @if (concerns.Count == 0)
            {
                <p class="text-muted mb-0">
                    @(pending
                        ? "Nothing raised yet. Matters are raised when the document is applied and screened."
                        : "Nothing was raised. Nobody screened resembles anyone on the register, and the document raised no discrepancies.")
                </p>
            }

            @foreach (var c in concerns)
            {
                var isMatch = c.Category == SanctionsConcernCategory.PossibleMatch;

                <div class="border rounded p-3 mb-3 @(c.Status == SanctionsConcernStatus.Open ? "border-warning" : "")">

                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <span class="badge @(isMatch ? "bg-danger" : "bg-secondary")">
                                @(isMatch ? $"Possible match · score {c.Score}" : "Discrepancy")
                            </span>
                            @if (isMatch)
                            {
                                <strong class="ms-1">@c.SubjectType: @c.SubjectName</strong>
                                <span class="text-muted">resembles</span>
                                <strong>@c.Reference @c.ListedName</strong>
                            }
                            else if (c.Reference != null)
                            {
                                <strong class="ms-1">@c.Reference @c.ListedName</strong>
                            }
                        </div>
                        <span class="badge @(c.Status == SanctionsConcernStatus.Open ? "bg-warning text-dark" : "bg-success")">
                            @c.Status
                        </span>
                    </div>

                    <p class="mt-2 mb-2">@c.Reason</p>

                    @if (c.Status != SanctionsConcernStatus.Open)
                    {
                        <p class="small mb-0">
                            <strong>Outcome:</strong> @c.Resolution
                            <span class="text-muted">
                                &middot; @c.ResolvedByName, @c.ResolvedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm")
                            </span>
                        </p>
                    }
                    else if (!pending)
                    {
                        <form asp-action="Resolve" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="concernId" value="@c.Id" />
                            <div class="col-md-3">
                                <label class="form-label small" for="outcome-@c.Id">Outcome</label>
                                <select id="outcome-@c.Id" name="outcome" class="form-select form-select-sm">
                                    @if (isMatch)
                                    {
                                        <option value="@SanctionsConcernStatus.Cleared">Cleared: not the listed party</option>
                                        <option value="@SanctionsConcernStatus.Confirmed">Confirmed: escalated</option>
                                    }
                                    else
                                    {
                                        <option value="@SanctionsConcernStatus.Resolved">Resolved</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label small" for="resolution-@c.Id">What was found</label>
                                <input id="resolution-@c.Id" name="resolution" class="form-control form-control-sm"
                                       maxlength="4000" required
                                       placeholder="@(isMatch ? "e.g. Different person: date of birth and ID number do not match" : "e.g. Full list uploaded as SAN-2026-0002")" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">Record</button>
                            </div>
                        </form>
                    }

                </div>
            }

        </div>
    </div>

    @if (inReview)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">Sign off</div>
            <div class="card-body">
                @if (open.Any())
                {
                    <p class="text-muted mb-0">
                        @open.Count matter(s) still open. Every matter must be resolved before the
                        review can be signed off.
                    </p>
                }
                else
                {
                    <form asp-action="SignOff" asp-route-id="@Model.Id" method="post">
                        <p>
                            Signing off records you as the reviewer, makes the report and keeps it
                            with its SHA-256 so any copy can be checked later. It cannot be undone.
                        </p>
                        <div class="mb-3">
                            <label for="note" class="form-label">Note for the report (optional)</label>
                            <textarea id="note" name="note" class="form-control" rows="2" maxlength="4000"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Sign off and make the report</button>
                    </form>
                }
            </div>
        </div>
    }

    @if (Model.Status == SanctionsReviewStatus.SignedOff)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">Signed off</div>
            <div class="card-body">
                <p class="mb-1">
                    By <strong>@Model.SignedOffByName</strong> on
                    @Model.SignedOffAt?.ToLocalTime().ToString("d MMM yyyy HH:mm").
                </p>
                @if (Model.SignOffNote != null)
                {
                    <p class="mb-1">@Model.SignOffNote</p>
                }
                <p class="small text-muted mb-0">Report SHA-256: <code>@Model.ReportSha256</code></p>
            </div>
        </div>
    }

    @if (others.Any())
    {
        <form asp-action="Compare" method="get" class="d-flex flex-wrap gap-2 align-items-end mb-4">
            <input type="hidden" name="b" value="@Model.Id" />
            <div>
                <label class="form-label small" for="compare-a">Compare this document with</label>
                <select id="compare-a" name="a" class="form-select form-select-sm">
                    @foreach (var other in others)
                    {
                        <option value="@other.Id">@other.ReviewNumber · @(((DateTime)other.UploadedAt).ToLocalTime().ToString("d MMM yyyy"))</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Compare</button>
        </form>
    }

</div>
