@using HrPortal.Entities
@using HrPortal.Services.Sanctions
@using HrPortal.ViewModels
@model SanctionsResultViewModel

@{
    var R = Model.Review;
    ViewData["Title"] = R.ReviewNumber;

    var finalised = R.FinalisedAt != null;
    var outstanding = Model.Outstanding;
    var dealtWith = Model.DealtWith;
    var setAside = Model.SetAside;
    var raised = R.Concerns.Where(c => c.Category == SanctionsConcernCategory.PossibleMatch && c.Strength != SanctionsMatchStrength.SetAside).ToList();

    var isNotice = R.NewDocument.Kind != SanctionsDocumentKind.FullList;
    var compared = R.PreviousDocument != null || isNotice;
    var changes = R.Changes.OrderBy(c => c.Type).ThenBy(c => c.Reference).ToList();

    SanctionsMatterView View(SanctionsConcern c) => new(
        c,
        c.Reference != null && Model.Entries.TryGetValue(c.Reference, out var entry) ? entry : null,
        Model.Subjects.TryGetValue(SanctionsResultViewModel.SubjectKey(c.SubjectType, c.SubjectId), out var subject) ? subject : null,
        !finalised,
        R.Id,
        R.NewDocumentId);
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@R.ReviewNumber</h2>
            <p class="text-muted mb-0">
                @R.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm") by @R.CreatedByName
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Report" asp-route-id="@R.Id" class="btn btn-outline-primary">
                @(finalised ? "Download the report" : "Preview the report")
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (R.CorrectsReview != null)
    {
        <div class="alert alert-info">
            This review corrects <a asp-action="Result" asp-route-id="@R.CorrectsReviewId">@R.CorrectsReview.ReviewNumber</a>,
            whose report is kept exactly as it was.
        </div>
    }

    @if (ViewBag.CorrectedBy is SanctionsReview correctedBy)
    {
        <div class="alert alert-warning">
            This review has been corrected by <a asp-action="Result" asp-route-id="@correctedBy.Id">@correctedBy.ReviewNumber</a>.
            Its report is kept unchanged for the record.
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header">What was found</div>
        <div class="card-body">
            <div class="sanctions-tally mb-3">
                @if (compared)
                {
                    <div><strong>@R.Changes.Count(c => c.Type == SanctionsChangeType.Added)</strong><span>New listings</span></div>
                    <div><strong>@R.Changes.Count(c => c.Type == SanctionsChangeType.Removed)</strong><span>Removed</span></div>
                    <div><strong>@R.Changes.Count(c => c.Type == SanctionsChangeType.Changed)</strong><span>Amended</span></div>
                    <div><strong>@R.UnchangedCount</strong><span>Unchanged</span></div>
                }
                <div><strong>@raised.Count(c => c.Strength == SanctionsMatchStrength.Exact)</strong><span>Exact matches</span></div>
                <div><strong>@raised.Count(c => c.Strength == SanctionsMatchStrength.Potential)</strong><span>Potential matches</span></div>
                <div><strong>@R.Concerns.Count(c => c.Category == SanctionsConcernCategory.Discrepancy)</strong><span>Discrepancies</span></div>
                <div class="@(outstanding.Any() ? "is-attention" : "")"><strong>@outstanding.Count</strong><span>Need a decision</span></div>
            </div>
            <ul class="mb-0">
                @foreach (var sentence in SanctionsFindings.Sentences(R))
                {
                    <li class="mb-1">@sentence</li>
                }
            </ul>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var (heading, document) in new[] { ("New document", (SanctionsDocument?)R.NewDocument), ("Compared with", R.PreviousDocument) })
        {
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header">@heading</div>
                    <div class="card-body">
                        @if (document == null)
                        {
                            <p class="text-muted mb-0">
                                @(isNotice
                                    ? "Each name in the notice was compared with its latest earlier version uploaded."
                                    : "Nothing. This was the first full list of its kind uploaded.")
                            </p>
                        }
                        else
                        {
                            <p class="mb-1"><strong>@document.Label</strong></p>
                            <p class="small mb-1">@document.Title</p>
                            <p class="small mb-1">
                                @SanctionsText.Kind(document.Kind)@(document.ListName == null ? "" : $" of the {document.ListName}")
                                &middot; @document.EntryCount names
                                @if (document.PageCount > 0)
                                {
                                    <span>&middot; @document.PageCount pages</span>
                                }
                                @if (document.Source != null)
                                {
                                    <span>&middot; issued by the @document.Source</span>
                                }
                            </p>
                            <p class="small mb-1">
                                <a asp-action="Document" asp-route-id="@document.Id">@document.OriginalFileName</a>
                                &middot; uploaded @document.UploadedAt.ToLocalTime().ToString("d MMM yyyy HH:mm") by @document.UploadedByName
                            </p>
                            <p class="small text-muted mb-0">SHA-256 <code>@document.Sha256</code></p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (compared)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">What changed</div>
            <div class="card-body">

                <div class="sanctions-tally mb-3">
                    <div><strong>@R.Changes.Count(c => c.Type == SanctionsChangeType.Added)</strong><span>Added</span></div>
                    <div><strong>@R.Changes.Count(c => c.Type == SanctionsChangeType.Removed)</strong><span>Removed</span></div>
                    <div><strong>@R.Changes.Count(c => c.Type == SanctionsChangeType.Changed)</strong><span>Amended</span></div>
                    <div><strong>@R.UnchangedCount</strong><span>Unchanged</span></div>
                    @if (R.NotComparedCount > 0)
                    {
                        <div><strong>@R.NotComparedCount</strong><span>Not compared</span></div>
                    }
                </div>

                @foreach (var note in SanctionsService.Lines(R.ComparisonNote))
                {
                    <p class="small text-muted mb-2">@note</p>
                }

                @if (changes.Count == 0)
                {
                    <p class="mb-0">No names were added, removed or amended.</p>
                }

                @foreach (var change in changes)
                {
                    var rows = SanctionsText.Differences(change.Differences);

                    <details class="sanctions-change">
                        <summary>
                            <span class="badge @(change.Type == SanctionsChangeType.Added ? "bg-danger" : change.Type == SanctionsChangeType.Removed ? "bg-secondary" : "bg-warning text-dark")">@SanctionsText.ChangeType(change.Type)</span>
                            <strong>@change.Reference</strong> @change.Name
                            @if (change.Page != null)
                            {
                                <span class="text-muted small">&middot; page @change.Page</span>
                            }
                        </summary>
                        <div class="pt-2">
                            @if (change.Note != null)
                            {
                                <p class="small text-muted mb-2">@change.Note</p>
                            }
                            @if (rows.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-top mb-0">
                                        <thead>
                                            <tr><th>Field</th><th>Previous information</th><th>New information</th></tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var row in rows)
                                        {
                                            <tr>
                                                <td>@row.Field</td>
                                                <td>@(row.Before ?? "—")</td>
                                                <td>@(row.After ?? "—")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (change.Type != SanctionsChangeType.Changed)
                            {
                                <p class="small mb-0">
                                    @(change.Type == SanctionsChangeType.Added ? "A new listing." : "No longer listed.")
                                    <a asp-action="Document" asp-route-id="@(change.Type == SanctionsChangeType.Removed && R.PreviousDocumentId != null ? R.PreviousDocumentId : R.NewDocumentId)">Open the document</a> to read the entry in full.
                                </p>
                            }
                        </div>
                    </details>
                }

            </div>
        </div>
    }


    <div class="card shadow-sm mb-3" id="needs-decision">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Needs your decision</span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge @(outstanding.Any() ? "bg-warning text-dark" : "bg-success")">@outstanding.Count</span>
                @if (!finalised)
                {
                    <form asp-action="CheckAgain" asp-route-id="@R.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Check people again</button>
                    </form>
                }
            </div>
        </div>
        <div class="card-body">
            @if (outstanding.Count == 0)
            {
                <p class="mb-0">
                    <i class="fas fa-circle-check text-success" aria-hidden="true"></i>
                    Nothing needs a decision.
                </p>
            }

            @foreach (var c in outstanding)
            {
                <partial name="_SanctionsMatter" model="View(c)" />
            }
        </div>
    </div>

    @if (dealtWith.Any())
    {
        <div class="card shadow-sm mb-3">
            <details>
                <summary class="card-header">Dealt with (@dealtWith.Count)</summary>
                <div class="card-body">
                    @foreach (var c in dealtWith)
                    {
                        <partial name="_SanctionsMatter" model="View(c)" />
                    }
                </div>
            </details>
        </div>
    }

    @if (setAside.Any())
    {
        <div class="card shadow-sm mb-3">
            <details>
                <summary class="card-header">Set aside automatically (@setAside.Count)</summary>
                <div class="card-body">
                    <p class="small text-muted">
                        These names resemble a listed name, but the date of birth the portal holds clearly
                        differs from the one listed, so they were not raised. Open any of them to look into it.
                    </p>
                    @foreach (var c in setAside)
                    {
                        <partial name="_SanctionsMatter" model="View(c)" />
                    }
                </div>
            </details>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">Finalise</div>
        <div class="card-body">
            @if (finalised)
            {
                <p class="mb-1">
                    Finalised by <strong>@R.FinalisedByName</strong> on
                    @R.FinalisedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm").
                    @R.Note
                </p>
                <p class="small text-muted mb-2">Report SHA-256 <code>@R.ReportSha256</code></p>
                @if (ViewBag.CorrectedBy == null)
                {
                    <form asp-action="Correct" asp-route-id="@R.Id" method="post" class="mb-0"
                          onsubmit="return confirm('Start a new review of the same documents to correct this one? This review and its report stay exactly as they are.');">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Correct this review</button>
                        <span class="small text-muted ms-2">Starts a new review of the same documents; this one and its report stay as they are.</span>
                    </form>
                }
            }
            else if (Model.FinaliseBlockers.Any())
            {
                <p class="mb-1">This review cannot be finalised yet:</p>
                <ul class="mb-0">
                    @foreach (var reason in Model.FinaliseBlockers)
                    {
                        <li>@reason</li>
                    }
                </ul>
            }
            else
            {
                <form asp-action="Finalise" asp-route-id="@R.Id" method="post">
                    <p>
                        Finalising records you as the reviewer and makes the report. The portal keeps
                        it with its SHA-256 so any copy can be checked later.
                    </p>
                    @if (R.Concerns.Any(c => c.Status == SanctionsConcernStatus.UnableToDetermine))
                    {
                        <p class="small text-muted">
                            Matters recorded as unable to determine will be listed in the report as outstanding.
                        </p>
                    }
                    <div class="mb-3">
                        <label for="note" class="form-label">Note for the report (optional)</label>
                        <textarea id="note" name="note" class="form-control" rows="2" maxlength="4000"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Finalise and make the report</button>
                </form>
            }
        </div>
    </div>

</div>
