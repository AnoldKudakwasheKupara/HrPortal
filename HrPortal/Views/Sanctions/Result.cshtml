@using HrPortal.Entities
@using HrPortal.Services.Sanctions
@model HrPortal.Entities.SanctionsReview

@{
    ViewData["Title"] = Model.ReviewNumber;

    var finalised = Model.FinalisedAt != null;
    var open = Model.Concerns.Where(c => c.Status == SanctionsConcernStatus.Open).ToList();
    var matters = Model.Concerns
        .OrderBy(c => c.Status == SanctionsConcernStatus.Open ? 0 : 1)
        .ThenBy(c => c.Category)
        .ThenByDescending(c => c.Score)
        .ToList();

    var isNotice = Model.NewDocument.Kind != SanctionsDocumentKind.FullList;
    var compared = Model.PreviousDocument != null || isNotice;
    var changes = Model.Changes.OrderBy(c => c.Type).ThenBy(c => c.Reference).ToList();
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@Model.ReviewNumber</h2>
            <p class="text-muted mb-0">
                @Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm") by @Model.CreatedByName
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Report" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                @(finalised ? "Download the report" : "Preview the report")
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header">What was found</div>
        <div class="card-body">
            <ul class="mb-0">
                @foreach (var sentence in SanctionsFindings.Sentences(Model))
                {
                    <li class="mb-1">@sentence</li>
                }
            </ul>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var (heading, document) in new[] { ("New document", (SanctionsDocument?)Model.NewDocument), ("Compared with", Model.PreviousDocument) })
        {
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header">@heading</div>
                    <div class="card-body">
                        @if (document == null)
                        {
                            <p class="text-muted mb-0">
                                @(isNotice
                                    ? "Each name in the notice was compared with its latest earlier version uploaded."
                                    : "Nothing. This was the first full list of its kind uploaded.")
                            </p>
                        }
                        else
                        {
                            <p class="mb-1"><strong>@document.Label</strong></p>
                            <p class="small mb-1">@document.Title</p>
                            <p class="small mb-1">
                                @SanctionsText.Kind(document.Kind)@(document.ListName == null ? "" : $" of the {document.ListName}")
                                &middot; @document.EntryCount names
                                @if (document.PageCount > 0)
                                {
                                    <span>&middot; @document.PageCount pages</span>
                                }
                                @if (document.Source != null)
                                {
                                    <span>&middot; issued by the @document.Source</span>
                                }
                            </p>
                            <p class="small mb-1">
                                <a asp-action="Document" asp-route-id="@document.Id">@document.OriginalFileName</a>
                                &middot; uploaded @document.UploadedAt.ToLocalTime().ToString("d MMM yyyy HH:mm") by @document.UploadedByName
                            </p>
                            <p class="small text-muted mb-0">SHA-256 <code>@document.Sha256</code></p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (compared)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">What changed</div>
            <div class="card-body">

                <div class="sanctions-tally mb-3">
                    <div><strong>@Model.Changes.Count(c => c.Type == SanctionsChangeType.Added)</strong><span>Added</span></div>
                    <div><strong>@Model.Changes.Count(c => c.Type == SanctionsChangeType.Removed)</strong><span>Removed</span></div>
                    <div><strong>@Model.Changes.Count(c => c.Type == SanctionsChangeType.Changed)</strong><span>Amended</span></div>
                    <div><strong>@Model.UnchangedCount</strong><span>Unchanged</span></div>
                    @if (Model.NotComparedCount > 0)
                    {
                        <div><strong>@Model.NotComparedCount</strong><span>Not compared</span></div>
                    }
                </div>

                @foreach (var note in SanctionsService.Lines(Model.ComparisonNote))
                {
                    <p class="small text-muted mb-2">@note</p>
                }

                @if (changes.Count == 0)
                {
                    <p class="mb-0">No names were added, removed or amended.</p>
                }

                @foreach (var change in changes)
                {
                    var rows = SanctionsText.Differences(change.Differences);

                    <details class="sanctions-change">
                        <summary>
                            <span class="badge @(change.Type == SanctionsChangeType.Added ? "bg-danger" : change.Type == SanctionsChangeType.Removed ? "bg-secondary" : "bg-warning text-dark")">@SanctionsText.ChangeType(change.Type)</span>
                            <strong>@change.Reference</strong> @change.Name
                            @if (change.Page != null)
                            {
                                <span class="text-muted small">&middot; page @change.Page</span>
                            }
                        </summary>
                        <div class="pt-2">
                            @if (change.Note != null)
                            {
                                <p class="small text-muted mb-2">@change.Note</p>
                            }
                            @if (rows.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-top mb-0">
                                        <thead>
                                            <tr><th>Field</th><th>Previous information</th><th>New information</th></tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var row in rows)
                                        {
                                            <tr>
                                                <td>@row.Field</td>
                                                <td>@(row.Before ?? "—")</td>
                                                <td>@(row.After ?? "—")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (change.Type != SanctionsChangeType.Changed)
                            {
                                <p class="small mb-0">
                                    @(change.Type == SanctionsChangeType.Added ? "A new listing." : "No longer listed.")
                                    <a asp-action="Document" asp-route-id="@(change.Type == SanctionsChangeType.Removed && Model.PreviousDocumentId != null ? Model.PreviousDocumentId : Model.NewDocumentId)">Open the document</a> to read the entry in full.
                                </p>
                            }
                        </div>
                    </details>
                }

            </div>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Things to look into</span>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">@open.Count open of @matters.Count</span>
                @if (!finalised)
                {
                    <form asp-action="CheckAgain" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Check people again</button>
                    </form>
                }
            </div>
        </div>
        <div class="card-body">

            @if (matters.Count == 0)
            {
                <p class="mb-0">
                    <i class="fas fa-circle-check text-success" aria-hidden="true"></i>
                    Nothing to look into: no discrepancies, and nobody the company deals with is on the new document.
                </p>
            }

            @foreach (var c in matters)
            {
                var isMatch = c.Category == SanctionsConcernCategory.PossibleMatch;

                <div class="border rounded p-3 mb-3 @(c.Status == SanctionsConcernStatus.Open ? "border-warning" : "")">

                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <span class="badge @(isMatch ? "bg-danger" : "bg-secondary")">
                                @(isMatch ? "Possible match" : "Discrepancy")
                            </span>
                            @if (isMatch)
                            {
                                <strong class="ms-1">@c.SubjectType @c.SubjectName</strong>
                                <span class="text-muted">resembles</span>
                                <strong>@c.Reference @c.ListedName</strong>
                            }
                        </div>
                        <span class="badge @(c.Status == SanctionsConcernStatus.Open ? "bg-warning text-dark" : "bg-success")">@c.Status</span>
                    </div>

                    <p class="mt-2 mb-2">@c.Reason</p>

                    @if (c.Status != SanctionsConcernStatus.Open)
                    {
                        <p class="small mb-0">
                            <strong>Outcome:</strong> @c.Resolution
                            <span class="text-muted">&middot; @c.ResolvedByName, @c.ResolvedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm")</span>
                        </p>
                    }
                    else if (!finalised)
                    {
                        <form asp-action="Resolve" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="concernId" value="@c.Id" />
                            <div class="col-md-3">
                                <label class="form-label small" for="outcome-@c.Id">Outcome</label>
                                <select id="outcome-@c.Id" name="outcome" class="form-select form-select-sm">
                                    @if (isMatch)
                                    {
                                        <option value="@SanctionsConcernStatus.Cleared">Not the same person</option>
                                        <option value="@SanctionsConcernStatus.Confirmed">Same person: escalated</option>
                                    }
                                    else
                                    {
                                        <option value="@SanctionsConcernStatus.Resolved">Dealt with</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label small" for="resolution-@c.Id">What you found</label>
                                <input id="resolution-@c.Id" name="resolution" class="form-control form-control-sm" maxlength="4000" required
                                       placeholder="@(isMatch ? "e.g. Different person: date of birth and ID number do not match" : "e.g. Checked with the FIU; the earlier notice was superseded")" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">Save</button>
                            </div>
                        </form>
                    }

                </div>
            }

        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">Finalise</div>
        <div class="card-body">
            @if (finalised)
            {
                <p class="mb-1">
                    Finalised by <strong>@Model.FinalisedByName</strong> on
                    @Model.FinalisedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm").
                    @Model.Note
                </p>
                <p class="small text-muted mb-0">Report SHA-256 <code>@Model.ReportSha256</code></p>
            }
            else if (open.Any())
            {
                <p class="text-muted mb-0">
                    Save an outcome for the @(open.Count == 1 ? "1 open item" : $"{open.Count} open items") above,
                    then finalise to make the report.
                </p>
            }
            else
            {
                <form asp-action="Finalise" asp-route-id="@Model.Id" method="post">
                    <p>
                        Finalising records you as the reviewer and makes the report. The portal keeps
                        it with its SHA-256 so any copy can be checked later.
                    </p>
                    <div class="mb-3">
                        <label for="note" class="form-label">Note for the report (optional)</label>
                        <textarea id="note" name="note" class="form-control" rows="2" maxlength="4000"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Finalise and make the report</button>
                </form>
            }
        </div>
    </div>

</div>
