@model HrPortal.Entities.SanctionsReviewStatus

@switch (Model)
{
    case HrPortal.Entities.SanctionsReviewStatus.Pending:
        <span class="badge bg-secondary">Not yet applied</span>
        break;
    case HrPortal.Entities.SanctionsReviewStatus.InReview:
        <span class="badge bg-warning text-dark">In review</span>
        break;
    default:
        <span class="badge bg-success">Signed off</span>
        break;
}
