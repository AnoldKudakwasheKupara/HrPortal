@using HrPortal.Entities
@model List<HrPortal.Entities.SanctionsList>

@{
    ViewData["Title"] = "Sanctions screening";

    var registerSize = (int)ViewBag.RegisterSize;
    var clientList = ViewBag.ClientList as SanctionsClientList;
    var openMatters = (int)ViewBag.OpenMatters;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>Sanctions screening</h2>
            <p class="text-muted mb-0">
                Every document received from the FIU, what it changed on the
                register, and the screening of staff, vendors and clients
                against it. Only compliance officers can see this.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Upload" class="btn btn-primary">
                <i class="fas fa-upload" aria-hidden="true"></i> Upload a document
            </a>
            <a asp-action="Register" class="btn btn-outline-secondary">Register</a>
            <a asp-action="Compare" class="btn btn-outline-secondary">Compare two</a>
            <a asp-action="Clients" class="btn btn-outline-secondary">Client list</a>
            <a asp-action="Verify" class="btn btn-outline-secondary">Verify a report</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-stats">

        <a class="report-stat" asp-action="Register">
            <span class="report-stat-label">On the register</span>
            <span class="report-stat-value">@registerSize</span>
            <span class="report-stat-note">Listed parties screened against</span>
        </a>

        <a class="report-stat @(clientList == null ? "is-warning" : "")" asp-action="Clients">
            <span class="report-stat-label">Clients</span>
            <span class="report-stat-value">@(clientList?.Clients.Count ?? 0)</span>
            <span class="report-stat-note">
                @(clientList == null
                    ? "No client list uploaded yet"
                    : $"From {clientList.UploadedAt.ToLocalTime():d MMM yyyy}")
            </span>
        </a>

        <div class="report-stat @(openMatters > 0 ? "is-warning" : "is-good")">
            <span class="report-stat-label">Open matters</span>
            <span class="report-stat-value">@openMatters</span>
            <span class="report-stat-note">To resolve before sign-off</span>
        </div>

    </div>

    @if (registerSize == 0)
    {
        <div class="alert alert-info">
            The register is empty. Screening checks people against the register,
            so start by uploading the full UN consolidated list (or the FIU's full
            list). After that, each notice the FIU sends brings it up to date.
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header">Documents received</div>
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Review</th>
                            <th>Document</th>
                            <th>Dated</th>
                            <th class="num">Added</th>
                            <th class="num">Amended</th>
                            <th class="num">Removed</th>
                            <th class="num">Open matters</th>
                            <th>Status</th>
                            <th class="col-actions"></th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Nothing uploaded yet.
                            </td>
                        </tr>
                    }

                    @foreach (var list in Model)
                    {
                        <tr>
                            <td>
                                <strong>@list.ReviewNumber</strong>
                                <div class="text-muted small">
                                    uploaded @list.UploadedAt.ToLocalTime().ToString("d MMM yyyy")
                                </div>
                            </td>
                            <td style="max-width: 380px;">
                                @(list.Title ?? list.OriginalFileName)
                                @if (list.DocumentReference != null)
                                {
                                    <div class="text-muted small">@list.DocumentReference</div>
                                }
                            </td>
                            <td>@list.IssuedOn?.ToString("d MMM yyyy")</td>
                            <td class="num">@list.Changes.Count(c => c.Type == SanctionsChangeType.Added)</td>
                            <td class="num">@list.Changes.Count(c => c.Type == SanctionsChangeType.Amended)</td>
                            <td class="num">@list.Changes.Count(c => c.Type == SanctionsChangeType.Removed)</td>
                            <td class="num">@list.Concerns.Count(c => c.Status == SanctionsConcernStatus.Open)</td>
                            <td><partial name="_SanctionsStatus" model="list.Status" /></td>
                            <td class="col-actions">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Review" asp-route-id="@list.Id">Open</a>
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
