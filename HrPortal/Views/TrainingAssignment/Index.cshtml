@model IEnumerable<HrPortal.Entities.TrainingAssignment>

@{
    ViewData["Title"] = "Training Assignments";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Training Assignments</h2>

            <p class="text-muted">
                Track which employees are booked onto which courses.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Assign Employees
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-4">

                    <label for="courseId"
                           class="form-label">
                        Training Course
                    </label>

                    <select id="courseId"
                            name="courseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">

                        <option value="">
                            -- All Courses --
                        </option>

                    </select>

                </div>

                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-outline-secondary">
                        Filter
                    </button>

                </div>

            </form>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Employee</th>
                            <th>Assigned</th>
                            <th>Due</th>
                            <th>Completed</th>
                            <th>Feedback</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var assignment in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @assignment.TrainingCourse.Title
                                </strong>
                            </td>

                            <td>
                                @assignment.Employee.FirstName
                                @assignment.Employee.LastName
                            </td>

                            <td>
                                @assignment.AssignedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (assignment.DueDate.HasValue)
                                {
                                    if (!assignment.IsCompleted &&
                                        assignment.DueDate.Value.Date < DateTime.Today)
                                    {
                                        <span class="badge bg-danger">
                                            Overdue
                                            @assignment.DueDate.Value.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        @assignment.DueDate.Value.ToString("dd MMM yyyy")
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No due date
                                    </span>
                                }
                            </td>

                            <td>
                                @if (assignment.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Outstanding
                                    </span>
                                }
                            </td>

                            <td>
                                @if (assignment.Feedback != null)
                                {
                                    <span class="badge bg-info text-dark">
                                        @assignment.Feedback.Rating / 5
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        None
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="dropdown">

                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">

                                        Actions

                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@assignment.Id">

                                                View

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@assignment.Id">

                                                Edit

                                            </a>
                                        </li>

                                        <li>

                                            <form asp-action="ToggleCompletion"
                                                  asp-route-id="@assignment.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item">

                                                    @(assignment.IsCompleted
                                                        ? "Mark Outstanding"
                                                        : "Mark Completed")

                                                </button>

                                            </form>

                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@assignment.Id">

                                                Delete

                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

                @if (!Model.Any())
                {
                    <p class="text-muted mb-0">
                        No training assignments match this filter.
                    </p>
                }

            </div>

        </div>

    </div>

</div>
