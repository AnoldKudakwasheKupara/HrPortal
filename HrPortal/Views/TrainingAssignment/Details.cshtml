@model HrPortal.Entities.TrainingAssignment

@{
    ViewData["Title"] = "Training Assignment Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.TrainingCourse.Title</h2>

            <p class="text-muted">
                Assignment for
                @Model.Employee.FirstName
                @Model.Employee.LastName
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Course</span>

                    <div class="field-value">
                        @Model.TrainingCourse.Title
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <div class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <div class="field-value">
                        @Model.Employee.Department.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Assigned</span>

                    <div class="field-value">
                        @Model.AssignedAt.ToString("dd MMM yyyy")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Due Date</span>

                    <div class="field-value">
                        @if (Model.DueDate.HasValue)
                        {
                            if (!Model.IsCompleted &&
                                Model.DueDate.Value.Date < DateTime.Today)
                            {
                                <span class="badge bg-danger">
                                    Overdue
                                    @Model.DueDate.Value.ToString("dd MMM yyyy")
                                </span>
                            }
                            else
                            {
                                @Model.DueDate.Value.ToString("dd MMM yyyy")
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                No due date
                            </span>
                        }
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Status</span>

                    <div class="field-value">
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Outstanding
                            </span>
                        }
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Completed On</span>

                    <div class="field-value">
                        @if (Model.CompletedAt.HasValue)
                        {
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span class="text-muted">
                                Not completed
                            </span>
                        }
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">Feedback</div>

        <div class="card-body">

            @if (Model.Feedback != null)
            {
                <div class="row g-3">

                    <div class="col-md-4">

                        <span class="field-label">Rating</span>

                        <div class="field-value">
                            <span class="badge bg-info text-dark">
                                @Model.Feedback.Rating / 5
                            </span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <span class="field-label">Submitted</span>

                        <div class="field-value">
                            @Model.Feedback.SubmittedAt.ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="col-12">

                        <span class="field-label">Comments</span>

                        <div class="field-value">
                            @(Model.Feedback.Comments ?? "No comments given.")
                        </div>

                    </div>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No feedback has been submitted for this assignment.
                </p>
            }

        </div>

    </div>

</div>
