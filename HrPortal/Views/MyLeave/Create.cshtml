@model HrPortal.ViewModels.MyLeaveRequestViewModel

@{
    ViewData["Title"] = "Request Leave";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Request Leave</h2>

        <p class="text-muted">
            The number of days is counted from your dates, skipping
            weekends. Your request goes to HR first, then to the
            Managing Director.
        </p>

    </div>

    @{
        var applicant = ViewBag.Applicant as HrPortal.Entities.Employee;

        var balances = ViewBag.Balances
            as List<HrPortal.Entities.LeaveBalance>
            ?? new List<HrPortal.Entities.LeaveBalance>();
    }

    @if (applicant != null)
    {
        <div class="card shadow-sm mb-3">

            <div class="card-header d-flex justify-content-between align-items-center">

                <span>Applicant</span>

                <span class="text-muted small">From your record</span>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-sm-6 col-lg-3">
                        <span class="field-label">First name</span>
                        <div class="field-value">@applicant.FirstName</div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <span class="field-label">Surname</span>
                        <div class="field-value">@applicant.LastName</div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <span class="field-label">Employee number</span>
                        <div class="field-value">@applicant.EmployeeNumber</div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <span class="field-label">Department</span>
                        <div class="field-value">
                            @(applicant.Department?.Name ?? "--")
                        </div>
                    </div>

                </div>

            </div>

        </div>
    }

    @if (balances.Any())
    {
        <div class="card shadow-sm mb-3">

            <div class="card-header d-flex justify-content-between align-items-center">

                <span>Your leave days</span>

                <span class="text-muted small">@DateTime.Today.Year</span>

            </div>

            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Type of leave</th>
                                <th class="num">Total days taken</th>
                                <th class="num">Total days accrued</th>
                                <th class="num">Days balance</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var balance in balances)
                        {
                            <tr>
                                <td>@balance.LeaveType.Name</td>
                                <td class="num">@balance.UsedDays.ToString("0.##")</td>
                                <td class="num">@balance.AllocatedDays.ToString("0.##")</td>
                                <td class="num">@balance.RemainingDays.ToString("0.##")</td>
                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="LeaveTypeId"
                               class="form-label">
                        </label>

                        <select asp-for="LeaveTypeId"
                                asp-items="ViewBag.LeaveTypes"
                                class="form-select">

                            <option value="">
                                -- Select Leave Type --
                            </option>

                        </select>

                        <span asp-validation-for="LeaveTypeId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="EndDate"
                               class="form-label">
                        </label>

                        <input asp-for="EndDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="Reason"
                           class="form-label">
                    </label>

                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="4"
                              placeholder="Why are you requesting this leave?">
                    </textarea>

                    <span asp-validation-for="Reason"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    Submit Request

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
