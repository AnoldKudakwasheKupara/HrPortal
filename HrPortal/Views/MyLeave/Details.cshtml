@model HrPortal.Entities.LeaveRequest

@{
    ViewData["Title"] = "My Leave Request";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.RequestNumber</h2>

            <p class="text-muted">
                @Model.LeaveType.Name
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            Back

        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Leave Type</span>

                    <p class="field-value">@Model.LeaveType.Name</p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Dates</span>

                    <p class="field-value">
                        @Model.StartDate.ToString("dd MMM yyyy")
                        &ndash;
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Working Days</span>

                    <p class="field-value">@Model.NumberOfDays.ToString("0.##")</p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Status</span>

                    <p class="field-value">
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Submitted</span>

                    <p class="field-value">
                        @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Completed</span>

                    <p class="field-value">
                        @if (Model.CompletedAt.HasValue)
                        {
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                Still in progress
                            </span>
                        }
                    </p>

                </div>

                <div class="col-12">

                    <span class="field-label">Reason</span>

                    <p class="field-value">@(Model.Reason ?? "No reason given.")</p>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">Progress</div>

        <div class="card-body @(Model.History.Any() ? "is-table" : "")">

            @if (Model.History.Any())
            {
                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>By</th>
                                <th>Date</th>
                                <th>Status Change</th>
                                <th>Comment</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var entry in Model.History
                            .OrderBy(h => h.ActionDate))
                        {
                            <tr>

                                <td>
                                    <strong>@entry.Action</strong>
                                </td>

                                <td>
                                    @entry.ActionedByEmployee.FirstName
                                    @entry.ActionedByEmployee.LastName
                                </td>

                                <td>
                                    @entry.ActionDate.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @entry.PreviousStatus
                                    </span>
                                    &rarr;
                                    @entry.NewStatus
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                    {
                                        @entry.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No comment
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    Nothing has happened to this request yet.
                </p>
            }

        </div>

    </div>

</div>
