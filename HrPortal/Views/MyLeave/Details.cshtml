@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.LeaveRequest

@{
    ViewData["Title"] = "My Leave Request";

    var balance = ViewBag.Balance as LeaveBalance;
    var withEmployee = LeaveWorkflowService.IsWithEmployee(Model.Status);
    var final = LeaveWorkflowService.IsFinal(Model.Status);
    var dates = Model.StartDate.Date == Model.EndDate.Date
        ? Model.StartDate.ToString("d MMM yyyy")
        : $"{Model.StartDate:d MMM yyyy} – {Model.EndDate:d MMM yyyy}";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.RequestNumber</h2>
            <p>@Model.LeaveType.Name, @dates</p>
        </div>

        <div class="head-actions">

            <partial name="_LeaveStatusBadge" model="Model.Status" />

            <a class="btn btn-outline-secondary" asp-action="Form" asp-route-id="@Model.Id">
                <i class="fas fa-download" aria-hidden="true"></i> Application form (PDF)
            </a>

            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <div class="panel-head-split">
                    <h3 class="panel-head">
                        <i class="fas fa-calendar-days" aria-hidden="true"></i> Request Details
                    </h3>
                    <partial name="_LeaveStatusBadge" model="Model.Status" />
                </div>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div><span>Applicant</span><strong>@Model.Employee.FirstName @Model.Employee.LastName</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-hashtag" aria-hidden="true"></i>
                        <div><span>Employee number</span><strong>@Model.Employee.EmployeeNumber</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-building" aria-hidden="true"></i>
                        <div><span>Department</span><strong>@(Model.Employee.Department?.Name ?? "--")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-tags" aria-hidden="true"></i>
                        <div><span>Leave type</span><strong>@Model.LeaveType.Name</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-week" aria-hidden="true"></i>
                        <div><span>Dates</span><strong>@dates</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-business-time" aria-hidden="true"></i>
                        <div><span>Working days</span><strong>@Model.NumberOfDays.ToString("0.##")</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-comment" aria-hidden="true"></i> Reason</h4>
                    <p class="pre-line">@(Model.Reason ?? "No reason given.")</p>
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Progress
                </h3>

                <partial name="_Timeline" model="Timeline.Of(Model.History)" />

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> What Happens Next
                </h3>

                <p class="small text-muted">
                    @if (withEmployee)
                    {
                        <text>This is back with you. Edit it and send it again, or cancel it.</text>
                    }
                    else if (final)
                    {
                        <text>A decision has been made. Nothing more is needed from you.</text>
                    }
                    else
                    {
                        <text>This is being looked at. You will get a notification when it moves on.</text>
                    }
                </p>

                <div class="d-grid gap-2">

                    @if (withEmployee)
                    {
                        <a class="btn btn-gold" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit and resend
                        </a>
                    }

                    @if (!final)
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-grid"
                              onsubmit="return confirm('Cancel @Model.RequestNumber?');">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fas fa-xmark" aria-hidden="true"></i> Cancel request
                            </button>
                        </form>
                    }

                    <a class="btn btn-outline-secondary" asp-action="Form" asp-route-id="@Model.Id">
                        <i class="fas fa-download" aria-hidden="true"></i> Download the form
                    </a>

                </div>

            </section>

            @if (balance != null)
            {
                <section class="panel-card mb-3">

                    <h3 class="panel-head">
                        <i class="fas fa-scale-balanced" aria-hidden="true"></i> @Model.LeaveType.Name, @balance.Year
                    </h3>

                    <dl class="info-list">
                        <dt>Days accrued</dt>
                        <dd>@balance.AllocatedDays.ToString("0.##")</dd>
                        <dt>Days taken</dt>
                        <dd>@balance.UsedDays.ToString("0.##")</dd>
                        <dt>Days pending</dt>
                        <dd>@balance.PendingDays.ToString("0.##")</dd>
                        <dt>Balance</dt>
                        <dd class="@(balance.RemainingDays < 0 ? "text-danger" : "")">@balance.RemainingDays.ToString("0.##")</dd>
                    </dl>

                </section>
            }

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Request Information
                </h3>

                <dl class="info-list">
                    <dt>Request No.</dt>
                    <dd>@Model.RequestNumber</dd>
                    <dt>Status</dt>
                    <dd><partial name="_LeaveStatusBadge" model="Model.Status" /></dd>
                    <dt>Submitted</dt>
                    <dd>@Model.SubmittedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                    <dt>Completed</dt>
                    <dd>@(Model.CompletedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "Still in progress")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
