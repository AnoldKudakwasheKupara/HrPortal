@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.ViewModels.MyLeaveIndexViewModel

@{
    ViewData["Title"] = "My Leave";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>My Leave</h2>

            <p class="text-muted">
                Your leave balances and the requests you have made.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Request Leave
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <strong>
                My Balances for @DateTime.Today.Year
            </strong>

        </div>

        <div class="card-body">

            @if (Model.Balances.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Leave Type</th>
                                <th>Allocated</th>
                                <th>Used</th>
                                <th>Pending</th>
                                <th>Remaining</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var balance in Model.Balances)
                        {
                            <tr>
                                <td>@balance.LeaveType.Name</td>
                                <td>@balance.AllocatedDays.ToString("0.##")</td>
                                <td>@balance.UsedDays.ToString("0.##")</td>
                                <td>@balance.PendingDays.ToString("0.##")</td>
                                <td>
                                    <span class="badge bg-success">
                                        @balance.RemainingDays.ToString("0.##")
                                    </span>
                                </td>
                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No leave balances have been set up for you yet.
                    You can still request leave types that are not
                    rationed.
                </p>
            }

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">

            <strong>
                My Requests
            </strong>

        </div>

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var request in Model.Requests)
                    {
                        <tr>

                            <td>
                                <strong>@request.RequestNumber</strong>
                            </td>

                            <td>
                                @request.LeaveType.Name
                            </td>

                            <td>
                                @request.StartDate.ToString("dd MMM yyyy")
                                &ndash;
                                @request.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @request.NumberOfDays.ToString("0.##")
                            </td>

                            <td>
                                @switch (request.Status)
                                {
                                    case LeaveRequestStatus.Approved:
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                        break;

                                    case LeaveRequestStatus.Rejected:
                                    case LeaveRequestStatus.HRRejected:
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                        break;

                                    case LeaveRequestStatus.Cancelled:
                                        <span class="badge bg-secondary">
                                            Cancelled
                                        </span>
                                        break;

                                    case LeaveRequestStatus.ReturnedToEmployee:
                                        <span class="badge bg-warning text-dark">
                                            Returned to you
                                        </span>
                                        break;

                                    case LeaveRequestStatus.HRApproved:
                                        <span class="badge bg-info text-dark">
                                            With the MD
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-info text-dark">
                                            With HR
                                        </span>
                                        break;
                                }
                            </td>

                            <td>

                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Details"
                                   asp-route-id="@request.Id">
                                    View
                                </a>

                                @if (LeaveWorkflowService.IsWithEmployee(
                                    request.Status))
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit"
                                       asp-route-id="@request.Id">
                                        Edit and resend
                                    </a>
                                }

                                @if (!LeaveWorkflowService.IsFinal(
                                    request.Status))
                                {
                                    <form asp-action="Cancel"
                                          asp-route-id="@request.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Cancel
                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

                @if (!Model.Requests.Any())
                {
                    <p class="text-muted mb-0">
                        You have not made any leave requests yet.
                    </p>
                }

            </div>

        </div>

    </div>

</div>
