@model IEnumerable<HrPortal.ViewModels.PositionListViewModel>

@{
    ViewData["Title"] = "Positions";

    var includeRetired = (bool)ViewBag.IncludeRetired;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>Positions</h2>
            <p class="text-muted mb-0">
                The posts the organisation has, how many of each are
                budgeted for and how many are filled.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Add Position</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-stats">

        <div class="report-stat">
            <span class="report-stat-label">Positions</span>
            <span class="report-stat-value">@Model.Count()</span>
            <span class="report-stat-note">On the register</span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">Filled</span>
            <span class="report-stat-value">@ViewBag.TotalFilled</span>
            <span class="report-stat-note">People in post</span>
        </div>

        <div class="report-stat">
            <span class="report-stat-label">Budgeted</span>
            <span class="report-stat-value">@ViewBag.TotalEstablishment</span>
            <span class="report-stat-note">Where a number is set</span>
        </div>

        <div class="report-stat @(((int)ViewBag.Vacancies) > 0 ? "is-warning" : "is-good")">
            <span class="report-stat-label">Vacancies</span>
            <span class="report-stat-value">@ViewBag.Vacancies</span>
            <span class="report-stat-note">Budgeted but unfilled</span>
        </div>

    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="d-flex gap-2 align-items-center">
                <div class="form-check">
                    <input name="includeRetired" value="true" type="checkbox"
                           class="form-check-input"
                           checked="@includeRetired" />
                    <label class="form-check-label">
                        Include positions no longer in use
                    </label>
                </div>
                <button type="submit" class="btn btn-secondary">Apply</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Position</th>
                            <th>Department</th>
                            <th class="num">Budgeted</th>
                            <th class="num">Filled</th>
                            <th>Vacancies</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No positions on the register yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@p.Title</strong>
                                    @if (!p.IsActive)
                                    {
                                        <span class="badge bg-secondary">
                                            Not in use
                                        </span>
                                    }
                                </td>

                                <td>@(p.Department ?? "--")</td>

                                <td class="num">
                                    @(p.Establishment?.ToString() ?? "--")
                                </td>

                                <td class="num">@p.Filled</td>

                                <td>
                                    @if (p.Establishment == null)
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                    else if (p.IsOverFilled)
                                    {
                                        <span class="badge bg-danger">
                                            @(p.Filled - p.Establishment.Value) over
                                        </span>
                                    }
                                    else if (p.Vacancies > 0)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @p.Vacancies vacant
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Full</span>
                                    }
                                </td>

                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Edit" asp-route-id="@p.Id">
                                            Edit
                                        </a>
                                        <form asp-action="Delete"
                                              asp-route-id="@p.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
