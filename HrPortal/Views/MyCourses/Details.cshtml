@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.CourseApplication

@{
    ViewData["Title"] = "Course Application";

    var withApplicant =
        CourseApplicationWorkflowService.IsWithApplicant(Model.Status);

    var canSend = CourseApplicationWorkflowService.CanAct(
        CourseApplicationAction.Submitted, Model.Status);

    var canCancel = CourseApplicationWorkflowService.CanAct(
        CourseApplicationAction.Cancelled, Model.Status);
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.ApplicationNumber</h2>

            <p class="text-muted mb-0">@Model.ProgramIntended</p>
        </div>

        <div class="table-actions">

            <a class="btn btn-outline-secondary"
               asp-action="Form"
               asp-route-id="@Model.Id">
                <i class="fas fa-download" aria-hidden="true"></i>
                Application form (PDF)
            </a>

            <a class="btn btn-secondary" asp-action="Index">
                Back
            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <partial name="_CourseApplicationCard" model="Model" />

    @if (withApplicant || canCancel)
    {
        <div class="card shadow-sm mb-3">

            <div class="card-header">What happens next</div>

            <div class="card-body">

                <div class="field-value mb-3">
                    @if (withApplicant)
                    {
                        <text>
                            This is still with you. Send it and HR will
                            review it, then the Managing Consultant
                            decides.
                        </text>
                    }
                    else
                    {
                        <text>This is being looked at.</text>
                    }
                </div>

                <div class="table-actions">

                    @if (canSend)
                    {
                        <form asp-action="Send"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"
                                   aria-hidden="true"></i>
                                Send for approval
                            </button>

                        </form>
                    }

                    @if (withApplicant)
                    {
                        <a class="btn btn-outline-secondary"
                           asp-action="Edit"
                           asp-route-id="@Model.Id">
                            Edit
                        </a>
                    }

                    @if (canCancel)
                    {
                        <form asp-action="Cancel"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Cancel application
                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>
    }

    <partial name="_CourseHistoryCard" model="Model" />

</div>
