@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.CourseApplication

@{
    ViewData["Title"] = "Course Application";

    var withApplicant = CourseApplicationWorkflowService.IsWithApplicant(Model.Status);
    var canSend = CourseApplicationWorkflowService.CanAct(CourseApplicationAction.Submitted, Model.Status);
    var canCancel = CourseApplicationWorkflowService.CanAct(CourseApplicationAction.Cancelled, Model.Status);
    var final = CourseApplicationWorkflowService.IsFinal(Model.Status);
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.ApplicationNumber</h2>
            <p>@Model.ProgramIntended</p>
        </div>

        <div class="head-actions">

            <partial name="_CourseStatusBadge" model="Model.Status" />

            <a class="btn btn-outline-secondary" asp-action="Form" asp-route-id="@Model.Id">
                <i class="fas fa-download" aria-hidden="true"></i> Application form (PDF)
            </a>

            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-8">

            <partial name="_CourseApplicationCard" model="Model" />

            <partial name="_CourseHistoryCard" model="Model" />

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> What Happens Next
                </h3>

                <p class="small text-muted">
                    @if (withApplicant)
                    {
                        <text>This is still with you. Send it and HR will review it, then the Managing Consultant decides.</text>
                    }
                    else if (final)
                    {
                        <text>A decision has been made. Nothing more is needed from you.</text>
                    }
                    else
                    {
                        <text>This is being looked at. You will get a notification when it moves on.</text>
                    }
                </p>

                <div class="d-grid gap-2">

                    @if (canSend)
                    {
                        <form asp-action="Send" asp-route-id="@Model.Id" method="post" class="d-grid">
                            <button type="submit" class="btn btn-gold">
                                <i class="fas fa-paper-plane" aria-hidden="true"></i> Send for approval
                            </button>
                        </form>
                    }

                    @if (withApplicant)
                    {
                        <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                        </a>
                    }

                    @if (canCancel)
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-grid"
                              onsubmit="return confirm('Cancel @Model.ApplicationNumber?');">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fas fa-xmark" aria-hidden="true"></i> Cancel application
                            </button>
                        </form>
                    }

                    <a class="btn btn-outline-secondary" asp-action="Form" asp-route-id="@Model.Id">
                        <i class="fas fa-download" aria-hidden="true"></i> Download the form
                    </a>

                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Application Information
                </h3>

                <dl class="info-list">
                    <dt>Application No.</dt>
                    <dd>@Model.ApplicationNumber</dd>
                    <dt>Status</dt>
                    <dd><partial name="_CourseStatusBadge" model="Model.Status" /></dd>
                    <dt>Started</dt>
                    <dd>@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
                    <dt>Sent</dt>
                    <dd>@(Model.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy") ?? "Not yet")</dd>
                    <dt>Decided</dt>
                    <dd>@(Model.CompletedAt?.ToLocalTime().ToString("d MMM yyyy") ?? "Not yet")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
