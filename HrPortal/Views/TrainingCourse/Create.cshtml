@model HrPortal.ViewModels.TrainingCourseCreateViewModel

@{
    ViewData["Title"] = "Add Training Course";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Add Training Course</h2>

        <p class="text-muted">
            Create a new training course.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="e.g. Workplace Safety Induction" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="TrainerEmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="TrainerEmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Nobody yet --
                            </option>

                        </select>

                        <span asp-validation-for="TrainerEmployeeId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Trainer"
                               class="form-label">
                        </label>

                        <input asp-for="Trainer"
                               class="form-control"
                               placeholder="e.g. Deloitte Zimbabwe" />

                        <span asp-validation-for="Trainer"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="TrainingDate"
                               class="form-label">
                        </label>

                        <input asp-for="TrainingDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="TrainingDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="MaterialsDueDate"
                               class="form-label">
                        </label>

                        <input asp-for="MaterialsDueDate"
                               class="form-control"
                               type="date" />

                        <div class="form-text">
                            The trainer is told to have the material
                            posted by this date. Leave it empty where
                            an outside provider is delivering it.
                        </div>

                        <span asp-validation-for="MaterialsDueDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="CreatedByEmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="CreatedByEmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>

                        </select>

                        <span asp-validation-for="CreatedByEmployeeId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Optional course description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="card bg-light border mb-4">

                    <div class="card-body">

                        <p class="fw-semibold mb-2">
                            <i class="fas fa-users me-1"
                               aria-hidden="true"></i>
                            Everybody will be assigned this course
                        </p>

                        <p class="text-muted small">
                            Saving assigns the course to everybody on
                            the staff list and tells each of them.
                            The trainer is told they are delivering
                            it, and is not given it to complete.
                            Anybody who joins afterwards is not
                            caught by this.
                        </p>

                        <div class="row">

                            <div class="col-md-5">

                                <label asp-for="AssignmentDueDate"
                                       class="form-label">
                                </label>

                                <input asp-for="AssignmentDueDate"
                                       class="form-control"
                                       type="date" />

                                <span asp-validation-for="AssignmentDueDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    Save Course

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
