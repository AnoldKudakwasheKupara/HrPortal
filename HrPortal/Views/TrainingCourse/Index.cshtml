@model IEnumerable<HrPortal.Entities.TrainingCourse>

@{
    ViewData["Title"] = "Training Courses";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Training Courses</h2>

            <p class="text-muted">
                Manage the training courses offered to employees.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Course
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Trainer</th>
                            <th>Training Date</th>
                            <th>Assigned</th>
                            <th>Materials</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var course in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @course.Title
                                </strong>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(course.Trainer))
                                {
                                    @course.Trainer
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not set
                                    </span>
                                }
                            </td>

                            <td>
                                @if (course.TrainingDate.HasValue)
                                {
                                    @course.TrainingDate.Value.ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not scheduled
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @course.Assignments.Count
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @course.Materials.Count
                                </span>
                            </td>

                            <td>
                                @if (course.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="dropdown">

                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">

                                        Actions

                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@course.Id">

                                                View

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@course.Id">

                                                Edit

                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>

                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@course.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item">

                                                    @(course.IsActive
                                                        ? "Deactivate"
                                                        : "Activate")

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
