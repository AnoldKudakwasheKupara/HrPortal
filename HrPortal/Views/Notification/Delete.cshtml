@model HrPortal.Entities.Notification

@{
    ViewData["Title"] = "Delete Notification";
}

<div class="container">

    <div class="mb-4">

        <h2>Delete Notification</h2>

        <p class="text-muted">
            This notification will be removed permanently.
        </p>

    </div>


    <div class="alert alert-warning">

        Are you sure you want to delete this notification?
        This cannot be undone.

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Title</strong>

                    <p>
                        @Model.Title
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Employee</strong>

                    <p>
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Created</strong>

                    <p>
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>

                </div>


                <div class="col-12">

                    <strong>Message</strong>

                    <p>
                        @Model.Message
                    </p>

                </div>

            </div>


            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete Notification

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
