@{
    ViewData["Title"] = "My Loans";
}

<div class="container">

    <div class="page-head-simple">

        <h2>My loans</h2>

        <p class="text-muted">
            Loan applications you have made and how they were decided.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">No employee record</div>

        <div class="card-body">

            <div class="detail-rows">

                <div class="detail-row">

                    <span class="detail-icon">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                    </span>

                    <div class="detail-text">
                        <span class="field-label">Nothing to show yet</span>
                        <div class="field-value">
                            Your sign-in is not linked to an employee
                            record, so there is nothing to apply
                            against.
                        </div>
                    </div>

                </div>

                <div class="detail-row">

                    <span class="detail-icon">
                        <i class="fas fa-user-shield" aria-hidden="true"></i>
                    </span>

                    <div class="detail-text">
                        <span class="field-label">How to fix it</span>
                        <div class="field-value">
                            An administrator can link your sign-in by
                            editing your employee record.
                        </div>
                    </div>

                </div>

            </div>

            <div class="mt-4">

                <a class="btn btn-primary"
                   asp-controller="Home"
                   asp-action="Index">
                    Back to the dashboard
                </a>

            </div>

        </div>

    </div>

</div>
