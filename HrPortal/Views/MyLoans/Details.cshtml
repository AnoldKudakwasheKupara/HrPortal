@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.LoanApplication

@{
    ViewData["Title"] = "Loan Application";

    var withApplicant =
        LoanWorkflowService.IsWithApplicant(Model.Status);

    var canSend = LoanWorkflowService.CanAct(
        LoanApplicationAction.Submitted, Model.Status);

    var canCancel = LoanWorkflowService.CanAct(
        LoanApplicationAction.Cancelled, Model.Status);
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.ApplicationNumber</h2>

            <p class="text-muted mb-0">
                @AmountInWords.Convert(Model.AmountRequested)
            </p>
        </div>

        <a class="btn btn-secondary" asp-action="Index">
            Back
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>The application</span>

            <partial name="_LoanStatusBadge" model="Model.Status" />

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Amount required</span>
                    <div class="field-value">
                        @Model.AmountRequested.ToString("N2")
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Amount authorised</span>
                    <div class="field-value @(Model.AmountAuthorised == null ? "is-empty" : "")">
                        @(Model.AmountAuthorised == null
                            ? "Not yet decided"
                            : Model.AmountAuthorised.Value.ToString("N2"))
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Repayment period</span>
                    <div class="field-value">
                        @Model.RepaymentMonths months
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Instalment per month</span>
                    <div class="field-value">
                        @(Model.MonthlyInstalment == null
                            ? "--"
                            : Model.MonthlyInstalment.Value.ToString("N2"))
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Deductions start</span>
                    <div class="field-value @(Model.RepaymentStartDate == null ? "is-empty" : "")">
                        @(Model.RepaymentStartDate == null
                            ? "Set when sanctioned"
                            : Model.RepaymentStartDate.Value
                                .ToString("d MMM yyyy"))
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <span class="field-label">Applied</span>
                    <div class="field-value">
                        @(Model.CreatedAt.ToLocalTime()
                            .ToString("d MMM yyyy"))
                    </div>
                </div>

                <div class="col-12">
                    <span class="field-label">Purpose</span>
                    <div class="field-value">@Model.Purpose</div>
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>Receipts and quotations</span>

            <span class="text-muted small">
                @Model.Attachments.Count
                @(Model.Attachments.Count == 1 ? "file" : "files")
            </span>

        </div>

        @if (Model.Attachments.Any())
        {
            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Added</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var attachment in Model.Attachments
                            .OrderByDescending(a => a.UploadedAt))
                        {
                            <tr>

                                <td>@attachment.OriginalFileName</td>

                                <td>
                                    @(attachment.UploadedAt.ToLocalTime()
                                        .ToString("d MMM yyyy"))
                                </td>

                                <td class="col-actions">

                                    <div class="table-actions">

                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Attachment"
                                           asp-route-id="@Model.Id"
                                           asp-route-attachmentId="@attachment.Id">
                                            Download
                                        </a>

                                        @if (withApplicant)
                                        {
                                            <form asp-action="Detach"
                                                  asp-route-id="@Model.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="attachmentId"
                                                       value="@attachment.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Remove
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <p class="empty-state">
                    <span class="empty-icon">&#128206;</span>
                    Nothing attached yet.
                </p>

            </div>
        }

        @if (withApplicant)
        {
            <div class="card-footer">

                <form asp-action="Attach"
                      asp-route-id="@Model.Id"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="row g-2 align-items-end">

                        <div class="col-md-8">

                            <label for="file" class="form-label">
                                Add a receipt or quotation
                            </label>

                            <input type="file"
                                   id="file"
                                   name="file"
                                   class="form-control" />

                        </div>

                        <div class="col-md-4">

                            <button type="submit"
                                    class="btn btn-outline-primary">
                                <i class="fas fa-paperclip"
                                   aria-hidden="true"></i>
                                Attach
                            </button>

                        </div>

                    </div>

                </form>

            </div>
        }

    </div>

    @if (withApplicant || canCancel)
    {
        <div class="card shadow-sm mb-3">

            <div class="card-header">What happens next</div>

            <div class="card-body">

                <div class="field-value mb-3">
                    @if (withApplicant)
                    {
                        <text>
                            This is still with you. Send it when you are
                            ready and the Managing Director will decide.
                        </text>
                    }
                    else
                    {
                        <text>
                            This is with the Managing Director.
                        </text>
                    }
                </div>

                <div class="table-actions">

                    @if (canSend)
                    {
                        <form asp-action="Send"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="fas fa-paper-plane"
                                   aria-hidden="true"></i>
                                Send to the Managing Director
                            </button>

                        </form>
                    }

                    @if (withApplicant)
                    {
                        <a class="btn btn-outline-secondary"
                           asp-action="Edit"
                           asp-route-id="@Model.Id">
                            Edit
                        </a>
                    }

                    @if (canCancel)
                    {
                        <form asp-action="Cancel"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Cancel application
                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">History</div>

        @if (Model.History.Any())
        {
            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-sm align-middle mb-0">

                        <thead>
                            <tr>
                                <th>When</th>
                                <th>What happened</th>
                                <th>By</th>
                                <th>Comment</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var entry in Model.History
                            .OrderByDescending(h => h.ActionDate))
                        {
                            <tr>

                                <td>
                                    @(entry.ActionDate.ToLocalTime()
                                        .ToString("d MMM yyyy HH:mm"))
                                </td>

                                <td>@entry.Action</td>

                                <td>
                                    @(entry.ActionedByEmployee == null
                                        ? "--"
                                        : entry.ActionedByEmployee.FirstName
                                          + " "
                                          + entry.ActionedByEmployee.LastName)
                                </td>

                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(entry.Comment)
                                        ? "--"
                                        : entry.Comment)
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    Nothing has happened to this application yet.
                </p>

            </div>
        }

    </div>

</div>
