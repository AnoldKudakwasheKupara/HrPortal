@model HrPortal.ViewModels.MyLoanViewModel

@{
    ViewData["Title"] = "Edit Loan Application";
}

<div class="container">

    <div class="page-head-simple">

        <h2>@Model.ApplicationNumber</h2>

        <p class="text-muted">
            Change the application and send it again.
        </p>

    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"
             role="alert"></div>

        <partial name="_LoanFields" model="Model" />

        <div class="mb-4">

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-floppy-disk" aria-hidden="true"></i>
                Save changes
            </button>

            <a class="btn btn-outline-secondary"
               asp-action="Details"
               asp-route-id="@Model.Id">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
