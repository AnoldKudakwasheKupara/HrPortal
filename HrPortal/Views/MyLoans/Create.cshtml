@model HrPortal.ViewModels.MyLoanViewModel

@{
    ViewData["Title"] = "Apply for a Loan";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Apply for a loan</h2>

        <p class="text-muted">
            This saves as a draft so you can attach receipts or
            quotations before sending it to the Managing Director.
        </p>

    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"
             role="alert"></div>

        <partial name="_LoanFields" model="Model" />

        <div class="mb-4">

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-floppy-disk" aria-hidden="true"></i>
                Save as draft
            </button>

            <a class="btn btn-outline-secondary" asp-action="Index">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
