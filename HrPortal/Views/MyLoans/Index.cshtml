@model List<HrPortal.Entities.LoanApplication>

@{
    ViewData["Title"] = "My Loans";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>My loans</h2>

            <p class="text-muted mb-0">
                Loan applications you have made. The Managing Director
                sanctions them; payroll handles the deduction.
            </p>
        </div>

        <a class="btn btn-primary"
           asp-action="Create">
            Apply for a loan
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Application</th>
                            <th class="num">Requested</th>
                            <th class="num">Authorised</th>
                            <th>Repayment</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                You have not applied for a loan yet.
                            </td>
                        </tr>
                    }

                    @foreach (var application in Model)
                    {
                        <tr>

                            <td>
                                <strong>@application.ApplicationNumber</strong>
                                <div class="row-meta">
                                    @(application.CreatedAt.ToLocalTime()
                                        .ToString("d MMM yyyy"))
                                </div>
                            </td>

                            <td class="num">
                                @application.AmountRequested.ToString("N2")
                            </td>

                            <td class="num">
                                @(application.AmountAuthorised == null
                                    ? "--"
                                    : application.AmountAuthorised.Value
                                        .ToString("N2"))
                            </td>

                            <td>
                                @application.RepaymentMonths months
                                @if (application.MonthlyInstalment != null)
                                {
                                    <div class="row-meta">
                                        @(application.MonthlyInstalment.Value
                                            .ToString("N2")) a month
                                    </div>
                                }
                            </td>

                            <td>
                                <partial name="_LoanStatusBadge"
                                         model="application.Status" />
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Details"
                                       asp-route-id="@application.Id">
                                        Open
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
