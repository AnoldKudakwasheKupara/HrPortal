@using HrPortal.ViewModels
@model List<HrPortal.Entities.VaultEntry>

@{
    ViewData["Title"] = "Password vault";

    var search = ViewBag.Search as string;
    var paged = PagedList.Of(Model, PagedList.PageFrom(Context.Request));
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Password Vault</h2>
            <p>Passwords for local systems, held encrypted.</p>
        </div>

        <div class="head-actions">

            <form asp-action="Lock" method="post">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="fas fa-lock" aria-hidden="true"></i> Lock
                </button>
            </form>

            <a asp-action="Create" class="btn btn-gold">
                <i class="fas fa-plus" aria-hidden="true"></i> Add a password
            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-key"></i></span>
            <div>
                <div class="kpi-label">@(string.IsNullOrWhiteSpace(search) ? "Passwords Saved" : "Matching")</div>
                <div class="kpi-value">@Model.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-user"></i></span>
            <div>
                <div class="kpi-label">With a Username</div>
                <div class="kpi-value">@Model.Count(e => !string.IsNullOrWhiteSpace(e.Username))</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-lock-open"></i></span>
            <div>
                <div class="kpi-label">Vault</div>
                <div class="kpi-value kpi-value-text">Unlocked</div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <div class="panel-head-split">

            <h3 class="panel-head">
                <i class="fas fa-key" aria-hidden="true"></i> Passwords
                <span class="tab-count">@Model.Count</span>
            </h3>

            <form method="get" class="filter-search list-toolbar-search mb-0" role="search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="search" name="search" type="search" class="form-control" value="@search"
                       placeholder="Service or username" aria-label="Search the vault" />
            </form>

        </div>

        @if (Model.Count == 0)
        {
            <div class="list-empty mb-0">
                <i class="fas fa-key" aria-hidden="true"></i>
                <p>
                    @if (string.IsNullOrWhiteSpace(search))
                    {
                        <text>No passwords saved yet.</text>
                    }
                    else
                    {
                        <text>Nothing matches.</text>
                        <a asp-action="Index">Clear the search</a>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Username</th>
                            <th>Password</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var entry in paged.Items)
                        {
                            <tr data-vault-entry="@entry.Id">

                                <td class="fw-semibold">@entry.Name</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(entry.Username))
                                    {
                                        <span class="text-break">@entry.Username</span>
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-1"
                                                data-vault-copy-text="@entry.Username"
                                                title="Copy the username"
                                                aria-label="Copy the username for @entry.Name">
                                            <i class="fas fa-copy" aria-hidden="true"></i>
                                        </button>
                                    }
                                </td>

                                <td class="text-nowrap">
                                    <code data-vault-password>••••••••••</code>

                                    <div class="d-inline-flex gap-1 ms-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-vault-reveal>Show</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-vault-copy
                                                aria-label="Copy the password for @entry.Name">Copy</button>
                                    </div>
                                </td>

                                <td>
                                    <div class="table-actions justify-content-end">

                                        <a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Edit" asp-route-id="@entry.Id">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@entry.Id" method="post" class="d-inline"
                                              data-confirm="Delete the password for @entry.Name? This cannot be undone."
                                              onsubmit="return confirm(this.dataset.confirm);">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash" aria-hidden="true"></i>
                                                <span class="visually-hidden">Delete the password for @entry.Name</span>
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "password", "passwords")' />
        }

    </section>

    <form id="vault-reveal-form" asp-action="Reveal" method="post" hidden></form>

</div>

@section Scripts {
    <script src="~/js/vault.js" asp-append-version="true"></script>
}
