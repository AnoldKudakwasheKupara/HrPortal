@{
    ViewData["Title"] = "Open the password vault";

    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container">

    <div class="page-head-simple">
        <h2>Open the password vault</h2>
        <p class="text-muted">
            Enter your password again to see the shared passwords. The
            vault stays open for
            @HrPortal.Services.VaultLock.OpenFor.TotalMinutes minutes,
            or until you sign out.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card shadow-sm" style="max-width: 480px;">

        <div class="card-body">

            <form asp-action="Unlock" method="post" autocomplete="off">

                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="mb-3">

                    <label for="password" class="form-label">
                        Your password
                    </label>

                    <input id="password"
                           name="password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           required
                           autofocus />

                    <div class="form-text">
                        Opening the vault is recorded in the audit log.
                    </div>

                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-lock-open" aria-hidden="true"></i>
                    Open the vault
                </button>

            </form>

        </div>

    </div>

</div>
