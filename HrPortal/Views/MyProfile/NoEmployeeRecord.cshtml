@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>My profile</h2>

        <p class="text-muted">
            Your employment record, the documents on your file and the
            notices the portal has sent you.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">No employee record</div>

        <div class="card-body">

            <div class="detail-rows">

                <div class="detail-row">

                    <span class="detail-icon">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                    </span>

                    <div class="detail-text">
                        <span class="field-label">Nothing to show yet</span>
                        <div class="field-value">
                            Your sign-in is not linked to an employee
                            record, so there is no employment
                            information, document or notice to show here.
                        </div>
                    </div>

                </div>

                <div class="detail-row">

                    <span class="detail-icon">
                        <i class="fas fa-user-shield" aria-hidden="true"></i>
                    </span>

                    <div class="detail-text">
                        <span class="field-label">How to fix it</span>
                        <div class="field-value">
                            An administrator can link your sign-in by
                            editing your employee record, or by creating
                            one for you.
                        </div>
                    </div>

                </div>

            </div>

            <div class="mt-4">

                <a class="btn btn-primary"
                   asp-controller="Home"
                   asp-action="Index">
                    Back to the dashboard
                </a>

                <a class="btn btn-outline-secondary"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index">
                    My account
                </a>

            </div>

        </div>

    </div>

</div>
