@model HrPortal.ViewModels.MyProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var e = Model.Employee;
    var fullName = $"{e.FirstName} {e.LastName}".Trim();
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?" : fullName[0].ToString().ToUpper();
    var hasKin = !string.IsNullOrWhiteSpace(e.EmergencyContactName);
    var unread = Model.Notifications.Count(n => !n.IsRead);
    var years = (int)((DateTime.Today - e.DateJoined.Date).TotalDays / 365.25);
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>My Profile</h2>
            <p>Your employment record, the documents on your file and the notices the portal has sent you.</p>
        </div>

        <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Manage/Index">
            <i class="fas fa-user-gear" aria-hidden="true"></i> My account
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
            <div>
                <div class="kpi-label">Years of Service</div>
                <div class="kpi-value">@(years < 1 ? "Under 1" : years.ToString())</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-folder-open"></i></span>
            <div>
                <div class="kpi-label">Documents on File</div>
                <div class="kpi-value">@Model.Documents.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon @(hasKin && e.NextOfKinConfirmedAt != null ? "is-green" : "is-amber")" aria-hidden="true"><i class="fas fa-people-roof"></i></span>
            <div>
                <div class="kpi-label">Next of Kin</div>
                <div class="kpi-value kpi-value-text">
                    @(!hasKin ? "Not given" : e.NextOfKinConfirmedAt == null ? "To confirm" : "Confirmed")
                </div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-bell"></i></span>
            <div>
                <div class="kpi-label">Unread Notices</div>
                <div class="kpi-value">@unread</div>
            </div>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-id-badge" aria-hidden="true"></i> Employment Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-hashtag" aria-hidden="true"></i>
                        <div><span>Employee number</span><strong>@e.EmployeeNumber</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-check" aria-hidden="true"></i>
                        <div><span>Date joined</span><strong>@e.DateJoined.ToString("d MMM yyyy")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-building" aria-hidden="true"></i>
                        <div><span>Department</span><strong>@e.Department.Name</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-briefcase" aria-hidden="true"></i>
                        <div>
                            <span>Position</span>
                            @if (e.JobTitle == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@e.JobTitle</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        <div><span>Email</span><strong class="text-break">@e.Email</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-phone" aria-hidden="true"></i>
                        <div>
                            <span>Phone number</span>
                            @if (e.PhoneNumber == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@e.PhoneNumber</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                        <div>
                            <span>National ID</span>
                            @if (e.NationalId == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@e.NationalId</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        <div><span>Status</span><strong>@(e.IsActive ? "Active" : "Inactive")</strong></div>
                    </div>

                </div>

                <p class="text-muted small mt-3 mb-0">
                    HR keeps this record. To correct anything here, speak to them. Your sign-in email
                    and phone number are managed separately under
                    <a asp-area="Identity" asp-page="/Account/Manage/Index">My account</a>.
                </p>

            </section>

            <section class="panel-card mb-3">

                <div class="panel-head-split">

                    <h3 class="panel-head">
                        <i class="fas fa-people-roof" aria-hidden="true"></i> Next of Kin
                    </h3>

                    <div class="table-actions">

                        @if (hasKin)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="NextOfKinForm">
                                <i class="fas fa-download" aria-hidden="true"></i> Form (PDF)
                            </a>
                        }

                        <a class="btn btn-sm btn-gold" asp-action="NextOfKin">
                            <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                            @(hasKin ? "Update" : "Complete this form")
                        </a>

                    </div>

                </div>

                @if (!hasKin)
                {
                    <div class="list-empty mb-0">
                        <i class="fas fa-people-roof" aria-hidden="true"></i>
                        <p>You have not told us who to contact in an emergency.</p>
                    </div>
                }
                else
                {
                    <div class="facts">

                        <div class="fact">
                            <i class="fas fa-user" aria-hidden="true"></i>
                            <div><span>Contact</span><strong>@e.EmergencyContactName</strong></div>
                        </div>

                        <div class="fact">
                            <i class="fas fa-heart" aria-hidden="true"></i>
                            <div>
                                <span>Relationship</span>
                                @if (e.EmergencyContactRelationship == null)
                                {
                                    <em>Not recorded</em>
                                }
                                else
                                {
                                    <strong>@e.EmergencyContactRelationship</strong>
                                }
                            </div>
                        </div>

                        <div class="fact">
                            <i class="fas fa-phone" aria-hidden="true"></i>
                            <div>
                                <span>Phone number(s)</span>
                                @if (e.EmergencyContactPhone == null)
                                {
                                    <em>Not recorded</em>
                                }
                                else
                                {
                                    <strong>@e.EmergencyContactPhone</strong>
                                }
                            </div>
                        </div>

                        <div class="fact">
                            <i class="fas fa-location-dot" aria-hidden="true"></i>
                            <div><span>Address</span><strong>@(e.EmergencyContactAddress ?? "Same as yours")</strong></div>
                        </div>

                    </div>

                    @if (e.NextOfKinConfirmedAt != null)
                    {
                        <p class="text-muted small mt-3 mb-0">
                            You confirmed these on @e.NextOfKinConfirmedAt.Value.ToLocalTime().ToString("d MMM yyyy, HH:mm").
                        </p>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            These were entered by HR and you have not confirmed them yet. Please check them over.
                        </div>
                    }
                }

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-folder-open" aria-hidden="true"></i> My Documents
                    <span class="tab-count">@Model.Documents.Count</span>
                </h3>

                @if (!Model.Documents.Any())
                {
                    <div class="list-empty mb-0">
                        <i class="fas fa-folder-open" aria-hidden="true"></i>
                        <p>There are no documents on your file.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Category</th>
                                    <th>Uploaded</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var document in Model.Documents)
                                {
                                    <tr>
                                        <td class="fw-semibold text-break">
                                            <i class="fas fa-file-lines text-muted me-1" aria-hidden="true"></i>
                                            @document.OriginalFileName
                                        </td>
                                        <td>@document.DocumentCategory.Name</td>
                                        <td class="text-nowrap">@document.UploadedAt.ToString("d MMM yyyy")</td>
                                        <td>
                                            <div class="table-actions justify-content-end">
                                                <a class="btn btn-sm btn-outline-secondary text-nowrap"
                                                   asp-action="Document" asp-route-id="@document.Id">
                                                    <i class="fas fa-download" aria-hidden="true"></i> Download
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3 profile-card">

                <div class="profile-avatar" aria-hidden="true">@initial</div>
                <div class="profile-name">@fullName</div>
                <div class="profile-role">@(e.JobTitle ?? "No job title recorded")</div>

                <div class="profile-tags">
                    <span class="status-badge badge-blue">@e.Department.Name</span>
                    @if (e.IsActive)
                    {
                        <span class="status-badge badge-green">Active</span>
                    }
                    else
                    {
                        <span class="status-badge badge-gray">Inactive</span>
                    }
                </div>

            </section>

            <section class="panel-card mb-3">

                <div class="panel-head-split">
                    <h3 class="panel-head">
                        <i class="fas fa-bell" aria-hidden="true"></i> Recent Notices
                    </h3>
                    <a class="small fw-semibold" asp-controller="MyNotifications" asp-action="Index">See all</a>
                </div>

                @if (!Model.Notifications.Any())
                {
                    <p class="text-muted mb-0">You have no notifications.</p>
                }
                else
                {
                    <ul class="notice-list">
                        @foreach (var notification in Model.Notifications)
                        {
                            <li class="@(notification.IsRead ? "" : "is-unread")">
                                <i class="fas @(notification.IsRead ? "fa-envelope-open" : "fa-bell")" aria-hidden="true"></i>
                                <div>
                                    <div class="notice-title">
                                        @if (!string.IsNullOrWhiteSpace(notification.Link))
                                        {
                                            <a asp-controller="MyNotifications" asp-action="Open" asp-route-id="@notification.Id">@notification.Title</a>
                                        }
                                        else
                                        {
                                            @notification.Title
                                        }
                                    </div>
                                    <div class="notice-meta">@notification.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }

            </section>

        </div>

    </div>

</div>
