@model HrPortal.ViewModels.MyProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var fullName =
        $"{Model.Employee.FirstName} {Model.Employee.LastName}".Trim();

    var initial = string.IsNullOrWhiteSpace(fullName)
        ? "?"
        : fullName[0].ToString().ToUpper();
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>My profile</h2>

        <p class="text-muted">
            Your employment record, the documents on your file and the
            notices the portal has sent you.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3">

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="account-identity">

                        <div class="account-avatar">@initial</div>

                        <div>
                            <h5 class="mb-1">@fullName</h5>

                            <div class="text-muted">
                                @(Model.Employee.JobTitle ?? "No job title recorded")
                            </div>

                            <div class="mt-2">
                                <span class="badge bg-primary">
                                    @Model.Employee.Department.Name
                                </span>

                                @if (Model.Employee.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                    <hr />

                    <div class="row">

                        <div class="col-6">
                            <span class="field-label">Employee number</span>
                            <div class="field-value">
                                @Model.Employee.EmployeeNumber
                            </div>
                        </div>

                        <div class="col-6">
                            <span class="field-label">Date joined</span>
                            <div class="field-value">
                                @Model.Employee.DateJoined.ToString("dd MMM yyyy")
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <span>Contact details</span>

                    <a class="btn btn-sm btn-outline-secondary"
                       asp-area="Identity"
                       asp-page="/Account/Manage/Index">
                        My account
                    </a>

                </div>

                <div class="card-body d-flex flex-column">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <span class="field-label">Email</span>
                            <div class="field-value">
                                @Model.Employee.Email
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span class="field-label">Phone number</span>
                            <div class="field-value @(Model.Employee.PhoneNumber == null ? "is-empty" : "")">
                                @(Model.Employee.PhoneNumber ?? "Not recorded")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <span class="field-label">National ID</span>
                            <div class="field-value @(Model.Employee.NationalId == null ? "is-empty" : "")">
                                @(Model.Employee.NationalId ?? "Not recorded")
                            </div>
                        </div>

                    </div>

                    <p class="text-muted small mt-auto pt-3 mb-0">
                        HR keeps this record. To correct anything on this
                        page, speak to them. Your sign-in email and phone
                        number are managed separately under
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/Index">My account</a>.
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mt-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>Next of kin</span>

            <a class="btn btn-sm btn-primary"
               asp-action="NextOfKin">
                @(string.IsNullOrWhiteSpace(Model.Employee.EmergencyContactName)
                    ? "Complete this form"
                    : "Update")
            </a>

        </div>

        <div class="card-body">

            @if (string.IsNullOrWhiteSpace(Model.Employee.EmergencyContactName))
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128101;</span>
                    You have not told us who to contact in an emergency.
                </p>
            }
            else
            {
                <div class="row g-3">

                    <div class="col-sm-6">
                        <span class="field-label">Contact</span>
                        <div class="field-value">
                            @Model.Employee.EmergencyContactName
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <span class="field-label">Relationship</span>
                        <div class="field-value @(Model.Employee.EmergencyContactRelationship == null ? "is-empty" : "")">
                            @(Model.Employee.EmergencyContactRelationship
                                ?? "Not recorded")
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <span class="field-label">Phone number(s)</span>
                        <div class="field-value @(Model.Employee.EmergencyContactPhone == null ? "is-empty" : "")">
                            @(Model.Employee.EmergencyContactPhone
                                ?? "Not recorded")
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <span class="field-label">Address</span>
                        <div class="field-value @(Model.Employee.EmergencyContactAddress == null ? "is-empty" : "")">
                            @(Model.Employee.EmergencyContactAddress
                                ?? "Same as yours")
                        </div>
                    </div>

                </div>

                @if (Model.Employee.NextOfKinConfirmedAt != null)
                {
                    <p class="text-muted small mt-3 mb-0">
                        You confirmed these on
                        @(Model.Employee.NextOfKinConfirmedAt.Value
                            .ToLocalTime().ToString("d MMM yyyy HH:mm")).
                    </p>
                }
                else
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        These were entered by HR and you have not
                        confirmed them yet. Please check them over.
                    </div>
                }
            }

        </div>

    </div>

    <div class="card shadow-sm mt-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>My documents</span>

            <span class="text-muted small">
                @Model.Documents.Count
                @(Model.Documents.Count == 1 ? "document" : "documents")
                on your file
            </span>

        </div>

        @if (Model.Documents.Any())
        {
            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Category</th>
                                <th>Uploaded</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var document in Model.Documents)
                        {
                            <tr>

                                <td>@document.OriginalFileName</td>

                                <td>@document.DocumentCategory.Name</td>

                                <td>
                                    @document.UploadedAt.ToString("dd MMM yyyy")
                                </td>

                                <td class="col-actions">

                                    <div class="table-actions">

                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Document"
                                           asp-route-id="@document.Id">
                                            <i class="fas fa-download"
                                               aria-hidden="true"></i>
                                            Download
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <p class="empty-state">
                    <span class="empty-icon">&#128193;</span>
                    There are no documents on your file.
                </p>

            </div>
        }

    </div>

    <div class="card shadow-sm mt-3 mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>Notifications</span>

            <a class="btn btn-sm btn-outline-secondary"
               asp-controller="MyNotifications"
               asp-action="Index">
                All notifications
            </a>

        </div>

        <div class="card-body">

            @if (Model.Notifications.Any())
            {
                <ul class="row-list">

                @foreach (var notification in Model.Notifications)
                {
                    <li>

                        <span class="row-icon">
                            <i class="fas @(notification.IsRead ? "fa-envelope-open" : "fa-bell")"
                               aria-hidden="true"></i>
                        </span>

                        <div class="row-main">

                            <span class="row-title">
                                @notification.Title

                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary">New</span>
                                }
                            </span>

                            <span class="row-meta">
                                @notification.Message
                                &middot;
                                @notification.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </span>

                        </div>

                        <div class="table-actions">

                            @if (!string.IsNullOrWhiteSpace(notification.Link))
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="@notification.Link">
                                    Open
                                </a>
                            }

                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkRead"
                                      asp-route-id="@notification.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary">
                                        Mark read
                                    </button>

                                </form>
                            }

                        </div>

                    </li>
                }

                </ul>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128276;</span>
                    You have no notifications.
                </p>
            }

        </div>

    </div>

</div>
