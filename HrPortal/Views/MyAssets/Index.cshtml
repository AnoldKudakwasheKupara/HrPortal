@using HrPortal.Entities
@using HrPortal.ViewModels
@model IEnumerable<HrPortal.Entities.Asset>

@{
    ViewData["Title"] = "My Assets";

    var all = Model.ToList();
    var paged = PagedList.Of(all, PagedList.PageFrom(Context.Request));
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>My Assets</h2>
            <p>Equipment issued to you. If something here is wrong, or a machine needs attention, speak to IT.</p>
        </div>

    </div>

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-laptop"></i></span>
            <div>
                <div class="kpi-label">Items Issued</div>
                <div class="kpi-value">@all.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
            <div>
                <div class="kpi-label">In Use</div>
                <div class="kpi-value">@all.Count(a => a.IsInUse)</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-triangle-exclamation"></i></span>
            <div>
                <div class="kpi-label">Old or Bad</div>
                <div class="kpi-value">@all.Count(a => a.Condition is AssetCondition.Old or AssetCondition.Bad)</div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-laptop" aria-hidden="true"></i> My Equipment
            <span class="tab-count">@all.Count</span>
        </h3>

        @if (!all.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-laptop" aria-hidden="true"></i>
                <p>No equipment is assigned to you.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Device / Model</th>
                            <th>Serial</th>
                            <th>Issued</th>
                            <th>Condition</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var asset in paged.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@asset.DeviceModel</div>
                                    <div class="small text-muted">
                                        @(string.IsNullOrWhiteSpace(asset.Processor) ? "" : asset.Processor)
                                        @if (!asset.IsInUse)
                                        {
                                            <span class="status-badge badge-gray ms-1">Not in use</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-break">@(string.IsNullOrWhiteSpace(asset.SerialNumber) ? "--" : asset.SerialNumber)</td>
                                <td class="text-nowrap">@(asset.AssignedOn?.ToLocalTime().ToString("d MMM yyyy") ?? "--")</td>
                                <td><partial name="_AssetConditionBadge" model="asset.Condition" /></td>
                                <td class="small">@(string.IsNullOrWhiteSpace(asset.Notes) ? "--" : asset.Notes)</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "item", "items")' />
        }

    </section>

</div>
