@using HrPortal.ViewModels
@model IEnumerable<HrPortal.ViewModels.RoleEditViewModel>

@{
    ViewData["Title"] = "Role Management";

    var all = Model.ToList();
    var search = PagedList.SearchFrom(Context.Request);
    var shown = all.Where(r => PagedList.Matches(search, r.Name)).ToList();
    var paged = PagedList.Of(shown, PagedList.PageFrom(Context.Request));
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Role Management</h2>
            <p>Manage system roles and user assignments.</p>
        </div>

        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Role
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-user-shield"></i></span>
            <div>
                <div class="kpi-label">Roles</div>
                <div class="kpi-value">@all.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-users"></i></span>
            <div>
                <div class="kpi-label">Role Assignments</div>
                <div class="kpi-value">@all.Sum(r => r.UserCount)</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-user-slash"></i></span>
            <div>
                <div class="kpi-label">Roles Nobody Holds</div>
                <div class="kpi-value">@all.Count(r => r.UserCount == 0)</div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-user-shield" aria-hidden="true"></i> System Roles
            <span class="tab-count">@shown.Count</span>
        </h3>

        <partial name="_ListToolbar" model='new ListToolbarModel(null, search, "Search roles...")' />

        @if (!shown.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-user-shield" aria-hidden="true"></i>
                <p>@(all.Any() ? "No roles match." : "No roles have been created.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Users</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var role in paged.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@role.Name</td>
                                <td><span class="status-badge badge-gray">@role.UserCount</span></td>
                                <td>
                                    <div class="table-actions justify-content-end">

                                        <a asp-action="Users" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary text-nowrap">
                                            <i class="fas fa-users-gear" aria-hidden="true"></i> Manage Users
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-success text-nowrap">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                        </a>

                                        @if (!string.Equals(role.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this role?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Delete @role.Name</span>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "role", "roles")' />
        }

    </section>

</div>
