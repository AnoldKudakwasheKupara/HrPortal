@model HrPortal.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Settings";

    var overrides = ViewBag.Overrides as List<HrPortal.Entities.AppSetting>
        ?? new List<HrPortal.Entities.AppSetting>();
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Settings</h2>
            <p>Changed here, these take effect immediately. Anything left alone keeps the value from the configuration file.</p>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3">

        <div class="col-lg-8">

            <form asp-action="Index" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <section class="panel-card mb-3">

                    <h3 class="panel-head">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Mail
                    </h3>

                    <div class="fact">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                        <div>
                            <span>Not editable here</span>
                            <p class="mb-0 small">
                                Mail settings include a password, and a password in a table every administrator
                                can read is worse than one in a protected configuration file. They stay under
                                <code>Email</code> in appsettings.json.
                            </p>
                        </div>
                    </div>

                </section>

                <div class="mb-4">
                    <button type="submit" class="btn btn-gold">
                        <i class="fas fa-floppy-disk" aria-hidden="true"></i> Save settings
                    </button>
                </div>

            </form>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> About Settings
                </h3>

                <dl class="info-list">
                    <dt>Overridden here</dt>
                    <dd>@overrides.Count</dd>
                    <dt>Last changed</dt>
                    <dd>@(overrides.Any() ? overrides.Max(o => o.UpdatedAt).ToLocalTime().ToString("d MMM yyyy, HH:mm") : "Never")</dd>
                </dl>

            </section>

        </div>

    </div>

    <section class="panel-card mb-4">

        <div class="panel-head-split">

            <h3 class="panel-head">
                <i class="fas fa-sliders" aria-hidden="true"></i> Overridden Here
                <span class="tab-count">@overrides.Count</span>
            </h3>

            @if (overrides.Any())
            {
                <form asp-action="Reset" method="post"
                      onsubmit="return confirm('Reset every setting to the value in the configuration file?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-rotate-left" aria-hidden="true"></i> Reset all to the file
                    </button>
                </form>
            }

        </div>

        @if (overrides.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Setting</th>
                            <th>Value</th>
                            <th>Changed</th>
                            <th>By</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var setting in overrides)
                        {
                            <tr>
                                <td><code>@setting.Key</code></td>
                                <td class="text-break">@setting.Value</td>
                                <td class="text-nowrap">@setting.UpdatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                                <td class="text-muted">@(setting.UpdatedBy ?? "--")</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="list-empty mb-0">
                <i class="fas fa-sliders" aria-hidden="true"></i>
                <p>Nothing is overridden. Every setting currently comes from appsettings.json.</p>
            </div>
        }

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
