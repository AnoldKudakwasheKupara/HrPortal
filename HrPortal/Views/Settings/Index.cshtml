@model HrPortal.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Settings";

    var overrides = ViewBag.Overrides as List<HrPortal.Entities.AppSetting>
        ?? new List<HrPortal.Entities.AppSetting>();
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>Settings</h2>
            <p class="text-muted mb-0">
                Changed here, these take effect immediately. Anything
                left alone keeps the value from the configuration file.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Requisitions</div>
            <div class="card-body">
                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="MdApprovalThreshold" class="form-label"></label>
                        <input asp-for="MdApprovalThreshold" class="form-control"
                               type="number" step="0.01" min="0" />
                        <div class="form-text">
                            At or above this, a requisition goes to the
                            Managing Director after review. Below it,
                            review is the final approval.
                        </div>
                        <span asp-validation-for="MdApprovalThreshold" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="CurrencyCode" class="form-label"></label>
                        <input asp-for="CurrencyCode" class="form-control" />
                        <span asp-validation-for="CurrencyCode" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Leave</div>
            <div class="card-body">
                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="BackdateGraceDays" class="form-label"></label>
                        <input asp-for="BackdateGraceDays" class="form-control"
                               type="number" min="0" />
                        <div class="form-text">
                            How many days back leave may start, so sick
                            leave can be recorded after returning. Set
                            it to 0 to refuse any past start date.
                        </div>
                        <span asp-validation-for="BackdateGraceDays" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Reminders</div>
            <div class="card-body">

                <div class="form-check mb-3">
                    <input asp-for="RemindersEnabled" class="form-check-input" />
                    <label asp-for="RemindersEnabled" class="form-check-label">
                        Run the daily reminders
                    </label>
                    <div class="form-text">
                        Switching this off takes effect at the next
                        restart, since the schedule is set when the
                        application starts. Running by hand still works.
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label asp-for="RunAtHour" class="form-label"></label>
                        <input asp-for="RunAtHour" class="form-control"
                               type="number" min="0" max="23" />
                        <div class="form-text">Hour of the day, 0 to 23.</div>
                        <span asp-validation-for="RunAtHour" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="ExpiryWindowDays" class="form-label"></label>
                        <input asp-for="ExpiryWindowDays" class="form-control"
                               type="number" min="1" />
                        <div class="form-text">Days ahead to warn.</div>
                        <span asp-validation-for="ExpiryWindowDays" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="RepeatEveryDays" class="form-label"></label>
                        <input asp-for="RepeatEveryDays" class="form-control"
                               type="number" min="1" />
                        <div class="form-text">
                            Before the same reminder is sent again.
                        </div>
                        <span asp-validation-for="RepeatEveryDays" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="StaleApprovalDays" class="form-label"></label>
                        <input asp-for="StaleApprovalDays" class="form-control"
                               type="number" min="1" />
                        <div class="form-text">
                            How long a request may sit unanswered.
                        </div>
                        <span asp-validation-for="StaleApprovalDays" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="alert alert-info">
            Mail settings are not here on purpose. They include a
            password, and a password in a table every administrator can
            read is worse than one in a protected configuration file.
            They stay under <code>Email</code> in appsettings.json.
        </div>

        <div class="d-flex gap-2 mb-4">
            <button type="submit" class="btn btn-primary">Save Settings</button>
        </div>

    </form>

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Overridden here</span>

            @if (overrides.Any())
            {
                <form asp-action="Reset" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        Reset all to the file
                    </button>
                </form>
            }
        </div>

        <div class="card-body is-table">
            @if (!overrides.Any())
            {
                <p class="field-value is-empty mb-0 p-3">
                    Nothing is overridden. Every setting currently comes
                    from appsettings.json.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Setting</th>
                                <th>Value</th>
                                <th>Changed</th>
                                <th>By</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var setting in overrides)
                        {
                            <tr>
                                <td><code>@setting.Key</code></td>
                                <td>@setting.Value</td>
                                <td>
                                    @(setting.UpdatedAt.ToLocalTime()
                                        .ToString("d MMM yyyy HH:mm"))
                                </td>
                                <td class="text-muted">
                                    @(setting.UpdatedBy ?? "--")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
