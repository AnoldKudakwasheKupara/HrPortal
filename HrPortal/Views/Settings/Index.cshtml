@model HrPortal.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Settings";

    var overrides = ViewBag.Overrides as List<HrPortal.Entities.AppSetting>
        ?? new List<HrPortal.Entities.AppSetting>();
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>Settings</h2>

        <p class="text-muted">
            Changed here, these take effect immediately. Anything left
            alone keeps the value from the configuration file.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Index" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"
             role="alert"></div>

        <div class="card shadow-sm mt-3">

            <div class="card-header">Mail</div>

            <div class="card-body">

                <div class="detail-rows">

                    <div class="detail-row">

                        <span class="detail-icon">
                            <i class="fas fa-lock" aria-hidden="true"></i>
                        </span>

                        <div class="detail-text">
                            <span class="field-label">Not editable here</span>
                            <div class="field-value">
                                Mail settings include a password, and a
                                password in a table every administrator
                                can read is worse than one in a
                                protected configuration file. They stay
                                under <code>Email</code> in
                                appsettings.json.
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="mt-3 mb-4">

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-floppy-disk" aria-hidden="true"></i>
                Save settings
            </button>

        </div>

    </form>

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>Overridden here</span>

            @if (overrides.Any())
            {
                <form asp-action="Reset" method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-rotate-left" aria-hidden="true"></i>
                        Reset all to the file
                    </button>

                </form>
            }

        </div>

        @if (overrides.Any())
        {
            <div class="card-body is-table">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Setting</th>
                                <th>Value</th>
                                <th>Changed</th>
                                <th>By</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var setting in overrides)
                        {
                            <tr>

                                <td><code>@setting.Key</code></td>

                                <td>@setting.Value</td>

                                <td>
                                    @(setting.UpdatedAt.ToLocalTime()
                                        .ToString("d MMM yyyy HH:mm"))
                                </td>

                                <td class="text-muted">
                                    @(setting.UpdatedBy ?? "--")
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="card-body">

                <p class="empty-state">
                    <span class="empty-icon">&#9881;</span>
                    Nothing is overridden. Every setting currently comes
                    from appsettings.json.
                </p>

            </div>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
