@model HrPortal.Entities.LeaveBalance

@{
    ViewData["Title"] = "Delete Leave Balance";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Delete Leave Balance</h2>

        <p class="text-muted">
            This balance will be removed permanently.
        </p>

    </div>

    <div class="alert alert-warning">

        Are you sure you want to delete this leave balance?
        This cannot be undone.

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <p class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Leave Type</span>

                    <p class="field-value">
                        @Model.LeaveType.Name
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Year</span>

                    <p class="field-value">
                        @Model.Year
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Allocated Days</span>

                    <p class="field-value">
                        @Model.AllocatedDays.ToString("0.##")
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Used Days</span>

                    <p class="field-value">
                        @Model.UsedDays.ToString("0.##")
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Remaining Days</span>

                    <p class="field-value">
                        @Model.RemainingDays.ToString("0.##")
                    </p>

                </div>

            </div>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete Balance

                </button>

                <a asp-action="Index"
                   asp-route-year="@Model.Year"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
