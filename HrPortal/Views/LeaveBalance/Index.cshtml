@model IEnumerable<HrPortal.Entities.LeaveBalance>

@{
    ViewData["Title"] = "Leave Balances";

    var years = ViewBag.Years as List<int> ?? new List<int>();
    var selectedYear = (int)ViewBag.SelectedYear;
    var ratedTypes = ViewBag.RatedTypes as List<HrPortal.Entities.LeaveType> ?? new();
    var withoutBalance = (int)ViewBag.WithoutBalance;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Leave Balances</h2>

            <p class="text-muted">
                Each employee's running balance. It gains the monthly days on the
                1st, loses approved leave and carries on from year to year.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Upload"
               class="btn btn-primary">
                Upload Balances
            </a>

            <a asp-action="Create"
               class="btn btn-outline-primary">
                <i class="bi bi-plus-circle"></i>
                Add Balance
            </a>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!ratedTypes.Any())
    {
        <div class="alert alert-warning">
            No leave type earns days yet. Set <strong>Days earned per month</strong> on annual
            leave under <a asp-controller="LeaveType" asp-action="Index">Leave Types</a>.
        </div>
    }
    else if (withoutBalance > 0)
    {
        <div class="alert alert-info">
            @withoutBalance active employee@(withoutBalance == 1 ? " has" : "s have") no
            @ratedTypes[0].Name balance yet, so leave they take is not being deducted from anything.
            <a asp-action="Upload">Upload their balances</a>.
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-auto">

                    <label for="year"
                           class="form-label">
                        Year
                    </label>

                    <select id="year"
                            name="year"
                            class="form-select">

                    @foreach (var year in years)
                    {
                        if (year == selectedYear)
                        {
                            <option value="@year" selected>@year</option>
                        }
                        else
                        {
                            <option value="@year">@year</option>
                        }
                    }

                    </select>

                </div>

                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-outline-secondary">
                        Show
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Opening + earned</th>
                            <th>Used</th>
                            <th>Pending</th>
                            <th>Remaining</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No leave balances have been recorded for @selectedYear.
                            </td>
                        </tr>
                    }

                    @foreach (var balance in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @balance.Employee.FirstName
                                    @balance.Employee.LastName
                                </strong>
                            </td>

                            <td>
                                @balance.LeaveType.Name
                            </td>

                            <td>
                                @balance.AllocatedDays.ToString("0.##")
                            </td>

                            <td>
                                @balance.UsedDays.ToString("0.##")
                            </td>

                            <td>
                                @balance.PendingDays.ToString("0.##")
                            </td>

                            <td>
                                @if (balance.RemainingDays < 0)
                                {
                                    <span class="badge bg-danger">
                                        @balance.RemainingDays.ToString("0.##")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @balance.RemainingDays.ToString("0.##")
                                    </span>
                                }
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@balance.Id">

                                        View

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@balance.Id">

                                        Edit

                                    </a>

                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Delete"
                                       asp-route-id="@balance.Id">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
