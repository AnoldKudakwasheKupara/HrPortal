@model HrPortal.Entities.LeaveBalance

@{
    ViewData["Title"] = "Leave Balance Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>
                @Model.Employee.FirstName
                @Model.Employee.LastName
            </h2>

            <p class="text-muted">
                @Model.LeaveType.Name &mdash; @Model.Year
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               asp-route-year="@Model.Year"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <p class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <p class="field-value">
                        @Model.Employee.Department.Name
                    </p>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Leave Type</span>

                    <p class="field-value">
                        @Model.LeaveType.Name
                    </p>

                </div>

                <div class="col-md-3">

                    <span class="field-label">Year</span>

                    <p class="field-value">
                        @Model.Year
                    </p>

                </div>

                <div class="col-md-3">

                    <span class="field-label">Allocated Days</span>

                    <p class="field-value">
                        @Model.AllocatedDays.ToString("0.##")
                    </p>

                </div>

                <div class="col-md-3">

                    <span class="field-label">Used Days</span>

                    <p class="field-value">
                        @Model.UsedDays.ToString("0.##")
                    </p>

                </div>

                <div class="col-md-3">

                    <span class="field-label">Pending Days</span>

                    <p class="field-value">
                        @Model.PendingDays.ToString("0.##")
                    </p>

                </div>

                <div class="col-12">

                    <span class="field-label">Remaining Days</span>

                    <p class="field-value">
                        @if (Model.RemainingDays < 0)
                        {
                            <span class="badge bg-danger">
                                @Model.RemainingDays.ToString("0.##")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                @Model.RemainingDays.ToString("0.##")
                            </span>
                        }
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
