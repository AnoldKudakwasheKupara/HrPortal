@model HrPortal.Entities.LeaveBalance

@{
    ViewData["Title"] = "Leave Balance Details";

    var over = Model.RemainingDays < 0;
    var scale = Math.Max(Model.AllocatedDays, Model.UsedDays + Model.PendingDays);
    string Pct(decimal d) => (scale <= 0 ? 0 : Math.Round(Math.Clamp(d, 0, scale) / scale * 100, 1))
        .ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Employee.FirstName @Model.Employee.LastName</h2>
            <p>@Model.LeaveType.Name, @Model.Year</p>
        </div>

        <div class="head-actions">

            <span class="status-badge @(over ? "badge-red" : "badge-green")">
                @Model.RemainingDays.ToString("0.##") @(Math.Abs(Model.RemainingDays) == 1 ? "day" : "days") @(over ? "over" : "left")
            </span>

            <a asp-action="Index" asp-route-year="@Model.Year" class="btn btn-outline-secondary">Back</a>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-scale-balanced" aria-hidden="true"></i> Balance Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div><span>Employee</span><strong>@Model.Employee.FirstName @Model.Employee.LastName</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-building" aria-hidden="true"></i>
                        <div><span>Department</span><strong>@(Model.Employee.Department?.Name ?? "--")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-tags" aria-hidden="true"></i>
                        <div><span>Leave type</span><strong>@Model.LeaveType.Name</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar" aria-hidden="true"></i>
                        <div><span>Year</span><strong>@Model.Year</strong></div>
                    </div>

                </div>

                <div class="panel-block">

                    <div class="balance-bar mb-2" role="img"
                         aria-label="@Model.UsedDays.ToString("0.##") used and @Model.PendingDays.ToString("0.##") pending of @Model.AllocatedDays.ToString("0.##")">
                        <span class="is-used" style="width: @Pct(Model.UsedDays)%"></span>
                        <span class="is-pending" style="width: @Pct(Model.PendingDays)%"></span>
                    </div>

                    <dl class="balance-figures">
                        <div><dt>Opening + earned</dt><dd>@Model.AllocatedDays.ToString("0.##")</dd></div>
                        <div><dt><span class="legend-dot is-used"></span>Used</dt><dd>@Model.UsedDays.ToString("0.##")</dd></div>
                        <div><dt><span class="legend-dot is-pending"></span>Pending</dt><dd>@Model.PendingDays.ToString("0.##")</dd></div>
                        <div><dt>Remaining</dt><dd class="@(over ? "text-danger" : "")">@Model.RemainingDays.ToString("0.##")</dd></div>
                    </dl>

                </div>

            </section>

            @if (ViewBag.Statement is List<HrPortal.Entities.LeaveBalanceEntry> statement && statement.Any())
            {
                <section class="panel-card mb-3">

                    <h3 class="panel-head">
                        <i class="fas fa-list-ol" aria-hidden="true"></i> How the Balance Was Worked Out
                    </h3>

                    <partial name="_LeaveStatement" model="statement" />

                </section>
            }

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                    </a>

                    <partial name="_DownloadPdf" model="@Model.Id" />

                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Summary
                </h3>

                <dl class="info-list">
                    <dt>Opening + earned</dt>
                    <dd>@Model.AllocatedDays.ToString("0.##")</dd>
                    <dt>Used</dt>
                    <dd>@Model.UsedDays.ToString("0.##")</dd>
                    <dt>Pending</dt>
                    <dd>@Model.PendingDays.ToString("0.##")</dd>
                    <dt>Remaining</dt>
                    <dd class="@(over ? "text-danger" : "")">@Model.RemainingDays.ToString("0.##")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
