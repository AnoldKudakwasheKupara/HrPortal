@model HrPortal.ViewModels.LeaveBalanceEditViewModel

@{
    ViewData["Title"] = "Edit Leave Balance";
}

<div class="container">

    <div class="mb-4">

        <h2>Edit Leave Balance</h2>

        <p class="text-muted">
            Update this allocation. Remaining days are worked out
            automatically.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="EmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>

                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="LeaveTypeId"
                               class="form-label">
                        </label>

                        <select asp-for="LeaveTypeId"
                                asp-items="ViewBag.LeaveTypes"
                                class="form-select">

                            <option value="">
                                -- Select Leave Type --
                            </option>

                        </select>

                        <span asp-validation-for="LeaveTypeId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Year"
                               class="form-label">
                        </label>

                        <input asp-for="Year"
                               class="form-control"
                               type="number" />

                        <span asp-validation-for="Year"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="AllocatedDays"
                               class="form-label">
                        </label>

                        <input asp-for="AllocatedDays"
                               class="form-control"
                               type="number"
                               step="0.5"
                               min="0" />

                        <span asp-validation-for="AllocatedDays"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="UsedDays"
                               class="form-label">
                        </label>

                        <input asp-for="UsedDays"
                               class="form-control"
                               type="number"
                               step="0.5"
                               min="0" />

                        <span asp-validation-for="UsedDays"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-4">

                        <label asp-for="PendingDays"
                               class="form-label">
                        </label>

                        <input asp-for="PendingDays"
                               class="form-control"
                               type="number"
                               step="0.5"
                               min="0" />

                        <span asp-validation-for="PendingDays"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Save Changes

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
