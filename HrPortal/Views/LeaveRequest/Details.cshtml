@model HrPortal.Entities.LeaveRequest

@{
    ViewData["Title"] = "Leave Request Details";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>@Model.RequestNumber</h2>

            <p class="text-muted">
                Leave Request Details
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Employee</strong>

                    <p>
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Department</strong>

                    <p>
                        @Model.Employee.Department.Name
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Leave Type</strong>

                    <p>
                        @Model.LeaveType.Name
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Start Date</strong>

                    <p>
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>End Date</strong>

                    <p>
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Working Days</strong>

                    <p>
                        @Model.NumberOfDays.ToString("0.##")
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Status</strong>

                    <p>
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Submitted</strong>

                    <p>
                        @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Completed</strong>

                    <p>
                        @if (Model.CompletedAt.HasValue)
                        {
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                Still in progress
                            </span>
                        }
                    </p>

                </div>


                <div class="col-12">

                    <strong>Reason</strong>

                    <p>
                        @(Model.Reason ?? "No reason given.")
                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">

            <strong>
                History
            </strong>

        </div>

        <div class="card-body">

            @if (Model.History.Any())
            {
                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>By</th>
                                <th>Date</th>
                                <th>Comment</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var entry in Model.History
                            .OrderBy(h => h.ActionDate))
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @entry.Action
                                    </strong>
                                </td>

                                <td>
                                    @entry.ActionedByEmployee.FirstName
                                    @entry.ActionedByEmployee.LastName
                                </td>

                                <td>
                                    @entry.ActionDate.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        entry.Comment))
                                    {
                                        @entry.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No comment
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No history has been recorded for this request.
                </p>
            }

        </div>

    </div>

</div>
