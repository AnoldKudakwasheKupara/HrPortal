@model HrPortal.Entities.LeaveRequest

@{
    ViewData["Title"] = "Leave Request Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.RequestNumber</h2>

            <p class="text-muted">
                Leave Request Details
            </p>
        </div>

        <div>

            <a asp-action="Form"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                <i class="fas fa-download" aria-hidden="true"></i>
                Application form (PDF)
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Employee</span>

                    <div class="field-value">
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Department</span>

                    <div class="field-value">
                        @Model.Employee.Department.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Leave Type</span>

                    <div class="field-value">
                        @Model.LeaveType.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Start Date</span>

                    <div class="field-value">
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">End Date</span>

                    <div class="field-value">
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Working Days</span>

                    <div class="field-value">
                        @Model.NumberOfDays.ToString("0.##")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Status</span>

                    <div class="field-value">
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Submitted</span>

                    <div class="field-value">
                        @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Completed</span>

                    <div class="field-value">
                        @if (Model.CompletedAt.HasValue)
                        {
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                Still in progress
                            </span>
                        }
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Reason</span>

                    <div class="field-value">
                        @(Model.Reason ?? "No reason given.")
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">History</div>

        <div class="card-body @(Model.History.Any() ? "is-table" : "")">

            @if (Model.History.Any())
            {
                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>By</th>
                                <th>Date</th>
                                <th>Status Change</th>
                                <th>Comment</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var entry in Model.History
                            .OrderBy(h => h.ActionDate))
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @entry.Action
                                    </strong>
                                </td>

                                <td>
                                    @entry.ActionedByEmployee.FirstName
                                    @entry.ActionedByEmployee.LastName
                                </td>

                                <td>
                                    @entry.ActionDate.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @entry.PreviousStatus
                                    </span>
                                    &rarr;
                                    @entry.NewStatus
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        entry.Comment))
                                    {
                                        @entry.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No comment
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128220;</span>
                    No history has been recorded for this request.
                </p>
            }

        </div>

    </div>

</div>
