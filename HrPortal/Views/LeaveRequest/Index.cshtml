@using HrPortal.Entities
@model IEnumerable<HrPortal.Entities.LeaveRequest>

@{
    ViewData["Title"] = "All Leave Requests";

    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
    var status = ViewBag.SelectedStatus as LeaveRequestStatus?;
    var employeeId = ViewBag.SelectedEmployeeId as int?;
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>All Leave Requests</h2>

        <p class="text-muted">
            Every request across the organisation, for oversight
            and reporting. Requests are raised by employees and
            decided by the approvers, so nothing is changed here.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-3">

                    <label for="status" class="form-label">
                        Status
                    </label>

                    <select id="status"
                            name="status"
                            asp-items="Html.GetEnumSelectList<LeaveRequestStatus>()"
                            class="form-select">

                        <option value="">-- All Statuses --</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label for="employeeId" class="form-label">
                        Employee
                    </label>

                    <select id="employeeId"
                            name="employeeId"
                            asp-items="ViewBag.Employees"
                            class="form-select">

                        <option value="">-- All Employees --</option>

                    </select>

                </div>

                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-outline-secondary">
                        Filter
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var request in Model)
                    {
                        <tr>

                            <td>
                                <strong>@request.RequestNumber</strong>
                            </td>

                            <td>
                                @request.Employee.FirstName
                                @request.Employee.LastName
                            </td>

                            <td>
                                @request.LeaveType.Name
                            </td>

                            <td>
                                @request.StartDate.ToString("dd MMM yyyy")
                                &ndash;
                                @request.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @request.NumberOfDays.ToString("0.##")
                            </td>

                            <td>
                                @switch (request.Status)
                                {
                                    case LeaveRequestStatus.Approved:
                                        <span class="badge bg-success">
                                            @request.Status
                                        </span>
                                        break;

                                    case LeaveRequestStatus.Rejected:
                                    case LeaveRequestStatus.HRRejected:
                                        <span class="badge bg-danger">
                                            @request.Status
                                        </span>
                                        break;

                                    case LeaveRequestStatus.Cancelled:
                                        <span class="badge bg-secondary">
                                            @request.Status
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-warning text-dark">
                                            @request.Status
                                        </span>
                                        break;
                                }
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@request.Id">
                                        View
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

                @if (!Model.Any())
                {
                    <p class="text-muted mb-0">
                        No leave requests match this filter.
                    </p>
                }

            </div>

        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">

                <span class="text-muted">
                    Page @(page) of @totalPages (@totalCount requests)
                </span>

                <div>

                    @if (page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           asp-action="Index"
                           asp-route-page="@(page - 1)"
                           asp-route-status="@status"
                           asp-route-employeeId="@employeeId">
                            Previous
                        </a>
                    }

                    @if (page < totalPages)
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           asp-action="Index"
                           asp-route-page="@(page + 1)"
                           asp-route-status="@status"
                           asp-route-employeeId="@employeeId">
                            Next
                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>
