@model HrPortal.Entities.LeaveRequest

@{
    ViewData["Title"] = "Delete Leave Request";
}

<div class="container">

    <div class="mb-4">

        <h2>Delete @Model.RequestNumber</h2>

        <p class="text-muted">
            This request will be removed permanently.
        </p>

    </div>


    <div class="alert alert-warning">

        Are you sure you want to delete this leave request?

        @if (Model.History.Any())
        {
            <strong>
                Its @Model.History.Count history
                @(Model.History.Count == 1 ? "entry" : "entries")
                will be deleted too.
            </strong>
        }

        If you only want to withdraw it, cancel the request instead
        so the record is kept.

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Employee</strong>

                    <p>
                        @Model.Employee.FirstName
                        @Model.Employee.LastName
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Leave Type</strong>

                    <p>
                        @Model.LeaveType.Name
                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Status</strong>

                    <p>
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Dates</strong>

                    <p>
                        @Model.StartDate.ToString("dd MMM yyyy")
                        &ndash;
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Working Days</strong>

                    <p>
                        @Model.NumberOfDays.ToString("0.##")
                    </p>

                </div>

            </div>


            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete Request

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
