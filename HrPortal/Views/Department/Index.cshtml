@using HrPortal.ViewModels
@model IEnumerable<HrPortal.Entities.Department>

@{
    ViewData["Title"] = "Departments";

    var all = Model.ToList();
    var search = PagedList.SearchFrom(Context.Request);
    var shown = all.Where(d => PagedList.Matches(search, d.Name, d.Description)).ToList();
    var paged = PagedList.Of(shown, PagedList.PageFrom(Context.Request));
    var staff = all.Sum(d => d.Employees.Count(e => e.IsActive));
    var largest = all.OrderByDescending(d => d.Employees.Count(e => e.IsActive)).FirstOrDefault();
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Departments</h2>
            <p>Manage company departments.</p>
        </div>

        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-plus" aria-hidden="true"></i> Add Department
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-sitemap"></i></span>
            <div>
                <div class="kpi-label">Departments</div>
                <div class="kpi-value">@all.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
            <div>
                <div class="kpi-label">Active</div>
                <div class="kpi-value">@all.Count(d => d.IsActive)</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-users"></i></span>
            <div>
                <div class="kpi-label">Active Staff</div>
                <div class="kpi-value">@staff</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-ranking-star"></i></span>
            <div>
                <div class="kpi-label">Largest</div>
                @if (largest == null)
                {
                    <div class="kpi-value kpi-value-text text-muted">None</div>
                }
                else
                {
                    <div class="kpi-value kpi-value-text text-truncate" title="@largest.Name">@largest.Name</div>
                    <div class="kpi-note">@largest.Employees.Count(e => e.IsActive) active staff</div>
                }
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-sitemap" aria-hidden="true"></i> Departments
            <span class="tab-count">@shown.Count</span>
        </h3>

        <partial name="_ListToolbar" model='new ListToolbarModel(null, search, "Search departments...")' />

        @if (!shown.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-sitemap" aria-hidden="true"></i>
                <p>@(all.Any() ? "No departments match." : "No departments have been added yet.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Description</th>
                            <th>Employees</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var department in paged.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@department.Name</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(department.Description))
                                    {
                                        @department.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>
                                <td><span class="status-badge badge-blue">@department.Employees.Count</span></td>
                                <td>
                                    @if (department.IsActive)
                                    {
                                        <span class="status-badge badge-green">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-gray">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions justify-content-end">

                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@department.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>

                                        <a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Edit" asp-route-id="@department.Id">
                                            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                        </a>

                                        @if (department.Employees.Count == 0)
                                        {
                                            <form asp-action="Delete" asp-route-id="@department.Id" method="post" class="d-inline"
                                                  data-confirm="Delete the @department.Name department? This cannot be undone."
                                                  onsubmit="return confirm(this.dataset.confirm);">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Delete @department.Name</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                                    title="Move its @department.Employees.Count employee(s) to another department before deleting it.">
                                                <i class="fas fa-trash" aria-hidden="true"></i>
                                                <span class="visually-hidden">Delete @department.Name</span>
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "department", "departments")' />
        }

    </section>

</div>
