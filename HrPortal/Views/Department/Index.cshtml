@model IEnumerable<HrPortal.Entities.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Departments</h2>

            <p class="text-muted">
                Manage company departments.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Department
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Description</th>
                            <th>Employees</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var department in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @department.Name
                                </strong>
                                @if (department.TracksTimesheets)
                                {
                                    <span class="badge bg-info ms-1"
                                          title="Staff in this department keep timesheets">
                                        Timesheets
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    department.Description))
                                {
                                    @department.Description
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No description
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @department.Employees.Count
                                </span>
                            </td>

                            <td>
                                @if (department.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="col-actions">

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details"
                                       asp-route-id="@department.Id">

                                        View

                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@department.Id">

                                        Edit

                                    </a>

                                    <form asp-action="ToggleStatus"
                                          asp-route-id="@department.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">

                                            @(department.IsActive
                                                ? "Deactivate"
                                                : "Activate")

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
