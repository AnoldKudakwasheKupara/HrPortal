@using HrPortal.ViewModels
@model NotificationsIndexViewModel

@{
    ViewData["Title"] = "Notifications";
    var paged = Model.Page;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Notifications</h2>
            <p>Raised automatically when something happens to your requests, courses or training.</p>
        </div>

        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button type="submit" class="btn btn-gold">
                    <i class="fas fa-check-double" aria-hidden="true"></i> Mark all as read
                </button>
            </form>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-bell"></i></span>
            <div>
                <div class="kpi-label">All Notifications</div>
                <div class="kpi-value">@Model.Total</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-envelope"></i></span>
            <div>
                <div class="kpi-label">Unread</div>
                <div class="kpi-value">@Model.UnreadCount</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-calendar-week"></i></span>
            <div>
                <div class="kpi-label">In the Last 7 Days</div>
                <div class="kpi-value">@Model.ThisWeek</div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-bell" aria-hidden="true"></i> Your Notifications
        </h3>

        <partial name="_ListTabs" model="new ListTabsModel(Model.Tabs, Model.Show)" />

        @if (paged.TotalCount == 0)
        {
            <div class="list-empty mb-0">
                <i class="fas fa-bell-slash" aria-hidden="true"></i>
                <p>@(Model.Total == 0 ? "You have no notifications yet." : "Nothing here.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Notification</th>
                            <th>Received</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var notification in paged.Items)
                        {
                            <tr class="@(notification.IsRead ? "" : "is-unread")">

                                <td>
                                    <div class="fw-semibold">@notification.Title</div>
                                    <div class="small text-muted">@notification.Message</div>
                                </td>

                                <td class="text-nowrap">@notification.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>

                                <td>
                                    @if (notification.IsRead)
                                    {
                                        <span class="status-badge badge-gray">Read</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-blue">Unread</span>
                                    }
                                </td>

                                <td>
                                    <div class="table-actions justify-content-end">

                                        @if (!string.IsNullOrWhiteSpace(notification.Link))
                                        {
                                            <a class="btn btn-sm btn-outline-secondary text-nowrap"
                                               asp-action="Open" asp-route-id="@notification.Id">
                                                <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i> Open
                                            </a>
                                        }

                                        @if (!notification.IsRead)
                                        {
                                            <form asp-action="MarkRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">
                                                    <i class="fas fa-check" aria-hidden="true"></i> Mark as read
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(paged, "notification", "notifications")' />
        }

    </section>

</div>
