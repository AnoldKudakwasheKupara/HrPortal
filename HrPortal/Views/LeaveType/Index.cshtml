@model IEnumerable<HrPortal.Entities.LeaveType>

@{
    ViewData["Title"] = "Leave Types";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Leave Types</h2>

            <p class="text-muted">
                Manage the categories of leave employees can request.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Leave Type
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th>Description</th>
                            <th>Default Days</th>
                            <th>Approval</th>
                            <th>Requests</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var leaveType in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @leaveType.Name
                                </strong>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    leaveType.Description))
                                {
                                    @leaveType.Description
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No description
                                    </span>
                                }
                            </td>

                            <td>
                                @leaveType.DefaultDays.ToString("0.##")
                            </td>

                            <td>
                                @if (leaveType.RequiresApproval)
                                {
                                    <span class="badge bg-info text-dark">
                                        Required
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">
                                        Not required
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @leaveType.LeaveRequests.Count
                                </span>
                            </td>

                            <td>
                                @if (leaveType.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="dropdown">

                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">

                                        Actions

                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@leaveType.Id">

                                                View

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@leaveType.Id">

                                                Edit

                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>

                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@leaveType.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item">

                                                    @(leaveType.IsActive
                                                        ? "Deactivate"
                                                        : "Activate")

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
