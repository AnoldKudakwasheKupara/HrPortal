@using HrPortal.Entities
@using HrPortal.ViewModels
@model HrPortal.Entities.LeaveType

@{
    ViewData["Title"] = "Leave Type Details";

    var requests = Model.LeaveRequests.OrderByDescending(r => r.SubmittedAt).ToList();
    var paged = PagedList.Of(requests, PagedList.PageFrom(Context.Request));
    var approved = requests.Where(r => r.Status == LeaveRequestStatus.Approved).ToList();

    string Span(DateTime start, DateTime end) =>
        start.Date == end.Date ? start.ToString("d MMM yyyy")
        : start.Year == end.Year && start.Month == end.Month ? $"{start.Day}–{end:d MMM yyyy}"
        : start.Year == end.Year ? $"{start:d MMM} – {end:d MMM yyyy}"
        : $"{start:d MMM yyyy} – {end:d MMM yyyy}";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Name</h2>
            <p>@(Model.Description ?? "Leave type details")</p>
        </div>

        <div class="head-actions">

            @if (Model.IsActive)
            {
                <span class="status-badge badge-green">Active</span>
            }
            else
            {
                <span class="status-badge badge-gray">Inactive</span>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-tags" aria-hidden="true"></i> Leave Type Details
                </h3>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-tag" aria-hidden="true"></i>
                        <div><span>Name</span><strong>@Model.Name</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        <div><span>Status</span><strong>@(Model.IsActive ? "Active" : "Inactive")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                        <div>
                            <span>Earned per month</span>
                            @if (Model.MonthlyAccrualDays > 0)
                            {
                                <strong>@Model.MonthlyAccrualDays.ToString("0.##") days</strong>
                            }
                            else
                            {
                                <em>No balance kept</em>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-days" aria-hidden="true"></i>
                        <div><span>Requests made</span><strong>@requests.Count</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-align-left" aria-hidden="true"></i> Description</h4>
                    <p class="pre-line">@(Model.Description ?? "No description provided.")</p>
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-calendar-days" aria-hidden="true"></i> Leave Requests of this Type
                    <span class="tab-count">@requests.Count</span>
                </h3>

                @if (!requests.Any())
                {
                    <div class="list-empty mb-0">
                        <i class="fas fa-calendar-xmark" aria-hidden="true"></i>
                        <p>No leave requests have been made using this leave type.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Request</th>
                                    <th>Employee</th>
                                    <th>Dates</th>
                                    <th>Days</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var request in paged.Items)
                                {
                                    <tr>
                                        <td class="text-nowrap fw-semibold">@request.RequestNumber</td>
                                        <td>@request.Employee.FirstName @request.Employee.LastName</td>
                                        <td class="text-nowrap">@Span(request.StartDate, request.EndDate)</td>
                                        <td>@request.NumberOfDays.ToString("0.##")</td>
                                        <td><partial name="_LeaveStatusBadge" model="request.Status" /></td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <partial name="_NumberedPager" model='PagerSummary.From(paged, "request", "requests")' />
                }

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                    </a>

                    <partial name="_DownloadPdf" model="@Model.Id" />

                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Usage
                </h3>

                <dl class="info-list">
                    <dt>Requests</dt>
                    <dd>@requests.Count</dd>
                    <dt>Approved</dt>
                    <dd>@approved.Count</dd>
                    <dt>Days approved</dt>
                    <dd>@approved.Sum(r => r.NumberOfDays).ToString("0.##")</dd>
                    <dt>Last requested</dt>
                    <dd>@(requests.FirstOrDefault()?.SubmittedAt.ToLocalTime().ToString("d MMM yyyy") ?? "Never")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
