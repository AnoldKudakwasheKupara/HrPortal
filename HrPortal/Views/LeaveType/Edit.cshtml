@model HrPortal.ViewModels.LeaveTypeEditViewModel

@{
    ViewData["Title"] = "Edit Leave Type";
}

<div class="container">

    <div class="mb-4">

        <h2>Edit Leave Type</h2>

        <p class="text-muted">
            Update this category of leave.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DefaultDays"
                               class="form-label">
                        </label>

                        <input asp-for="DefaultDays"
                               class="form-control"
                               type="number"
                               step="0.5"
                               min="0" />

                        <span asp-validation-for="DefaultDays"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-check mb-3">

                    <input asp-for="RequiresApproval"
                           class="form-check-input" />

                    <label asp-for="RequiresApproval"
                           class="form-check-label">
                        Requests of this type need approval
                    </label>

                </div>


                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Leave type is active
                    </label>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Save Changes

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
