@model HrPortal.Entities.DocumentCategory

@{
    ViewData["Title"] = "Document Category Details";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.Name</h2>

            <p class="text-muted">
                Document Category Details
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <span class="field-label">Category Name</span>

                    <div class="field-value">
                        @Model.Name
                    </div>

                </div>

                <div class="col-md-6">

                    <span class="field-label">Status</span>

                    <div class="field-value">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Description</span>

                    <div class="field-value">
                        @(Model.Description ?? "No description provided.")
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">Documents in this Category</div>

        <div class="card-body @(Model.Documents.Any() ? "is-table" : "")">

            @if (Model.Documents.Any())
            {
                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Employee</th>
                                <th>Uploaded</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var document in Model.Documents
                            .OrderByDescending(d => d.UploadedAt))
                        {
                            <tr>

                                <td>
                                    @document.OriginalFileName
                                </td>

                                <td>
                                    @document.Employee.FirstName
                                    @document.Employee.LastName
                                </td>

                                <td>
                                    @document.UploadedAt.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128193;</span>
                    No documents are currently filed under this category.
                </p>
            }

        </div>

    </div>

</div>
