@model HrPortal.ViewModels.DocumentCategoryEditViewModel

@{
    ViewData["Title"] = "Edit Document Category";
}

<div class="container">

    <div class="page-head-simple">

        <h2>Edit Document Category</h2>

        <p class="text-muted">
            Update this document category.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-check mb-4">

                    <input asp-for="IsRestricted"
                           class="form-check-input" />

                    <label asp-for="IsRestricted"
                           class="form-check-label">
                        HR only &mdash; hide from the employee
                    </label>

                    <div class="form-text">
                        For disciplinary and performance records.
                        Documents in this category stay out of the
                        employee&rsquo;s own profile and cannot be
                        opened by them.
                    </div>

                </div>


                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Category is active
                    </label>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Save Changes

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
