@model HrPortal.Entities.License

@{
    ViewData["Title"] = "Licence Details";
    var daysLeft = (int)(Model.ExpiryDate.Date - DateTime.Today).TotalDays;
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@Model.Name</h2>
            <p>@Model.Type@(Model.AutoRenews ? ", renews automatically" : "")</p>
        </div>

        <div class="head-actions">
            <partial name="_LicenseStatusBadge" model="Model" />
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-lg-8">

            <section class="panel-card mb-3">

                <div class="panel-head-split">
                    <h3 class="panel-head">
                        <i class="fas fa-certificate" aria-hidden="true"></i> Licence Details
                    </h3>
                    <partial name="_LicenseStatusBadge" model="Model" />
                </div>

                <div class="facts">

                    <div class="fact">
                        <i class="fas fa-key" aria-hidden="true"></i>
                        <div>
                            <span>Reference or key</span>
                            @if (string.IsNullOrWhiteSpace(Model.Reference))
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong class="text-break">@Model.Reference</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <div><span>Seats</span><strong>@(Model.Seats?.ToString() ?? "Not per seat")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-calendar-day" aria-hidden="true"></i>
                        <div>
                            <span>Started</span>
                            @if (Model.StartDate == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.StartDate.Value.ToString("d MMM yyyy")</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-hourglass-end" aria-hidden="true"></i>
                        <div><span>Expires</span><strong class="@(daysLeft < 0 ? "text-danger" : "")">@Model.ExpiryDate.ToString("d MMM yyyy")</strong></div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-coins" aria-hidden="true"></i>
                        <div>
                            <span>Current cost</span>
                            @if (Model.Cost == null)
                            {
                                <em>Not recorded</em>
                            }
                            else
                            {
                                <strong>@Model.Cost.Value.ToString("0.00")</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-truck-field" aria-hidden="true"></i>
                        <div>
                            <span>Vendor</span>
                            @if (Model.Vendor == null)
                            {
                                <em>Not on the vendor register</em>
                            }
                            else
                            {
                                <strong>@Model.Vendor.Name</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <div>
                            <span>Held by</span>
                            @if (Model.AssignedToEmployee == null)
                            {
                                <em>Company wide</em>
                            }
                            else
                            {
                                <strong>@Model.AssignedToEmployee.FirstName @Model.AssignedToEmployee.LastName</strong>
                            }
                        </div>
                    </div>

                    <div class="fact">
                        <i class="fas fa-sitemap" aria-hidden="true"></i>
                        <div><span>Department</span><strong>@(Model.AssignedToEmployee?.Department?.Name ?? "--")</strong></div>
                    </div>

                </div>

                <div class="panel-block">
                    <h4><i class="fas fa-note-sticky" aria-hidden="true"></i> Notes</h4>
                    <p class="pre-line">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Nothing recorded against this licence." : Model.Notes)</p>
                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Renewal History
                    <span class="tab-count">@Model.Renewals.Count</span>
                </h3>

                @if (!Model.Renewals.Any())
                {
                    <div class="list-empty mb-0">
                        <i class="fas fa-rotate" aria-hidden="true"></i>
                        <p>This licence has not been renewed through the portal yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Renewed On</th>
                                    <th>Previous Expiry</th>
                                    <th>New Expiry</th>
                                    <th class="num">Cost</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Renewals)
                                {
                                    <tr>
                                        <td class="text-nowrap">@r.RenewedOn.ToString("d MMM yyyy")</td>
                                        <td class="text-nowrap">@r.PreviousExpiry.ToString("d MMM yyyy")</td>
                                        <td class="text-nowrap fw-semibold">@r.NewExpiry.ToString("d MMM yyyy")</td>
                                        <td class="num">@(r.Cost?.ToString("0.00") ?? "-")</td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(r.Notes) ? "-" : r.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

        <div class="col-lg-4">

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-bolt" aria-hidden="true"></i> Actions
                </h3>

                <div class="d-grid gap-2">

                    <a asp-action="Renew" asp-route-id="@Model.Id" class="btn btn-gold">
                        <i class="fas fa-rotate" aria-hidden="true"></i> Record a renewal
                    </a>

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-success">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                    </a>

                    <partial name="_DownloadPdf" model="@Model.Id" />

                </div>

            </section>

            <section class="panel-card mb-3">

                <h3 class="panel-head">
                    <i class="fas fa-circle-info" aria-hidden="true"></i> Licence Information
                </h3>

                <dl class="info-list">
                    <dt>Type</dt>
                    <dd>@Model.Type</dd>
                    <dt>Renews</dt>
                    <dd>@(Model.AutoRenews ? "Automatically" : "By hand")</dd>
                    <dt>Expires</dt>
                    <dd>@Model.ExpiryDate.ToString("d MMM yyyy")</dd>
                    <dt>@(daysLeft < 0 ? "Expired" : "Days left")</dt>
                    <dd class="@(daysLeft < 0 ? "text-danger" : "")">@(daysLeft < 0 ? $"{-daysLeft} days ago" : daysLeft.ToString())</dd>
                    <dt>Renewals</dt>
                    <dd>@Model.Renewals.Count</dd>
                    <dt>Added</dt>
                    <dd>@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
                </dl>

            </section>

        </div>

    </div>

</div>
