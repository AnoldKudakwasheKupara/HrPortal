@model HrPortal.ViewModels.LicenseCreateViewModel

@{ ViewData["Title"] = "Add Licence"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Add Licence</h2>
        <p class="text-muted">
            Record what it is, when it expires and who supplies it.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_LicenseFields" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add Licence</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
