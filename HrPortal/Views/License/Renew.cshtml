@model HrPortal.ViewModels.LicenseRenewViewModel

@{ ViewData["Title"] = "Renew Licence"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Renew @Model.Name</h2>
        <p class="text-muted">
            Currently expires @Model.CurrentExpiry.ToString("d MMM yyyy").
            The old date is kept in the renewal history.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Renew" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="NewExpiry" class="form-label"></label>
                        <input asp-for="NewExpiry" class="form-control" type="date" />
                        <span asp-validation-for="NewExpiry" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="RenewedOn" class="form-label"></label>
                        <input asp-for="RenewedOn" class="form-control" type="date" />
                        <span asp-validation-for="RenewedOn" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Cost" class="form-label"></label>
                        <input asp-for="Cost" class="form-control"
                               type="number" step="0.01" min="0" />
                        <div class="form-text">What this renewal cost.</div>
                        <span asp-validation-for="Cost" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Invoice number, who approved it"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Record Renewal</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
