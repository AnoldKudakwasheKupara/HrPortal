@model IEnumerable<HrPortal.Entities.TrainingAssignment>

@{
    ViewData["Title"] = "My Training";
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>My Training</h2>

        <p class="text-muted">
            Courses you have been assigned. Open one to read the
            materials, then mark it complete and leave feedback.
        </p>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body is-table">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Assigned</th>
                            <th>Due</th>
                            <th>Status</th>
                            <th>Feedback</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var assignment in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @assignment.TrainingCourse.Title
                                </strong>
                            </td>

                            <td>
                                @assignment.AssignedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (assignment.DueDate.HasValue)
                                {
                                    if (!assignment.IsCompleted &&
                                        assignment.DueDate.Value.Date < DateTime.Today)
                                    {
                                        <span class="badge bg-danger">
                                            Overdue
                                            @assignment.DueDate.Value.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        @assignment.DueDate.Value.ToString("dd MMM yyyy")
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No due date
                                    </span>
                                }
                            </td>

                            <td>
                                @if (assignment.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Outstanding
                                    </span>
                                }
                            </td>

                            <td>
                                @if (assignment.Feedback != null)
                                {
                                    <span class="badge bg-info text-dark">
                                        @assignment.Feedback.Rating / 5
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not given
                                    </span>
                                }
                            </td>

                            <td>

                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Details"
                                   asp-route-id="@assignment.Id">
                                    Open
                                </a>

                                @if (assignment.IsCompleted &&
                                     assignment.Feedback == null)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Feedback"
                                       asp-route-id="@assignment.Id">
                                        Give feedback
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

                @if (!Model.Any())
                {
                    <p class="text-muted mb-0">
                        You have no training assigned at the moment.
                    </p>
                }

            </div>

        </div>

    </div>

</div>
