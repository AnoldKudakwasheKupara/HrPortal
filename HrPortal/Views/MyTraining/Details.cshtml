@model HrPortal.Entities.TrainingAssignment

@{
    ViewData["Title"] = "Training Course";
}

<div class="container">

    <div class="page-head">

        <div>
            <h2>@Model.TrainingCourse.Title</h2>

            <p class="text-muted">
                Assigned
                @Model.AssignedAt.ToString("dd MMM yyyy")
            </p>
        </div>

        <partial name="_DownloadPdf" model="@Model.Id" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <span class="field-label">Trainer</span>

                    <div class="field-value">@(Model.TrainingCourse.Trainer ?? "Not set")</div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Training Date</span>

                    <div class="field-value">
                        @if (Model.TrainingCourse.TrainingDate.HasValue)
                        {
                            @Model.TrainingCourse.TrainingDate.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span class="text-muted">Not scheduled</span>
                        }
                    </div>

                </div>

                <div class="col-md-4">

                    <span class="field-label">Due</span>

                    <div class="field-value">
                        @if (Model.DueDate.HasValue)
                        {
                            @Model.DueDate.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span class="text-muted">No due date</span>
                        }
                    </div>

                </div>

                <div class="col-12">

                    <span class="field-label">Description</span>

                    <div class="field-value">
                        @(Model.TrainingCourse.Description
                          ?? "No description provided.")
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">Course Materials</div>

        <div class="card-body">

            @if (Model.TrainingCourse.Materials.Any())
            {
                <ul class="row-list">

                @foreach (var material in Model.TrainingCourse.Materials
                    .OrderByDescending(m => m.UploadedAt))
                {
                    <li>

                        <span class="row-icon">
                            <i class="fas fa-file-lines" aria-hidden="true"></i>
                        </span>

                        <div class="row-main">

                            <span class="row-title">
                                @material.OriginalFileName
                            </span>

                            <span class="row-meta">
                                @if (!string.IsNullOrWhiteSpace(material.Description))
                                {
                                    @material.Description
                                }
                                else
                                {
                                    <text>Uploaded @material.UploadedAt.ToString("dd MMM yyyy")</text>
                                }
                            </span>

                        </div>

                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Material"
                           asp-route-id="@material.Id">
                            Download
                        </a>

                    </li>
                }

                </ul>
            }
            else
            {
                <p class="empty-state">
                    <span class="empty-icon">&#128193;</span>
                    No materials have been uploaded for this course.
                </p>
            }

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.IsCompleted)
            {
                <p>
                    <span class="badge bg-success">Completed</span>
                    on @Model.CompletedAt?.ToString("dd MMM yyyy")
                </p>

                @if (Model.Feedback == null)
                {
                    <a asp-action="Feedback"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Give feedback
                    </a>
                }
                else
                {
                    <p class="mb-0 text-muted">
                        You rated this course
                        @Model.Feedback.Rating out of 5.
                    </p>
                }
            }
            else
            {
                <p>
                    When you have worked through the materials, mark
                    this training as complete.
                </p>

                <form asp-action="Complete"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success">
                        Mark as completed
                    </button>

                </form>
            }

        </div>

    </div>

</div>
