@model HrPortal.ViewModels.AssetMaintenanceCreateViewModel

@{
    ViewData["Title"] = "Schedule Maintenance";
}

<div class="container">

    <div class="page-head-simple">
        <h2>Schedule Maintenance</h2>
        <p class="text-muted">
            Book servicing, a repair, an upgrade or an inspection
            against a machine.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <partial name="_MaintenanceFields" model="Model" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Schedule
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
