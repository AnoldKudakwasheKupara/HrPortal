@*  Layout for the signed-out pages.

    No sidebar and no account controls: showing the whole
    navigation to someone who cannot use any of it was both
    confusing and a hint about the system's shape to anyone who
    had not signed in.                                         *@

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script>
        (function () {
            try {
                var stored = localStorage.getItem("hrportal-theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)").matches;
                document.documentElement.setAttribute(
                    "data-bs-theme",
                    stored || (prefersDark ? "dark" : "light"));
            } catch (e) { /* storage blocked: stay on light */ }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
</head>
<body class="auth-body">

    <main class="auth-shell">

        <div class="auth-card">

            <div class="auth-brand">
                <span class="brand-mark">HR</span>
                <span class="brand-name">HR Portal</span>
            </div>

            @RenderBody()

        </div>

        <p class="auth-foot">
            &copy; 2026 HR Portal
        </p>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
