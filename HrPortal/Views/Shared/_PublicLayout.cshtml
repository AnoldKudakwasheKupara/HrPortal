<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Brand.Current.PortalName</title>

    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content(Brand.Current.Asset("icon-32.png"))" />
    <link rel="icon" type="image/png" sizes="512x512" href="@Url.Content(Brand.Current.Asset("icon-512.png"))" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content(Brand.Current.Asset("icon-180.png"))" />

    <link rel="stylesheet" href="~/fonts/montserrat/montserrat.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/app-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
    <partial name="_BrandStyle" />
</head>
<body>

    <div class="public-shell" id="top">

        <header class="public-topbar">

            <div class="public-topbar-inner">

                <a class="public-brand" href="@Url.Content("~/")" aria-label="@Brand.Current.ShortName home">
                    <img src="@Url.Content(Brand.Current.Asset("logo.png"))"
                         alt="@Brand.Current.FullName"
                         class="brand-logo" />
                </a>

                @{
                    var front = Url.Content("~/");

                    var onFront =
                        (ViewContext.RouteData.Values["controller"] as string)
                            == "Home" &&
                        (ViewContext.RouteData.Values["action"] as string)
                            == "Index";
                }

                <nav class="public-nav" aria-label="Sections of this page">
                    <a href="@(front)#home"
                       class="@(onFront ? "is-active" : "")">Home</a>
                    <a href="@(front)#about">About @Brand.Current.ShortName</a>
                    <a href="@(front)#services">Our Services</a>
                    <a href="@(front)#values">Our Values</a>
                </nav>

                <a class="btn btn-outline-primary public-signin"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                    <i class="fas fa-right-to-bracket" aria-hidden="true"></i>
                    Sign in
                </a>

            </div>

        </header>

        <main class="public-main">
            @RenderBody()
        </main>

        <footer class="public-foot">

            <div class="public-foot-inner">

                <span class="public-foot-note">
                    &copy; @DateTime.Today.Year @Brand.Current.LegalName.
                    <span class="public-foot-sep">|</span>
                    For internal use by @Brand.Current.ShortName staff.
                </span>

                <span class="public-foot-links">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">Privacy</a>
                </span>

            </div>

        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/public-nav.js" asp-append-version="true"></script>
    <script src="~/js/ux.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
