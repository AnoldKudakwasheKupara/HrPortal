<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Intellego</title>

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/icon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/images/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/icon-180.png" />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/app-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="public-shell" id="top">

        <header class="public-topbar">

            <div class="public-topbar-inner">

                <a class="public-brand" href="#top" aria-label="Intellego, back to top">
                    <img src="~/images/intellego-logo.png"
                         alt="Intellego Investment Consultants"
                         class="brand-logo" />
                </a>

                <nav class="public-nav" aria-label="Sections of this page">
                    <a href="#home" class="is-active">Home</a>
                    <a href="#about">About Intellego</a>
                    <a href="#services">Our Services</a>
                    <a href="#values">Our Values</a>
                </nav>

                <a class="btn btn-outline-primary public-signin"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                    <i class="fas fa-right-to-bracket" aria-hidden="true"></i>
                    Sign in
                </a>

            </div>

        </header>

        <main class="public-main">
            @RenderBody()
        </main>

        <footer class="public-foot">

            <div class="public-foot-inner">

                <span class="public-foot-note">
                    &copy; @DateTime.Today.Year Intellego Investment
                    Consultants (Pvt) Ltd.
                    <span class="public-foot-sep">|</span>
                    For internal use by Intellego staff.
                </span>

                <span class="public-foot-links">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">Privacy</a>
                </span>

            </div>

        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/public-nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
