@using HrPortal.Entities
@model HrPortal.Entities.RequisitionStatus

@{
    var (css, label) = Model switch
    {
        RequisitionStatus.Draft =>
            ("bg-secondary", "Draft"),

        RequisitionStatus.Submitted =>
            ("bg-warning text-dark", "Awaiting review"),

        RequisitionStatus.ReturnedToRequester =>
            ("bg-warning text-dark", "Returned to you"),

        RequisitionStatus.ReviewApproved =>
            ("bg-info", "Awaiting MD"),

        RequisitionStatus.ReviewRejected =>
            ("bg-danger", "Rejected at review"),

        RequisitionStatus.Approved =>
            ("bg-success", "Approved"),

        RequisitionStatus.Rejected =>
            ("bg-danger", "Rejected by MD"),

        RequisitionStatus.Cancelled =>
            ("bg-secondary", "Withdrawn"),

        _ => ("bg-secondary", Model.ToString())
    };
}

<span class="badge @css">@label</span>
