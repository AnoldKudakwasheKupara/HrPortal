@model (string Title, string What)

@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>@Model.Title</h2>
            <p>Your sign-in is not linked to an employee record yet.</p>
        </div>
    </div>

    <section class="panel-card mb-4">

        <div class="list-empty mb-0 border-0">
            <i class="fas fa-user-slash" aria-hidden="true"></i>
            <p class="mb-1">Your sign-in is not linked to an employee record, so there is @Model.What to show here.</p>
            <p class="small mb-3">An administrator can link it by editing your employee record, or by creating one for you.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-house" aria-hidden="true"></i> Back to the dashboard
            </a>
        </div>

    </section>

</div>
