@*  The left navigation.

    A sidebar has room to show the whole structure at once, so
    the sections are flat lists under headings rather than
    dropdowns: nothing is hidden behind a click, and the current
    page is visible in context.                                *@

@functions {
    /// <summary>
    /// Marks the link for the page being viewed. Matching on the
    /// controller alone is right for most entries, since a
    /// section's list, details and edit pages all belong to the
    /// same nav item; an action is given only where one
    /// controller serves two separate entries.
    /// </summary>
    string Active(string controller, string? action = null)
    {
        var route = ViewContext.RouteData.Values;

        var onController = string.Equals(
            route["controller"] as string,
            controller,
            StringComparison.OrdinalIgnoreCase);

        if (!onController)
            return string.Empty;

        if (action == null)
            return "active";

        return string.Equals(
            route["action"] as string,
            action,
            StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
    }
}

<nav class="sidebar-nav">

    <a class="sidebar-link @Active("Home")"
       asp-controller="Home"
       asp-action="Index">
        <svg class="icon" aria-hidden="true"><use href="#i-dashboard" /></svg>
        Dashboard
