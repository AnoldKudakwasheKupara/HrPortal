@inject HrPortal.Services.NotificationBadgeService Notifications
@inject HrPortal.Services.SupervisorQueueService TeamQueue
@inject HrPortal.Services.TrainingAssignmentService Training

@{
    var unread = await Notifications.UnreadCountAsync();

    var supervises = await TeamQueue.SupervisesAnyoneAsync();

    var awaitingMe = supervises
        ? await TeamQueue.PendingCountAsync()
        : 0;

    var ctrl = ViewContext.RouteData.Values["controller"] as string;
    var act = ViewContext.RouteData.Values["action"] as string;

    string On(string controller) =>
        string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    string OnAction(string controller, string action) =>
        string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(act, action, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    string OnExcept(string controller, params string[] others) =>
        string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase) &&
        !others.Any(other =>
            string.Equals(act, other, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";

    var isAdmin = User.IsInRole("Administrator");
    var isHr = User.IsInRole("HR Officer");

    var leadsTraining = !isHr && await Training.LeadsAnyTrainingAsync();
    var isMd = User.IsInRole("MD");
}

