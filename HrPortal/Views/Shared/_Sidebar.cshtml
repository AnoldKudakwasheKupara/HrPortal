@*  Navigation, in the IT Service Management System's sidebar
    idiom: .nav-group headings with .nav-item links and Font
    Awesome icons, active state on the controller.           *@

@inject HrPortal.Services.TimesheetAccessService TimesheetAccess

@{
    var ctrl = ViewContext.RouteData.Values["controller"] as string;
    var act = ViewContext.RouteData.Values["action"] as string;

    string On(string controller) =>
        string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    string OnAction(string controller, string action) =>
        string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(act, action, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    var isAdmin = User.IsInRole("Administrator");
    var isHr = User.IsInRole("HR Officer");
    var isMd = User.IsInRole("MD");

    // Only departments that keep timesheets (IT, typically) see the
    // link, so everyone else's menu stays uncluttered.
    var keepsTimesheet = (await TimesheetAccess.GetAsync()).Enabled;
}

<nav class="sidebar-nav" id="sidebarNav" aria-label="Main navigation">

    <div class="nav-group">Core</div>

    <a class="nav-item @On("Home")"
       asp-controller="Home" asp-action="Index">
        <i class="fas fa-chart-line"></i> Dashboard
    </a>


    <a class="nav-item @On("Directory")"
       asp-controller="Directory" asp-action="Index">
        <i class="fas fa-address-book"></i> Staff Directory
    </a>


    <div class="nav-group">Mine</div>

    <a class="nav-item @On("MyProfile")"
       asp-controller="MyProfile" asp-action="Index">
        <i class="fas fa-id-badge"></i> My Profile
    </a>

    @*  The MD is the last approver, so there is nobody to approve
        their leave. They do not raise requests.                 *@
    @if (!isMd)
    {
        <a class="nav-item @On("MyLeave")"
           asp-controller="MyLeave" asp-action="Index">
            <i class="fas fa-umbrella-beach"></i> My Leave
        </a>
    }

    <a class="nav-item @On("MyTraining")"
       asp-controller="MyTraining" asp-action="Index">
        <i class="fas fa-graduation-cap"></i> My Training
    </a>

    <a class="nav-item @On("MyAssets")"
       asp-controller="MyAssets" asp-action="Index">
        <i class="fas fa-laptop"></i> My Assets
    </a>

    <a class="nav-item @On("MyRequisitions")"
       asp-controller="MyRequisitions" asp-action="Index">
        <i class="fas fa-cart-shopping"></i> My Requisitions
    </a>

    @if (keepsTimesheet)
    {
        <a class="nav-item @On("MyTimesheet")"
           asp-controller="MyTimesheet" asp-action="Index">
            <i class="fas fa-stopwatch"></i> My Timesheet
        </a>
    }

    <a class="nav-item @On("MyNotifications")"
       asp-controller="MyNotifications" asp-action="Index">
        <i class="fas fa-bell"></i> Notifications
    </a>


    @if (isHr || isMd || isAdmin)
    {
        <div class="nav-group">Insight</div>

        <a class="nav-item @On("Reports")"
           asp-controller="Reports" asp-action="Index">
            <i class="fas fa-chart-column"></i> Reports
        </a>
    }


    @if (isHr || isMd || isAdmin)
    {
        <div class="nav-group">Approvals</div>

        @if (isHr)
        {
            <a class="nav-item @OnAction("LeaveApproval", "Index")"
               asp-controller="LeaveApproval" asp-action="Index">
                <i class="fas fa-inbox"></i> Leave Review
            </a>
        }

        @if (isMd)
        {
            <a class="nav-item @OnAction("LeaveApproval", "FinalApproval")"
               asp-controller="LeaveApproval" asp-action="FinalApproval">
                <i class="fas fa-stamp"></i> Final Approval
            </a>
        }

        @if (isAdmin)
        {
            <a class="nav-item @OnAction("RequisitionApproval", "Index")"
               asp-controller="RequisitionApproval" asp-action="Index">
                <i class="fas fa-file-invoice-dollar"></i> Requisition Review
            </a>
        }

        @if (isMd)
        {
            <a class="nav-item @OnAction("RequisitionApproval", "FinalApproval")"
               asp-controller="RequisitionApproval" asp-action="FinalApproval">
                <i class="fas fa-file-invoice-dollar"></i> Requisition Approval
            </a>
        }

        @if (isAdmin || isMd)
        {
            <a class="nav-item @OnAction("RequisitionApproval", "All")"
               asp-controller="RequisitionApproval" asp-action="All">
                <i class="fas fa-rectangle-list"></i> All Requisitions
            </a>
        }
    }


    @if (isHr || isAdmin)
    {
        <div class="nav-group">People</div>

        <a class="nav-item @On("Employee")"
           asp-controller="Employee" asp-action="Index">
            <i class="fas fa-users"></i> Employees
        </a>

        @if (isHr)
        {
            <a class="nav-item @On("EmployeeDocument")"
               asp-controller="EmployeeDocument" asp-action="Index">
                <i class="fas fa-folder-open"></i> Employee Documents
            </a>
        }
    }


    @if (isHr || isMd)
    {
        <div class="nav-group">Leave</div>

        @*  The MD approves leave, so they can read the whole
            register, not only what is sitting in their own
            queue. The rest of this group is HR's housekeeping. *@

        <a class="nav-item @On("LeaveRequest")"
           asp-controller="LeaveRequest" asp-action="Index">
            <i class="fas fa-calendar-days"></i> All Requests
        </a>

        @if (isHr)
        {
            <a class="nav-item @On("LeaveBalance")"
               asp-controller="LeaveBalance" asp-action="Index">
                <i class="fas fa-scale-balanced"></i> Leave Balances
            </a>

            <a class="nav-item @On("LeaveType")"
               asp-controller="LeaveType" asp-action="Index">
                <i class="fas fa-tags"></i> Leave Types
            </a>

            <a class="nav-item @On("PublicHoliday")"
               asp-controller="PublicHoliday" asp-action="Index">
                <i class="fas fa-calendar-check"></i> Public Holidays
            </a>

        }
    }


    @if (isHr)
    {
        <div class="nav-group">Training</div>

        <a class="nav-item @On("TrainingCourse")"
           asp-controller="TrainingCourse" asp-action="Index">
            <i class="fas fa-chalkboard-user"></i> Courses
        </a>

        <a class="nav-item @On("TrainingAssignment")"
           asp-controller="TrainingAssignment" asp-action="Index">
            <i class="fas fa-clipboard-check"></i> Assignments
        </a>

        <a class="nav-item @On("TrainingMaterial")"
           asp-controller="TrainingMaterial" asp-action="Index">
            <i class="fas fa-file-lines"></i> Materials
        </a>

        <a class="nav-item @On("TrainingFeedback")"
           asp-controller="TrainingFeedback" asp-action="Index">
            <i class="fas fa-comment-dots"></i> Feedback
        </a>

        <a class="nav-item @On("Certification")"
           asp-controller="Certification" asp-action="Index">
            <i class="fas fa-award"></i> Certifications
        </a>

    }


    @if (isAdmin)
    {
        <div class="nav-group">System</div>

        <a class="nav-item @On("Department")"
           asp-controller="Department" asp-action="Index">
            <i class="fas fa-sitemap"></i> Departments
        </a>

        <a class="nav-item @On("Position")"
           asp-controller="Position" asp-action="Index">
            <i class="fas fa-id-card-clip"></i> Positions
        </a>

        <a class="nav-item @On("DocumentCategory")"
           asp-controller="DocumentCategory" asp-action="Index">
            <i class="fas fa-folder-tree"></i> Document Categories
        </a>

        <a class="nav-item @On("Role")"
           asp-controller="Role" asp-action="Index">
            <i class="fas fa-user-shield"></i> Roles
        </a>

        <a class="nav-item @On("ApprovalConfiguration")"
           asp-controller="ApprovalConfiguration" asp-action="Index">
            <i class="fas fa-sliders"></i> Approval Configuration
        </a>

        <a class="nav-item @On("Asset")"
           asp-controller="Asset" asp-action="Index">
            <i class="fas fa-laptop"></i> Asset Register
        </a>

        <a class="nav-item @On("AssetMaintenance")"
           asp-controller="AssetMaintenance" asp-action="Index">
            <i class="fas fa-screwdriver-wrench"></i> Maintenance
        </a>

        <a class="nav-item @On("Vendor")"
           asp-controller="Vendor" asp-action="Index">
            <i class="fas fa-truck-field"></i> Vendors
        </a>

        <a class="nav-item @On("License")"
           asp-controller="License" asp-action="Index">
            <i class="fas fa-certificate"></i> Licence Renewals
        </a>

        <a class="nav-item @On("Timesheet")"
           asp-controller="Timesheet" asp-action="Index">
            <i class="fas fa-business-time"></i> Timesheets
        </a>

        <a class="nav-item @On("ItActivity")"
           asp-controller="ItActivity" asp-action="Index">
            <i class="fas fa-headset"></i> IT Activity Log
        </a>

        <a class="nav-item @On("WeeklyReport")"
           asp-controller="WeeklyReport" asp-action="Index">
            <i class="fas fa-file-contract"></i> Weekly Reports
        </a>

        <a class="nav-item @On("Reminder")"
           asp-controller="Reminder" asp-action="Index">
            <i class="fas fa-bell"></i> Reminders
        </a>

        <a class="nav-item @On("AuditLog")"
           asp-controller="AuditLog" asp-action="Index">
            <i class="fas fa-clipboard-list"></i> Audit Log
        </a>
    }

</nav>
