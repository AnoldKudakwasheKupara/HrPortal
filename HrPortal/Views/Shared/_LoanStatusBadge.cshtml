@using HrPortal.Entities
@model LoanApplicationStatus

@*
    Every status is named, and there is no catch-all that guesses a
    stage. The old one said "With the MD" for anything it did not
    recognise, which would have sent an applicant chasing the wrong
    person while their application sat with their supervisor.
*@
@switch (Model)
{
    case LoanApplicationStatus.Draft:
        <span class="badge bg-secondary">Draft</span>
        break;

    case LoanApplicationStatus.SupervisorReview:
        <span class="badge bg-info">With the supervisor</span>
        break;

    case LoanApplicationStatus.SupervisorRejected:
        <span class="badge bg-danger">Declined by the supervisor</span>
        break;

    case LoanApplicationStatus.Submitted:
        <span class="badge bg-info">With the MD</span>
        break;

    case LoanApplicationStatus.ReturnedToApplicant:
        <span class="badge bg-warning">Returned</span>
        break;

    case LoanApplicationStatus.Approved:
        <span class="badge bg-success">Sanctioned</span>
        break;

    case LoanApplicationStatus.Rejected:
        <span class="badge bg-danger">Declined</span>
        break;

    case LoanApplicationStatus.Cancelled:
        <span class="badge bg-secondary">Cancelled</span>
        break;

    default:
        <span class="badge bg-secondary">@Model</span>
        break;
}
