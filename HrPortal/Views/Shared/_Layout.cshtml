@using Microsoft.AspNetCore.Identity
@using HrPortal.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@*  Shell copied from the IT Service Management System so the
    two systems read as one product. The chrome, tokens and
    component classes are theirs; only the navigation and the
    identity source differ, since this app uses ASP.NET
    Identity rather than session values.                      *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/app-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="app-layout">

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <i class="fas fa-users-gear"></i>
                <span>Intellego HR</span>
            </div>

            <partial name="_Sidebar" />

        </aside>

        <div class="main-wrapper">

            <div class="topbar">

                <div class="topbar-left">

                    <button class="mobile-toggle"
                            onclick="toggleSidebar()"
                            aria-label="Toggle menu">
                        <i class="fas fa-bars"></i>
                    </button>

                    <h5>
                        @ViewData["Title"]
                        <small>Intellego Human Resources</small>
                    </h5>

                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);

                    var displayName = currentUser?.FullName
                        ?? User.Identity?.Name
                        ?? "User";

                    var roleName = User.IsInRole("Administrator") ? "Administrator"
                        : User.IsInRole("HR Officer") ? "HR Officer"
                        : User.IsInRole("MD") ? "Managing Director"
                        : "Employee";

                    <div class="user-profile">

                        <a asp-area="Identity"
                           asp-page="/Account/Manage/Index"
                           class="profile-link">

                            <div class="user-avatar">
                                @displayName.Trim()[0].ToString().ToUpper()
                            </div>

                            <div class="user-info">
                                <div class="user-name">@displayName</div>
                                <div class="user-role">@roleName</div>
                            </div>

                        </a>

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                              method="post"
                              class="logout-form">

                            <button type="submit"
                                    class="btn-logout"
                                    title="Log out"
                                    aria-label="Log out">
                                <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                            </button>

                        </form>

                    </div>
                }

            </div>

            <main id="main-content" class="content fade-in" tabindex="-1">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
