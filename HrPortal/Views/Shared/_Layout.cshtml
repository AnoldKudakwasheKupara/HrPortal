@using Microsoft.AspNetCore.Identity
@using HrPortal.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject HrPortal.Services.NotificationBadgeService NotificationBadge

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Intellego</title>

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/icon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/images/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/icon-180.png" />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/app-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="app-layout">

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">

                <i class="fas fa-users-gear" aria-hidden="true"></i>

                <span class="brand-text">
                    <span class="brand-name">My Intellego</span>
                    <span class="brand-sub">People Portal</span>
                </span>

            </div>

            <partial name="_Sidebar" />

        </aside>

        <div class="main-area">

            <div class="topbar">

                <div class="topbar-left">

                    <button class="mobile-toggle"
                            onclick="toggleSidebar()"
                            aria-label="Toggle menu">
                        <i class="fas fa-bars"></i>
                    </button>

                    <nav class="crumbs" aria-label="Breadcrumb">

                        <span class="crumb-here">@ViewData["Title"]</span>

                        @if (ViewData["Crumb"] != null)
                        {
                            <span class="crumb-sep" aria-hidden="true">/</span>
                            <span class="crumb-then">@ViewData["Crumb"]</span>
                        }

                    </nav>

                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    var displayName =
                        User.FindFirst(
                            ApplicationUserClaimsPrincipalFactory
                                .FullNameClaim)?.Value
                        ?? User.Identity?.Name
                        ?? "User";

                    var roleName = User.IsInRole("Administrator") ? "Administrator"
                        : User.IsInRole("HR Officer") ? "HR Officer"
                        : User.IsInRole("MD") ? "Managing Director"
                        : "Employee";

                    var unread = await NotificationBadge.UnreadCountAsync();

                    <div class="topbar-right">

                        <a class="topbar-bell"
                           asp-controller="MyNotifications"
                           asp-action="Index"
                           aria-label="@(unread == 1
                               ? "Notifications, 1 unread"
                               : $"Notifications, {unread} unread")">

                            <i class="fas fa-bell" aria-hidden="true"></i>

                            @if (unread > 0)
                            {
                                <span class="topbar-bell-count">
                                    @(unread > 9 ? "9+" : unread.ToString())
                                </span>
                            }

                        </a>

                        <div class="user-profile">

                            <a asp-area="Identity"
                               asp-page="/Account/Manage/Index"
                               class="profile-link">

                                <div class="user-avatar">
                                    @displayName.Trim()[0].ToString().ToUpper()
                                </div>

                                <div class="user-info">
                                    <div class="user-name">@displayName</div>
                                    <div class="user-role">@roleName</div>
                                </div>

                            </a>

                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                  method="post"
                                  class="logout-form">

                                <button type="submit"
                                        class="btn-logout"
                                        title="Log out"
                                        aria-label="Log out">
                                    <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>

            <main id="main-content" class="content fade-in" tabindex="-1">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
