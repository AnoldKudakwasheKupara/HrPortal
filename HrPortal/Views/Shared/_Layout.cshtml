@using Microsoft.AspNetCore.Identity
@using HrPortal.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script>
        // Applied before first paint so the page never flashes
        // light before switching to dark.
        (function () {
            try {
                var stored = localStorage.getItem("hrportal-theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)").matches;
                document.documentElement.setAttribute(
                    "data-bs-theme",
                    stored || (prefersDark ? "dark" : "light"));
            } catch (e) { /* storage blocked: stay on light */ }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
</head>
<body>

    <partial name="_Icons" />

    <div class="app-shell">

        @*  offcanvas-lg: a drawer below the large breakpoint,
            an ordinary column at and above it.                *@
        <aside class="sidebar offcanvas-lg offcanvas-start"
               tabindex="-1"
               id="appSidebar"
               aria-label="Main navigation">

            <div class="sidebar-brand">

                <a class="brand-link"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-mark">HR</span>
                    <span class="brand-name">HR Portal</span>
                </a>

                <button type="button"
                        class="btn-close d-lg-none"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#appSidebar"
                        aria-label="Close navigation"></button>

            </div>

            <div class="sidebar-scroll">
                <partial name="_Sidebar" />
            </div>

            @*  The account sits at the foot of the rail, which
                frees the content area of a second header bar
                repeating the page title.                      *@
            <div class="sidebar-foot">

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);

                    <a class="account-link"
                       asp-area="Identity"
                       asp-page="/Account/Manage/Index"
                       title="Manage your account">

                        <span class="account-avatar" aria-hidden="true">
                            @(string.IsNullOrWhiteSpace(currentUser?.FullName)
                                ? "?"
                                : currentUser!.FullName.Trim()[0].ToString().ToUpper())
                        </span>

                        <span class="account-name">
                            @(currentUser?.FullName ?? User.Identity?.Name)
                        </span>

                    </a>
                }

                <div class="sidebar-foot-actions">

                    <button type="button"
                            class="icon-button"
                            id="themeToggle"
                            title="Switch between light and dark"
                            aria-label="Switch between light and dark">
                        <svg class="icon" aria-hidden="true">
                            <use id="themeToggleIcon" href="#i-moon" />
                        </svg>
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                              method="post">

                            <button type="submit"
                                    class="icon-button"
                                    title="Sign out"
                                    aria-label="Sign out">
                                <svg class="icon" aria-hidden="true">
                                    <use href="#i-logout" />
                                </svg>
                            </button>

                        </form>
                    }

                </div>

            </div>

        </aside>


        <div class="app-main">

            @*  Only on small screens, where the rail is hidden
                behind a button. *@
            <header class="mobile-bar d-lg-none">

                <button type="button"
                        class="icon-button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#appSidebar"
                        aria-controls="appSidebar"
                        aria-label="Open navigation">
                    <svg class="icon" aria-hidden="true">
                        <use href="#i-menu" />
                    </svg>
                </button>

                <span class="mobile-bar-title">
                    @ViewData["Title"]
                </span>

            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 HR Portal
                &middot;
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
