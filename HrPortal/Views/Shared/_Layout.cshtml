<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script>
        // Applied before first paint so the page never flashes
        // light before switching to dark.
        (function () {
            try {
                var stored = localStorage.getItem("hrportal-theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)").matches;
                document.documentElement.setAttribute(
                    "data-bs-theme",
                    stored || (prefersDark ? "dark" : "light"));
            } catch (e) { /* storage blocked: stay on light */ }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrPortal.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="app-shell">

        @*  offcanvas-lg: a drawer below the large breakpoint,
            an ordinary column at and above it.                *@
        <aside class="sidebar offcanvas-lg offcanvas-start"
               tabindex="-1"
               id="appSidebar"
               aria-label="Main navigation">

            <div class="sidebar-brand">

                <a class="brand-link"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-mark">HR</span>
                    <span class="brand-name">HR Portal</span>
                </a>

                <button type="button"
                        class="btn-close d-lg-none"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#appSidebar"
                        aria-label="Close navigation"></button>

            </div>

            <div class="sidebar-scroll">
                <partial name="_Sidebar" />
            </div>

        </aside>


        <div class="app-main">

            <header class="topbar">

                <button type="button"
                        class="topbar-burger d-lg-none"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#appSidebar"
                        aria-controls="appSidebar"
                        aria-label="Open navigation">
                    <span aria-hidden="true">&#9776;</span>
                </button>

                <div class="topbar-title">
                    @ViewData["Title"]
                </div>

                <div class="topbar-actions">

                    <button type="button"
                            class="theme-toggle"
                            id="themeToggle"
                            title="Switch between light and dark"
                            aria-label="Switch between light and dark">
                        <span id="themeToggleIcon">&#9789;</span>
                    </button>

                    <partial name="_LoginPartial" />

                </div>

            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 HR Portal
                &middot;
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
