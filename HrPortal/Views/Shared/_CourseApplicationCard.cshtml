@using HrPortal.Entities
@model HrPortal.Entities.CourseApplication

@{
    var captured = Model.History.Any(h => h.Action == CourseApplicationAction.CapturedAsApproved);

    var nationalId = ViewData["HidePersonal"] as bool? == true
        ? HrPortal.Services.PersonalData.MaskId(Model.Employee.NationalId)
        : Model.Employee.NationalId;

    var attempt = Model.Sitting switch
    {
        CourseSitting.NextLevel => "Proceeding to the next level",
        CourseSitting.Rewriting => "Re-writing",
        _ => "First attempt"
    };
}

<section class="panel-card mb-3">

    <div class="panel-head-split">
        <h3 class="panel-head">
            <i class="fas fa-briefcase" aria-hidden="true"></i> Application Details
        </h3>
        <partial name="_CourseStatusBadge" model="Model.Status" />
    </div>

    <div class="facts">

        <div class="fact">
            <i class="fas fa-user" aria-hidden="true"></i>
            <div><span>Applicant</span><strong>@Model.Employee.FirstName @Model.Employee.LastName</strong></div>
        </div>

        <div class="fact">
            <i class="fas fa-id-card" aria-hidden="true"></i>
            <div>
                <span>I.D. No.</span>
                @if (nationalId == null)
                {
                    <em>Not recorded</em>
                }
                else
                {
                    <strong>@nationalId</strong>
                }
            </div>
        </div>

        <div class="fact">
            <i class="fas fa-building" aria-hidden="true"></i>
            <div><span>Department</span><strong>@(Model.Employee.Department?.Name ?? "--")</strong></div>
        </div>

        <div class="fact">
            <i class="fas fa-briefcase" aria-hidden="true"></i>
            <div>
                <span>Position</span>
                @if (Model.Employee.JobTitle == null)
                {
                    <em>Not recorded</em>
                }
                else
                {
                    <strong>@Model.Employee.JobTitle</strong>
                }
            </div>
        </div>

        <div class="fact">
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <div><span>Programme intended</span><strong>@Model.ProgramIntended</strong></div>
        </div>

        <div class="fact">
            <i class="fas fa-calendar-days" aria-hidden="true"></i>
            <div>
                <span>Target exam date</span>
                @if (Model.TargetExamDate == null)
                {
                    <em>Not given</em>
                }
                else
                {
                    <strong>@Model.TargetExamDate.Value.ToString("d MMM yyyy")</strong>
                }
            </div>
        </div>

        <div class="fact">
            <i class="fas fa-circle-check" aria-hidden="true"></i>
            <div><span>Sat before</span><strong>@(Model.HasSatBefore ? "Yes" : "No")</strong></div>
        </div>

        <div class="fact">
            <i class="fas fa-rotate" aria-hidden="true"></i>
            <div><span>This attempt</span><strong>@attempt</strong></div>
        </div>

    </div>

    <div class="panel-block">
        <h4><i class="fas fa-bullseye" aria-hidden="true"></i> Justification and Relevance</h4>
        <p class="pre-line">@Model.Justification</p>
    </div>

    <div class="panel-block">
        <h4><i class="fas fa-file-signature" aria-hidden="true"></i> Pledge</h4>
        <p>
            <em>
                @if (Model.PledgedAt == null && captured)
                {
                    <text>On the paper form, approved before the portal.</text>
                }
                else if (Model.PledgedAt == null)
                {
                    <text>Not made yet.</text>
                }
                else
                {
                    <text>Made on @Model.PledgedAt.Value.ToLocalTime().ToString("d MMM yyyy, HH:mm").</text>
                }
            </em>
        </p>
    </div>

</section>
