@model HrPortal.Entities.Requisition

@{
    var currency = ViewBag.Currency as string ?? "USD";
}

<div class="table-responsive">
    <table class="table table-sm align-middle mb-0">

        <thead>
            <tr>
                <th>Item or service</th>
                <th class="num">Qty</th>
                <th>Unit</th>
                <th class="num">Est. unit cost</th>
                <th class="num">Line total</th>
            </tr>
        </thead>

        <tbody>

        @if (!Model.Lines.Any())
        {
            <tr>
                <td colspan="5"
                    class="text-center text-muted py-4">
                    No items have been added to this requisition.
                </td>
            </tr>
        }

        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>
                    @line.Description
                    @if (!string.IsNullOrWhiteSpace(line.Notes))
                    {
                        <div class="text-muted small">@line.Notes</div>
                    }
                </td>

                <td class="num">@line.Quantity.ToString("0.##")</td>

                <td>
                    @(string.IsNullOrWhiteSpace(line.UnitOfMeasure)
                        ? "--"
                        : line.UnitOfMeasure)
                </td>

                <td class="num">
                    @(line.EstimatedUnitCost?.ToString("N2") ?? "--")
                </td>

                <td class="num">
                    @(line.EstimatedUnitCost == null
                        ? "--"
                        : line.LineTotal.ToString("N2"))
                </td>
            </tr>
        }
        </tbody>

        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Estimated total</th>
                <th class="num">
                    @currency @Model.EstimatedTotal.ToString("N2")
                </th>
            </tr>
        </tfoot>

    </table>
</div>
