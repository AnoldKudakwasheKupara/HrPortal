@model List<HrPortal.Services.OutstandingPolicy>

<div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2" role="status">
    <div>
        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
        @if (Model.Count == 1)
        {
            <span>You must read and confirm <strong>@Model[0].Title</strong>.</span>
        }
        else
        {
            <span>You must read and confirm <strong>@Model.Count policies</strong>: @string.Join(", ", Model.Select(p => p.Title)).</span>
        }
    </div>
    @if (Model.Count == 1)
    {
        <a class="btn btn-sm btn-warning" asp-controller="Policy" asp-action="Details" asp-route-id="@Model[0].Id">Read it now</a>
    }
    else
    {
        <a class="btn btn-sm btn-warning" asp-controller="Policy" asp-action="Index">Read them now</a>
    }
</div>
