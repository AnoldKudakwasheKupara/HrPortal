@model HrPortal.ViewModels.SignaturePad

<div class="sign-pad" data-sign-pad data-required="@(Model.Required ? "true" : "false")">

    <div class="form-label" id="@(Model.Name)-label">@Model.Label</div>

    <canvas class="sign-canvas" width="600" height="180" role="img"
            aria-labelledby="@(Model.Name)-label"></canvas>

    <input type="hidden" name="@Model.Name" />

    <div class="sign-tools">

        <button type="button" class="btn btn-sm btn-outline-secondary" data-sign-clear>
            <i class="fas fa-eraser" aria-hidden="true"></i> Clear
        </button>

        <button type="button" class="btn btn-sm btn-outline-secondary" data-sign-choose>
            <i class="fas fa-image" aria-hidden="true"></i> Use a picture of a signature
        </button>

    </div>

    <p class="text-danger small mb-0 mt-1" data-sign-error role="alert" hidden></p>

</div>
