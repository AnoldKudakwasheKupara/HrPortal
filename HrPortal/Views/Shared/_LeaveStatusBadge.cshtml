@using HrPortal.Entities
@model LeaveRequestStatus

@*
    Every status is named, and there is no catch-all that guesses a
    stage. A status nobody has named here prints its own name rather
    than borrowing a label that would be wrong.
*@
@switch (Model)
{
    case LeaveRequestStatus.Draft:
        <span class="badge bg-secondary">Draft</span>
        break;

    case LeaveRequestStatus.SupervisorReview:
        <span class="badge bg-info">With the supervisor</span>
        break;

    case LeaveRequestStatus.SupervisorRejected:
        <span class="badge bg-danger">Rejected by the supervisor</span>
        break;

    case LeaveRequestStatus.Submitted:
    case LeaveRequestStatus.HRReview:
        <span class="badge bg-info">With HR</span>
        break;

    case LeaveRequestStatus.ReturnedToEmployee:
        <span class="badge bg-warning">Returned</span>
        break;

    case LeaveRequestStatus.HRApproved:
    case LeaveRequestStatus.MDReview:
        <span class="badge bg-info">With the MD</span>
        break;

    case LeaveRequestStatus.HRRejected:
        <span class="badge bg-danger">Rejected by HR</span>
        break;

    case LeaveRequestStatus.Approved:
        <span class="badge bg-success">Approved</span>
        break;

    case LeaveRequestStatus.Rejected:
        <span class="badge bg-danger">Rejected</span>
        break;

    case LeaveRequestStatus.Cancelled:
        <span class="badge bg-secondary">Cancelled</span>
        break;

    default:
        <span class="badge bg-secondary">@Model</span>
        break;
}
