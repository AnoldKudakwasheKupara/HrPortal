@using HrPortal.Entities
@model LeaveRequestStatus

@*  One place for how a leave status looks and reads, so the
    same state never appears with two different words. The
    colour is always paired with the word, never alone.       *@

@switch (Model)
{
    case LeaveRequestStatus.Approved:
        <span class="badge bg-success">Approved</span>
        break;

    case LeaveRequestStatus.Rejected:
        <span class="badge bg-danger">Rejected</span>
        break;

    case LeaveRequestStatus.HRRejected:
        <span class="badge bg-danger">Rejected by HR</span>
        break;

    case LeaveRequestStatus.Cancelled:
        <span class="badge bg-secondary">Cancelled</span>
        break;

    case LeaveRequestStatus.ReturnedToEmployee:
        <span class="badge bg-warning">Returned</span>
        break;

    case LeaveRequestStatus.HRApproved:
    case LeaveRequestStatus.MDReview:
        <span class="badge bg-info">With the MD</span>
        break;

    case LeaveRequestStatus.Draft:
        <span class="badge bg-secondary">Draft</span>
        break;

    default:
        <span class="badge bg-info">With HR</span>
        break;
}
