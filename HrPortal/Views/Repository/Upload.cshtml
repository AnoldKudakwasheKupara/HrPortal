@using HrPortal.Entities
@model HrPortal.ViewModels.RepositoryUploadViewModel

@{
    ViewData["Title"] = "Add Document";

    var folders = ViewBag.FolderOptions as List<RepositoryFolder>
        ?? new List<RepositoryFolder>();
}

<div class="container">

    <div class="page-head-simple">
        <h2>Add Document</h2>
        <p class="text-muted">
            Who can see it is decided by the folder you put it in.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control"
                               placeholder="Leave application form" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RepositoryFolderId" class="form-label"></label>
                        <select asp-for="RepositoryFolderId" class="form-select">
                            <option value="">-- Choose a folder --</option>
                            @foreach (var folder in folders)
                            {
                                <option value="@folder.Id"
                                        selected="@(Model.RepositoryFolderId == folder.Id)">
                                    @folder.Name (@folder.Audience)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="RepositoryFolderId" class="text-danger"></span>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label asp-for="File" class="form-label"></label>
                        <input asp-for="File" class="form-control" type="file" />
                        <div class="form-text">
                            Up to 10 MB. PDF, Word, Excel, PowerPoint,
                            text, CSV and images.
                        </div>
                        <span asp-validation-for="File" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" class="form-control" type="date" />
                        <div class="form-text">
                            Optional. Marks it out of date afterwards.
                        </div>
                        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="What it is for, and who should use it"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add Document</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
