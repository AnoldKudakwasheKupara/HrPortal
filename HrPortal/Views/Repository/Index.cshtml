@using HrPortal.Services
@using HrPortal.ViewModels
@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.RepositoryDocument>

@{
    ViewData["Title"] = "Document Repository";

    var folders = ViewBag.Folders as List<RepositoryFolderViewModel>
        ?? new List<RepositoryFolderViewModel>();
    var folderFilter = ViewBag.FolderFilter as int?;
    var search = ViewBag.Search as string;
    var canCurate = (bool)ViewBag.CanCurate;
    var today = DateTime.Today;
    var filtered = folderFilter != null || !string.IsNullOrWhiteSpace(search);

    string Size(long bytes) => bytes switch
    {
        >= 1048576 => $"{bytes / 1048576d:0.#} MB",
        >= 1024 => $"{bytes / 1024d:0} KB",
        _ => $"{bytes} bytes"
    };
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Document Repository</h2>
            <p>The organisation's shared documents: forms, templates, handbooks and procedures.</p>
        </div>

        @if (canCurate)
        {
            <div class="head-actions">
                <a asp-controller="RepositoryFolder" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-folder-tree" aria-hidden="true"></i> Folders
                </a>
                <a asp-action="Upload" asp-route-folderId="@folderFilter" class="btn btn-gold">
                    <i class="fas fa-plus" aria-hidden="true"></i> Add Document
                </a>
            </div>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-folder-open"></i></span>
            <div>
                <div class="kpi-label">Folders</div>
                <div class="kpi-value">@folders.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-file-lines"></i></span>
            <div>
                <div class="kpi-label">Documents</div>
                <div class="kpi-value">@folders.Sum(f => f.DocumentCount)</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-magnifying-glass"></i></span>
            <div>
                <div class="kpi-label">@(filtered ? "Matching" : "Showing")</div>
                <div class="kpi-value">@Model.TotalCount</div>
            </div>
        </div>

    </div>

    @if (!folders.Any())
    {
        <div class="list-empty">
            <i class="fas fa-folder-open" aria-hidden="true"></i>
            <p>
                There is nothing in the repository yet.
                @if (canCurate)
                {
                    <text>Create a folder first, then add documents to it.</text>
                }
            </p>
        </div>
    }
    else
    {
        <section class="panel-card mb-3">

            <h3 class="panel-head">
                <i class="fas fa-folder-tree" aria-hidden="true"></i> Folders
                <span class="tab-count">@folders.Count</span>
            </h3>

            <div class="row g-3">
                @foreach (var folder in folders)
                {
                    <div class="col-6 col-lg-3">
                        <a class="stat-tile @(folderFilter == folder.Id ? "is-action" : "")"
                           asp-action="Index" asp-route-folderId="@folder.Id">

                            <i class="fas fa-folder stat-icon" aria-hidden="true"></i>

                            <span class="stat-label">@folder.Name</span>

                            <span class="stat-value">@folder.DocumentCount</span>

                            <div class="stat-note">
                                @Html.DisplayFor(m => folder.Audience)
                            </div>

                        </a>
                    </div>
                }
            </div>

        </section>
    }

    <form method="get" class="filter-bar filter-bar-short" data-auto-submit>

        <div>
            <label for="repo-search" class="form-label">Search</label>
            <div class="filter-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="repo-search" type="search" name="search" class="form-control" value="@search"
                       placeholder="Title, file name or description" />
            </div>
        </div>

        <div>
            <label for="repo-folder" class="form-label">Folder</label>
            <select id="repo-folder" name="folderId" class="form-select">
                <option value="">All folders</option>
                @foreach (var folder in folders)
                {
                    <option value="@folder.Id" selected="@(folderFilter == folder.Id)">@folder.Name</option>
                }
            </select>
        </div>

        <div class="filter-bar-actions">
            <noscript>
                <button type="submit" class="btn btn-outline-secondary">Apply</button>
            </noscript>
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-filter-circle-xmark" aria-hidden="true"></i> Reset Filters
            </a>
        </div>

    </form>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-file-lines" aria-hidden="true"></i> Documents
            <span class="tab-count">@Model.TotalCount</span>
        </h3>

        @if (!Model.Items.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <p>
                    Nothing here matches.
                    @if (filtered)
                    {
                        <a asp-action="Index">Reset filters</a>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Folder</th>
                            <th>Size</th>
                            <th>Added</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var document in Model.Items)
                        {
                            var stale = document.ExpiryDate != null && document.ExpiryDate.Value.Date < today;

                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @document.Title
                                        @if (stale)
                                        {
                                            <span class="status-badge badge-amber ms-1">Out of date</span>
                                        }
                                    </div>
                                    <div class="small text-muted text-break">@document.OriginalFileName</div>
                                    @if (!string.IsNullOrWhiteSpace(document.Description))
                                    {
                                        <div class="small text-muted">@document.Description</div>
                                    }
                                </td>
                                <td>@document.Folder.Name</td>
                                <td class="text-nowrap">@Size(document.FileSizeBytes)</td>
                                <td>
                                    <div class="text-nowrap">@document.UploadedAt.ToLocalTime().ToString("d MMM yyyy")</div>
                                    <div class="small text-muted">@(document.UploadedByName ?? "--")</div>
                                </td>
                                <td>
                                    <div class="table-actions justify-content-end">

                                        @if (FileStorageService.CanPreview(document.OriginalFileName))
                                        {
                                            <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Preview"
                                               asp-route-id="@document.Id" target="_blank" rel="noopener">
                                                <i class="fas fa-eye" aria-hidden="true"></i> Preview
                                            </a>
                                        }

                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Download" asp-route-id="@document.Id">
                                            <i class="fas fa-download" aria-hidden="true"></i> Download
                                        </a>

                                        @if (canCurate)
                                        {
                                            <form asp-action="Delete" asp-route-id="@document.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Remove this document from the repository?');">
                                                <input type="hidden" name="id" value="@document.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Remove @document.Title</span>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(Model, "document", "documents")' />
        }

    </section>

</div>

