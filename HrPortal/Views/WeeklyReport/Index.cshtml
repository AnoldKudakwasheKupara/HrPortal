@using HrPortal.Entities
@using HrPortal.ViewModels
@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.WeeklyReport>

@{
    ViewData["Title"] = "Weekly Reports";

    var hasRecord = ViewBag.HasEmployeeRecord == true;
    var thisWeek = (DateTime)ViewBag.ThisWeek;
    var thisWeeksReport = ViewBag.ThisWeeksReport as int?;
    var isMd = ViewBag.IsMd == true;
    var hasTeam = ViewBag.HasTeam == true;
    var earlier = ViewBag.Earlier as List<WeeklyReport> ?? new List<WeeklyReport>();
    var drafts = (int)(ViewBag.Drafts ?? 0);
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>Weekly Reports</h2>
            <p>
                Your own report of each week's work. Drafts are yours alone; once you submit one,
                your supervisor and the Managing Director can read it.
            </p>
        </div>

        <div class="head-actions">

            @if (isMd || hasTeam)
            {
                <a asp-action="Overview" class="btn btn-outline-secondary">
                    <i class="fas fa-table-columns" aria-hidden="true"></i>
                    @(isMd ? "Staff overview" : "My team's reports")
                </a>
            }

            @if (hasRecord)
            {
                <a asp-action="Create" class="btn btn-outline-secondary">
                    <i class="fas fa-calendar-plus" aria-hidden="true"></i> Another week
                </a>

                if (thisWeeksReport is int current)
                {
                    <a asp-action="Details" asp-route-id="@current" class="btn btn-gold">
                        <i class="fas fa-file-contract" aria-hidden="true"></i> This week's report
                    </a>
                }
                else
                {
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="PeriodStart" value="@thisWeek.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-plus" aria-hidden="true"></i> Start this week's report
                        </button>
                    </form>
                }
            }

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!hasRecord)
    {
        <div class="alert alert-info">
            Your sign-in is not linked to an employee record, so you have no reports of your own. Ask HR to link it.
        </div>
    }

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-file-contract"></i></span>
            <div>
                <div class="kpi-label">My Reports</div>
                <div class="kpi-value">@Model.TotalCount</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-amber" aria-hidden="true"><i class="fas fa-pen"></i></span>
            <div>
                <div class="kpi-label">Drafts</div>
                <div class="kpi-value">@drafts</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon @(thisWeeksReport != null ? "is-green" : "is-blue")" aria-hidden="true"><i class="fas fa-calendar-week"></i></span>
            <div>
                <div class="kpi-label">This Week</div>
                <div class="kpi-value kpi-value-text">@(thisWeeksReport != null ? "Started" : "Not started")</div>
                <div class="kpi-note">Week of @thisWeek.ToString("d MMM")</div>
            </div>
        </div>

    </div>

    <section class="panel-card mb-4">

        <h3 class="panel-head">
            <i class="fas fa-file-contract" aria-hidden="true"></i> My Reports
            <span class="tab-count">@Model.TotalCount</span>
        </h3>

        @if (!Model.Items.Any())
        {
            <div class="list-empty mb-0">
                <i class="fas fa-file-contract" aria-hidden="true"></i>
                <p>No reports yet. Start this week's when you are ready.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Week</th>
                            <th class="num">Pieces of Work</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-nowrap">@r.PeriodStart.ToString("d MMM") &ndash; @r.PeriodEnd.ToString("d MMM yyyy")</td>
                                <td class="num">
                                    @r.Sections.Count(s => !string.IsNullOrWhiteSpace(s.Body) || !string.IsNullOrWhiteSpace(s.Workstream))
                                </td>
                                <td>
                                    @if (r.Status == WeeklyReportStatus.Final)
                                    {
                                        <span class="status-badge badge-green">Submitted @(r.FinalisedOn?.ToString("d MMM") ?? "")</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-amber">Draft</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@r.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>
                                        @if (r.Status != WeeklyReportStatus.Final)
                                        {
                                            <a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Edit" asp-route-id="@r.Id">
                                                <i class="fas fa-pen-to-square" aria-hidden="true"></i> Edit
                                            </a>
                                        }
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Pdf" asp-route-id="@r.Id">
                                            <i class="fas fa-download" aria-hidden="true"></i> PDF
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_NumberedPager" model='PagerSummary.From(Model, "report", "reports")' />
        }

    </section>

    @if (earlier.Any())
    {
        <section class="panel-card mb-4">

            <h3 class="panel-head">
                <i class="fas fa-box-archive" aria-hidden="true"></i> Earlier IT Department Reports
                <span class="tab-count">@earlier.Count</span>
            </h3>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Reporting Period</th>
                            <th>Prepared By</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var r in earlier)
                        {
                            <tr>
                                <td class="text-nowrap">@r.PeriodStart.ToString("d MMM") &ndash; @r.PeriodEnd.ToString("d MMM yyyy")</td>
                                <td>@r.PreparedBy</td>
                                <td>
                                    @if (r.Status == WeeklyReportStatus.Final)
                                    {
                                        <span class="status-badge badge-green">Issued</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-amber">Draft</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@r.Id">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Pdf" asp-route-id="@r.Id">
                                            <i class="fas fa-download" aria-hidden="true"></i> PDF
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </section>
    }

</div>
