@using HrPortal.Entities
@model HrPortal.ViewModels.PagedResult<HrPortal.Entities.WeeklyReport>

@{
    ViewData["Title"] = "Weekly Reports";

    var hasRecord = ViewBag.HasEmployeeRecord == true;
    var thisWeek = (DateTime)ViewBag.ThisWeek;
    var thisWeeksReport = ViewBag.ThisWeeksReport as int?;
    var isMd = ViewBag.IsMd == true;
    var hasTeam = ViewBag.HasTeam == true;
    var earlier = ViewBag.Earlier as List<WeeklyReport> ?? new List<WeeklyReport>();
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>Weekly Reports</h2>
            <p class="text-muted mb-0">
                Your own report of each week's work. Drafts are yours alone;
                once you submit one, your supervisor and the Managing
                Director can read it.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            @if (isMd || hasTeam)
            {
                <a asp-action="Overview" class="btn btn-outline-primary">
                    <i class="fas fa-table-columns" aria-hidden="true"></i>
                    @(isMd ? "Staff overview" : "My team's reports")
                </a>
            }

            @if (hasRecord)
            {
                if (thisWeeksReport is int current)
                {
                    <a asp-action="Details" asp-route-id="@current" class="btn btn-primary">
                        This week's report
                    </a>
                }
                else
                {
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="PeriodStart" value="@thisWeek.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-plus" aria-hidden="true"></i>
                            Start this week's report
                        </button>
                    </form>
                }

                <a asp-action="Create" class="btn btn-outline-secondary">Another week</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!hasRecord)
    {
        <div class="alert alert-info">
            Your sign-in is not linked to an employee record, so you have no
            reports of your own. Ask HR to link it.
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">My reports</div>

        <div class="card-body is-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Week</th>
                            <th class="num">Pieces of work</th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No reports yet. Start this week's when you are
                                ready.
                            </td>
                        </tr>
                    }

                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @r.PeriodStart.ToString("dd MMM")
                                    &ndash;
                                    @r.PeriodEnd.ToString("dd MMM yyyy")
                                </strong>
                            </td>

                            <td class="num">
                                @r.Sections.Count(s =>
                                    !string.IsNullOrWhiteSpace(s.Body) ||
                                    !string.IsNullOrWhiteSpace(s.Workstream))
                            </td>

                            <td>
                                @if (r.Status == WeeklyReportStatus.Final)
                                {
                                    <span class="badge bg-success">
                                        Submitted @(r.FinalisedOn?.ToString("d MMM") ?? "")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Draft</span>
                                }
                            </td>

                            <td class="col-actions">
                                <div class="table-actions">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Details" asp-route-id="@r.Id">
                                        View
                                    </a>
                                    @if (r.Status != WeeklyReportStatus.Final)
                                    {
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-action="Edit" asp-route-id="@r.Id">
                                            Edit
                                        </a>
                                    }
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Pdf" asp-route-id="@r.Id">
                                        PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>

                @{ var pager = HrPortal.ViewModels.PagerViewModel.From(Context.Request, Model, "reports"); }
                <partial name="_Pager" model="pager" />
            </div>
        </div>

    </div>

    @if (earlier.Any())
    {
        <div class="card shadow-sm">

            <div class="card-header">Earlier IT department reports</div>

            <div class="card-body is-table">
                <div class="table-responsive">
                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Reporting period</th>
                                <th>Prepared by</th>
                                <th>Status</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        @foreach (var r in earlier)
                        {
                            <tr>
                                <td>
                                    @r.PeriodStart.ToString("dd MMM")
                                    &ndash;
                                    @r.PeriodEnd.ToString("dd MMM yyyy")
                                </td>
                                <td>@r.PreparedBy</td>
                                <td>
                                    @(r.Status == WeeklyReportStatus.Final ? "Issued" : "Draft")
                                </td>
                                <td class="col-actions">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Details" asp-route-id="@r.Id">
                                            View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Pdf" asp-route-id="@r.Id">
                                            PDF
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>

                    </table>
                </div>
            </div>

        </div>
    }

</div>
