@model HrPortal.ViewModels.WeeklyReportCreateViewModel

@{ ViewData["Title"] = "New Weekly Report"; }

<div class="container">

    <div class="page-head-simple">
        <h2>New Weekly Report</h2>
        <p class="text-muted">
            Pick the period. The draft arrives with the week's numbers
            already in it and last week's priorities carried forward.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="PeriodStart" class="form-label"></label>
                        <input asp-for="PeriodStart" class="form-control" type="date" />
                        <span asp-validation-for="PeriodStart" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="PeriodEnd" class="form-label"></label>
                        <input asp-for="PeriodEnd" class="form-control" type="date" />
                        <span asp-validation-for="PeriodEnd" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="PreparedBy" class="form-label"></label>
                        <input asp-for="PreparedBy" class="form-control"
                               placeholder="Anold Kupara &amp; Takudzwa Murombedzi" />
                        <span asp-validation-for="PreparedBy" class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info">
                    What gets filled in for you: the hardware section
                    (including &ldquo;no faults reported&rdquo; when that is the
                    case), the support request counts and categories,
                    anything you flagged as notable, every unresolved
                    item as a priority, and last week&rsquo;s priorities.
                    The executive overview stays yours to write.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Create Draft
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
