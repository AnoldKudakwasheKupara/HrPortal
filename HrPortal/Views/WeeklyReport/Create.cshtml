@model HrPortal.ViewModels.WeeklyReportCreateViewModel

@{ ViewData["Title"] = "Start a Weekly Report"; }

<div class="container">

    <div class="page-head-simple">
        <h2>Start a Weekly Report</h2>
        <p class="text-muted">
            Pick any day in the week. The report covers Monday to Friday of
            that week, and starts from the pieces of work and priorities in
            your last report.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3" style="max-width: 280px;">
                    <label asp-for="PeriodStart" class="form-label"></label>
                    <input asp-for="PeriodStart" class="form-control" type="date" />
                    <span asp-validation-for="PeriodStart" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Start the report</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
