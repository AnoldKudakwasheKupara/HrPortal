@using HrPortal.ViewModels
@model HrPortal.ViewModels.WeeklyOverviewViewModel

@{
    ViewData["Title"] = Model.AllStaff ? "Weekly progress" : "My team's weekly reports";

    var previous = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var next = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    var isCurrent = Model.WeekStart == HrPortal.Services.WeeklyReportBuilder.WeekStart(DateTime.Today);

    static string Short(string? text, int length) =>
        string.IsNullOrWhiteSpace(text)
            ? string.Empty
            : text.Length <= length ? text : text[..length].TrimEnd() + "…";
}

<div class="container-fluid">

    <div class="page-head">

        <div>
            <h2>@(Model.AllStaff ? "Weekly Progress" : "My Team's Weekly Reports")</h2>
            <p>
                Week of @Model.WeekStart.ToString("d MMM") &ndash; @Model.WeekEnd.ToString("d MMM yyyy").
                @(Model.AllStaff ? "Everybody who can sign in, by department." : "The people who report to you.")
                Drafts stay private until they are submitted.
            </p>
        </div>

        <div class="head-actions">
            <a asp-action="Overview" asp-route-week="@previous" class="btn btn-outline-secondary">
                <i class="fas fa-chevron-left" aria-hidden="true"></i> Previous week
            </a>
            @if (!isCurrent)
            {
                <a asp-action="Overview" class="btn btn-outline-secondary">This week</a>
                <a asp-action="Overview" asp-route-week="@next" class="btn btn-outline-secondary">
                    Next week <i class="fas fa-chevron-right" aria-hidden="true"></i>
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">My reports</a>
        </div>

    </div>

    <div class="kpis">

        <div class="kpi">
            <span class="kpi-icon is-teal" aria-hidden="true"><i class="fas fa-users"></i></span>
            <div>
                <div class="kpi-label">People</div>
                <div class="kpi-value">@Model.Rows.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-green" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
            <div>
                <div class="kpi-label">Submitted</div>
                <div class="kpi-value">@Model.Submitted</div>
                <div class="kpi-note">of @Model.Rows.Count</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon is-blue" aria-hidden="true"><i class="fas fa-pen"></i></span>
            <div>
                <div class="kpi-label">In Draft</div>
                <div class="kpi-value">@Model.Drafts</div>
                <div class="kpi-note">Started, not yet submitted</div>
            </div>
        </div>

        <div class="kpi">
            <span class="kpi-icon @(Model.NotStarted > 0 ? "is-red" : "is-amber")" aria-hidden="true"><i class="fas fa-hourglass-start"></i></span>
            <div>
                <div class="kpi-label">Not Started</div>
                <div class="kpi-value">@Model.NotStarted</div>
                <div class="kpi-note">No report this week</div>
            </div>
        </div>

    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="list-empty">
            <i class="fas fa-users-slash" aria-hidden="true"></i>
            <p>Nobody to show for this week.</p>
        </div>
    }

    @foreach (var department in Model.Rows.GroupBy(r => r.Department ?? "No department"))
    {
        <section class="panel-card mb-3">

            <div class="panel-head-split">
                <h3 class="panel-head">
                    <i class="fas fa-sitemap" aria-hidden="true"></i> @department.Key
                    <span class="tab-count">@department.Count()</span>
                </h3>
                <span class="text-muted small">
                    @department.Count(r => r.Progress == WeeklyProgress.Submitted) of @department.Count() submitted
                </span>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Name</th>
                            @if (Model.AllStaff)
                            {
                                <th>Supervisor</th>
                            }
                            <th>Status</th>
                            <th class="num">Work</th>
                            <th>Summary</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in department)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@row.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(row.JobTitle))
                                    {
                                        <div class="small text-muted">@row.JobTitle</div>
                                    }
                                </td>

                                @if (Model.AllStaff)
                                {
                                    <td class="text-muted">@(row.Supervisor ?? "None")</td>
                                }

                                <td>
                                    @switch (row.Progress)
                                    {
                                        case WeeklyProgress.Submitted:
                                            <span class="status-badge badge-green">Submitted @(row.SubmittedOn?.ToString("d MMM") ?? "")</span>
                                            break;
                                        case WeeklyProgress.Draft:
                                            <span class="status-badge badge-amber">In draft</span>
                                            break;
                                        default:
                                            <span class="status-badge badge-gray">Not started</span>
                                            break;
                                    }
                                </td>

                                <td class="num">
                                    @if (row.Progress == WeeklyProgress.Submitted)
                                    {
                                        <span title="@row.Completed completed">
                                            @row.Items
                                            @if (row.Completed > 0)
                                            {
                                                <span class="text-success small">(@row.Completed done)</span>
                                            }
                                        </span>
                                    }
                                </td>

                                <td class="small" style="max-width: 420px;">@Short(row.Summary, 180)</td>

                                <td>
                                    <div class="table-actions justify-content-end">
                                        @if (row.ReportId is int reportId)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="Details" asp-route-id="@reportId">
                                                <i class="fas fa-eye" aria-hidden="true"></i> Read
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </section>
    }

</div>
