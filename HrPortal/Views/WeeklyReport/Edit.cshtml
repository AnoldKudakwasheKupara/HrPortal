@using HrPortal.Entities
@model HrPortal.ViewModels.WeeklyReportEditViewModel

@{
    ViewData["Title"] = "My Weekly Report";

    var previousPeriod = ViewBag.PreviousPeriod as string;

    if (!Model.FixedHeadings && Model.Sections.Count == 0)
    {
        Model.Sections.Add(new HrPortal.ViewModels.WeeklyReportSectionEditViewModel());
    }
}

<div class="container">

    <div class="page-head">
        <div>
            <h2>
                Week of
                @Model.PeriodStart.ToString("dd MMM")
                &ndash;
                @Model.PeriodEnd.ToString("dd MMM yyyy")
            </h2>

            <div class="detail-badges">
                <span class="badge bg-warning text-dark">Draft &middot; only you can see it</span>
                <span class="badge bg-light text-dark">
                    @Model.OwnerName@(Model.OwnerDepartment == null ? "" : $", {Model.OwnerDepartment}")
                </span>
            </div>
        </div>

        <div class="page-head-actions">
            <a asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">Preview</a>

            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="weekly-report-form">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PeriodStart" />
        <input type="hidden" asp-for="PeriodEnd" />
        <input type="hidden" asp-for="Status" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Summary of the week</div>
            <div class="card-body">
                <label asp-for="ExecutiveOverview" class="form-label visually-hidden"></label>
                <textarea asp-for="ExecutiveOverview" class="form-control"
                          rows="5"
                          placeholder="How the week went in a few sentences: what moved forward, what got in the way, what needs attention."></textarea>
                <span asp-validation-for="ExecutiveOverview" class="text-danger"></span>
            </div>
        </div>

        <div id="report-items">

            @for (var i = 0; i < Model.Sections.Count; i++)
            {
                var sec = Model.Sections[i];

                <div class="card shadow-sm mb-3" data-report-item>

                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        @if (Model.FixedHeadings)
                        {
                            <span>@((i + 1).ToString("00")). @sec.Heading</span>
                            <input type="hidden" asp-for="Sections[i].Heading" />
                        }
                        else
                        {
                            <input asp-for="Sections[i].Heading"
                                   class="form-control"
                                   placeholder="Piece of work, e.g. Client onboarding for ABC Ltd"
                                   aria-label="Piece of work" />

                            <label class="form-check-label small text-nowrap">
                                <input type="checkbox"
                                       class="form-check-input me-1"
                                       asp-for="Sections[i].Remove" />
                                Remove
                            </label>
                        }
                    </div>

                    <div class="card-body">

                        <input type="hidden" asp-for="Sections[i].Id" />
                        <input type="hidden" asp-for="Sections[i].Order" />

                        <div class="row">

                            <div class="col-md-7 mb-3">
                                <label asp-for="Sections[i].Workstream" class="form-label">
                                    @(Model.FixedHeadings ? "Workstream" : "Project or client (optional)")
                                </label>
                                <input asp-for="Sections[i].Workstream" class="form-control" />
                            </div>

                            <div class="col-md-5 mb-3">
                                <label asp-for="Sections[i].WorkstreamStatus" class="form-label">
                                    Status
                                </label>
                                <select asp-for="Sections[i].WorkstreamStatus"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<WorkstreamStatus>()">
                                </select>
                            </div>

                        </div>

                        <div class="mb-0">
                            <label asp-for="Sections[i].Body" class="form-label">
                                What was done
                            </label>
                            <textarea asp-for="Sections[i].Body"
                                      class="form-control" rows="4"
                                      placeholder="One point per line."></textarea>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(sec.PreviousBody))
                        {
                            <details class="mt-3">
                                <summary class="text-muted small">
                                    What you wrote for @previousPeriod
                                </summary>
                                <ul class="text-muted small mt-2 mb-0">
                                    @foreach (var line in
                                        HrPortal.Services.WeeklyReportPdfService.Lines(sec.PreviousBody))
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                            </details>
                        }

                    </div>

                </div>
            }

        </div>

        @if (!Model.FixedHeadings)
        {
            <button type="button" class="btn btn-outline-primary mb-3" data-add-report-item>
                <i class="fas fa-plus" aria-hidden="true"></i>
                Add another piece of work
            </button>

            <template id="report-item-template">
                <div class="card shadow-sm mb-3" data-report-item>
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <input name="Sections[__i__].Heading" class="form-control"
                               placeholder="Piece of work, e.g. Client onboarding for ABC Ltd"
                               aria-label="Piece of work" />
                        <label class="form-check-label small text-nowrap">
                            <input type="checkbox" class="form-check-input me-1"
                                   name="Sections[__i__].Remove" value="true" />
                            Remove
                        </label>
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="Sections[__i__].Id" value="0" />
                        <input type="hidden" name="Sections[__i__].Order" value="0" />
                        <div class="row">
                            <div class="col-md-7 mb-3">
                                <label class="form-label">Project or client (optional)</label>
                                <input name="Sections[__i__].Workstream" class="form-control" />
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label">Status</label>
                                <select name="Sections[__i__].WorkstreamStatus" class="form-select">
                                    @foreach (var option in Html.GetEnumSelectList<WorkstreamStatus>())
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">What was done</label>
                            <textarea name="Sections[__i__].Body" class="form-control" rows="4"
                                      placeholder="One point per line."></textarea>
                        </div>
                    </div>
                </div>
            </template>
        }

        <div class="card shadow-sm mb-3">

            <div class="card-header">Priorities for next week</div>

            <div class="card-body">
                <label asp-for="PrioritiesText" class="form-label visually-hidden"></label>
                <textarea asp-for="PrioritiesText" class="form-control"
                          rows="5"
                          placeholder="One priority per line."></textarea>
                <div class="form-text">
                    One per line. These carry into next week's report as a
                    starting point.
                </div>
            </div>

        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">

            <button type="submit" class="btn btn-outline-primary">Save draft</button>

            <button type="submit" name="thenSubmit" value="true" class="btn btn-primary">
                Save and submit
            </button>

            <a asp-action="Delete" asp-route-id="@Model.Id"
               class="btn btn-outline-danger ms-auto">Delete draft</a>

        </div>

        <p class="text-muted small mb-4">
            Submitting lets your supervisor and the Managing Director read the
            report, and tells your supervisor it is in. You can take it back
            to change it afterwards.
        </p>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var add = document.querySelector("[data-add-report-item]");
            var template = document.getElementById("report-item-template");
            var list = document.getElementById("report-items");
            if (!add || !template || !list) return;

            add.addEventListener("click", function () {
                var index = list.querySelectorAll("[data-report-item]").length;
                var html = template.innerHTML.replace(/__i__/g, index);
                list.insertAdjacentHTML("beforeend", html);
                var cards = list.querySelectorAll("[data-report-item]");
                cards[cards.length - 1].querySelector("input[name$='.Heading']").focus();
            });
        })();
    </script>
}
