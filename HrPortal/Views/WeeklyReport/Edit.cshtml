@using HrPortal.Entities
@model HrPortal.ViewModels.WeeklyReportEditViewModel

@{
    ViewData["Title"] = "Edit Weekly Report";

    var previousPeriod = ViewBag.PreviousPeriod as string;
    var activityCount = (int)ViewBag.ActivityCount;
}

<div class="container">

    <div class="page-head">
        <div>
            <h2>
                @Model.PeriodStart.ToString("dd MMM")
                &ndash;
                @Model.PeriodEnd.ToString("dd MMM yyyy")
            </h2>

            <div class="detail-badges">
                @if (Model.Status == WeeklyReportStatus.Final)
                {
                    <span class="badge bg-success">Issued</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Draft</span>
                }

                <span class="badge bg-light text-dark">
                    @activityCount activities logged this period
                </span>
            </div>
        </div>

        <div class="page-head-actions">
            <a asp-action="Pdf" asp-route-id="@Model.Id"
               class="btn btn-outline-primary">Preview PDF</a>

            <a asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">On-screen</a>

            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PeriodStart" />
        <input type="hidden" asp-for="PeriodEnd" />
        <input type="hidden" asp-for="Status" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Executive Overview</div>
            <div class="card-body">

                <div class="mb-3">
                    <label asp-for="PreparedBy" class="form-label"></label>
                    <input asp-for="PreparedBy" class="form-control" />
                    <span asp-validation-for="PreparedBy" class="text-danger"></span>
                </div>

                <div class="mb-0">
                    <label asp-for="ExecutiveOverview" class="form-label"></label>
                    <textarea asp-for="ExecutiveOverview" class="form-control"
                              rows="7"
                              placeholder="During the reporting period, the IT Department maintained focus on..."></textarea>
                    <div class="form-text">
                        One paragraph. This is the part that cannot be
                        generated &mdash; it is the judgement call on how the
                        week went.
                    </div>
                    <span asp-validation-for="ExecutiveOverview" class="text-danger"></span>
                </div>

            </div>
        </div>

        @for (var i = 0; i < Model.Sections.Count; i++)
        {
            var sec = Model.Sections[i];

            <div class="card shadow-sm mb-3">

                <div class="card-header">
                    @sec.Order.ToString("00"). @sec.Heading
                </div>

                <div class="card-body">

                    <input type="hidden" asp-for="Sections[i].Id" />
                    <input type="hidden" asp-for="Sections[i].Order" />
                    <input type="hidden" asp-for="Sections[i].Heading" />

                    <div class="row">

                        <div class="col-md-7 mb-3">
                            <label asp-for="Sections[i].Workstream"
                                   class="form-label">
                                Workstream
                            </label>
                            <input asp-for="Sections[i].Workstream"
                                   class="form-control"
                                   placeholder="Sophos Firewall Implementation" />
                            <div class="form-text">
                                Leave blank for a plain list with no
                                named workstream.
                            </div>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="Sections[i].WorkstreamStatus"
                                   class="form-label">
                                Status
                            </label>
                            <select asp-for="Sections[i].WorkstreamStatus"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<WorkstreamStatus>()">
                            </select>
                        </div>

                    </div>

                    <div class="mb-0">
                        <label asp-for="Sections[i].Body" class="form-label">
                            Bullets
                        </label>
                        <textarea asp-for="Sections[i].Body"
                                  class="form-control" rows="5"
                                  placeholder="One bullet per line."></textarea>
                        <div class="form-text">One bullet per line.</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(sec.PreviousBody))
                    {
                        <details class="mt-3">
                            <summary class="text-muted small">
                                What this section said for @previousPeriod
                            </summary>
                            <ul class="text-muted small mt-2 mb-0">
                                @foreach (var line in
                                    HrPortal.Services.WeeklyReportPdfService
                                        .Lines(sec.PreviousBody))
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </details>
                    }

                </div>

            </div>
        }

        <div class="card shadow-sm mb-3">

            <div class="card-header">
                Priorities for the Next Reporting Period
            </div>

            <div class="card-body">
                <label asp-for="PrioritiesText" class="form-label visually-hidden">
                    Priorities
                </label>
                <textarea asp-for="PrioritiesText" class="form-control"
                          rows="7"
                          placeholder="One priority per line."></textarea>
                <div class="form-text">
                    One per line. Whatever is here becomes the starting
                    point for next week's draft, so leave the ones that
                    are still open.
                </div>
            </div>

        </div>

        <div class="d-flex gap-2 mb-4">

            <button type="submit" class="btn btn-primary">Save</button>

            <button type="submit" name="thenPreview" value="true"
                    class="btn btn-outline-primary">
                Save and preview
            </button>

            <a asp-action="Index" class="btn btn-secondary">Cancel</a>

        </div>

    </form>

    @if (Model.Status == WeeklyReportStatus.Draft)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>Issue this report</strong>
                    <div class="text-muted small">
                        Marks it final and drops the DRAFT marking from
                        the file name. You can reopen it afterwards.
                    </div>
                </div>

                <form asp-action="Finalise" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        Issue Report
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>This report has been issued</strong>
                    <div class="text-muted small">
                        Reopen it if something needs correcting.
                    </div>
                </div>

                <form asp-action="Reopen" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        Reopen
                    </button>
                </form>
            </div>
        </div>
    }

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
