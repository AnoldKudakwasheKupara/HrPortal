@using HrPortal.Entities
@using HrPortal.Services
@model HrPortal.Entities.WeeklyReport

@{
    ViewData["Title"] = "Weekly Report";

    var sections = Model.Sections
        .OrderBy(s => s.Order)
        .Where(s => !string.IsNullOrWhiteSpace(s.Body)
                 || !string.IsNullOrWhiteSpace(s.Workstream))
        .ToList();

    var priorities = Model.Priorities.OrderBy(p => p.Order).ToList();

    var nextNumber = sections.Count + 1;

    var owns = ViewBag.Owns == true;
    var submitted = Model.Status == WeeklyReportStatus.Final;
    var personal = Model.EmployeeId != null;

    var who = Model.Employee == null
        ? Model.PreparedBy
        : $"{Model.Employee.FirstName} {Model.Employee.LastName}";
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>
                @(personal && !owns ? who + ": " : "")
                Week of
                @Model.PeriodStart.ToString("dd MMM")
                &ndash;
                @Model.PeriodEnd.ToString("dd MMM yyyy")
            </h2>

            <div class="detail-badges">
                @if (submitted)
                {
                    <span class="badge bg-success">
                        @(personal ? "Submitted" : "Issued")
                        @(Model.FinalisedOn?.ToString("d MMM yyyy") ?? "")
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Draft &middot; only you can see it</span>
                }

                <span class="badge bg-light text-dark">
                    @who@(Model.Employee?.Department == null ? "" : $", {Model.Employee.Department.Name}")
                </span>
            </div>
        </div>

        <div class="page-head-actions">
            <a asp-action="Pdf" asp-route-id="@Model.Id"
               class="btn btn-outline-primary">Download PDF</a>

            @if (owns && !submitted)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">Edit</a>

                <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-primary">
                        @(personal ? "Submit" : "Issue")
                    </button>
                </form>
            }
            else if (owns)
            {
                <form asp-action="Reopen" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-secondary">
                        Take back to change
                    </button>
                </form>
            }

            @if (owns)
            {
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            }
            else
            {
                <a asp-action="Overview"
                   asp-route-week="@Model.PeriodStart.ToString("yyyy-MM-dd")"
                   class="btn btn-secondary">Back to overview</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">

        <div class="card-header">@(personal ? "Summary of the week" : "Executive Overview")</div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.ExecutiveOverview))
            {
                <div class="field-value mb-0" style="white-space: pre-line;">@Model.ExecutiveOverview</div>
            }
            else
            {
                <div class="field-value is-empty mb-0">No summary written.</div>
            }
        </div>

    </div>

    @for (var n = 0; n < sections.Count; n++)
    {
        var s = sections[n];

        <div class="card shadow-sm mb-3">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@((n + 1).ToString("00")). @s.Heading</span>

                @if (WeeklyReportPdfService.StatusLabel(s.WorkstreamStatus) is string label)
                {
                    <span class="badge bg-light text-dark">@label</span>
                }
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(s.Workstream))
                {
                    <p class="fw-semibold mb-2">@s.Workstream</p>
                }

                @{
                    var lines = WeeklyReportPdfService.Lines(s.Body);
                }

                @if (lines.Any())
                {
                    <ul class="mb-0">
                        @foreach (var line in lines)
                        {
                            <li class="mb-2">@line</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="field-value is-empty mb-0">
                        Nothing written under this heading.
                    </div>
                }

            </div>

        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            @nextNumber.ToString("00"). Priorities for next week
        </div>

        <div class="card-body">
            @if (priorities.Any())
            {
                <ul class="mb-0">
                    @foreach (var p in priorities)
                    {
                        <li class="mb-2">
                            @p.Text
                            @if (p.CarriedForward)
                            {
                                <span class="badge bg-light text-dark">
                                    Carried forward
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="field-value is-empty mb-0">
                    No priorities recorded for next week.
                </div>
            }
        </div>

    </div>

</div>
