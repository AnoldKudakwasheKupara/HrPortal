@model HrPortal.Services.HrContact

@{
    ViewData["Title"] = "Help & Support";
    ViewData["Crumb"] = "Who to ask";
}

<div class="container-fluid">

    <div class="page-head-simple">
        <h2>Help &amp; Support</h2>
        <p class="text-muted">
            Where to look first, and who to ask when the answer is
            not here.
        </p>
    </div>

    <div class="row g-3">

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">Talk to HR</div>

                <div class="card-body">

                    @if (Model.IsKnown)
                    {
                        <div class="detail-rows">

                            <div class="detail-row">
                                <span class="detail-icon">
                                    <i class="fas fa-user" aria-hidden="true"></i>
                                </span>
                                <span class="detail-text">@Model.Name</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <div class="detail-row">
                                    <span class="detail-icon">
                                        <i class="fas fa-envelope" aria-hidden="true"></i>
                                    </span>
                                    <span class="detail-text">
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <div class="detail-row">
                                    <span class="detail-icon">
                                        <i class="fas fa-phone" aria-hidden="true"></i>
                                    </span>
                                    <span class="detail-text">@Model.Phone</span>
                                </div>
                            }

                        </div>

                        <p class="field-value mt-3 mb-0">
                            Questions about your pay, leave, records or
                            anything else people-related start here.
                        </p>
                    }
                    else
                    {
                        <p class="empty-state mb-0">
                            <span class="empty-icon">&#128100;</span>
                            No HR officer is set up yet. An
                            administrator can name one on the approval
                            settings page, and their details will show
                            here.
                        </p>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header">Look here first</div>

                <div class="card-body">

                    <div class="settings-grid">

                        <a class="settings-item"
                           asp-controller="Policy"
                           asp-action="Index">
                            <span class="settings-icon">
                                <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">Policy Hub</span>
                                <span class="settings-note">
                                    Company policies, the code of
                                    conduct and procedures
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                        <a class="settings-item"
                           asp-controller="Repository"
                           asp-action="Index">
                            <span class="settings-icon">
                                <i class="fas fa-folder-open" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">Documents</span>
                                <span class="settings-note">
                                    Forms, guidance and the files you
                                    are asked for most
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                        <a class="settings-item"
                           asp-controller="MyProfile"
                           asp-action="Index">
                            <span class="settings-icon">
                                <i class="fas fa-id-badge" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">My Profile</span>
                                <span class="settings-note">
                                    Correct your own details and next
                                    of kin
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                        <a class="settings-item"
                           asp-controller="Home"
                           asp-action="Privacy">
                            <span class="settings-icon">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">Privacy notice</span>
                                <span class="settings-note">
                                    What the portal holds about you and
                                    who can see it
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
