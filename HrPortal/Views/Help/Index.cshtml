@model HrPortal.Services.SupportContacts

@{
    ViewData["Title"] = "Help & Support";
    ViewData["Crumb"] = "Who to ask";
}

<div class="container-fluid">

    <div class="page-head-simple">
        <h2>Help &amp; Support</h2>
        <p class="text-muted">
            Any queries, contact Human Resources. Anything to do with
            the portal, your computer or your account, contact IT.
        </p>
    </div>

    <div class="row g-3">

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">
                    Any queries &mdash; contact HR
                </div>

                <div class="card-body">

                    @if (Model.Hr.Any())
                    {
                        <div class="row-list">

                            @foreach (var person in Model.Hr)
                            {
                                <div class="row-item">

                                    <span class="row-icon">
                                        <i class="fas fa-user"
                                           aria-hidden="true"></i>
                                    </span>

                                    <span class="row-main">
                                        <span class="row-title">@person.Name</span>

                                        <span class="row-meta">
                                            @if (!string.IsNullOrWhiteSpace(person.JobTitle))
                                            {
                                                @person.JobTitle<text> &middot; </text>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(person.Email))
                                            {
                                                <a href="mailto:@person.Email">@person.Email</a>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(person.Phone))
                                            {
                                                <text> &middot; </text>@person.Phone
                                            }
                                        </span>
                                    </span>

                                </div>
                            }

                        </div>

                        <p class="field-value mt-3 mb-0">
                            Your pay, leave, records, training and
                            anything else people-related starts here.
                        </p>
                    }
                    else
                    {
                        <p class="empty-state mb-0">
                            <span class="empty-icon">&#128100;</span>
                            Nobody holds the HR Officer role yet. An
                            administrator can grant it on the roles
                            page, and their details will show here.
                        </p>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header">
                    Portal, device or account &mdash; contact IT
                </div>

                <div class="card-body">

                    @if (Model.It.Any())
                    {
                        <div class="row-list">

                            @foreach (var person in Model.It)
                            {
                                <div class="row-item">

                                    <span class="row-icon">
                                        <i class="fas fa-headset"
                                           aria-hidden="true"></i>
                                    </span>

                                    <span class="row-main">
                                        <span class="row-title">@person.Name</span>

                                        <span class="row-meta">
                                            @if (!string.IsNullOrWhiteSpace(person.JobTitle))
                                            {
                                                @person.JobTitle<text> &middot; </text>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(person.Email))
                                            {
                                                <a href="mailto:@person.Email">@person.Email</a>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(person.Phone))
                                            {
                                                <text> &middot; </text>@person.Phone
                                            }
                                        </span>
                                    </span>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="empty-state mb-0">
                            <span class="empty-icon">&#128187;</span>
                            Nobody is on record in the IT department
                            yet. Once somebody is, their details will
                            show here.
                        </p>
                    }

                </div>

            </div>

        </div>

        <div class="col-12">

            <div class="card shadow-sm">

                <div class="card-header">Look here first</div>

                <div class="card-body">

                    <div class="settings-grid">

                        <a class="settings-item"
                           asp-controller="Policy"
                           asp-action="Index">
                            <span class="settings-icon">
                                <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">Policy Hub</span>
                                <span class="settings-note">
                                    Company policies, the code of
                                    conduct and procedures
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                        <a class="settings-item"
                           asp-controller="Repository"
                           asp-action="Index">
                            <span class="settings-icon">
                                <i class="fas fa-folder-open" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">Documents</span>
                                <span class="settings-note">
                                    Forms, guidance and the files you
                                    are asked for most
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                        <a class="settings-item"
                           asp-controller="MyProfile"
                           asp-action="Index">
                            <span class="settings-icon">
                                <i class="fas fa-id-badge" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">My Profile</span>
                                <span class="settings-note">
                                    Correct your own details and next
                                    of kin
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                        <a class="settings-item"
                           asp-controller="Home"
                           asp-action="Privacy">
                            <span class="settings-icon">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                            </span>
                            <span class="settings-text">
                                <span class="settings-title">Privacy notice</span>
                                <span class="settings-note">
                                    What the portal holds about you and
                                    who can see it
                                </span>
                            </span>
                            <i class="fas fa-chevron-right settings-chevron"
                               aria-hidden="true"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
