@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete account";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>Delete account</h2>

        <p class="text-muted">
            Closing the sign-in you are using now.
        </p>

    </div>

    <div class="row g-3">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header">Confirm</div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <strong>This cannot be undone.</strong>
                        You will be signed out straight away and will not
                        be able to sign in again.
                    </div>

                    <p class="field-value">
                        Your employment record stays with HR. Leave,
                        training, documents and the rest remain on file;
                        it is the sign-in that is removed, and it cannot
                        be put back without HR creating a new one.
                    </p>

                    <form id="delete-user" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert"></div>

                        @if (Model.RequirePassword)
                        {
                            <div class="mb-4">

                                <label asp-for="Input.Password"
                                       class="form-label">
                                    Your password
                                </label>

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       aria-required="true" />

                                <div class="form-text">
                                    Confirming with your password makes
                                    sure this is you.
                                </div>

                                <span asp-validation-for="Input.Password"
                                      class="text-danger"></span>

                            </div>
                        }

                        <div class="d-flex flex-wrap gap-2">

                            <button class="btn btn-danger" type="submit">
                                <i class="fas fa-triangle-exclamation"></i>
                                Delete my account
                            </button>

                            <a class="btn btn-secondary"
                               asp-page="./PersonalData">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
