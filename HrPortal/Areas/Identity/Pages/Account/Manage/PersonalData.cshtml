@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>Personal data</h2>

        <p class="text-muted">
            What the portal holds against your sign-in, how to take a copy
            of it, and how to close the account.
        </p>

    </div>

    <div class="row g-3">

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header">Take a copy</div>

                <div class="card-body d-flex flex-column">

                    <div class="detail-rows">

                        <div class="detail-row">

                            <span class="detail-icon">
                                <i class="fas fa-id-card"></i>
                            </span>

                            <div class="detail-text">
                                <span class="field-label">Sign-in details</span>
                                <div class="field-value">
                                    The username, email address and phone
                                    number held against your account, and
                                    whether each has been confirmed.
                                </div>
                            </div>

                        </div>

                        <div class="detail-row">

                            <span class="detail-icon">
                                <i class="fas fa-shield-halved"></i>
                            </span>

                            <div class="detail-text">
                                <span class="field-label">Sign-in security</span>
                                <div class="field-value">
                                    Your authenticator key and any outside
                                    accounts linked for signing in.
                                </div>
                            </div>

                        </div>

                    </div>

                    <p class="text-muted small mt-3 mb-4">
                        It downloads as a JSON file. Your employment record
                        is not part of it: leave, training, documents and
                        the rest are on
                        <a asp-area=""
                           asp-controller="MyProfile"
                           asp-action="Index">My Profile</a>.
                    </p>

                    <form id="download-data"
                          asp-page="DownloadPersonalData"
                          method="post"
                          class="mt-auto">

                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-download"></i>
                            Download my data
                        </button>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">Close this account</div>

                <div class="card-body d-flex flex-column">

                    <div class="alert alert-warning">
                        <strong>This cannot be undone.</strong>
                        Deleting removes the sign-in you are using now, so
                        you will not be able to get back into the portal.
                    </div>

                    <div class="field-value">
                        Your employment record stays with HR. It is the
                        sign-in that goes, not your leave, training or
                        documents.
                    </div>

                    <p class="text-muted small">
                        You will be asked for your password to confirm.
                    </p>

                    <a id="delete"
                       class="btn btn-danger mt-auto"
                       asp-page="DeletePersonalData">
                        <i class="fas fa-triangle-exclamation"></i>
                        Delete my account
                    </a>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mt-3 mb-4">

        <div class="card-header">Account settings</div>

        <div class="card-body">
            <partial name="_ManageNav" />
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
