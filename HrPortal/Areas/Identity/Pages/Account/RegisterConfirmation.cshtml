@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "Confirm your account";
}

<div class="auth-head">
    <h1>Confirm your account</h1>

    @if (Model.DisplayConfirmAccountLink)
    {
        <p>
            No email sender is configured, so the confirmation link is
            shown here instead of being sent.
        </p>
    }
    else
    {
        <p>
            Check your email for a link to confirm your account.
        </p>
    }
</div>

@if (Model.DisplayConfirmAccountLink)
{
    <a id="confirm-link"
       href="@Model.EmailConfirmationUrl"
       class="btn btn-primary w-100 justify-content-center">
        Confirm account
    </a>
}
else
{
    <a asp-page="./Login"
       class="btn btn-primary w-100 justify-content-center">
        Back to sign in
    </a>
}
