@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "Finish signing in";
}

<div class="auth-head">
    <h1 id="external-login-title">Finish signing in</h1>
    <p id="external-login-description">
        You signed in with <strong>@Model.ProviderDisplayName</strong>.
        Enter an email address to finish setting up your account.
    </p>
</div>

<form asp-page-handler="Confirmation"
      asp-route-returnUrl="@Model.ReturnUrl"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"
         data-valmsg-summary="true"></div>

    <div class="mb-3">

        <label asp-for="Input.Email" class="form-label">
            Email
        </label>

        <input asp-for="Input.Email"
               class="form-control"
               autocomplete="email"
               aria-required="true"
               placeholder="you@company.com" />

        <span asp-validation-for="Input.Email"
              class="text-danger"></span>

    </div>

    <button type="submit"
            class="btn btn-primary w-100 justify-content-center">
        Continue
    </button>

</form>

<p class="auth-foot-link">
    <a asp-page="./Login">Back to sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
