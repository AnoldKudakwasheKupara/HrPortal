    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "My Intellego",
    "PortalBaseUrl": ""
  },
  "Leave": {
    "BackdateGraceDays": 7
  },
  "Requisitions": {
    "MdApprovalThreshold": 500,
    "CurrencyCode": "USD"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=HrPortalDB;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}